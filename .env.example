# Symfony Configuration
APP_ENV=dev
APP_SECRET=ChangeMe!ToARandomSecureKey!
APP_SHARE_DIR=var/share

# Default URI for non-HTTP contexts
DEFAULT_URI=http://localhost

# Database Configuration
# PostgreSQL (Default for development)
DATABASE_URL="postgresql://app:password@127.0.0.1:5432/sirius_solar?serverVersion=16&charset=utf8"

# MariaDB (Alternative)
# DATABASE_URL="mysql://app:password@127.0.0.1:3306/sirius_solar?serverVersion=10.11.2-MariaDB&charset=utf8mb4"

# MySQL
# DATABASE_URL="mysql://app:password@127.0.0.1:3306/sirius_solar?serverVersion=8.0.32&charset=utf8mb4"

# Messenger Configuration
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mailer Configuration
MAILER_DSN=null://null

# Production MAILER_DSN Examples:
# Brevo (API, recommandé): "brevo+api://VOTRE_CLE_API@default"
# Brevo (SMTP): "brevo+smtp://VOTRE_LOGIN:VOTRE_MDP@default"
# Gmail: "gmail+smtp://username:password@gmail.com:587"
# SendGrid: "sendgrid+api://SG.xxxxxxx@sendgrid.net"
# Mailgun: "mailgun+smtp://postmaster@example.com:key@smtp.mailgun.org:587"
# SMTP: "smtp://user:pass@mail.example.com:587?encryption=tls"
#
# Le vrai MAILER_DSN (avec la vraie clé Brevo) ne doit JAMAIS être mis ici
# ni commité sur Git : il va uniquement dans .env.prod.local sur le
# serveur (ce fichier est ignoré par Git, voir .gitignore).

# Adresse qui reçoit les notifications du formulaire "Me contacter"
CONTACT_NOTIFICATION_EMAIL=contact@panneauvoltaique.net

# Company Information
COMPANY_EMAIL=Info@Sirius-solar-services.ch
COMPANY_PHONE="+41 XX XXX XX XX"
COMPANY_ADDRESS="Route des dragons 7, 1027 Cheseaux-sur-Lausanne"

# Admin Credentials (À CHANGER IMMÉDIATEMENT!)
ADMIN_EMAIL=admin@sirius-solar.ch
ADMIN_PASSWORD=Sirius2024!Temp
