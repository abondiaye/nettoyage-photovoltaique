{% extends 'base.html.twig' %}

{% block title %}À Propos - Sirius-Solar{% endblock %}

{% block body %}

<style>
    .about-hero {
        background: linear-gradient(135deg, #003d5c 0%, #1a6b8f 40%, #2a9cc0 60%, #3d7ba0 100%);
        padding: 100px 40px;
        text-align: center;
        color: white;
    }

    .about-hero h1 {
        font-size: 52px;
        font-weight: 700;
        margin-bottom: 20px;
        font-family: 'Space Grotesk', sans-serif;
    }

    .about-hero p {
        font-size: 18px;
        opacity: 0.95;
        max-width: 700px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .about-container {
        max-width: 1200px;
        margin: 60px auto;
        padding: 0 40px;
    }

    .about-section {
        margin-bottom: 80px;
    }

    .about-section h2 {
        font-size: 36px;
        font-weight: 700;
        color: #0A3D35;
        margin-bottom: 30px;
        font-family: 'Space Grotesk', sans-serif;
        position: relative;
        padding-bottom: 15px;
    }

    .about-section h2::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #ffd700, #ffed4e);
        border-radius: 2px;
    }

    .about-section p {
        font-size: 16px;
        line-height: 1.8;
        color: #555;
        margin-bottom: 15px;
    }

    .about-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
        margin-top: 40px;
    }

    .about-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-top: 4px solid #ffd700;
    }

    .about-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 60px rgba(160, 160, 160, 0.2);
    }

    .about-card h3 {
        font-size: 22px;
        font-weight: 700;
        color: #0A3D35;
        margin-bottom: 15px;
        font-family: 'Space Grotesk', sans-serif;
    }

    .about-card p {
        font-size: 14px;
        color: #666;
        line-height: 1.6;
    }

    .about-values {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        margin-top: 40px;
    }

    .value-item {
        text-align: center;
    }

    .value-icon {
        font-size: 48px;
        margin-bottom: 15px;
    }

    .value-item h3 {
        font-size: 20px;
        font-weight: 700;
        color: #0A3D35;
        margin-bottom: 10px;
    }

    .value-item p {
        font-size: 14px;
        color: #666;
        line-height: 1.6;
    }

    .cta-section-about {
        background: linear-gradient(135deg, #0A3D35 0%, #2D6B55 100%);
        color: white;
        padding: 60px 40px;
        text-align: center;
        border-radius: 15px;
        margin: 60px 0;
    }

    .cta-section-about h2 {
        color: white;
        margin-bottom: 20px;
    }

    .cta-section-about h2::after {
        background: linear-gradient(90deg, #ffd700, #ffed4e);
    }

    .cta-section-about p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 16px;
        margin-bottom: 30px;
    }

    .btn-cta {
        display: inline-block;
        background: linear-gradient(135deg, #ffd700, #ffed4e);
        color: #0A3D35;
        padding: 15px 40px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        font-size: 16px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(255, 215, 0, 0.3);
    }

    .btn-cta:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(255, 215, 0, 0.5);
    }

    /* Dark mode */
    body.dark-mode .about-section h2 {
        color: #a8a8a8;
    }

    body.dark-mode .about-section p {
        color: #ccc;
    }

    body.dark-mode .about-card {
        background: #1a1a1a;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    body.dark-mode .about-card:hover {
        box-shadow: 0 20px 60px rgba(255, 215, 0, 0.3);
    }

    body.dark-mode .about-card h3 {
        color: #a8a8a8;
    }

    body.dark-mode .about-card p {
        color: #aaa;
    }

    body.dark-mode .value-item h3 {
        color: #a8a8a8;
    }

    body.dark-mode .value-item p {
        color: #aaa;
    }

    body.dark-mode .cta-section-about {
        background: linear-gradient(135deg, #1a3d35 0%, #2D6B55 100%);
    }

    /* Mobile */
    @media (max-width: 768px) {
        .about-hero {
            padding: 50px 20px;
        }

        .about-hero h1 {
            font-size: 32px;
        }

        .about-container {
            padding: 0 20px;
        }

        .about-section h2 {
            font-size: 26px;
        }

        .about-grid {
            grid-template-columns: 1fr;
        }

        .cta-section-about {
            padding: 40px 20px;
        }
    }
</style>

<section class="about-hero">
    <h1>🌟 À Propos de Sirius-Solar</h1>
    <p>Spécialistes du nettoyage professionnel de panneaux photovoltaïques avec eau osmosée. Depuis notre création, nous nous engageons à maximiser la performance de vos installations solaires.</p>
</section>

<section class="about-container">
    <div class="about-section">
        <h2>Notre Mission</h2>
        <p>Chez Sirius-Solar, notre mission est simple : <strong>aider nos clients à optimiser le rendement de leurs panneaux solaires</strong> en offrant un service de nettoyage professionnel, écologique et fiable.</p>
        <p>Un panneau solaire sale peut perdre jusqu'à 25% de son rendement. C'est pourquoi nous utilisons les meilleures techniques et matériels pour garantir un nettoyage efficace et sans résidu.</p>
    </div>

    <div class="about-section">
        <h2>Nos Valeurs</h2>
        <div class="about-values">
            <div class="value-item">
                <div class="value-icon">♻️</div>
                <h3>Écologie</h3>
                <p>Eau osmosée pure, zéro produit chimique agressif. Respect total de l'environnement.</p>
            </div>
            <div class="value-item">
                <div class="value-icon">⚡</div>
                <h3>Performance</h3>
                <p>Équipes formées et équipement professionnel pour un résultat optimal.</p>
            </div>
            <div class="value-item">
                <div class="value-icon">🤝</div>
                <h3>Confiance</h3>
                <p>Transparence totale, devis détaillé et suivi régulier de votre installation.</p>
            </div>
        </div>
    </div>

    <div class="about-section">
        <h2>Notre Expertise</h2>
        <div class="about-grid">
            <div class="about-card">
                <h3>✓ Nettoyage Premium</h3>
                <p>Eau osmosée haute pression, brosses spécialisées et technique sans traces pour un résultat impeccable.</p>
            </div>
            <div class="about-card">
                <h3>✓ Inspection Complète</h3>
                <p>Diagnostic professionnel de vos panneaux avec rapport détaillé et recommandations d'entretien.</p>
            </div>
            <div class="about-card">
                <h3>✓ Maintenance Régulière</h3>
                <p>Contrats d'entretien personnalisés pour maintenir vos panneaux en excellent état tout au long de l'année.</p>
            </div>
        </div>
    </div>

    <div class="about-section">
        <h2>Pourquoi Nous Choisir?</h2>
        <div class="about-grid">
            <div class="about-card">
                <h3>💧 Eau Osmosée</h3>
                <p>Eau pure sans minéraux, garantissant un nettoyage sans résidu calcaire ni trace sur vos panneaux.</p>
            </div>
            <div class="about-card">
                <h3>🎓 Expertise</h3>
                <p>Nos techniciens sont formés aux normes de sécurité du travail en hauteur et aux meilleures pratiques.</p>
            </div>
            <div class="about-card">
                <h3>📊 Transparence</h3>
                <p>Devis gratuit, rapports détaillés et suivi régulier de la performance de votre installation.</p>
            </div>
        </div>
    </div>
</section>

<div class="about-container">
    <section class="cta-section-about">
        <h2>Prêt à Optimiser Votre Installation?</h2>
        <p>Contactez nos experts Sirius-Solar pour un diagnostic gratuit et une solution adaptée à vos panneaux solaires.</p>
        <a href="{{ path('app_devis') }}" class="btn-cta">Demander un Devis Gratuit →</a>
    </section>
</div>

{% endblock %}
