{% extends 'base.html.twig' %}

{% block title %}Admin - Appointments - Solar Cleaning{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-bleu-nuit mb-8">All Appointments</h1>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full">
            <thead class="bg-bleu-nuit text-white">
                <tr>
                    <th class="px-6 py-3 text-left">Member</th>
                    <th class="px-6 py-3 text-left">Date</th>
                    <th class="px-6 py-3 text-left">Time</th>
                    <th class="px-6 py-3 text-left">Status</th>
                    <th class="px-6 py-3 text-left">Booked</th>
                </tr>
            </thead>
            <tbody>
                {% for appointment in appointments %}
                    <tr class="border-b hover:bg-gray-50">
                        <td class="px-6 py-3">{{ appointment.user.firstName }} {{ appointment.user.lastName }}</td>
                        <td class="px-6 py-3">{{ appointment.date.format('d/m/Y') if appointment.date else 'N/A' }}</td>
                        <td class="px-6 py-3">{{ appointment.timeSlot }}</td>
                        <td class="px-6 py-3">
                            <span class="px-3 py-1 rounded-full text-white text-sm font-semibold
                                {% if appointment.status == 'SCHEDULED' %}bg-blue-500
                                {% elseif appointment.status == 'COMPLETED' %}bg-green-500
                                {% else %}bg-red-500
                                {% endif %}">
                                {{ appointment.status }}
                            </span>
                        </td>
                        <td class="px-6 py-3 text-sm text-gray-500">{{ appointment.createdAt.format('d/m/Y H:i') if appointment.createdAt else 'N/A' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-4 text-center text-gray-500">No appointments found</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
