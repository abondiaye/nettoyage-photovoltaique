{% extends 'admin/_shell.html.twig' %}

{% block title %}Ajouter une Réalisation - Admin Sirius-Solar{% endblock %}
{% block page_title %}Ajouter une réalisation{% endblock %}
{% block page_subtitle %}Partagez un chantier réussi avec ses photos avant / après : il apparaît sur la page Blog{% endblock %}

{% set values = values|default({title: '', description: '', location: '', date: 'now'|date('Y-m-d')}) %}

{% block admin_styles %}
    .rf { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 20px; align-items: start; }
    .field { margin-bottom: 18px; }
    .field label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: var(--text); }
    .field label em { color: var(--gold); font-style: normal; }
    .field input[type=text], .field input[type=date], .field textarea {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid var(--line-strong);
        background: var(--panel-2);
        color: var(--text);
        font: 400 15px/1.5 'Poppins', system-ui, sans-serif;
        transition: border-color 0.2s, box-shadow 0.2s;
        color-scheme: dark;
    }
    html.ds-light .field input, html.ds-light .field textarea { color-scheme: light; }
    .field textarea { min-height: 170px; resize: vertical; }
    .field input::placeholder, .field textarea::placeholder { color: var(--muted); opacity: 0.8; }
    .field input:focus, .field textarea:focus { outline: none; border-color: var(--mint); box-shadow: 0 0 0 3px rgba(45, 255, 79, 0.15); }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .hint { margin: 6px 0 0; font-size: 12px; color: var(--muted); }

    /* Photo drop zones */
    .drops { display: grid; gap: 16px; }
    .drop {
        position: relative;
        display: grid;
        place-items: center;
        aspect-ratio: 16 / 10;
        border: 2px dashed var(--line-strong);
        border-radius: 14px;
        background: var(--panel-2);
        overflow: hidden;
        cursor: pointer;
        text-align: center;
        transition: border-color 0.2s, background 0.2s;
    }
    .drop:hover, .drop.is-over { border-color: var(--mint); background: rgba(45, 255, 79, 0.06); }
    .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .drop__txt { padding: 16px; color: var(--muted); font-size: 14px; pointer-events: none; }
    .drop__txt svg { width: 34px; height: 34px; stroke: var(--mint); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; display: block; margin: 0 auto 8px; }
    .drop__txt b { color: var(--text); }
    .drop img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
    .drop__tag { position: absolute; left: 12px; top: 12px; z-index: 1; padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; pointer-events: none; }
    .drop--before .drop__tag { background: #ff5d73; color: #fff; }
    .drop--after .drop__tag { background: #2dff4f; color: #03120e; }

    .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
    @media (max-width: 1024px) { .rf { grid-template-columns: 1fr; } }
    @media (max-width: 560px) { .field-row { grid-template-columns: 1fr; } .actions .ds-btn { flex: 1; } }
{% endblock %}

{% block content %}
    {% if errors|default([]) is not empty %}
        <div class="ds-flash ds-flash--error">La réalisation n'a pas été publiée :
            <ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
            Les photos doivent être choisies à nouveau.
        </div>
    {% endif %}

    <form method="post" enctype="multipart/form-data" class="rf">
        <input type="hidden" name="_token" value="{{ csrf_token('realisation') }}">

        <section class="ds-card">
            <div class="ds-card__head"><div><h2>Le projet</h2><p>Les champs marqués <em style="color:var(--gold);font-style:normal">*</em> sont obligatoires</p></div></div>

            <div class="field">
                <label for="title">Titre du projet <em>*</em></label>
                <input type="text" id="title" name="title" maxlength="255" value="{{ values.title }}" placeholder="Ex : Nettoyage installation résidentielle 8 kW" required>
            </div>
            <div class="field">
                <label for="description">Description <em>*</em></label>
                <textarea id="description" name="description" placeholder="Décrivez le projet, les résultats, les conditions…" required>{{ values.description }}</textarea>
            </div>
            <div class="field-row">
                <div class="field">
                    <label for="location">Localisation <em>*</em></label>
                    <input type="text" id="location" name="location" maxlength="255" value="{{ values.location }}" placeholder="Ex : Lausanne (VD)" required>
                </div>
                <div class="field">
                    <label for="date">Date du projet <em>*</em></label>
                    <input type="date" id="date" name="date" value="{{ values.date }}" required>
                </div>
            </div>
            <div class="actions">
                <button type="submit" class="ds-btn ds-btn--primary">Publier la réalisation</button>
                <a href="{{ path('app_admin_blog') }}" class="ds-btn ds-btn--ghost">Annuler</a>
            </div>
        </section>

        <section class="ds-card">
            <div class="ds-card__head"><div><h2>Photos</h2><p>JPG, PNG ou WebP, 12 Mo maximum chacune</p></div></div>
            <div class="drops">
                {% for key, label in {image_before: 'AVANT', image_after: 'APRÈS'} %}
                    <label class="drop drop--{{ key == 'image_before' ? 'before' : 'after' }}">
                        <span class="drop__tag">{{ label }}</span>
                        <input type="file" name="{{ key }}" accept="image/jpeg,image/png,image/webp,image/gif" required data-preview>
                        <span class="drop__txt">
                            <svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
                            <b>Photo {{ label|lower }}</b><br>Cliquez ou glissez une image ici
                        </span>
                    </label>
                {% endfor %}
            </div>
        </section>
    </form>

    <script>
    document.querySelectorAll('[data-preview]').forEach((input) => {
        const zone = input.closest('.drop');
        ['dragenter', 'dragover'].forEach((ev) => zone.addEventListener(ev, () => zone.classList.add('is-over')));
        ['dragleave', 'drop'].forEach((ev) => zone.addEventListener(ev, () => zone.classList.remove('is-over')));
        input.addEventListener('change', () => {
            zone.querySelector('img')?.remove();
            const file = input.files[0];
            if (!file) return;
            const img = document.createElement('img');
            img.alt = '';
            img.src = URL.createObjectURL(file);
            zone.appendChild(img);
        });
    });
    </script>
{% endblock %}
