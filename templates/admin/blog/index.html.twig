{% extends 'admin/_shell.html.twig' %}

{% block title %}Réalisations - Admin Sirius-Solar{% endblock %}
{% block page_title %}Réalisations{% endblock %}
{% block page_subtitle %}Les chantiers avant / après affichés sur la page Blog{% endblock %}

{% block admin_styles %}
    .rl-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
    .rl-head p { margin: 0; color: var(--muted); font-size: 14px; }
    .rl { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 20px; }
    .rl .ds-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
    .rl-imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--line); }
    .rl-imgs figure { position: relative; margin: 0; aspect-ratio: 4 / 3; background: var(--panel-2); }
    .rl-imgs img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .rl-imgs figcaption { position: absolute; left: 8px; top: 8px; padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    .rl-imgs figure:first-child figcaption { background: #ff5d73; color: #fff; }
    .rl-imgs figure:last-child figcaption { background: #2dff4f; color: #03120e; }
    .rl-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .rl-body h3 { margin: 0; font: 700 16px/1.3 'Space Grotesk', system-ui, sans-serif; color: var(--text); }
    .rl-body p { margin: 0; font-size: 13px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .rl-meta { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: auto; padding-top: 10px; font-size: 13px; color: var(--muted); }
    .rl-meta form { margin: 0; }
{% endblock %}

{% block content %}
    <div class="rl-head">
        <p>{{ realisations|length }} réalisation{{ realisations|length > 1 ? 's' }} publiée{{ realisations|length > 1 ? 's' }}{% if realisations is empty %} — la page Blog affiche des exemples tant qu'il n'y en a aucune{% endif %}</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a class="ds-btn ds-btn--ghost" href="{{ path('app_blog') }}" target="_blank" rel="noopener">Voir la page Blog</a>
            <a class="ds-btn ds-btn--primary" href="{{ path('app_admin_blog_create') }}">＋ Ajouter une réalisation</a>
        </div>
    </div>

    {% if realisations is empty %}
        <div class="ds-card ds-empty">Aucune réalisation pour l'instant. Ajoutez la première avec ses photos avant / après.</div>
    {% else %}
        <div class="rl">
            {% for r in realisations %}
                <article class="ds-card">
                    <div class="rl-imgs">
                        <figure><img src="{{ r.imageBefore }}" alt="Avant" loading="lazy"><figcaption>AVANT</figcaption></figure>
                        <figure><img src="{{ r.imageAfter }}" alt="Après" loading="lazy"><figcaption>APRÈS</figcaption></figure>
                    </div>
                    <div class="rl-body">
                        <h3>{{ r.title }}</h3>
                        <p>{{ r.description }}</p>
                        <div class="rl-meta">
                            <span>📍 {{ r.location }} · {{ r.date|date('d/m/Y') }}</span>
                            <form method="post" action="{{ path('app_admin_blog_delete', {id: r.id}) }}" onsubmit="return confirm('Supprimer « {{ r.title|e('js') }} » du blog ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-realisation-' ~ r.id) }}">
                                <button class="ds-btn ds-btn--danger" type="submit">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
