{% extends 'admin/_shell.html.twig' %}

{% block title %}Commentaires - Admin Sirius-Solar{% endblock %}
{% block page_title %}Commentaires{% endblock %}
{% block page_subtitle %}Les avis laissés par les clients{% endblock %}

{% block admin_styles %}
    .cm { display: grid; gap: 16px; }
    .cm .ds-card { display: grid; gap: 10px; }
    .cm__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
    .cm__head h3 { margin: 0; font: 700 16px/1.3 'Space Grotesk', system-ui, sans-serif; color: var(--text); }
    .cm__head small { color: var(--muted); font-size: 12px; }
    .cm p { margin: 0; color: var(--text); font-size: 14px; line-height: 1.6; white-space: pre-line; }
{% endblock %}

{% block content %}
    {% set cats = {SERVICE_QUALITY: 'Qualité du service', TECHNICIAN: 'Technicien', SCHEDULING: 'Planification', OTHER: 'Autre'} %}
    {% if comments is empty %}
        <div class="ds-card ds-empty">Aucun commentaire pour le moment.</div>
    {% else %}
        <div class="cm">
            {% for c in comments %}
                <article class="ds-card">
                    <div class="cm__head">
                        <div>
                            <h3>{{ c.user ? (c.user.prenom|default('') ~ ' ' ~ c.user.nom|default(''))|trim : 'Anonyme' }}</h3>
                            <small>{{ c.createdAt ? c.createdAt|date('d/m/Y H:i') }}{{ c.user ? ' · ' ~ c.user.email }}</small>
                        </div>
                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                            <span class="ds-badge ds-badge--new">{{ cats[c.category] ?? c.category }}</span>
                            <span class="ds-badge ds-badge--{{ c.status == 'PENDING' ? 'wip' : 'ok' }}">{{ c.status == 'PENDING' ? 'En attente' : 'Examiné' }}</span>
                        </div>
                    </div>
                    <p>{{ c.text }}</p>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
