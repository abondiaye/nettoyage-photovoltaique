{% extends 'base.html.twig' %}

{% block title %}Admin - Commentaires - Solar Cleaning{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-bleu-nuit mb-8">Commentaires clients</h1>

    <div class="grid grid-cols-1 gap-6">
        {% for comment in comments %}
            <div class="bg-white rounded-lg shadow p-6 border-l-4
                {% if comment.status == 'PENDING' %}border-yellow-500
                {% else %}border-green-500
                {% endif %}">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <h3 class="text-xl font-bold text-bleu-nuit">{{ comment.user.firstName }} {{ comment.user.lastName }}</h3>
                        <p class="text-sm text-gray-600">
                            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">{{ {'SERVICE_QUALITY': 'Qualité du service', 'TECHNICIAN': 'Technicien', 'SCHEDULING': 'Planification', 'OTHER': 'Autre'}[comment.category] ?? comment.category }}</span>
                        </p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-white text-sm font-semibold
                        {% if comment.status == 'PENDING' %}bg-yellow-500
                        {% else %}bg-green-500
                        {% endif %}">
                        {{ {'PENDING': 'En attente', 'REVIEWED': 'Examiné'}[comment.status] ?? comment.status }}
                    </span>
                </div>
                <p class="text-gray-700 mb-4">{{ comment.text }}</p>
                <p class="text-xs text-gray-500">{{ comment.createdAt ? comment.createdAt.format('d/m/Y H:i') : 'N/A' }}</p>
            </div>
        {% else %}
            <div class="bg-gray-100 rounded-lg p-8 text-center">
                <p class="text-gray-600 text-lg">Aucun commentaire pour le moment</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
