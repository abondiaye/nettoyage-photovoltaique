{% extends 'admin/_shell.html.twig' %}

{% block title %}Tableau de bord - Admin Sirius-Solar{% endblock %}
{% block page_title %}Bienvenue {{ app.user ? app.user.prenom|capitalize : 'Admin' }} !{% endblock %}
{% block page_subtitle %}Voici l'activité de Sirius-Solar au {{ 'now'|date('d/m/Y') }}{% endblock %}

{% block admin_styles %}
    .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-bottom: 22px; }
    .kpi { position: relative; overflow: hidden; }
    .kpi__icon { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; margin-bottom: 16px; }
    .kpi__icon svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .kpi b { display: block; font: 700 30px/1 'Space Grotesk', system-ui, sans-serif; color: var(--text); }
    .kpi span { display: block; margin-top: 6px; font-size: 14px; color: var(--muted); }
    .kpi em { position: absolute; top: 22px; right: 22px; font-style: normal; }
    .kpi--mint .kpi__icon { background: rgba(45, 255, 79, 0.12); color: var(--mint); }
    .kpi--gold .kpi__icon { background: rgba(255, 210, 31, 0.12); color: var(--gold); }
    .kpi--blue .kpi__icon { background: rgba(60, 214, 255, 0.12); color: var(--blue); }
    .kpi--red .kpi__icon { background: rgba(255, 93, 115, 0.12); color: var(--red); }
    .kpi::after { content: ''; position: absolute; right: -30px; bottom: -40px; width: 120px; height: 120px; border-radius: 50%; background: currentColor; opacity: 0.05; }
    .kpi--mint { color: var(--mint); } .kpi--gold { color: var(--gold); } .kpi--blue { color: var(--blue); } .kpi--red { color: var(--red); }

    .row-2 { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 20px; margin-bottom: 22px; }
    .row-map { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 20px; margin-bottom: 22px; }

    /* Bar chart */
    .chart { width: 100%; height: auto; display: block; }
    .chart .grid line { stroke: var(--line); }
    .chart .grid text, .chart .x text { fill: var(--muted); font-size: 11px; font-family: 'Poppins', system-ui, sans-serif; }
    .chart .b-devis { fill: var(--mint); } .chart .b-rdv { fill: var(--gold); } .chart .b-msg { fill: var(--blue); }
    .chart rect { transition: opacity 0.2s; }
    .chart rect:hover { opacity: 0.75; }
    .legend { display: flex; flex-wrap: wrap; gap: 16px; font-size: 13px; color: var(--muted); }
    .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }

    /* Donut */
    .donut { width: 180px; height: 180px; margin: 6px auto 22px; border-radius: 50%; display: grid; place-items: center; }
    .donut div { width: 124px; height: 124px; border-radius: 50%; background: var(--panel); display: grid; place-items: center; text-align: center; }
    .donut b { display: block; font: 700 28px/1 'Space Grotesk', system-ui, sans-serif; }
    .donut small { color: var(--muted); font-size: 12px; }
    .status-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .status-list li { display: flex; justify-content: space-between; font-size: 14px; color: var(--muted); }
    .status-list b { color: var(--text); }

    /* Swiss map */
    .ch-map { width: 100%; height: auto; display: block; }
    .ch-map__cantons path { fill: var(--map-empty); stroke: var(--map-line); stroke-width: 1.2; stroke-linejoin: round; transition: fill 0.2s; }
    .ch-map__cantons path.has { fill: color-mix(in srgb, var(--mint) calc(var(--k) * 100%), var(--map-empty)); }
    .ch-map__cantons path:hover { fill: var(--gold); cursor: default; }
    .ch-map__lakes path { fill: var(--lake); pointer-events: none; }
    .ch-map__labels text { font: 600 11px 'Poppins', system-ui, sans-serif; fill: var(--muted); text-anchor: middle; dominant-baseline: middle; pointer-events: none; opacity: 0.8; }
    .ch-map__labels text.has { fill: var(--text); opacity: 1; }
    html:not(.ds-light) .ch-map__cantons path.has { filter: drop-shadow(0 0 6px rgba(45, 255, 79, 0.25)); }
    .map-scale { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 12px; color: var(--muted); }
    .map-scale span { flex: 0 0 120px; height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--map-empty), var(--mint)); border: 1px solid var(--line); }
    .top-cantons { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .top-cantons li { display: grid; grid-template-columns: 36px 1fr auto; align-items: center; gap: 12px; font-size: 14px; }
    .top-cantons code { display: grid; place-items: center; height: 30px; border-radius: 8px; background: var(--panel-2); border: 1px solid var(--line); font: 700 12px/1 'Poppins', sans-serif; color: var(--mint); }
    .top-cantons .bar { height: 6px; margin-top: 6px; border-radius: 3px; background: var(--panel-2); overflow: hidden; }
    .top-cantons .bar i { display: block; height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--mint), var(--gold)); }
    .top-cantons b { color: var(--text); }

    /* Tables */
    .table-wrap { overflow-x: auto; margin: 0 -22px -22px; }
    .ds-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .ds-table th { text-align: left; padding: 12px 22px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); background: var(--panel-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); white-space: nowrap; }
    .ds-table td { padding: 14px 22px; border-bottom: 1px solid var(--line); color: var(--text); vertical-align: middle; }
    .ds-table tr:last-child td { border-bottom: 0; }
    .ds-table small { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
    .msgs { list-style: none; margin: 0; padding: 0; }
    .msgs li { display: grid; grid-template-columns: 40px 1fr; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); }
    .msgs li:first-child { border-top: 0; padding-top: 0; }
    .msgs .ini { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 14px; background: rgba(60, 214, 255, 0.14); color: var(--blue); }
    .msgs b { font-size: 14px; color: var(--text); }
    .msgs time { float: right; font-size: 12px; color: var(--muted); }
    .msgs p { margin: 3px 0 0; font-size: 13px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .link-more { font-size: 13px; font-weight: 600; color: var(--mint); text-decoration: none; white-space: nowrap; }

    @media (max-width: 1200px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 1024px) { .row-2, .row-map { grid-template-columns: 1fr; } }
    @media (max-width: 560px) { .kpis { grid-template-columns: 1fr 1fr; gap: 12px; } .kpi b { font-size: 24px; } .kpi em { display: none; } .ds-card { padding: 16px; } .table-wrap { margin: 0 -16px -16px; } }
{% endblock %}

{% block content %}
    {# ---------- KPI cards ---------- #}
    <div class="kpis">
        <div class="ds-card kpi kpi--mint">
            <div class="kpi__icon"><svg viewBox="0 0 24 24"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg></div>
            <b>{{ stats.devis }}</b><span>Demandes de devis</span>
            {% if stats.devis_nouveaux %}<em class="ds-badge ds-badge--new">{{ stats.devis_nouveaux }} nouvelle{{ stats.devis_nouveaux > 1 ? 's' }}</em>{% endif %}
        </div>
        <div class="ds-card kpi kpi--gold">
            <div class="kpi__icon"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></div>
            <b>{{ stats.rdv }}</b><span>Rendez-vous</span>
            {% if stats.rdv_attente %}<em class="ds-badge ds-badge--wip">{{ stats.rdv_attente }} en attente</em>{% endif %}
        </div>
        <div class="ds-card kpi kpi--blue">
            <div class="kpi__icon"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></div>
            <b>{{ stats.messages }}</b><span>Messages reçus</span>
        </div>
        <div class="ds-card kpi kpi--red">
            <div class="kpi__icon"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.9.7 3.1 2.4 3.5 5.2"/></svg></div>
            <b>{{ stats.clients }}</b><span>Clients</span>
        </div>
    </div>

    {# ---------- Activity chart + appointment status ---------- #}
    <div class="row-2">
        <section class="ds-card">
            <div class="ds-card__head">
                <div><h2>Activité des 6 derniers mois</h2><p>Devis, rendez-vous et messages reçus par mois</p></div>
                <div class="legend"><span><i style="background:var(--mint)"></i>Devis</span><span><i style="background:var(--gold)"></i>Rendez-vous</span><span><i style="background:var(--blue)"></i>Messages</span></div>
            </div>
            {% set top = 4 %}
            {% for m in months %}{% set top = max(top, m.devis, m.rdv, m.messages) %}{% endfor %}
            {% set top = (top / 4)|round(0, 'ceil') * 4 %}
            {% set W = 640 %}{% set H = 300 %}{% set L = 34 %}{% set B = 28 %}
            {% set colW = (W - L) / months|length %}
            <svg class="chart" viewBox="0 0 {{ W }} {{ H }}" role="img" aria-label="Activité mensuelle">
                <g class="grid">
                    {% for i in 0..4 %}
                        {% set y = (H - B) - (H - B - 10) * i / 4 %}
                        <line x1="{{ L }}" x2="{{ W }}" y1="{{ y }}" y2="{{ y }}"/>
                        <text x="{{ L - 8 }}" y="{{ y + 4 }}" text-anchor="end">{{ (top * i / 4)|round }}</text>
                    {% endfor %}
                </g>
                {% for m in months %}
                    {% set x0 = L + colW * loop.index0 + colW / 2 - 27 %}
                    {% for key, cls in {devis: 'b-devis', rdv: 'b-rdv', messages: 'b-msg'} %}
                        {% set h = (H - B - 10) * attribute(m, key) / top %}
                        <rect class="{{ cls }}" x="{{ x0 + loop.index0 * 19 }}" y="{{ H - B - h }}" width="15" height="{{ max(h, 0) }}" rx="4"><title>{{ m.label }} : {{ attribute(m, key) }}</title></rect>
                    {% endfor %}
                {% endfor %}
                <g class="x">
                    {% for m in months %}<text x="{{ L + colW * loop.index0 + colW / 2 }}" y="{{ H - 6 }}" text-anchor="middle">{{ m.label }}</text>{% endfor %}
                </g>
            </svg>
        </section>

        <section class="ds-card">
            <div class="ds-card__head"><div><h2>Rendez-vous</h2><p>Répartition par statut</p></div><a class="link-more" href="{{ path('app_admin_appointments') }}">Tout voir →</a></div>
            {% set tot = max(total_appointments, 1) %}
            {% set a = pending_appointments / tot * 100 %}
            {% set b = a + confirmed_appointments / tot * 100 %}
            {% set c = b + proposed_appointments / tot * 100 %}
            {% set d = c + refused_appointments / tot * 100 %}
            <div class="donut" style="background: {{ total_appointments ? 'conic-gradient(var(--gold) 0 ' ~ a ~ '%, var(--mint) 0 ' ~ b ~ '%, var(--blue) 0 ' ~ c ~ '%, var(--red) 0 ' ~ d ~ '%, var(--panel-2) 0)' : 'var(--panel-2)' }}">
                <div><span><b>{{ total_appointments }}</b><small>au total</small></span></div>
            </div>
            <ul class="status-list">
                <li><span><i class="ds-badge ds-badge--wip">En attente</i></span><b>{{ pending_appointments }}</b></li>
                <li><span><i class="ds-badge ds-badge--ok">Confirmés</i></span><b>{{ confirmed_appointments }}</b></li>
                <li><span><i class="ds-badge ds-badge--new">Autre date proposée</i></span><b>{{ proposed_appointments }}</b></li>
                <li><span><i class="ds-badge ds-badge--ko">Refusés</i></span><b>{{ refused_appointments }}</b></li>
            </ul>
        </section>
    </div>

    {# ---------- Swiss map ---------- #}
    <div class="row-map">
        <section class="ds-card">
            <div class="ds-card__head">
                <div><h2>Clients par canton</h2><p>D'après le code postal des demandes de devis et des réservations</p></div>
            </div>
            {% include 'admin/_swiss_map.html.twig' %}
            <div class="map-scale">Aucun <span></span> Le plus de clients</div>
        </section>

        <section class="ds-card">
            <div class="ds-card__head"><div><h2>Top cantons</h2><p>{{ cantons|length }} canton{{ cantons|length > 1 ? 's' }} avec des clients</p></div></div>
            {% if cantons is empty %}
                <p class="ds-empty">Les cantons apparaîtront dès les premières demandes de devis.</p>
            {% else %}
                {% set best = max(cantons) %}
                <ul class="top-cantons">
                    {% for code, n in cantons|slice(0, 7, true) %}
                        <li>
                            <code>{{ code }}</code>
                            <div>{{ canton_names[code]|default(code) }}<div class="bar"><i style="width: {{ (n / best * 100)|round }}%"></i></div></div>
                            <b>{{ n }}</b>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>

    {# ---------- Latest quotes + messages ---------- #}
    <div class="row-2">
        <section class="ds-card">
            <div class="ds-card__head"><div><h2>Dernières demandes de devis</h2><p>Les 6 plus récentes</p></div></div>
            {% if recent_devis is empty %}
                <p class="ds-empty">Aucune demande de devis pour l'instant.</p>
            {% else %}
                <div class="table-wrap">
                    <table class="ds-table">
                        <thead><tr><th>Client</th><th>Lieu</th><th>Installation</th><th>Statut</th><th>Date</th></tr></thead>
                        <tbody>
                        {% for d in recent_devis %}
                            {% set cl = d.client %}
                            <tr>
                                <td>{{ cl ? (cl.prenom ~ ' ' ~ cl.nom)|trim : '—' }}<small>{{ cl ? cl.email }}</small></td>
                                <td>{{ cl ? cl.ville : '—' }}<small>{{ cl ? cl.codePostal }}</small></td>
                                <td>{{ d.typeInstallation|default('—')|capitalize }}<small>{{ d.surface ? d.surface ~ ' m²' : (d.nombrePanneaux ? d.nombrePanneaux ~ ' panneaux') }}{{ d.toitType ? ' · ' ~ d.toitTypeLabel|lower }}{{ d.prixEstime ? ' · CHF ' ~ d.prixEstime|number_format(0, '.', "'") }}</small></td>
                                <td>
                                    {% set st = {nouveau: ['Nouveau', 'new'], en_cours: ['En cours', 'wip'], accepte: ['Accepté', 'ok'], refuse: ['Refusé', 'ko']}[d.statut]|default([d.statut, 'new']) %}
                                    <span class="ds-badge ds-badge--{{ st[1] }}">{{ st[0] }}</span>
                                </td>
                                <td>{{ d.dateCreation ? d.dateCreation|date('d/m/Y') : '—' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        <section class="ds-card">
            <div class="ds-card__head"><div><h2>Derniers messages</h2><p>Formulaire de contact</p></div><a class="link-more" href="{{ path('app_admin_messages') }}">Tout voir →</a></div>
            {% if recent_messages is empty %}
                <p class="ds-empty">Aucun message pour l'instant.</p>
            {% else %}
                <ul class="msgs">
                    {% for m in recent_messages %}
                        <li>
                            <span class="ini">{{ m.nom|first|upper }}</span>
                            <div><b>{{ m.nom }}</b><time>{{ m.createdAt|date('d/m') }}</time><p>{{ m.message }}</p></div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endblock %}
