{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Sirius-Solar{% endblock %}

{% block body %}

<script>
// Hide navbar in admin - execute immediately and aggressively
(function() {
    function hideNavbar() {
        const navbar = document.querySelector('.navbar');
        if (navbar) {
            navbar.style.cssText = 'display: none !important; visibility: hidden !important; height: 0 !important; margin: 0 !important; padding: 0 !important; overflow: hidden !important;';
        }
    }

    // Try immediately
    hideNavbar();

    // Try on DOM ready
    document.addEventListener('DOMContentLoaded', hideNavbar);

    // Try after load
    window.addEventListener('load', hideNavbar);

    // Keep trying until hidden
    let attempts = 0;
    const interval = setInterval(() => {
        hideNavbar();
        attempts++;
        if (attempts > 20) clearInterval(interval);
    }, 100);
})();
</script>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        overflow-y: auto;
    }

    /* Hide navbar with extreme specificity */
    html body .navbar {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        width: 0 !important;
        position: absolute !important;
        top: -9999px !important;
        left: -9999px !important;
    }

    /* Also target by direct selector */
    .navbar {
        display: none !important;
    }

    .admin-container {
        display: block;
        position: relative;
        min-height: 100vh;
    }

    /* Sidebar */
    .admin-sidebar {
        background: rgba(20, 20, 30, 0.9);
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        padding: 30px 20px;
        position: fixed;
        left: 0;
        top: 0;
        width: 280px;
        height: 100vh;
        overflow-y: auto;
    }

    .sidebar-logo {
        font-size: 24px;
        font-weight: 700;
        color: #ffd700;
        margin-bottom: 40px;
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: 1px;
    }

    .sidebar-menu {
        list-style: none;
    }

    .sidebar-menu li {
        margin-bottom: 15px;
    }

    .sidebar-menu a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 14px;
        font-weight: 500;
    }

    .sidebar-menu a:hover,
    .sidebar-menu a.active {
        background: rgba(255, 215, 0, 0.15);
        color: #ffd700;
        border-left: 3px solid #ffd700;
        padding-left: 13px;
    }

    /* Main Content */
    .admin-main {
        margin-left: 280px;
        padding: 40px;
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .admin-title {
        color: white;
    }

    .admin-title h1 {
        font-size: 32px;
        margin-bottom: 10px;
    }

    .admin-title p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 14px;
    }

    .admin-user {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .admin-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ffd700, #ffed4e);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
        color: #0A3D35;
    }

    .admin-user-info {
        color: white;
    }

    .admin-user-info p {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
    }

    /* Dashboard Content */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }

    .dashboard-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 30px;
        transition: all 0.3s ease;
        color: white;
    }

    .dashboard-card:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 215, 0, 0.5);
        transform: translateY(-5px);
    }

    .card-icon {
        font-size: 32px;
        margin-bottom: 15px;
    }

    .card-title {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-value {
        font-size: 32px;
        font-weight: 700;
        color: #ffd700;
    }

    .card-description {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 10px;
    }

    /* Recent Activity */
    .activity-section {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 30px;
        color: white;
    }

    .activity-section h2 {
        font-size: 20px;
        margin-bottom: 20px;
        color: white;
    }

    .activity-list {
        list-style: none;
    }

    .activity-item {
        padding: 15px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        font-size: 20px;
    }

    .activity-text p {
        font-size: 14px;
        color: white;
        margin-bottom: 5px;
    }

    .activity-time {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
    }

    /* Buttons */
    .btn-logout {
        background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.3s ease;
    }

    .btn-logout:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 107, 0.3);
    }

    /* Admin Circular Nav - Quick Access */
    .circular-nav-admin {
        position: fixed;
        bottom: 40px;
        right: 40px;
        z-index: 999;
        width: 280px;
        height: 280px;
    }

    .circular-nav-admin .circular-nav-center {
        background: linear-gradient(135deg, #ffd700, #ffed4e) !important;
        border-color: #ffd700 !important;
        box-shadow: 0 0 50px rgba(255, 215, 0, 0.6), 0 0 80px rgba(255, 215, 0, 0.3) !important;
    }

    .circular-nav-admin .circular-nav-center:hover {
        box-shadow: 0 0 80px rgba(255, 215, 0, 0.8), 0 0 120px rgba(255, 215, 0, 0.5) !important;
        transform: translate(-50%, -50%) scale(1.15) !important;
    }

    .circular-nav-admin .center-text {
        color: #0A3D35 !important;
        font-weight: 700 !important;
    }

    .circular-nav-admin .nav-link {
        background: linear-gradient(135deg, #ffd700, #ffed4e) !important;
        color: #0A3D35 !important;
        border-color: #ffd700 !important;
        font-weight: 700 !important;
    }

    .circular-nav-admin .nav-link:hover {
        background: linear-gradient(135deg, #ffed4e, #ffd700) !important;
        color: #0A3D35 !important;
        box-shadow: 0 10px 40px rgba(255, 215, 0, 0.6) !important;
    }

    .circular-nav-admin .nav-icon {
        font-size: 24px !important;
    }

    .circular-nav-admin .nav-label {
        color: #0A3D35 !important;
        font-weight: 700 !important;
        font-size: 11px !important;
    }

    /* Hide public nav elements in admin */
    .navbar {
        display: none !important;
    }

    /* Hide public circular nav in admin */
    .circular-nav-container:not(.circular-nav-admin) {
        display: none !important;
    }

    /* Mobile */
    @media (max-width: 768px) {
        .admin-sidebar {
            position: static;
            width: 100%;
            border-right: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            height: auto;
            margin-bottom: 20px;
        }

        .admin-main {
            margin-left: 0;
            padding: 20px;
            min-height: auto;
        }

        .admin-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .admin-title h1 {
            font-size: 24px;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Admin Circular Nav -->
<div class="circular-nav-container circular-nav-admin">
    <div class="circular-nav-center">
        <div class="center-text">⚙️<br>Admin</div>
    </div>
    <div class="circular-nav-wheel">
        <div class="nav-item" style="--angle: 0deg;">
            <a href="{{ path('app_admin_dashboard') }}" class="nav-link" data-tooltip="Dashboard">
                <span class="nav-icon">📊</span>
                <span class="nav-label">Dashboard</span>
            </a>
        </div>
        <div class="nav-item" style="--angle: 60deg;">
            <a href="{{ path('app_devis') }}" class="nav-link" data-tooltip="Devis">
                <span class="nav-icon">📋</span>
                <span class="nav-label">Devis</span>
            </a>
        </div>
        <div class="nav-item" style="--angle: 120deg;">
            <a href="{{ path('app_admin_messages') }}" class="nav-link" data-tooltip="Messages">
                <span class="nav-icon">💬</span>
                <span class="nav-label">Messages</span>
            </a>
        </div>
        <div class="nav-item" style="--angle: 180deg;">
            <a href="{{ path('app_admin_calendar') }}" class="nav-link" data-tooltip="Calendrier">
                <span class="nav-icon">📅</span>
                <span class="nav-label">Calendrier</span>
            </a>
        </div>
        <div class="nav-item" style="--angle: 240deg;">
            <a href="{{ path('app_blog') }}" class="nav-link" data-tooltip="Blog">
                <span class="nav-icon">🖼️</span>
                <span class="nav-label">Blog</span>
            </a>
        </div>
        <div class="nav-item" style="--angle: 300deg;">
            <a href="{{ path('app_home') }}" class="nav-link" data-tooltip="Accueil">
                <span class="nav-icon">🏠</span>
                <span class="nav-label">Accueil</span>
            </a>
        </div>
    </div>
</div>

<div class="admin-container">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-logo">SIRIUS</div>
        <ul class="sidebar-menu">
            <li><a href="{{ path('app_admin_dashboard') }}" class="active">📊 Dashboard</a></li>
            <li><a href="{{ path('app_admin_calendar') }}">📅 Rendez-vous</a></li>
            <li><a href="{{ path('app_admin_messages') }}">📬 Messages</a></li>
            <li><a href="{{ path('app_devis') }}" style="background: rgba(255, 215, 0, 0.2); border-left: 3px solid #ffd700; color: #ffd700;">➕ Demandes de Devis</a></li>
            <li><a href="{{ path('app_admin_blog_create') }}">📝 Ajouter Réalisation</a></li>
            <li><a href="{{ path('app_blog') }}">🖼️ Voir Blog</a></li>
            <li><a href="{{ path('app_home') }}">🏠 Accueil</a></li>
            <li style="margin-top: 30px; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 20px;">
                <a href="{{ path('app_logout') }}" style="color: #ff6b6b;">🚪 Déconnexion</a>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
        <div class="admin-header">
            <div class="admin-title">
                <h1>👋 Bienvenue Admin!</h1>
                <p>Gérez votre site Sirius-Solar</p>
            </div>
            <div class="admin-user">
                <div class="admin-avatar">AH</div>
                <div class="admin-user-info">
                    <p>Admin Haroun</p>
                    <p>admin@sirius-solar.ch</p>
                </div>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="dashboard-grid">
            <a href="{{ path('app_admin_calendar') }}" class="dashboard-card" style="text-decoration: none; cursor: pointer;">
                <div class="card-icon">📅</div>
                <div class="card-title">Rendez-vous Total</div>
                <div class="card-value" style="color: #2196f3;">{{ total_appointments ?? 0 }}</div>
                <div class="card-description">Toutes les demandes</div>
            </a>

            <a href="{{ path('app_admin_calendar') }}" class="dashboard-card" style="text-decoration: none; cursor: pointer;">
                <div class="card-icon">⏳</div>
                <div class="card-title">En Attente</div>
                <div class="card-value" style="color: #ff9800;">{{ pending_appointments ?? 0 }}</div>
                <div class="card-description">À valider</div>
            </a>

            <a href="{{ path('app_admin_calendar') }}" class="dashboard-card" style="text-decoration: none; cursor: pointer;">
                <div class="card-icon">✅</div>
                <div class="card-title">Confirmés</div>
                <div class="card-value" style="color: #4caf50;">{{ confirmed_appointments ?? 0 }}</div>
                <div class="card-description">Approuvés</div>
            </a>

            <a href="{{ path('app_admin_calendar') }}" class="dashboard-card" style="text-decoration: none; cursor: pointer;">
                <div class="card-icon">ℹ️</div>
                <div class="card-title">Proposés</div>
                <div class="card-value" style="color: #2196f3;">{{ proposed_appointments ?? 0 }}</div>
                <div class="card-description">Dates alternatives</div>
            </a>

            <a href="{{ path('app_admin_calendar') }}" class="dashboard-card" style="text-decoration: none; cursor: pointer;">
                <div class="card-icon">❌</div>
                <div class="card-title">Refusés</div>
                <div class="card-value" style="color: #f44336;">{{ refused_appointments ?? 0 }}</div>
                <div class="card-description">Rejettés</div>
            </a>

            <a href="{{ path('app_admin_messages') }}" class="dashboard-card" style="text-decoration: none; cursor: pointer;">
                <div class="card-icon">📬</div>
                <div class="card-title">Messages</div>
                <div class="card-value" style="color: #ffd700;">{{ total_messages ?? 0 }}</div>
                <div class="card-description">Demandes clients</div>
            </a>
        </div>

        <!-- Recent Activity -->
        <div class="activity-section">
            <h2>📨 Messages Récents</h2>
            <ul class="activity-list">
                {% if recent_messages|length > 0 %}
                    {% for message in recent_messages %}
                        <li class="activity-item">
                            <div class="activity-icon">📧</div>
                            <div class="activity-text">
                                <p><strong>{{ message.nom }}</strong> - {{ message.email }}</p>
                                <div class="activity-time">{{ message.createdAt|date('d/m/Y H:i') }}</div>
                                <div style="font-size: 12px; color: rgba(255,255,255,0.7); margin-top: 5px;">{{ message.message|slice(0, 60) }}{% if message.message|length > 60 %}...{% endif %}</div>
                            </div>
                        </li>
                    {% endfor %}
                {% else %}
                    <li class="activity-item">
                        <div class="activity-icon">📭</div>
                        <div class="activity-text">
                            <p>Aucun message pour le moment</p>
                            <div class="activity-time">En attente de contact client</div>
                        </div>
                    </li>
                {% endif %}
            </ul>
            <div style="margin-top: 15px; text-align: center;">
                <a href="{{ path('app_admin_messages') }}" style="color: #ffd700; text-decoration: none; font-size: 13px;">→ Voir tous les messages</a>
            </div>
        </div>
    </main>
</div>

{% endblock %}
