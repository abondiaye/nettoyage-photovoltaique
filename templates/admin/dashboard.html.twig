{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Sirius-Solar{% endblock %}

{% block body %}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        min-height: 100vh;
    }

    .admin-container {
        display: grid;
        grid-template-columns: 280px 1fr;
        min-height: 100vh;
    }

    /* Sidebar */
    .admin-sidebar {
        background: rgba(20, 20, 30, 0.9);
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        padding: 30px 20px;
        position: fixed;
        left: 0;
        top: 0;
        width: 280px;
        height: 100vh;
        overflow-y: auto;
    }

    .sidebar-logo {
        font-size: 24px;
        font-weight: 700;
        color: #ffd700;
        margin-bottom: 40px;
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: 1px;
    }

    .sidebar-menu {
        list-style: none;
    }

    .sidebar-menu li {
        margin-bottom: 15px;
    }

    .sidebar-menu a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 14px;
        font-weight: 500;
    }

    .sidebar-menu a:hover,
    .sidebar-menu a.active {
        background: rgba(255, 215, 0, 0.15);
        color: #ffd700;
        border-left: 3px solid #ffd700;
        padding-left: 13px;
    }

    /* Main Content */
    .admin-main {
        margin-left: 280px;
        padding: 40px;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .admin-title {
        color: white;
    }

    .admin-title h1 {
        font-size: 32px;
        margin-bottom: 10px;
    }

    .admin-title p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 14px;
    }

    .admin-user {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .admin-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ffd700, #ffed4e);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
        color: #0A3D35;
    }

    .admin-user-info {
        color: white;
    }

    .admin-user-info p {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
    }

    /* Dashboard Content */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .dashboard-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 30px;
        transition: all 0.3s ease;
        color: white;
    }

    .dashboard-card:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 215, 0, 0.5);
        transform: translateY(-5px);
    }

    .card-icon {
        font-size: 32px;
        margin-bottom: 15px;
    }

    .card-title {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-value {
        font-size: 32px;
        font-weight: 700;
        color: #ffd700;
    }

    .card-description {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 10px;
    }

    /* Recent Activity */
    .activity-section {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 30px;
        color: white;
    }

    .activity-section h2 {
        font-size: 20px;
        margin-bottom: 20px;
        color: white;
    }

    .activity-list {
        list-style: none;
    }

    .activity-item {
        padding: 15px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        font-size: 20px;
    }

    .activity-text p {
        font-size: 14px;
        color: white;
        margin-bottom: 5px;
    }

    .activity-time {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
    }

    /* Buttons */
    .btn-logout {
        background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.3s ease;
    }

    .btn-logout:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 107, 0.3);
    }

    /* Mobile */
    @media (max-width: 768px) {
        .admin-container {
            grid-template-columns: 1fr;
        }

        .admin-sidebar {
            position: static;
            width: 100%;
            border-right: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            height: auto;
            margin-bottom: 20px;
        }

        .admin-main {
            margin-left: 0;
            padding: 20px;
        }

        .admin-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .admin-title h1 {
            font-size: 24px;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-container">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-logo">SIRIUS</div>
        <ul class="sidebar-menu">
            <li><a href="{{ path('app_admin_dashboard') }}" class="active">📊 Dashboard</a></li>
            <li><a href="{{ path('app_admin_blog_create') }}">📝 Ajouter Réalisation</a></li>
            <li><a href="{{ path('app_blog') }}">🖼️ Voir Blog</a></li>
            <li><a href="{{ path('app_home') }}">🏠 Accueil</a></li>
            <li style="margin-top: 30px; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 20px;">
                <a href="{{ path('app_logout') }}" style="color: #ff6b6b;">🚪 Déconnexion</a>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
        <div class="admin-header">
            <div class="admin-title">
                <h1>👋 Bienvenue Admin!</h1>
                <p>Gérez votre site Sirius-Solar</p>
            </div>
            <div class="admin-user">
                <div class="admin-avatar">AH</div>
                <div class="admin-user-info">
                    <p>Admin Haroun</p>
                    <p>admin@sirius-solar.ch</p>
                </div>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="dashboard-grid">
            <div class="dashboard-card">
                <div class="card-icon">📱</div>
                <div class="card-title">Réalisations</div>
                <div class="card-value">{{ project_count ?? 0 }}</div>
                <div class="card-description">Projets publiés</div>
            </div>

            <div class="dashboard-card">
                <div class="card-icon">👥</div>
                <div class="card-title">Utilisateurs</div>
                <div class="card-value">{{ user_count ?? 0 }}</div>
                <div class="card-description">Comptes actifs</div>
            </div>

            <div class="dashboard-card">
                <div class="card-icon">📊</div>
                <div class="card-title">Devis</div>
                <div class="card-value">{{ quote_count ?? 0 }}</div>
                <div class="card-description">Demandes reçues</div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="activity-section">
            <h2>📈 Activité Récente</h2>
            <ul class="activity-list">
                <li class="activity-item">
                    <div class="activity-icon">✅</div>
                    <div class="activity-text">
                        <p>Dashboard admin créé</p>
                        <div class="activity-time">Aujourd'hui - Admin Haroun</div>
                    </div>
                </li>
                <li class="activity-item">
                    <div class="activity-icon">🔐</div>
                    <div class="activity-text">
                        <p>Authentification admin activée</p>
                        <div class="activity-time">Maintenant</div>
                    </div>
                </li>
                <li class="activity-item">
                    <div class="activity-icon">🎨</div>
                    <div class="activity-text">
                        <p>Design Frosted Glass appliqué</p>
                        <div class="activity-time">Maintenant - Premium Edition</div>
                    </div>
                </li>
            </ul>
        </div>
    </main>
</div>

{% endblock %}
