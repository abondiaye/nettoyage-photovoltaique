{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard — Sirius-Solar{% endblock %}

{% block body %}
<style>
    /* ===== ADMIN LAYOUT ===== */
    .admin-container {
        display: grid;
        grid-template-columns: 250px 1fr;
        min-height: calc(100vh - 80px);
        background: #f5f7fa;
    }

    /* Sidebar */
    .admin-sidebar {
        background: linear-gradient(180deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        padding: 30px 20px;
        color: white;
        overflow-y: auto;
    }

    .admin-sidebar h3 {
        font-size: 14px;
        text-transform: uppercase;
        margin-top: 20px;
        margin-bottom: 15px;
        opacity: 0.7;
        letter-spacing: 0.5px;
    }

    .admin-sidebar a {
        display: block;
        padding: 12px 15px;
        margin-bottom: 8px;
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .admin-sidebar a:hover,
    .admin-sidebar a.active {
        background: rgba(212, 168, 66, 0.2);
        color: var(--dore);
        padding-left: 20px;
    }

    /* Main Content */
    .admin-main {
        padding: 40px;
        overflow-y: auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 2px solid rgba(212, 168, 66, 0.2);
    }

    .admin-header h1 {
        font-size: 32px;
        color: var(--vert-fonce);
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
    }

    .admin-user-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #121212;
    }

    /* ===== STATS ===== */
    .admin-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        border-left: 4px solid var(--dore);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);

        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

    .stat-card:nth-child(1) { animation-delay: 0.1s; }
    .stat-card:nth-child(2) { animation-delay: 0.2s; }
    .stat-card:nth-child(3) { animation-delay: 0.3s; }
    .stat-card:nth-child(4) { animation-delay: 0.4s; }

    .stat-label {
        font-size: 13px;
        text-transform: uppercase;
        color: #888;
        margin-bottom: 8px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: var(--vert-fonce);
    }

    /* ===== DEVIS TABLE ===== */
    .devis-section h2 {
        font-size: 24px;
        color: var(--vert-fonce);
        margin-bottom: 20px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .devis-table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        overflow-x: auto;
    }

    .devis-table {
        width: 100%;
        border-collapse: collapse;
    }

    .devis-table thead {
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        color: white;
    }

    .devis-table th {
        padding: 16px;
        text-align: left;
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .devis-table td {
        padding: 16px;
        border-top: 1px solid #e0e0e0;
    }

    .devis-table tbody tr:hover {
        background: #f9f9f9;
    }

    .devis-client {
        font-weight: 600;
        color: var(--vert-fonce);
    }

    .devis-email {
        font-size: 13px;
        color: #888;
    }

    .devis-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-pending {
        background: rgba(255, 193, 7, 0.2);
        color: #ff9800;
    }

    .status-confirmed {
        background: rgba(76, 175, 80, 0.2);
        color: #4caf50;
    }

    .status-rejected {
        background: rgba(244, 67, 54, 0.2);
        color: #f44336;
    }

    .devis-actions {
        display: flex;
        gap: 8px;
    }

    .btn-action {
        padding: 8px 12px;
        border: 1px solid #ddd;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-action:hover {
        background: var(--dore);
        color: white;
        border-color: var(--dore);
    }

    .btn-action.delete:hover {
        background: #f44336;
        border-color: #f44336;
    }

    .btn-action.confirm:hover {
        background: #4caf50;
        border-color: #4caf50;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

    .empty-state-icon {
        font-size: 48px;
        margin-bottom: 20px;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .admin-container {
            grid-template-columns: 1fr;
        }

        .admin-sidebar {
            display: none;
        }

        .admin-main {
            padding: 20px;
        }

        .admin-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .devis-table {
            font-size: 12px;
        }

        .devis-table th,
        .devis-table td {
            padding: 10px;
        }

        .devis-actions {
            flex-direction: column;
        }

        .btn-action {
            width: 100%;
        }
    }
</style>

<div class="admin-container">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div style="margin-bottom: 30px;">
            <div style="font-size: 20px; font-weight: 700; margin-bottom: 5px;">☀️ ADMIN</div>
            <div style="font-size: 12px; opacity: 0.7;">Sirius-Solar</div>
        </div>

        <h3>Navigation</h3>
        <a href="#" class="active">📊 Dashboard</a>
        <a href="#devis">📋 Demandes de Devis</a>
        <a href="#calendar">📅 Calendrier</a>

        <h3>Gestion</h3>
        <a href="#">👥 Clients</a>
        <a href="#">📁 Fichiers</a>
        <a href="#">⚙️ Paramètres</a>

        <h3>Compte</h3>
        <a href="{{ path('app_logout') }}">🚪 Déconnexion</a>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
        <!-- Header -->
        <div class="admin-header">
            <h1>Dashboard Admin</h1>
            <div class="admin-user-info">
                <div style="text-align: right; font-size: 13px; color: #888;">
                    <div>{{ app.user.email }}</div>
                    <div>Admin</div>
                </div>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <!-- Stats -->
        <div class="admin-stats">
            <div class="stat-card">
                <div class="stat-label">📋 Demandes Total</div>
                <div class="stat-value">{{ pendingReservations|length + confirmedReservations|length }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">⏳ En Attente</div>
                <div class="stat-value" style="color: #ff9800;">{{ pendingReservations|length }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">✅ Confirmées</div>
                <div class="stat-value" style="color: #4caf50;">{{ confirmedReservations|length }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">🔔 Notifications</div>
                <div class="stat-value" style="color: var(--dore);">{{ unreadCount }}</div>
            </div>
        </div>

        <!-- Devis Section -->
        <div class="devis-section" id="devis">
            <h2>Demandes de Devis Récentes</h2>

            {% if pendingReservations|length > 0 or confirmedReservations|length > 0 %}
                <div class="devis-table-container">
                    <table class="devis-table">
                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Email</th>
                                <th>Téléphone</th>
                                <th>Adresse</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in pendingReservations %}
                                <tr>
                                    <td class="devis-client">{{ reservation.client.prenom }} {{ reservation.client.nom }}</td>
                                    <td class="devis-email">{{ reservation.client.email }}</td>
                                    <td>{{ reservation.client.telephone }}</td>
                                    <td>{{ reservation.client.adresse }}, {{ reservation.client.codePostal }} {{ reservation.client.ville }}</td>
                                    <td>
                                        <span class="devis-status status-pending">En Attente</span>
                                    </td>
                                    <td class="devis-actions">
                                        <a href="{{ path('admin_reservation_details', {id: reservation.id}) }}" class="btn-action">Voir</a>
                                        <form method="POST" action="#" style="display: inline;">
                                            <button type="submit" class="btn-action confirm">Confirmer</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}

                            {% for reservation in confirmedReservations %}
                                <tr>
                                    <td class="devis-client">{{ reservation.client.prenom }} {{ reservation.client.nom }}</td>
                                    <td class="devis-email">{{ reservation.client.email }}</td>
                                    <td>{{ reservation.client.telephone }}</td>
                                    <td>{{ reservation.client.adresse }}, {{ reservation.client.codePostal }} {{ reservation.client.ville }}</td>
                                    <td>
                                        <span class="devis-status status-confirmed">Confirmée</span>
                                    </td>
                                    <td class="devis-actions">
                                        <a href="{{ path('admin_reservation_details', {id: reservation.id}) }}" class="btn-action">Voir</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <p>Aucune demande de devis pour le moment</p>
                </div>
            {% endif %}
        </div>
    </main>
</div>

{% endblock %}
