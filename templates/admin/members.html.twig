{% extends 'admin/_shell.html.twig' %}

{% block title %}Membres - Admin Sirius-Solar{% endblock %}
{% block page_title %}Membres{% endblock %}
{% block page_subtitle %}Les comptes créés sur le site{% endblock %}

{% block admin_styles %}
    .table-wrap { overflow-x: auto; margin: 0 -22px -22px; }
    .ds-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .ds-table th { text-align: left; padding: 12px 22px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); background: var(--panel-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); white-space: nowrap; }
    .ds-table td { padding: 14px 22px; border-bottom: 1px solid var(--line); color: var(--text); vertical-align: middle; }
    .ds-table tr:last-child td { border-bottom: 0; }
    .ds-table small { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
    .who { display: flex; align-items: center; gap: 12px; }
    .who i { flex: none; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-weight: 700; font-size: 13px; background: rgba(45, 255, 79, 0.12); color: var(--mint); }
    .ds-table a { color: var(--text); text-decoration: none; }
    .ds-table a:hover { color: var(--mint); }
{% endblock %}

{% block content %}
    <section class="ds-card">
        <div class="ds-card__head"><div><h2>{{ members|length }} compte{{ members|length > 1 ? 's' }}</h2><p>Du plus récent au plus ancien</p></div></div>
        {% if members is empty %}
            <p class="ds-empty">Aucun compte pour l'instant.</p>
        {% else %}
            <div class="table-wrap">
                <table class="ds-table">
                    <thead><tr><th>Nom</th><th>Rôle</th><th>Demandes de devis</th><th>Inscrit le</th><th>Dernière connexion</th><th>Statut</th></tr></thead>
                    <tbody>
                    {% for m in members %}
                        {% set admin = 'ROLE_ADMIN' in m.roles %}
                        <tr>
                            <td><div class="who"><i>{{ (m.prenom|default('?'))|first|upper }}{{ (m.nom|default(''))|first|upper }}</i><div>{{ (m.prenom|default('') ~ ' ' ~ m.nom|default(''))|trim|default('—') }}<small><a href="mailto:{{ m.email }}">{{ m.email }}</a></small></div></div></td>
                            <td><span class="ds-badge ds-badge--{{ admin ? 'wip' : 'new' }}">{{ admin ? 'Administrateur' : 'Client' }}</span></td>
                            <td>{{ m.devis|length }}</td>
                            <td>{{ m.createdAt ? m.createdAt|date('d/m/Y') : '—' }}</td>
                            <td>{{ m.lastLogin ? m.lastLogin|date('d/m/Y H:i') : '—' }}</td>
                            <td><span class="ds-badge ds-badge--{{ m.active ? 'ok' : 'ko' }}">{{ m.active ? 'Actif' : 'Désactivé' }}</span></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
