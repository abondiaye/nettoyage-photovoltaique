{% extends 'base.html.twig' %}

{% block title %}Admin - Members - Solar Cleaning{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-bleu-nuit mb-8">Manage Members</h1>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full">
            <thead class="bg-bleu-nuit text-white">
                <tr>
                    <th class="px-6 py-3 text-left">Name</th>
                    <th class="px-6 py-3 text-left">Email</th>
                    <th class="px-6 py-3 text-left">Points</th>
                    <th class="px-6 py-3 text-left">Appointments</th>
                    <th class="px-6 py-3 text-left">Joined</th>
                </tr>
            </thead>
            <tbody>
                {% for member in members %}
                    <tr class="border-b hover:bg-gray-50">
                        <td class="px-6 py-3 font-semibold">{{ member.firstName }} {{ member.lastName }}</td>
                        <td class="px-6 py-3">{{ member.email }}</td>
                        <td class="px-6 py-3">
                            <span class="bg-jaune-solaire text-bleu-nuit px-3 py-1 rounded font-bold">
                                {{ member.points }}
                            </span>
                        </td>
                        <td class="px-6 py-3">{{ member.appointments | length }}</td>
                        <td class="px-6 py-3 text-sm text-gray-500">{{ member.createdAt.format('d/m/Y') if member.createdAt else 'N/A' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-4 text-center text-gray-500">No members found</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
