{% extends 'admin/_shell.html.twig' %}

{% block title %}Messages - Admin Sirius-Solar{% endblock %}
{% block page_title %}Messages{% endblock %}
{% block page_subtitle %}Reçus par le formulaire de contact{% endblock %}

{% block admin_styles %}
    .msg-list { display: grid; gap: 16px; }
    .msg { display: grid; grid-template-columns: 44px 1fr; gap: 14px; }
    .msg__ini { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; background: rgba(60, 214, 255, 0.14); color: var(--blue); }
    .msg__head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .msg__head h3 { margin: 0; font: 700 16px/1.3 'Space Grotesk', system-ui, sans-serif; color: var(--text); }
    .msg__head a { font-size: 13px; color: var(--muted); text-decoration: none; }
    .msg__head a:hover { color: var(--mint); }
    .msg__head time { font-size: 13px; color: var(--muted); white-space: nowrap; }
    .msg p { margin: 10px 0 0; color: var(--text); font-size: 14px; line-height: 1.6; white-space: pre-line; }
    .msg__foot { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 14px; }
    .ds-btn--sm { padding: 8px 12px; font-size: 13px; }
{% endblock %}

{% block content %}
    {% if messages is empty %}
        <div class="ds-card ds-empty">Aucun message pour le moment.</div>
    {% else %}
        <div class="msg-list">
            {% for m in messages %}
                <article class="ds-card msg">
                    <span class="msg__ini">{{ m.nom|first|upper }}</span>
                    <div>
                        <div class="msg__head">
                            <div><h3>{{ m.nom }}</h3><a href="mailto:{{ m.email }}">{{ m.email }}</a></div>
                            <time>{{ m.createdAt|date('d/m/Y H:i') }}</time>
                        </div>
                        <p>{{ m.message }}</p>
                        <div class="msg__foot">
                            <a class="ds-btn ds-btn--primary ds-btn--sm" href="mailto:{{ m.email }}?subject={{ 'Votre message à Sirius-Solar'|url_encode }}">Répondre par e-mail</a>
                            {% if m.datePreferee %}<span class="ds-badge ds-badge--wip">Date souhaitée : {{ m.datePreferee|date('d/m/Y') }}</span>{% endif %}
                            <a class="ds-btn ds-btn--ghost ds-btn--sm" href="{{ path('app_admin_appointment_new', {date: (m.datePreferee ?? 'tomorrow')|date('Y-m-d')}) }}">Créer un rendez-vous</a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
