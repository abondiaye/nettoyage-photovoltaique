{% extends 'admin/layout.html.twig' %}

{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Vue d'ensemble de votre activité et statistiques en temps réel{% endblock %}

{% block content %}

<style>
    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: linear-gradient(135deg, rgba(45, 107, 85, 0.3) 0%, rgba(45, 107, 85, 0.1) 100%);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(45, 107, 85, 0.4);
        border-radius: 14px;
        padding: 28px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, #ffd700, transparent);
    }

    .stat-card:hover {
        background: linear-gradient(135deg, rgba(45, 107, 85, 0.5) 0%, rgba(45, 107, 85, 0.2) 100%);
        transform: translateY(-8px);
        border-color: rgba(255, 215, 0, 0.6);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .stat-icon {
        font-size: 36px;
        margin-bottom: 12px;
        display: inline-block;
    }

    .stat-label {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.6);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .stat-value {
        font-size: 36px;
        font-weight: 700;
        color: #ffd700;
        margin-bottom: 8px;
    }

    .stat-change {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.65);
        font-weight: 500;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 25px;
    }

    .panel-card {
        background: linear-gradient(135deg, rgba(45, 107, 85, 0.2) 0%, rgba(45, 107, 85, 0.05) 100%);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(45, 107, 85, 0.3);
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: all 0.3s;
    }

    .panel-card:hover {
        border-color: rgba(255, 215, 0, 0.3);
        background: linear-gradient(135deg, rgba(45, 107, 85, 0.3) 0%, rgba(45, 107, 85, 0.1) 100%);
    }

    .panel-card h3 {
        font-size: 16px;
        margin-bottom: 25px;
        color: #ffd700;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .quick-link {
        display: block;
        padding: 14px 16px;
        background: rgba(255, 215, 0, 0.05);
        border: 1px solid rgba(255, 215, 0, 0.1);
        border-radius: 10px;
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        margin-bottom: 12px;
        transition: all 0.25s;
        border-left: 3px solid transparent;
        font-weight: 500;
        font-size: 13px;
    }

    .quick-link:hover {
        background: rgba(255, 215, 0, 0.15);
        color: #ffd700;
        border-left-color: #ffd700;
        transform: translateX(4px);
    }

    .activity-item {
        padding: 15px 0;
        border-bottom: 1px solid rgba(45, 107, 85, 0.3);
        font-size: 13px;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-text {
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
        margin-bottom: 4px;
    }

    .activity-time {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.5);
    }
</style>

<div class="dashboard-stats">
    <div class="stat-card">
        <div class="stat-icon">📅</div>
        <div class="stat-label">Rendez-vous aujourd'hui</div>
        <div class="stat-value">8</div>
        <div class="stat-change">+2 depuis hier</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">⏳</div>
        <div class="stat-label">En attente de validation</div>
        <div class="stat-value">15</div>
        <div class="stat-change">3 prioritaires</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">✅</div>
        <div class="stat-label">Confirmées ce mois</div>
        <div class="stat-value">42</div>
        <div class="stat-change">+8 cette semaine</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">👥</div>
        <div class="stat-label">Clients actifs</div>
        <div class="stat-value">127</div>
        <div class="stat-change">+12 nouveaux</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">👷</div>
        <div class="stat-label">Techniciens actifs</div>
        <div class="stat-value">8</div>
        <div class="stat-change">Tous disponibles</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">💳</div>
        <div class="stat-label">Revenus ce mois</div>
        <div class="stat-value">12,450€</div>
        <div class="stat-change">+25% vs mois dernier</div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="panel-card">
        <h3>📋 Actions rapides</h3>
        <a href="{{ path('app_admin_panel_reservations', {status: 'pending'}) }}" class="quick-link">
            ➕ Nouvelle réservation
        </a>
        <a href="{{ path('app_admin_panel_clients') }}" class="quick-link">
            👥 Ajouter un client
        </a>
        <a href="{{ path('app_admin_panel_technicians') }}" class="quick-link">
            👷 Ajouter un technicien
        </a>
        <a href="{{ path('app_admin_panel_interventions') }}" class="quick-link">
            📸 Ajouter intervention
        </a>
    </div>

    <div class="panel-card">
        <h3>🔔 Activité récente</h3>
        <div class="activity-item">
            <div class="activity-text">✅ Réservation confirmée #2847</div>
            <div class="activity-time">Il y a 2 heures</div>
        </div>
        <div class="activity-item">
            <div class="activity-text">📸 Photos intervention #2843 ajoutées</div>
            <div class="activity-time">Il y a 5 heures</div>
        </div>
        <div class="activity-item">
            <div class="activity-text">💳 Paiement reçu 850€</div>
            <div class="activity-time">Il y a 8 heures</div>
        </div>
        <div class="activity-item">
            <div class="activity-text">⭐ Nouvel avis 5/5 - Michel D.</div>
            <div class="activity-time">Il y a 1 jour</div>
        </div>
    </div>

    <div class="panel-card">
        <h3>📅 Prochains RV</h3>
        <div class="activity-item">
            <div>Jean Dupont - Aujourd'hui 14h00</div>
            <div class="activity-time">Nettoyage complet</div>
        </div>
        <div class="activity-item">
            <div>Marie Blanc - Demain 10h00</div>
            <div class="activity-time">Inspection + nettoyage</div>
        </div>
        <div class="activity-item">
            <div>Carlos Rodriguez - Demain 15h30</div>
            <div class="activity-time">Entretien mensuel</div>
        </div>
    </div>
</div>

{% endblock %}
