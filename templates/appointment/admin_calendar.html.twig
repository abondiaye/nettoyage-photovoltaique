{% extends 'base.html.twig' %}

{% block title %}Calendrier Rendez-vous Admin - Sirius-Solar{% endblock %}

{% block body %}

<style>
    .admin-calendar-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        padding: 40px 20px;
        margin-top: 0;
        display: flex;
        flex-direction: column;
    }

    .calendar-header {
        width: 100%;
        margin-bottom: 40px;
    }

    .calendar-header h1 {
        color: white;
        font-size: 32px;
        margin-bottom: 10px;
    }

    .status-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .status-tab {
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        transition: all 0.3s;
        font-weight: 600;
    }

    .status-tab:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .calendar-grid {
        width: 100%;
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    }

    .appointment-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 25px;
        color: white;
    }

    .appointment-card.confirmed {
        border-left: 4px solid #4caf50;
    }

    .appointment-card.pending {
        border-left: 4px solid #ff9800;
    }

    .appointment-card.refused {
        border-left: 4px solid #f44336;
    }

    .appointment-card.proposed {
        border-left: 4px solid #2196f3;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .card-title {
        flex: 1;
    }

    .card-title h3 {
        margin: 0 0 5px 0;
        color: #ffd700;
    }

    .appointment-status {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-confirmed {
        background: rgba(76, 175, 80, 0.2);
        color: #4caf50;
    }

    .status-pending {
        background: rgba(255, 152, 0, 0.2);
        color: #ff9800;
    }

    .status-refused {
        background: rgba(244, 67, 54, 0.2);
        color: #f44336;
    }

    .status-proposed {
        background: rgba(33, 150, 243, 0.2);
        color: #2196f3;
    }

    .appointment-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .detail-item {
        font-size: 13px;
    }

    .detail-item strong {
        color: rgba(255, 255, 255, 0.9);
        display: block;
        margin-bottom: 4px;
    }

    .appointment-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-accept {
        background: linear-gradient(135deg, #4caf50, #66bb6a);
        color: white;
    }

    .btn-accept:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(76, 175, 80, 0.3);
    }

    .btn-refuse {
        background: linear-gradient(135deg, #f44336, #ef5350);
        color: white;
    }

    .btn-refuse:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(244, 67, 54, 0.3);
    }

    .btn-propose {
        background: linear-gradient(135deg, #2196f3, #42a5f5);
        color: white;
    }

    .btn-propose:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(33, 150, 243, 0.3);
    }

    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .modal.active {
        display: flex;
    }

    .modal-content {
        background: rgba(30, 30, 30, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 30px;
        max-width: 500px;
        width: 90%;
        color: white;
    }

    .modal-content h2 {
        margin-top: 0;
        color: #ffd700;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
        font-size: 13px;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 10px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        color: white;
        font-family: inherit;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .close-modal {
        flex: 1;
        padding: 10px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        border-radius: 6px;
        cursor: pointer;
    }

    .submit-btn {
        flex: 1;
        padding: 10px;
        background: linear-gradient(135deg, #ffd700, #ffed4e);
        color: #0A3D35;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: rgba(255, 255, 255, 0.7);
    }

    @media (max-width: 768px) {
        .admin-calendar-container {
            padding: 20px 10px;
        }

        .appointment-details {
            grid-template-columns: 1fr;
        }

        .appointment-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            text-align: center;
        }
    }

    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    main {
        flex: 1;
    }

    .admin-calendar-container {
        display: flex;
        flex-direction: column;
    }

    .nav-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 60px;
        padding: 40px 20px 0;
    }

    .nav-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(192, 192, 192, 0.2));
        border: 2px solid rgba(192, 192, 192, 0.5);
        color: rgba(192, 192, 192, 0.9);
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .nav-btn:hover {
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.3), rgba(192, 192, 192, 0.3));
        border-color: rgba(192, 192, 192, 0.8);
        color: #ffd700;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(192, 192, 192, 0.2);
    }

    .arrow {
        font-size: 18px;
        transition: transform 0.3s ease;
    }

    .nav-btn:hover .arrow-left {
        transform: translateX(-3px);
    }

    .nav-btn:hover .arrow-right {
        transform: translateX(3px);
    }

    .admin-footer {
        background: rgba(10, 61, 53, 0.4);
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(192, 192, 192, 0.2);
        padding: 30px 40px;
        margin-top: 60px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 14px;
        text-align: center;
    }

    .admin-footer p {
        margin: 0;
        line-height: 1.6;
    }

    .admin-footer a {
        color: #ffd700;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .admin-footer a:hover {
        color: #ffed4e;
        text-decoration: underline;
    }
</style>

<div class="admin-calendar-container">
    <div class="calendar-header">
        <h1>📅 Calendrier Rendez-vous</h1>
        <p>Gérez les demandes d'intervention des clients</p>

        <div class="status-tabs">
            <div class="status-tab" onclick="filterStatus('all')">
                📊 Tous ({{ appointments|length }})
            </div>
            <div class="status-tab" onclick="filterStatus('pending')">
                ⏳ En attente ({{ appointmentsByStatus.pending|length }})
            </div>
            <div class="status-tab" onclick="filterStatus('confirmed')">
                ✅ Confirmés ({{ appointmentsByStatus.confirmed|length }})
            </div>
            <div class="status-tab" onclick="filterStatus('proposed')">
                ℹ️ Proposés ({{ appointmentsByStatus.proposed|length }})
            </div>
            <div class="status-tab" onclick="filterStatus('refused')">
                ❌ Refusés ({{ appointmentsByStatus.refused|length }})
            </div>
        </div>
    </div>

    <div class="calendar-grid">
        {% if appointments|length > 0 %}
            {% for appointment in appointments %}
                <div class="appointment-card {{ appointment.status }}" data-status="{{ appointment.status }}">
                    <div class="card-header">
                        <div class="card-title">
                            <h3>👤 {{ appointment.clientName }}</h3>
                            <p style="margin: 0; font-size: 13px; color: rgba(255,255,255,0.7);">{{ appointment.clientEmail }}</p>
                        </div>
                        <span class="appointment-status status-{{ appointment.status }}">
                            {% if appointment.status == 'confirmed' %}
                                ✅ Confirmé
                            {% elseif appointment.status == 'pending' %}
                                ⏳ En attente
                            {% elseif appointment.status == 'refused' %}
                                ❌ Refusé
                            {% else %}
                                ℹ️ Proposition
                            {% endif %}
                        </span>
                    </div>

                    <div class="appointment-details">
                        <div class="detail-item">
                            <strong>📅 Date demandée:</strong>
                            {{ appointment.requestedDate|date('d/m/Y') }}
                        </div>

                        {% if appointment.confirmedDate %}
                            <div class="detail-item">
                                <strong>📅 Date {{ appointment.status == 'proposed' ? 'proposée' : 'confirmée' }}:</strong>
                                {{ appointment.confirmedDate|date('d/m/Y') }}
                            </div>
                        {% endif %}

                        {% if appointment.clientPhone %}
                            <div class="detail-item">
                                <strong>📱 Téléphone:</strong>
                                {{ appointment.clientPhone }}
                            </div>
                        {% endif %}

                        {% if appointment.notes %}
                            <div class="detail-item">
                                <strong>💬 Notes client:</strong>
                                {{ appointment.notes|slice(0, 50) }}{% if appointment.notes|length > 50 %}...{% endif %}
                            </div>
                        {% endif %}
                    </div>

                    {% if appointment.adminNotes %}
                        <div style="background: rgba(255, 215, 0, 0.1); padding: 10px; border-radius: 6px; margin: 10px 0; font-size: 12px;">
                            <strong>📝 Remarques admin:</strong><br>
                            {{ appointment.adminNotes }}
                        </div>
                    {% endif %}

                    {% if appointment.status == 'pending' %}
                        <div class="appointment-actions">
                            <button class="btn btn-accept" onclick="openAcceptModal({{ appointment.id }})">✅ Accepter</button>
                            <button class="btn btn-propose" onclick="openProposeModal({{ appointment.id }})">ℹ️ Proposer</button>
                            <button class="btn btn-refuse" onclick="openRefuseModal({{ appointment.id }})">❌ Refuser</button>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <h2>📭 Aucun rendez-vous</h2>
                <p>Aucune demande d'intervention pour le moment.</p>
            </div>
        {% endif %}
    </div>
</div>

<!-- Accept Modal -->
<div class="modal" id="acceptModal">
    <div class="modal-content">
        <h2>✅ Confirmer le rendez-vous</h2>
        <form id="acceptForm" method="POST">
            <div class="form-group">
                <label>Date de confirmation:</label>
                <input type="date" name="confirmedDate" required>
            </div>
            <div class="form-group">
                <label>Remarques:</label>
                <textarea name="adminNotes" placeholder="Ajoutez des remarques..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="close-modal" onclick="closeModal('acceptModal')">Annuler</button>
                <button type="submit" class="submit-btn">Confirmer</button>
            </div>
        </form>
    </div>
</div>

<!-- Propose Modal -->
<div class="modal" id="proposeModal">
    <div class="modal-content">
        <h2>ℹ️ Proposer une autre date</h2>
        <form id="proposeForm" method="POST">
            <div class="form-group">
                <label>Date proposée:</label>
                <input type="date" name="proposedDate" required>
            </div>
            <div class="form-group">
                <label>Remarques:</label>
                <textarea name="adminNotes" placeholder="Expliquez pourquoi cette date..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="close-modal" onclick="closeModal('proposeModal')">Annuler</button>
                <button type="submit" class="submit-btn">Proposer</button>
            </div>
        </form>
    </div>
</div>

<!-- Refuse Modal -->
<div class="modal" id="refuseModal">
    <div class="modal-content">
        <h2>❌ Refuser le rendez-vous</h2>
        <form id="refuseForm" method="POST">
            <div class="form-group">
                <label>Raison du refus:</label>
                <textarea name="adminNotes" placeholder="Expliquez le refus..." required></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="close-modal" onclick="closeModal('refuseModal')">Annuler</button>
                <button type="submit" class="submit-btn">Refuser</button>
            </div>
        </form>
    </div>

    <!-- Navigation Buttons -->
    <div class="nav-buttons">
        <a href="{{ path('app_admin_dashboard') }}" class="nav-btn">
            <span class="arrow arrow-left">←</span>
            Dashboard
        </a>
        <a href="{{ path('app_admin_messages') }}" class="nav-btn">
            Messages
            <span class="arrow arrow-right">→</span>
        </a>
    </div>

    <!-- Footer -->
    <footer class="admin-footer">
        <p>© 2026 <strong>Sirius-Solar</strong> — Nettoyage & Entretien de Panneaux Photovoltaïques</p>
        <p>Eau osmosée • Zéro produit chimique • Jusqu'à 25% de rendement regagné</p>
        <p><a href="{{ path('app_home') }}">Retour à l'accueil</a> | <a href="{{ path('app_devis') }}">Demander un devis</a></p>
    </footer>
</div>

<script>
function openAcceptModal(appointmentId) {
    const form = document.getElementById('acceptForm');
    form.action = '/admin/appointment/' + appointmentId + '/accept';
    document.getElementById('acceptModal').classList.add('active');
}

function openProposeModal(appointmentId) {
    const form = document.getElementById('proposeForm');
    form.action = '/admin/appointment/' + appointmentId + '/propose';
    document.getElementById('proposeModal').classList.add('active');
}

function openRefuseModal(appointmentId) {
    const form = document.getElementById('refuseForm');
    form.action = '/admin/appointment/' + appointmentId + '/refuse';
    document.getElementById('refuseModal').classList.add('active');
}

function closeModal(modalId) {
    document.getElementById(modalId).classList.remove('active');
}

function filterStatus(status) {
    const cards = document.querySelectorAll('.appointment-card');
    cards.forEach(card => {
        if (status === 'all' || card.dataset.status === status) {
            card.style.display = 'block';
        } else {
            card.style.display = 'none';
        }
    });
}

// Close modals when clicking outside
window.onclick = function(event) {
    const modals = document.querySelectorAll('.modal');
    modals.forEach(modal => {
        if (event.target === modal) {
            modal.classList.remove('active');
        }
    });
}
</script>

{% endblock %}
