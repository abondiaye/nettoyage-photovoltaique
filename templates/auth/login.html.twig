{% extends 'base.html.twig' %}

{% block title %}Login - Solar Cleaning{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-bleu-nuit to-bleu-panneau flex items-center justify-center px-4">
    <div class="w-full max-w-md bg-white rounded-lg shadow-xl p-8">
        <h1 class="text-3xl font-bold text-bleu-nuit mb-8 text-center">Login</h1>

        {% if error %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                {{ error.messageKey | trans(error.messageData) }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}" novalidate>
            <div class="mb-6">
                <label for="inputEmail" class="block text-sm font-medium text-bleu-nuit mb-2">Email</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-jaune-solaire focus:border-transparent" required autofocus>
            </div>

            <div class="mb-8">
                <label for="inputPassword" class="block text-sm font-medium text-bleu-nuit mb-2">Password</label>
                <input type="password" name="password" id="inputPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-jaune-solaire focus:border-transparent" required>
            </div>

            <button type="submit" class="w-full bg-jaune-solaire text-bleu-nuit font-bold py-3 rounded-lg hover:bg-opacity-90 transition duration-300">
                Login
            </button>
        </form>

        <div class="mt-6 text-center">
            <p class="text-sm text-gray-600">
                Don't have an account?
                <a href="{{ path('app_register') }}" class="text-bleu-panneau font-semibold hover:underline">Register here</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
