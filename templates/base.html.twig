            z-index: 9999;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 6px;
            box-shadow: 0 0 14px rgba(0, 255, 157, 0.35);
        }

        .hamburger-btn span {
            display: block;
            width: 24px;
            height: 3px;
            background: #00ff9d;
            border-radius: 2px;
            transition: 0.3s;
            box-shadow: 0 0 6px rgba(0, 255, 157, 0.6);
        }

        .hamburger-btn.active span:nth-child(1) {
            transform: rotate(45deg) translateY(12px);
        }

        .hamburger-btn.active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger-btn.active span:nth-child(3) {
            transform: rotate(-45deg) translateY(-12px);
        }

        .menu-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(2, 20, 16, 0.95);
            z-index: 9998;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .menu-overlay.show {
            display: flex !important;
        }

        .menu-list {
            list-style: none;
            padding: 0;
            margin: 0;
            text-align: center;
        }

        .menu-list li {
            margin: 20px 0;
        }

        .menu-list a {
            color: #00ff9d;
            text-decoration: none;
            font-size: 24px;
            font-weight: 600;
            padding: 10px 30px;
            display: inline-block;
            border-radius: 50px;
            text-shadow: 0 0 10px rgba(0, 255, 157, 0.5);
            transition: 0.3s;
        }

        .menu-list a:hover {
            color: #ffffff;
            background: rgba(0, 255, 157, 0.12);
            text-shadow: 0 0 16px rgba(0, 255, 157, 0.8);
        }

        .menu-list li:last-child a {
            color: #00ff9d;
        }

        /* Main content alignment */
        main {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Desktop: Hide hamburger, show vertical navbar */
        @media (min-width: 769px) {
            .hamburger-btn {
                display: none !important;
            }

            .menu-overlay:not(.show) {
                display: none !important;
            }
        }

        /* Mobile: Show hamburger, hide vertical navbar if it exists */
        @media screen and (max-width: 768px) {
            .hamburger-btn {
                display: flex !important;
                width: 45px;
                height: 45px;
                top: 20px;
                right: 20px;
            }

            .menu-list a {
                font-size: 20px;
            }

            /* Hide vertical navbar on mobile */
            .gooey-navbar,
            .navbar {
                display: none !important;
            }

            /* Hide auth buttons on mobile */
            .auth-buttons-top {
                display: none !important;
                visibility: hidden !important;
            }
        }
    </style>

    {% endblock %}

    <script>
        // Hamburger Menu Handler
        function initHamburgerMenu() {
            const hamburger = document.getElementById('hamburger-menu');
            const menuOverlay = document.getElementById('menu-overlay');
            const menuLinks = document.querySelectorAll('.menu-list a');

            if (hamburger && menuOverlay) {
                // Toggle menu on hamburger click
                hamburger.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    hamburger.classList.toggle('active');
                    menuOverlay.classList.toggle('show');
                });

                // Close menu on link click
                menuLinks.forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        hamburger.classList.remove('active');
                        menuOverlay.classList.remove('show');
                        // Navigate after closing menu
                        const href = this.getAttribute('href');
                        if (href) {
                            setTimeout(() => {
                                window.location.href = href;
                            }, 100);
                        }
                    });
                });

                // Close menu on overlay click (outside menu)
                menuOverlay.addEventListener('click', function(e) {
                    if (e.target === this) {
                        hamburger.classList.remove('active');
                        menuOverlay.classList.remove('show');
                    }
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initHamburgerMenu);
        } else {
            initHamburgerMenu();
        }
    </script>

    <script>
    // Hide navbar, circular-nav, and footer on ALL admin pages
    console.log('Admin hide script running. Pathname:', window.location.pathname);
    if (window.location.pathname.startsWith('/admin')) {
        console.log('IS ADMIN PAGE - hiding elements');
        const navbar = document.querySelector('.navbar');
        const circNav = document.querySelector('.circular-nav-container');
        const footer = document.querySelector('footer');

        console.log('Found elements:', {navbar: !!navbar, circNav: !!circNav, footer: !!footer});

        if (navbar) {
            navbar.style.cssText = 'display: none !important; visibility: hidden !important;';
            console.log('Navbar hidden');
        }
        if (circNav) {
            circNav.style.cssText = 'display: none !important; visibility: hidden !important;';
            console.log('CircNav hidden');
        }
        if (footer) {
            footer.style.cssText = 'display: none !important; visibility: hidden !important;';
            console.log('Footer hidden');
        }
    }
    </script>

    {% include 'components/_circular_navbar.html.twig' %}
</body>
</html>
