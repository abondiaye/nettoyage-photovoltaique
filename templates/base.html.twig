<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SyriusPro — Nettoyage de panneaux photovoltaïques{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
     <link rel="icon" href="{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}">{% block stylesheets %}
    <style>
        :root {
            --bleu-nuit: #0B1F33;
            --bleu-panneau: #1E5F8C;
            --jaune-solaire: #F4B731;
            --gris-verre: #F0F4F7;
            --blanc: #FFFFFF;
            --texte: #1A2733;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--texte);
            background: var(--blanc);
            line-height: 1.6;
        }

        h1, h2, h3, .display {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        a { color: inherit; }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Header */
        header.site {
            position: sticky;
            top: 0;
            z-index: 50;
            background: var(--bleu-nuit);
            color: var(--blanc);
        }

        .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 24px;           
            max-width: 1100px;   
            margin: 0 auto;
        }

        .logo {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            color: var(--blanc);
        }

        .logo-mark {
            display: inline-grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
            gap: 2px;
            width: 22px;
            height: 22px;
        }
        .logo-mark span {
            background: var(--jaune-solaire);
            border-radius: 2px;
        }
        .logo-mark span:nth-child(2),
        .logo-mark span:nth-child(3) { background: var(--bleu-panneau); }

        .nav-links {
            display: flex;
            gap: 28px;
            font-size: 0.95rem;
            font-weight: 500;
        }
        .nav-links a {
            text-decoration: none;
            color: rgba(255,255,255,0.85);
            transition: color 0.15s ease;
        }
        .nav-links a:hover { color: var(--jaune-solaire); }

        .btn {
            display: inline-block;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 6px;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .btn-primary {
            background: var(--jaune-solaire);
            color: var(--bleu-nuit);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(244,183,49,0.35);
        }
        .btn-outline {
            border: 1px solid rgba(255,255,255,0.4);
            color: var(--blanc);
        }
        .btn-outline:hover { border-color: var(--jaune-solaire); color: var(--jaune-solaire); }
        .btn-secondary { background: var(--bleu-panneau); color: var(--blanc); }
        .btn-secondary:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(30,95,140,0.35); }
        .btn-success { background: #16a34a; color: var(--blanc); }
        .btn-success:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(22,163,74,0.35); }

        /* Footer */
        footer.site {
            background: var(--bleu-nuit);
            color: rgba(255,255,255,0.7);
            margin-top: 80px;
        }
        footer.site .container {
            padding: 48px 24px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 32px;
            font-size: 0.9rem;
        }
        footer.site h4 {
            font-family: 'Space Grotesk', sans-serif;
            color: var(--blanc);
            margin-bottom: 12px;
            font-size: 1rem;
        }
        footer.site a { text-decoration: none; color: inherit; }
        footer.site a:hover { color: var(--jaune-solaire); }
        .footer-bottom {
            text-align: center;
            font-size: 0.8rem;
            padding: 16px 0 32px;
            color: rgba(255,255,255,0.4);
        }

        @media (max-width: 720px) {
            .nav-links { display: none; }
        }

        .lang-switch {
            display: flex;
            gap: 4px;
            margin-left: 20px;
        }
        .lang-switch a {
            text-decoration: none;
            color: rgba(255,255,255,0.6);
            font-size: 0.8rem;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 4px;
            border: 1px solid rgba(255,255,255,0.25);
        }
        .lang-switch a.-active {
            color: var(--bleu-nuit);
            background: var(--jaune-solaire);
            border-color: var(--jaune-solaire);
        }

        .page-nav {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            max-width: 1100px;
            margin: 48px auto 0;
            padding: 0 24px;
        }
        .page-nav .page-nav-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            color: var(--bleu-nuit);
            background: var(--gris-verre);
            padding: 12px 20px;
            border-radius: 6px;
            transition: transform 0.15s ease;
        }
        .page-nav .page-nav-link:hover { transform: translateY(-2px); }
        .page-nav .page-nav-spacer { flex: 1; }
    </style>
    {% endblock %}
 <link rel="icon" href="{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}"></head>
<body>
    <header class="site">
        <nav class="nav"> 
            <a href="{{ path('app_home') }}" class="logo">
                <span class="logo-mark">
                    <span></span><span></span><span></span><span></span>
                </span>
                SyriusPro
            </a>
            <div class="nav-links">
                <a href="{{ path('app_home') }}#services">{{ 'nav.services'|trans }}</a>
                <a href="{{ path('app_home') }}#avantages">{{ 'nav.why_us'|trans }}</a>
                <a href="{{ path('app_devis') }}">{{ 'nav.quote'|trans }}</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}">{{ 'nav.admin'|trans }}</a>
                {% elseif is_granted('ROLE_MEMBER') %}
                    <a href="{{ path('app_member_dashboard') }}">{{ 'nav.member_area'|trans }}</a>
                {% endif %}
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <a href="{{ path('app_logout') }}">{{ 'nav.logout'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                {% endif %}
            </div>
            <div class="lang-switch">
                <a href="{{ path('app_locale_switch', {locale: 'fr'}) }}" class="{{ app.request.locale == 'fr' ? '-active' : '' }}">FR</a>
                <a href="{{ path('app_locale_switch', {locale: 'en'}) }}" class="{{ app.request.locale == 'en' ? '-active' : '' }}">EN</a>
            </div>
            <a href="{{ path('app_devis') }}" class="btn btn-primary" style="font-size:0.9rem; padding:10px 20px;">{{ 'nav.free_quote'|trans }}</a>
        </nav>
    </header>

    <main>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ label }} container" style="margin-top:24px;">
                    <div style="background:#E7F6EC; border:1px solid #34A85333; color:#1F7A3F; padding:16px 20px; border-radius:8px; font-weight:500;">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}

        <div class="page-nav">
            {% block page_nav_prev %}{% endblock %}
            <div class="page-nav-spacer"></div>
            {% block page_nav_next %}{% endblock %}
        </div>
    </main>

    <footer class="site">
        <div class="container">
            <div>
                <h4>SyriusPro</h4>
                <p>{{ 'footer.tagline'|trans }}</p>
            </div>
            <div>
                <h4>{{ 'footer.nav_title'|trans }}</h4>
                <p><a href="{{ path('app_home') }}">{{ 'footer.home'|trans }}</a></p>
                <p><a href="{{ path('app_home') }}#services">{{ 'footer.services'|trans }}</a></p>
                <p><a href="{{ path('app_devis') }}">{{ 'footer.quote'|trans }}</a></p>
            </div>
            <div>
                <h4>{{ 'footer.contact_title'|trans }}</h4>
                <p>contact@SyriusPro.fr</p>
                <p>06 00 00 00 00</p>
            </div>
        </div>
        <div class="footer-bottom">
            © {{ "now"|date("Y") }} SyriusPro — {{ 'footer.rights'|trans }}
        </div>
    </footer>
</body>
</html>
