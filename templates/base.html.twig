<body>

    <!-- Navigation -->
    <nav class="navbar">
        <a href="{{ path('app_home') }}" class="nav-brand">
            <div class="nav-brand-icon">
                <img src="{{ asset('images/logo1.jpeg') }}" alt="Sirius-Solar Logo">
            </div>
            <span class="nav-brand-text">Sirius-Solar</span>
        </a>

        <!-- Desktop Menu -->
        <ul class="nav-menu" id="navMenu">
            <li><a href="{{ path('app_home') }}" class="nav-link" data-path="home">Accueil</a></li>
            <li><a href="#avantages" class="nav-link" data-path="about">À propos</a></li>
            <li><a href="#services" class="nav-link" data-path="services">Services</a></li>
            <li><a href="{{ path('app_cartes_animees') }}" class="nav-link" data-path="gallery">Gallery</a></li>
            <li><a href="#contact" class="nav-link" data-path="contact">Contact</a></li>
        </ul>

        <div class="nav-buttons">
            <!-- Language Selector -->
            <div class="language-selector">
                <a href="{{ path('set_locale', {locale: 'fr'}) }}" class="lang-link" title="Français">🇫🇷 FR</a>
                <span class="lang-separator">|</span>
                <a href="{{ path('set_locale', {locale: 'de'}) }}" class="lang-link" title="Deutsch">🇩🇪 DE</a>
                <span class="lang-separator">|</span>
                <a href="{{ path('set_locale', {locale: 'it'}) }}" class="lang-link" title="Italiano">🇮🇹 IT</a>
                <span class="lang-separator">|</span>
                <a href="{{ path('set_locale', {locale: 'rm'}) }}" class="lang-link" title="Rumantsch">🇨🇭 RM</a>
            </div>

            <button id="theme-toggle" class="btn-theme" title="Basculer le mode clair/sombre">
                <span class="theme-icon">🌙</span>
            </button>

            {% if app.user %}
                <a href="{{ path('app_user_dashboard') }}" class="btn-login">📊 Mon Compte</a>
                <a href="{{ path('app_logout') }}" class="btn-login">Déconnexion</a>
                {% if 'ROLE_ADMIN' in app.user.roles %}
                    <a href="{{ path('app_admin_dashboard') }}" class="btn-signup">Admin</a>
                {% endif %}
            {% else %}
                <a href="{{ path('app_register') }}" class="btn-login">S'inscrire</a>
                <a href="{{ path('app_login') }}" class="btn-login">Connexion</a>
            {% endif %}
        </div>

        <!-- Hamburger Menu -->
        <button class="hamburger-menu" id="hamburger" aria-label="Menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </nav>

    <!-- Mobile Menu -->
    <div class="nav-menu-mobile" id="mobileMenu">
        <ul>
            <li><a href="{{ path('app_home') }}" class="nav-link" data-path="home">Accueil</a></li>
            <li><a href="#avantages" class="nav-link" data-path="about">À propos</a></li>
            <li><a href="#services" class="nav-link" data-path="services">Services</a></li>
            <li><a href="{{ path('app_cartes_animees') }}" class="nav-link" data-path="gallery">Gallery</a></li>
            <li><a href="#contact" class="nav-link" data-path="contact">Contact</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <main>
        {% block body %}{% endblock %}
    </main>

    <!-- Circular Navigation Wheel (not in admin) -->
    {% if not (app.request.pathInfo|default('')|length > 0 and '/admin' in app.request.pathInfo) %}
        {% include 'components/circular-navbar.html.twig' %}
    {% endif %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        <script src="{{ asset('assets/js/navbar.js') }}"></script>
        <script>

            // Theme Toggle
            const themeToggle = document.getElementById('theme-toggle');
            const html = document.documentElement;
            const themeIcon = themeToggle.querySelector('.theme-icon');

            // Check for saved theme preference or default to light mode
            const currentTheme = localStorage.getItem('theme') || 'light';
            if (currentTheme === 'dark') {
                document.body.classList.add('dark-mode');
                html.setAttribute('data-theme', 'dark');
                themeIcon.textContent = '☀️';
            }

            themeToggle.addEventListener('click', () => {
                document.body.classList.toggle('dark-mode');

                if (document.body.classList.contains('dark-mode')) {
                    html.setAttribute('data-theme', 'dark');
                    localStorage.setItem('theme', 'dark');
                    themeIcon.textContent = '☀️';
                } else {
                    html.setAttribute('data-theme', 'light');
                    localStorage.setItem('theme', 'light');
                    themeIcon.textContent = '🌙';
                }
            });

            // Handle anchor links properly
            document.addEventListener('click', (e) => {
                const target = e.target.closest('a[href*="#"]');
                if (target && target.href) {
                    try {
                        const url = new URL(target.href);
                        const hash = url.hash;

                        // If the link is to an anchor on the same page or home page with anchor
                        if (hash && (url.pathname === window.location.pathname || url.pathname === '/' || url.pathname === '/index.php')) {
                            e.preventDefault();
                            const element = document.querySelector(hash);
                            if (element) {
                                // Scroll to the element
                                element.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                // Update URL without full page reload
                                window.history.pushState(null, null, hash);
                            }
                        }
                    } catch (err) {
                        // If URL parsing fails, let default behavior handle it
                        console.error('Error handling anchor link:', err);
                    }
                }
            });
        </script>
    {% endblock %}

    <script>
    // Hide navbar, circular-nav, and footer on ALL admin pages
    console.log('Admin hide script running. Pathname:', window.location.pathname);
    if (window.location.pathname.startsWith('/admin')) {
        console.log('IS ADMIN PAGE - hiding elements');
        const navbar = document.querySelector('.navbar');
        const circNav = document.querySelector('.circular-nav-container');
        const footer = document.querySelector('footer');

        console.log('Found elements:', {navbar: !!navbar, circNav: !!circNav, footer: !!footer});

        if (navbar) {
            navbar.style.cssText = 'display: none !important; visibility: hidden !important;';
            console.log('Navbar hidden');
        }
        if (circNav) {
            circNav.style.cssText = 'display: none !important; visibility: hidden !important;';
            console.log('CircNav hidden');
        }
        if (footer) {
            footer.style.cssText = 'display: none !important; visibility: hidden !important;';
            console.log('Footer hidden');
        }
    }
    </script>
</body>
</html>
