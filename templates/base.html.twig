    <!-- Dark mode toggle script -->
    <script>
        // Dark Mode Toggle Controller (Inline for immediate availability)
        (function() {
          'use strict';
          const THEME_KEY = 'syriussolar-theme';
          const DARK_MODE = 'dark';
          const LIGHT_MODE = 'light';

          function showThemeAnimation() {
            const svg = `<svg class="theme-toggle-svg" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
              <!-- Sky background -->
              <defs>
                <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#E0F6FF;stop-opacity:1" />
                </linearGradient>
              </defs>
              <rect width="300" height="200" fill="url(#skyGrad)"/>

              <!-- Sun -->
              <circle cx="80" cy="50" r="30" fill="#FFD700" class="sun-circle"/>

              <!-- Cloud layers -->
              <g class="cloud-layer cloud-1">
                <ellipse cx="150" cy="140" rx="60" ry="20" fill="white" opacity="0.9"/>
              </g>
              <g class="cloud-layer cloud-2">
                <ellipse cx="100" cy="160" rx="50" ry="18" fill="white" opacity="0.8"/>
              </g>
              <g class="cloud-layer cloud-3">
                <ellipse cx="200" cy="170" rx="55" ry="19" fill="white" opacity="0.75"/>
              </g>

              <!-- Cursor -->
              <g class="cursor-icon">
                <path d="M 250 80 L 250 120 L 270 110 Z" fill="black" stroke="black" stroke-width="2"/>
              </g>
            </svg>`;

            const container = document.createElement('div');
            container.className = 'theme-toggle-animation';
            container.innerHTML = svg;
            document.body.appendChild(container);

            setTimeout(() => container.remove(), 1500);
          }

          function setTheme(theme, animate = false) {
            const root = document.documentElement;
            if (animate) {
              root.classList.add('theme-changing');
              showThemeAnimation();
            }
            root.setAttribute('data-theme', theme);
            localStorage.setItem(THEME_KEY, theme);

            // Apply body styles inline
            const body = document.body;
            if (theme === LIGHT_MODE) {
              body.style.backgroundColor = '#faf9f7';
              body.style.color = '#1B4D3E';
            } else {
              body.style.backgroundColor = '#0a0f0d';
              body.style.color = '#e0e0e0';
            }

            // Sync checkbox state with theme
            const checkbox = document.querySelector('.daynight__checkbox');
            if (checkbox) {
              checkbox.checked = (theme === DARK_MODE);
            }

            if (animate) {
              setTimeout(() => root.classList.remove('theme-changing'), 300);
            }
          }

          function init() {
            const savedTheme = localStorage.getItem(THEME_KEY);
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = savedTheme || (prefersDark ? DARK_MODE : LIGHT_MODE);
            setTheme(theme, false);

            // Sync checkbox with theme
            const checkbox = document.querySelector('.daynight__checkbox');
            if (checkbox) {
              // Set initial checkbox state based on theme
              const initialTheme = localStorage.getItem(THEME_KEY) || (window.matchMedia('(prefers-color-scheme: dark)').matches ? DARK_MODE : LIGHT_MODE);
              checkbox.checked = (initialTheme === DARK_MODE);

              // Listen to checkbox changes
              checkbox.addEventListener('change', (e) => {
                const current = document.documentElement.getAttribute('data-theme') || LIGHT_MODE;
                setTheme(current === DARK_MODE ? LIGHT_MODE : DARK_MODE, true);
              });
            }

            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
              if (!localStorage.getItem(THEME_KEY)) {
                setTheme(e.matches ? DARK_MODE : LIGHT_MODE);
              }
            });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
          } else {
            init();
          }
        })();

        // Back to top button
        (function() {
          'use strict';
          const btn = document.querySelector('.back-to-top');
          if (!btn) return;

          window.addEventListener('scroll', () => {
            if (window.pageYOffset > 300) {
              btn.classList.add('visible');
            } else {
              btn.classList.remove('visible');
            }
          });

          btn.addEventListener('click', (e) => {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        })();
      </script>

