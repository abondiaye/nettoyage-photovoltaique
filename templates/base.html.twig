<!DOCTYPE html>
{% set routeName = app.request.attributes.get('_route')|default('NOROUTE') %}
<html lang="fr" data-x="{{ routeName }}" {% if routeName|slice(0, 6) == 'admin_' %}class="is-admin"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Sirius-Solar - Nettoyage & Entretien professionnel de panneaux photovoltaïques. Retrouvez jusqu'à 25% de rendement perdu. Eau osmosée, zéro produit chimique. Devis gratuit en 48h.">
    <meta name="keywords" content="nettoyage panneaux solaires, Sirius-Solar, panneaux photovoltaïques, maintenance solar, eau osmosée">
    <meta name="author" content="Sirius-Solar">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques">
    <meta property="og:description" content="Retrouvez jusqu'à 25% de rendement perdu. Eau osmosée, zéro produit chimique. Devis gratuit en 48h.">
    <meta property="og:image" content="{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}">

    <!-- Theme Color -->
    <meta name="theme-color" content="#0A3D35">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <title>{% block title %}Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques{% endblock %}</title>

    <link rel="icon" href="{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        {% set currentRoute = app.request.attributes.get('_route')|default('') %}
        {% if currentRoute|slice(0, 6) == 'admin_' or app.request.pathInfo|default('')|slice(0, 6) == '/admin' %}
        <style>
            /* Hide navbar and circular nav by DEFAULT (on ALL pages) */
            .navbar { display: none !important; visibility: hidden !important; height: 0 !important; margin: 0 !important; padding: 0 !important; }
            .circular-nav-container { display: none !important; visibility: hidden !important; height: 0 !important; width: 0 !important; margin: 0 !important; padding: 0 !important; }

            html footer {
                display: none !important;
                visibility: hidden !important;
                height: 0 !important;
            }
        </style>
        {% endif %}
        <style>
            /* ===== RESET & VARIABLES ===== */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --vert-fonce: #0A3D35;
                --vert-clair: #2D6B55;
                --dore: #a8a8a8;
                --dore-clair: #e8e8e8;
                --blanc: #FFFFFF;
                --noir: #121212;
                --gris-clair: #F0F4F8;
                --gris-moyen: #888888;
            }

            html {
                scroll-behavior: smooth;
            }

            html, body {
                height: 100%;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                background: white;
                color: #333;
            }

            /* ===== NAVBAR MINIMALISTE (CodePen Style) ===== */
            .navbar {
                position: sticky;
                top: 0;
                z-index: 1000;
                display: flex;
                justify-content: space-between;
                align-items: center;

                /* Glasmorphism minimaliste */
                background: rgba(10, 61, 53, 0.9);
                backdrop-filter: blur(15px);
                border-bottom: 2px solid rgba(192, 192, 192, 0.3);

                height: 70px;
                padding: 0 30px;

                /* Animation */
                animation: slideDown 0.6s ease-out;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            }

            @keyframes slideDown {
                from {
                    opacity: 0;
                    transform: translateY(-100%);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Brand */
            .nav-brand {
                font-size: 18px;
                font-weight: 700;
                color: white;
                cursor: pointer;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                flex-shrink: 0;
            }

            .nav-brand-icon {
                width: 50px;
                height: 50px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                background: rgba(192, 192, 192, 0.25);
                border-radius: 10px;
                border: 2px solid rgba(192, 192, 192, 0.8);
                box-shadow: 0 8px 20px rgba(192, 192, 192, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 15px rgba(192, 192, 192, 0.3);
                transition: all 0.3s ease;
            }

            .nav-brand-icon img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                padding: 6px;
                border-radius: 8px;
                filter: drop-shadow(0 2px 8px rgba(192, 192, 192, 0.6)) brightness(1.1);
            }

            .nav-brand:hover .nav-brand-icon {
                background: rgba(192, 192, 192, 0.4);
                border-color: rgba(192, 192, 192, 1);
                box-shadow: 0 12px 30px rgba(192, 192, 192, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 0 25px rgba(192, 192, 192, 0.5);
                transform: translateY(-2px) scale(1.08);
            }

            .nav-brand:hover {
                transform: scale(1.03);
                color: #c0c0c0;
            }

            /* Menu Items - 3D Solar Neon Style */
            .nav-menu {
                display: flex;
                list-style: none;
                gap: 15px;
                margin: 0 auto;
                flex-grow: 1;
                justify-content: center;
                perspective: 1200px;
            }

            .nav-menu li {
                position: relative;
            }

            .nav-menu a {
                color: rgba(255, 255, 255, 0.95);
                text-decoration: none;
                font-size: 13px;
                font-weight: 600;
                transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
                padding: 12px 24px;
                display: block;
                border-radius: 8px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                position: relative;

                /* 3D Solar Button - Grille Métallique Neon */
                background:
                    repeating-linear-gradient(
                        90deg,
                        rgba(192, 192, 192, 0.1) 0px,
                        rgba(192, 192, 192, 0.1) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    repeating-linear-gradient(
                        0deg,
                        rgba(192, 192, 192, 0.1) 0px,
                        rgba(192, 192, 192, 0.1) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    linear-gradient(180deg, rgba(192, 192, 192, 0.08) 0%, rgba(192, 192, 192, 0.02) 100%);
                border: 2px solid rgba(192, 192, 192, 0.4);
                box-shadow:
                    0 10px 25px rgba(0, 0, 0, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.2),
                    inset 0 0 10px rgba(192, 192, 192, 0.1),
                    0 0 0 0 rgba(192, 192, 192, 0);
                transform: translateZ(0) rotateX(0deg) rotateY(0deg);
                transform-style: preserve-3d;
            }

            .nav-menu a::before {
                content: '';
                position: absolute;
                inset: 0;
                background:
                    radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.3), transparent 50%),
                    repeating-linear-gradient(
                        90deg,
                        rgba(192, 192, 192, 0.2) 0px,
                        rgba(192, 192, 192, 0.2) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    repeating-linear-gradient(
                        0deg,
                        rgba(192, 192, 192, 0.2) 0px,
                        rgba(192, 192, 192, 0.2) 1px,
                        transparent 1px,
                        transparent 20px
                    );
                border-radius: 8px;
                opacity: 0;
                transition: opacity 0.3s ease;
                pointer-events: none;
                z-index: 0;
            }

            .nav-menu a:hover {
                color: #e8e8e8;
                border-color: rgba(192, 192, 192, 1);
                transform: translateY(-5px) rotateX(5deg) rotateY(0deg) scale(1.05);
                box-shadow:
                    0 20px 40px rgba(0, 0, 0, 0.5),
                    inset 0 1px 0 rgba(255, 255, 255, 0.3),
                    0 0 30px rgba(192, 192, 192, 1),
                    0 15px 35px rgba(192, 192, 192, 0.4),
                    inset 0 0 20px rgba(192, 192, 192, 0.3);
            }

            .nav-menu a:hover::before {
                opacity: 1;
            }

            /* Underline animation - Yellow glide effect */
            .nav-menu a::after {
                content: '';
                position: absolute;
                bottom: 8px;
                left: 24px;
                width: 0;
                height: 3px;
                background: linear-gradient(90deg, transparent, #c0c0c0, #d0d0d0, transparent);
                transition: width 0.4s cubic-bezier(0.4, 0.0, 0.2, 1);
                border-radius: 2px;
            }

            .nav-menu a:hover::after {
                width: calc(100% - 48px);
                box-shadow: 0 0 15px rgba(192, 192, 192, 0.8);
            }

            /* Action Buttons */
            .nav-buttons {
                display: flex;
                gap: 15px;
                align-items: center;
            }

            .btn-theme {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.3);
                color: white;
                padding: 10px 15px;
                border-radius: 8px;
                cursor: pointer;
                font-size: 16px;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .btn-theme:hover {
                background: rgba(255, 255, 255, 0.2);
                border-color: var(--dore);
                color: var(--dore);
            }

            .language-selector {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-right: 15px;
            }

            .lang-link {
                color: rgba(255, 255, 255, 0.8);
                text-decoration: none;
                font-size: 12px;
                font-weight: 600;
                transition: all 0.3s ease;
                padding: 5px 8px;
                border-radius: 4px;
            }

            .lang-link:hover {
                color: var(--dore);
                background: rgba(160, 160, 160, 0.1);
            }

            .lang-separator {
                color: rgba(255, 255, 255, 0.4);
                font-size: 12px;
            }

            @media (max-width: 768px) {
                .language-selector {
                    margin-right: 10px;
                    gap: 5px;
                }

                .lang-link {
                    font-size: 11px;
                    padding: 3px 5px;
                }
            }

            .btn-login {
                background: transparent;
                color: white;
                border: 1px solid rgba(255, 255, 255, 0.3);
                padding: 10px 20px;
                border-radius: 8px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 600;
                transition: all 0.3s ease;
            }

            .btn-login:hover {
                background: rgba(255, 255, 255, 0.1);
                border-color: var(--dore);
                color: var(--dore);
            }

            .btn-signup {
                background: linear-gradient(135deg, var(--dore), var(--dore-clair));
                color: #121212;
                border: none;
                padding: 10px 20px;
                border-radius: 8px;
                font-weight: 600;
                cursor: pointer;
                font-size: 13px;
                transition: all 0.3s ease;
            }

            .btn-signup:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 30px rgba(160, 160, 160, 0.4);
            }

            /* Hamburger Menu */
            .hamburger-menu {
                display: none;
                flex-direction: column;
                cursor: pointer;
                gap: 6px;
            }

            .hamburger-menu span {
                width: 25px;
                height: 3px;
                background: white;
                border-radius: 2px;
                transition: all 0.3s ease;
            }

            .hamburger-menu.active span:nth-child(1) {
                transform: rotate(45deg) translate(10px, 10px);
            }

            .hamburger-menu.active span:nth-child(2) {
                opacity: 0;
            }

            .hamburger-menu.active span:nth-child(3) {
                transform: rotate(-45deg) translate(7px, -7px);
            }

            /* Mobile Menu */
            .nav-menu-mobile {
                display: none;
                position: fixed;
                top: 140px;
                left: 0;
                right: 0;
                background: rgba(10, 61, 53, 0.98);
                backdrop-filter: blur(20px);
                flex-direction: column;
                gap: 0;
                list-style: none;
                padding: 0;
                margin: 0;
                border-bottom: 1px solid rgba(160, 160, 160, 0.3);
                max-height: calc(100vh - 140px);
                overflow-y: auto;
                z-index: 999;
                animation: slideDown 0.3s ease-out;
            }

            .nav-menu-mobile.active {
                display: flex !important;
            }

            .nav-menu-mobile li {
                border-bottom: 1px solid rgba(160, 160, 160, 0.2);
                width: 100%;
            }

            .nav-menu-mobile a {
                display: block;
                color: rgba(255, 255, 255, 0.8);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                padding: 16px 40px;
                transition: all 0.3s ease;
                width: 100%;
            }

            .nav-menu-mobile a:hover {
                color: var(--dore);
                background: rgba(160, 160, 160, 0.1);
            }

            .nav-menu-mobile li:last-child {
                border-bottom: none;
            }

            /* ===== ENHANCED NAV STYLES WITH NEON EFFECT ===== */
            .nav-brand-text {
                display: none;
                font-size: 14px;
                font-weight: 700;
                color: white;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            /* Active state for desktop menu - 3D SOLAR NEON GRID */
            .nav-menu a.active {
                color: #e8e8e8;
                background:
                    repeating-linear-gradient(
                        90deg,
                        rgba(192, 192, 192, 0.3) 0px,
                        rgba(192, 192, 192, 0.3) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    repeating-linear-gradient(
                        0deg,
                        rgba(192, 192, 192, 0.3) 0px,
                        rgba(192, 192, 192, 0.3) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    linear-gradient(180deg, rgba(192, 192, 192, 0.35) 0%, rgba(192, 192, 192, 0.2) 100%);
                border-color: rgba(192, 192, 192, 1);
                border-radius: 8px;
                box-shadow:
                    0 0 40px rgba(192, 192, 192, 1),
                    inset 0 0 30px rgba(192, 192, 192, 0.4),
                    0 15px 35px rgba(192, 192, 192, 0.5),
                    0 0 0 3px rgba(192, 192, 192, 0.2);
                transform: translateY(-8px) rotateX(8deg) scale(1.08);
            }

            .nav-menu a.active::before {
                opacity: 1;
                background:
                    radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.5), transparent 50%),
                    repeating-linear-gradient(
                        90deg,
                        rgba(192, 192, 192, 0.4) 0px,
                        rgba(192, 192, 192, 0.4) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    repeating-linear-gradient(
                        0deg,
                        rgba(192, 192, 192, 0.4) 0px,
                        rgba(192, 192, 192, 0.4) 1px,
                        transparent 1px,
                        transparent 20px
                    );
            }

            .nav-menu a.active::after {
                width: calc(100% - 48px);
                box-shadow: 0 0 30px rgba(192, 192, 192, 1), 0 0 60px rgba(192, 192, 192, 0.8);
                height: 4px;
                background: linear-gradient(90deg, transparent, #e8e8e8, #d0d0d0, #e8e8e8, transparent);
                bottom: 6px;
            }

            /* Enhanced hover effect - NEON GLOW */
            .nav-menu a:hover {
                color: #d0d0d0;
                background: rgba(192, 192, 192, 0.1);
                transform: translateY(-2px);
                box-shadow: 0 0 10px rgba(192, 192, 192, 0.4);
            }

            /* Active state for mobile menu - 3D SOLAR GRID */
            .nav-menu-mobile a.active {
                color: #e8e8e8;
                background:
                    repeating-linear-gradient(
                        90deg,
                        rgba(192, 192, 192, 0.3) 0px,
                        rgba(192, 192, 192, 0.3) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    repeating-linear-gradient(
                        0deg,
                        rgba(192, 192, 192, 0.3) 0px,
                        rgba(192, 192, 192, 0.3) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    linear-gradient(180deg, rgba(192, 192, 192, 0.25) 0%, rgba(192, 192, 192, 0.12) 100%);
                border-left: 4px solid #e8e8e8;
                padding-left: 36px;
                box-shadow:
                    inset 0 0 20px rgba(192, 192, 192, 0.25),
                    0 0 30px rgba(192, 192, 192, 0.8),
                    0 8px 20px rgba(192, 192, 192, 0.3);
                transform: translateZ(15px) translateX(8px) scale(1.02);
            }

            .nav-menu-mobile a.active:hover {
                background:
                    repeating-linear-gradient(
                        90deg,
                        rgba(192, 192, 192, 0.4) 0px,
                        rgba(192, 192, 192, 0.4) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    repeating-linear-gradient(
                        0deg,
                        rgba(192, 192, 192, 0.4) 0px,
                        rgba(192, 192, 192, 0.4) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    linear-gradient(180deg, rgba(192, 192, 192, 0.3) 0%, rgba(192, 192, 192, 0.18) 100%);
                box-shadow:
                    inset 0 0 30px rgba(192, 192, 192, 0.3),
                    0 0 40px rgba(192, 192, 192, 1),
                    0 12px 30px rgba(192, 192, 192, 0.5);
                transform: translateZ(20px) translateX(10px) scale(1.05);
            }

            /* Mobile menu improvements */
            .nav-menu-mobile {
                display: none;
                position: fixed;
                top: 70px;
                left: 0;
                right: 0;
                background: rgba(10, 61, 53, 0.99);
                backdrop-filter: blur(20px);
                border-bottom: 2px solid rgba(192, 192, 192, 0.3);
            }

            .nav-menu-mobile ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .nav-menu-mobile li {
                border-bottom: 1px solid rgba(160, 160, 160, 0.15);
                width: 100%;
                margin: 0;
            }

            .nav-menu-mobile a {
                display: block;
                color: rgba(255, 255, 255, 0.9);
                text-decoration: none;
                font-size: 15px;
                font-weight: 500;
                padding: 18px 40px;
                transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
                width: 100%;
                position: relative;

                /* 3D Mobile Button - Solar Grid */
                background:
                    repeating-linear-gradient(
                        90deg,
                        rgba(192, 192, 192, 0.08) 0px,
                        rgba(192, 192, 192, 0.08) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    repeating-linear-gradient(
                        0deg,
                        rgba(192, 192, 192, 0.08) 0px,
                        rgba(192, 192, 192, 0.08) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
                border-left: 4px solid rgba(192, 192, 192, 0.4);
                box-shadow:
                    0 8px 20px rgba(0, 0, 0, 0.2),
                    inset 1px 1px 0 rgba(255, 255, 255, 0.1),
                    inset 0 0 10px rgba(192, 192, 192, 0.05);
                transform-style: preserve-3d;
                transform: translateZ(0);
            }

            .nav-menu-mobile a::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 4px;
                background: linear-gradient(180deg, #c0c0c0, #d0d0d0);
                transform: scaleY(0) translateZ(15px);
                transform-origin: top;
                transition: transform 0.3s ease;
                box-shadow: 0 0 15px rgba(192, 192, 192, 0.8);
                z-index: 10;
            }

            .nav-menu-mobile a:hover::before,
            .nav-menu-mobile a.active::before {
                transform: scaleY(1) translateZ(15px);
            }

            .nav-menu-mobile a:hover {
                color: #e8e8e8;
                background:
                    repeating-linear-gradient(
                        90deg,
                        rgba(192, 192, 192, 0.2) 0px,
                        rgba(192, 192, 192, 0.2) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    repeating-linear-gradient(
                        0deg,
                        rgba(192, 192, 192, 0.2) 0px,
                        rgba(192, 192, 192, 0.2) 1px,
                        transparent 1px,
                        transparent 20px
                    ),
                    linear-gradient(180deg, rgba(192, 192, 192, 0.2) 0%, rgba(192, 192, 192, 0.08) 100%);
                padding-left: 48px;
                border-left-color: rgba(192, 192, 192, 1);
                box-shadow:
                    0 15px 35px rgba(0, 0, 0, 0.4),
                    inset 1px 1px 0 rgba(255, 255, 255, 0.15),
                    0 0 25px rgba(192, 192, 192, 0.8),
                    inset 0 0 15px rgba(192, 192, 192, 0.2);
                transform: translateZ(10px) translateX(5px);
            }

            /* Responsive - Show hamburger on mobile */
            @media (max-width: 768px) {
                .nav-menu {
                    display: none !important;
                }

                .hamburger-menu {
                    display: flex !important;
                    border: none;
                    background: transparent;
                    padding: 0;
                }

                .hamburger-menu:hover span {
                    background: #c0c0c0;
                }

                .nav-brand-text {
                    display: inline;
                }
            }

            /* Dark Mode - Complete Page Coverage */
            body.dark-mode {
                background: #0f0f0f !important;
                color: #e8e8e8;
            }

            body.dark-mode main {
                background: #0f0f0f !important;
                color: #e8e8e8;
            }

            body.dark-mode * {
                border-color: inherit;
            }

            body.dark-mode a {
                color: var(--dore);
            }

            body.dark-mode a:hover {
                color: var(--dore-clair);
            }

            body.dark-mode h1, body.dark-mode h2, body.dark-mode h3,
            body.dark-mode h4, body.dark-mode h5, body.dark-mode h6 {
                color: #f5f5f5 !important;
            }

            body.dark-mode p {
                color: #e8e8e8 !important;
            }

            body.dark-mode span {
                color: #e8e8e8 !important;
            }

            body.dark-mode div {
                background-color: inherit;
            }

            body.dark-mode section {
                background: rgba(255, 255, 255, 0.02) !important;
                color: #e8e8e8 !important;
            }

            body.dark-mode article {
                background: rgba(255, 255, 255, 0.02) !important;
                color: #e8e8e8 !important;
            }

            body.dark-mode strong, body.dark-mode b {
                color: #f5f5f5 !important;
            }

            body.dark-mode small {
                color: #d0d0d0 !important;
            }

            body.dark-mode em, body.dark-mode i {
                color: #e8e8e8 !important;
            }

