<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Sirius-Solar - Nettoyage & Entretien professionnel de panneaux photovoltaïques. Retrouvez jusqu'à 25% de rendement perdu. Eau osmosée, zéro produit chimique. Devis gratuit en 48h.">
    <meta name="keywords" content="nettoyage panneaux solaires, Sirius-Solar, panneaux photovoltaïques, maintenance solar, eau osmosée">
    <meta name="author" content="Sirius-Solar">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques">
    <meta property="og:description" content="Retrouvez jusqu'à 25% de rendement perdu. Eau osmosée, zéro produit chimique. Devis gratuit en 48h.">
    <meta property="og:image" content="{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}">

    <!-- Theme Color -->
    <meta name="theme-color" content="#0A3D35">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <title>{% block title %}Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques{% endblock %}</title>

    <link rel="icon" href="{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <style>
            /* ===== RESET & VARIABLES ===== */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --vert-fonce: #0A3D35;
                --vert-clair: #2D6B55;
                --dore: #D4A842;
                --dore-clair: #f4d03f;
                --blanc: #FFFFFF;
                --noir: #121212;
                --gris-clair: #F0F4F8;
                --gris-moyen: #888888;
            }

            html, body {
                height: 100%;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                background: white;
                color: #333;
            }

            /* ===== NAVBAR GLASMORPHISM ===== */
            .navbar {
                position: sticky;
                top: 0;
                z-index: 1000;
                display: flex;
                justify-content: space-between;
                align-items: center;

                /* Glasmorphism */
                background: rgba(10, 61, 53, 0.8);
                backdrop-filter: blur(20px);
                border-bottom: 1px solid rgba(212, 168, 66, 0.3);

                height: 80px;
                padding: 0 40px;

                /* Animation */
                animation: slideDown 0.6s ease-out;
            }

            @keyframes slideDown {
                from {
                    opacity: 0;
                    transform: translateY(-100%);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Brand */
            .nav-brand {
                font-size: 20px;
                font-weight: 700;
                color: white;
                cursor: pointer;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
            }

            .nav-brand-icon {
                width: 60px;
                height: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                background: rgba(255, 255, 255, 0.1);
                border-radius: 12px;
                border: 2px solid rgba(212, 168, 66, 0.4);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);
                transition: all 0.3s ease;
            }

            .nav-brand-icon img {
                width: 85%;
                height: 85%;
                object-fit: contain;
                filter: drop-shadow(0 2px 4px rgba(212, 168, 66, 0.3));
            }

            .nav-brand:hover .nav-brand-icon {
                background: rgba(212, 168, 66, 0.15);
                border-color: var(--dore);
                box-shadow: 0 12px 30px rgba(212, 168, 66, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2);
            }

            .nav-brand:hover {
                transform: scale(1.05);
                color: var(--dore);
            }

            /* Menu Items */
            .nav-menu {
                display: flex;
                list-style: none;
                gap: 30px;
            }

            .nav-menu a {
                color: rgba(255, 255, 255, 0.8);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.3s ease;
                position: relative;
            }

            .nav-menu a:hover {
                color: var(--dore);
            }

            .nav-menu a::after {
                content: '';
                position: absolute;
                bottom: -5px;
                left: 0;
                width: 0;
                height: 2px;
                background: var(--dore);
                transition: width 0.3s ease;
            }

            .nav-menu a:hover::after {
                width: 100%;
            }

            /* Action Buttons */
            .nav-buttons {
                display: flex;
                gap: 15px;
                align-items: center;
            }

            .btn-login {
                background: transparent;
                color: white;
                border: 1px solid rgba(255, 255, 255, 0.3);
                padding: 10px 20px;
                border-radius: 8px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 600;
                transition: all 0.3s ease;
            }

            .btn-login:hover {
                background: rgba(255, 255, 255, 0.1);
                border-color: var(--dore);
                color: var(--dore);
            }

            .btn-signup {
                background: linear-gradient(135deg, var(--dore), var(--dore-clair));
                color: #121212;
                border: none;
                padding: 10px 20px;
                border-radius: 8px;
                font-weight: 600;
                cursor: pointer;
                font-size: 13px;
                transition: all 0.3s ease;
            }

            .btn-signup:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 30px rgba(212, 168, 66, 0.4);
            }

            /* Hamburger Menu */
            .hamburger-menu {
                display: none;
                flex-direction: column;
                cursor: pointer;
                gap: 6px;
            }

            .hamburger-menu span {
                width: 25px;
                height: 3px;
                background: white;
                border-radius: 2px;
                transition: all 0.3s ease;
            }

            .hamburger-menu.active span:nth-child(1) {
                transform: rotate(45deg) translate(10px, 10px);
            }

            .hamburger-menu.active span:nth-child(2) {
                opacity: 0;
            }

            .hamburger-menu.active span:nth-child(3) {
                transform: rotate(-45deg) translate(7px, -7px);
            }

            /* Mobile Menu */
            .nav-menu-mobile {
                display: none;
                position: fixed;
                top: 80px;
                left: 0;
                right: 0;
                background: rgba(10, 61, 53, 0.98);
                backdrop-filter: blur(20px);
                flex-direction: column;
                gap: 0;
                list-style: none;
                padding: 0;
                margin: 0;
                border-bottom: 1px solid rgba(212, 168, 66, 0.3);
                max-height: calc(100vh - 80px);
                overflow-y: auto;
                z-index: 999;
                animation: slideDown 0.3s ease-out;
            }

            .nav-menu-mobile.active {
                display: flex !important;
            }

            .nav-menu-mobile li {
                border-bottom: 1px solid rgba(212, 168, 66, 0.2);
                width: 100%;
            }

            .nav-menu-mobile a {
                display: block;
                color: rgba(255, 255, 255, 0.8);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                padding: 16px 40px;
                transition: all 0.3s ease;
                width: 100%;
            }

            .nav-menu-mobile a:hover {
                color: var(--dore);
                background: rgba(212, 168, 66, 0.1);
            }

            .nav-menu-mobile li:last-child {
                border-bottom: none;
            }

            /* Responsive Mobile */
            @media (max-width: 768px) {
                .navbar {
                    padding: 0 20px;
                }

                .nav-menu, .nav-buttons {
                    display: none;
                }

                .hamburger-menu {
                    display: flex;
                }

                .nav-brand {
                    font-size: 18px;
                }

                .nav-brand-icon {
                    font-size: 24px;
                }
            }

            /* ===== GLOBAL ANIMATIONS ===== */
            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @keyframes fadeInDown {
                from {
                    opacity: 0;
                    transform: translateY(-30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @keyframes fadeInLeft {
                from {
                    opacity: 0;
                    transform: translateX(-30px);
                }
                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @keyframes pulse {
                0%, 100% {
                    opacity: 1;
                }
                50% {
                    opacity: 0.7;
                }
            }

            /* ===== UTILITY CLASSES ===== */
            .container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 40px;
            }

            @media (max-width: 768px) {
                .container {
                    padding: 0 20px;
                }
            }
        </style>
    {% endblock %}
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <a href="{{ path('app_home') }}" class="nav-brand">
            <div class="nav-brand-icon">
                <img src="{{ asset('images/logo.svg') }}" alt="Sirius-Solar Logo">
            </div>
            <span>SIRIUS-SOLAR</span>
        </a>

        <ul class="nav-menu">
            <li><a href="{{ path('app_home') }}#services">Services</a></li>
            <li><a href="{{ path('app_home') }}#avantages">Avantages</a></li>
            <li><a href="{{ path('app_devis') }}">Réserver</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>

        <div class="nav-buttons">
            <a href="{{ path('app_login') }}" class="btn-login">Connexion</a>
            <a href="{{ path('app_admin_dashboard') }}" class="btn-signup">Admin</a>
        </div>

        <div class="hamburger-menu" id="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <ul class="nav-menu-mobile" id="mobileMenu">
        <li><a href="{{ path('app_home') }}#services">Services</a></li>
        <li><a href="{{ path('app_home') }}#avantages">Avantages</a></li>
        <li><a href="{{ path('app_devis') }}">Réserver</a></li>
        <li><a href="#contact">Contact</a></li>
        <li style="border-bottom: none; display: flex; gap: 10px; padding: 16px 40px;">
            <a href="{{ path('app_login') }}" class="btn-login" style="flex: 1;">Connexion</a>
            <a href="{{ path('app_admin_dashboard') }}" class="btn-signup" style="flex: 1;">Admin</a>
        </li>
    </ul>

    <!-- Main Content -->
    <main>
        {% block body %}{% endblock %}
    </main>

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        <script>
            // Hamburger Menu Toggle
            const hamburger = document.getElementById('hamburger');
            const mobileMenu = document.getElementById('mobileMenu');

            hamburger.addEventListener('click', () => {
                hamburger.classList.toggle('active');
                mobileMenu.classList.toggle('active');
            });

            // Close menu on link click
            const mobileLinks = mobileMenu.querySelectorAll('a');
            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    hamburger.classList.remove('active');
                    mobileMenu.classList.remove('active');
                });
            });

            // Close menu on outside click
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.navbar') && !e.target.closest('#mobileMenu')) {
                    hamburger.classList.remove('active');
                    mobileMenu.classList.remove('active');
                }
            });
        </script>
    {% endblock %}
</body>
</html>
