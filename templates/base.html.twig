<script>
    // Scroll to a section so that its title sits just under the fixed navbar
    // (sections have a lot of padding on top: aiming at the section itself lands too low).
    window.siriusScrollTo = function (el, smooth) {
        if (!el) return;
        var title = el.matches('h1, h2, h3') ? el : (el.querySelector('h1, h2, .contact-scramble-heading') || el);
        var nav = document.getElementById('siteNavbar');
        var navH = nav ? nav.getBoundingClientRect().height : 70;
        var behavior = smooth === false ? 'auto' : 'smooth';
        // Position from the layout (offsetTop), not from the screen: it stays right even while the
        // page is still coming back from its tilted "menu open" state.
        var y = 0;
        for (var e = title; e; e = e.offsetParent) { y += e.offsetTop; }
        y = Math.max(0, y - navH - 24);
        // The page scrolls inside <body> (overflow-x: hidden on html and body), not the window.
        var b = document.body;
        if (b.scrollHeight > b.clientHeight + 5 && /(auto|scroll)/.test(getComputedStyle(b).overflowY)) {
            b.scrollTo({ top: y, behavior: behavior });
        } else {
            window.scrollTo({ top: y, behavior: behavior });
        }
    };
    // Arriving from another page with #section in the address.
    window.addEventListener('load', function () {
        if (location.hash.length > 1) {
            try { var t = document.querySelector(location.hash); if (t) setTimeout(function () { window.siriusScrollTo(t, false); }, 60); } catch (e) {}
        }
    });
</script>
