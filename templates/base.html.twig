<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Sirius-Solar - Nettoyage & Entretien professionnel de panneaux photovoltaïques. Retrouvez jusqu'à 25% de rendement perdu. Eau osmosée, zéro produit chimique. Devis gratuit en 48h.">
    <meta name="keywords" content="nettoyage panneaux solaires, Sirius-Solar, panneaux photovoltaïques, maintenance solar, eau osmosée">
    <meta name="author" content="Sirius-Solar">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques">
    <meta property="og:description" content="Retrouvez jusqu'à 25% de rendement perdu. Eau osmosée, zéro produit chimique. Devis gratuit en 48h.">
    <meta property="og:image" content="{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}">

    <!-- Theme Color -->
    <meta name="theme-color" content="#0A3D35">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <title>{% block title %}Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques{% endblock %}</title>

    <link rel="icon" href="{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <style>
            /* Theme Toggle Animation - Paper Cut Style */
            .theme-toggle-animation {
              position: fixed;
              top: 50%;
              left: 50%;
              transform: translate(-50%, -50%);
              z-index: 10000;
              pointer-events: none;
              opacity: 0;
              animation: themeToggleFade 1.5s ease-out forwards;
            }

            @keyframes themeToggleFade {
              0% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.5);
              }
              20% {
                opacity: 1;
              }
              80% {
                opacity: 1;
              }
              100% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(1.1);
              }
            }

            /* SVG Paper Cut Animation */
            .theme-toggle-svg {
              width: 300px;
              height: 200px;
              filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.2));
            }

            /* Sun animation */
            .sun-circle {
              animation: sunPulse 1.5s ease-out forwards;
              transform-origin: center;
            }

            @keyframes sunPulse {
              0% {
                r: 30;
                opacity: 0;
              }
              20% {
                opacity: 1;
              }
              80% {
                opacity: 1;
              }
              100% {
                r: 35;
                opacity: 0;
              }
            }

            /* Cloud layers animation */
            .cloud-layer {
              animation: cloudFloat 1.5s ease-out forwards;
            }

            .cloud-1 {
              animation-delay: 0.1s;
            }

            .cloud-2 {
              animation-delay: 0.2s;
            }

            .cloud-3 {
              animation-delay: 0.3s;
            }

            @keyframes cloudFloat {
              0% {
                opacity: 0;
                transform: translateY(20px);
              }
              20% {
                opacity: 1;
                transform: translateY(0);
              }
              80% {
                opacity: 1;
                transform: translateY(0);
              }
              100% {
                opacity: 0;
                transform: translateY(-20px);
              }
            }

            /* Cursor animation */
            .cursor-icon {
              animation: cursorClick 0.6s ease-out forwards;
              transform-origin: 60% 60%;
            }

            @keyframes cursorClick {
              0% {
                opacity: 0;
                transform: scale(0) rotate(0deg);
              }
              30% {
                opacity: 1;
                transform: scale(1) rotate(0deg);
              }
              60% {
                opacity: 1;
                transform: scale(1) rotate(-10deg);
              }
              100% {
                opacity: 0;
                transform: scale(0.8) rotate(-20deg) translateY(30px);
              }
            }
        </style>
    {% endblock %}

    <style>
        /* === SPLASH SCREEN - WEBGL PARTICLE ANIMATION === */
        .splash-screen {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: linear-gradient(135deg, #0A3D35 0%, #2D6B55 100%);
          z-index: 9999;
          display: flex;
          align-items: center;
          justify-content: center;
          flex-direction: column;
          gap: 40px;
          opacity: 1;
          visibility: visible;
          transition: opacity 0.8s ease-out, visibility 0.8s ease-out;
          color: #ffffff;
          overflow: hidden;
        }

        .splash-screen.hidden {
          opacity: 0;
          visibility: hidden;
          pointer-events: none;
        }

        #particle-canvas {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          z-index: 1;
        }

        .splash-content {
          position: relative;
          z-index: 2;
          text-align: center;
          animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        @keyframes fadeInUp {
          from {
            opacity: 0;
            transform: translateY(30px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .splash-logo {
          font-size: 4rem;
          margin-bottom: 24px;
          animation: spin 2s linear infinite;
        }

        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }

        .splash-title {
          font-size: 2.5rem;
          font-weight: 700;
          margin-bottom: 12px;
          letter-spacing: -0.02em;
          color: #D4A842;
          text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
          animation: fadeInUp 0.8s ease-out 0.3s both;
        }

        .splash-subtitle {
          font-size: 1rem;
          color: rgba(255, 255, 255, 0.8);
          font-style: italic;
          animation: fadeInUp 0.8s ease-out 0.4s both;
          letter-spacing: 0.05em;
        }

        .splash-loader {
          position: relative;
          width: 200px;
          height: 4px;
          background: rgba(255, 255, 255, 0.2);
          border-radius: 2px;
          overflow: hidden;
          animation: fadeInUp 0.8s ease-out 0.5s both;
        }

        .splash-loader::after {
          content: "";
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          background: linear-gradient(90deg, #D4A842, #ffffff, #D4A842);
          background-size: 200% 100%;
          animation: loading 2s linear infinite;
        }

        @keyframes loading {
          0% { left: -100%; }
          100% { left: 100%; }
        }

        .splash-text {
          font-size: 0.85rem;
          color: rgba(255, 255, 255, 0.6);
          margin-top: 16px;
          animation: fadeInUp 0.8s ease-out 0.6s both;
          letter-spacing: 0.05em;
        }

        @media (max-width: 768px) {
          .splash-screen {
            gap: 30px;
          }
          .splash-logo {
            font-size: 3rem;
          }
          .splash-title {
            font-size: 1.8rem;
          }
          .splash-subtitle {
            font-size: 0.95rem;
          }
          .splash-loader {
            width: 150px;
          }
        }

        @media (max-width: 480px) {
          .splash-screen {
            gap: 20px;
          }
          .splash-logo {
            font-size: 2.5rem;
          }
          .splash-title {
            font-size: 1.4rem;
          }
          .splash-subtitle {
            font-size: 0.9rem;
          }
          .splash-loader {
            width: 120px;
          }
          .splash-text {
            font-size: 0.8rem;
          }
        }

        @media (prefers-reduced-motion: reduce) {
          .splash-screen, .splash-content, .splash-logo, .splash-title, .splash-subtitle, .splash-loader, .splash-text {
            animation: none;
          }
          .splash-loader::after {
            animation: none;
            background: #D4A842;
          }
        }

        /* Mobile menu styles - Non modularisés car dépendant du controller */
        .mobile-menu {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--bleu-nuit);
            color: var(--blanc);
            z-index: 99;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            overflow-y: auto;
        }

        .mobile-menu.active {
            transform: translateX(0);
        }

        .mobile-menu-content {
            padding: 80px var(--padding-container) var(--space-xl);
        }

        .mobile-menu a {
            display: block;
            padding: var(--space-md) 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            text-decoration: none;
            color: rgba(255, 255, 255, 0.85);
            font-weight: 500;
        }

        .mobile-menu a:hover {
            color: var(--jaune-solaire);
        }

        .mobile-menu .lang-switch {
            margin-top: var(--space-xl);
            margin-left: 0;
        }

        /* === MEGASWITCHER-3000 === */
        .daynight {
            -webkit-tap-highlight-color: transparent;
            margin: 0;
            font-size: 0.6rem;
            display: block;
            position: relative;
            cursor: pointer;
            width: 25em;
            height: 10em;
            border-radius: 5em;
            overflow: hidden;
            isolation: isolate;
            box-shadow: 0 -0.3em 0.2em 0.1em rgba(0, 0, 0, 0.2), 0 0.3em 0.2em 0.1em rgb(255, 254, 255);
        }

        .daynight__checkbox {
            appearance: none;
            pointer-events: none;
            margin: 0;
            padding: 0;
            outline: none;
            border: none;
            background: none;
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            border-radius: inherit;
            box-shadow: inset 0 0.5em 0.5em 0 rgba(0, 0, 0, 0.5), inset 0 -0.5em 1em 0 rgba(0, 0, 0, 0.3);
            z-index: 2;
        }

        .daynight__sky {
            display: block;
            width: 100%;
            height: 100%;
            padding: 1em;
            box-sizing: border-box;
            background-color: #397ab0;
            transition: background 1s cubic-bezier(0.65, 0, 0.34, 1.17);
            isolation: isolate;
            position: relative;
        }

        .daynight__sky::before,
        .daynight__sky::after {
            content: "";
            position: absolute;
            z-index: 2;
            border-radius: 50%;
            width: 9em;
            height: 9em;
            left: 30.7em;
            top: 1.4em;
            transition: 1s cubic-bezier(0.65, 0, 0.34, 1.17);
            box-shadow: -10em 0 0 0 #fff, -12.7em 2.5em 0 -1em #fff, -16.5em 5.8em 0 0 #fff, -20em 5.7em 0 -1em #fff, -23.5em 5em 0 -1.2em #fff, -28em 5.5em 0 -1em #fff, -31em 7.5em 0 0 #fff, 9em 1em 0 0 #fff;
            animation: clouds 10s infinite cubic-bezier(0.65, 0, 0.35, 1);
        }

        .daynight__sky::before {
            z-index: -1;
            box-shadow: -10.5em -2.2em 0 0 #a5c5dc, -15em 0em 0 -2em #a5c5dc, -17.5em 1.8em 0 -1em #a5c5dc, -20.5em 4.6em 0 0 #a5c5dc, -24.5em 4.2em 0 0 #a5c5dc, -28.5em 5.8em 0 0 #a5c5dc, -31.5em 6.5em 0 0 #a5c5dc;
            animation-delay: -5s;
            animation-duration: 8s;
        }

        .daynight__checkbox:checked ~ .daynight__sky {
            background-color: #1c202c;
        }

        .daynight__checkbox:checked ~ .daynight__sky::before {
            transform: translateY(13em);
            opacity: 0;
        }

        .daynight__checkbox:checked ~ .daynight__sky::after {
            transform: translateY(10em);
            opacity: 0;
        }

        .daynight__stars,
        .daynight__morestars {
            transition: 1s cubic-bezier(0.65, 0, 0.34, 1.17);
            position: absolute;
        }

        .daynight__stars::before,
        .daynight__stars::after,
        .daynight__morestars::before,
        .daynight__morestars::after {
            content: "✦";
            position: absolute;
            font-size: 1.35em;
            color: #fff;
            opacity: 0;
            transform: translateY(-15em);
            transition: 1s cubic-bezier(0.65, 0, 0.34, 1.17);
            animation: stars 7s infinite;
        }

        .daynight__checkbox:checked ~ * .daynight__stars::before,
        .daynight__checkbox:checked ~ * .daynight__stars::after,
        .daynight__checkbox:checked ~ * .daynight__morestars::before,
        .daynight__checkbox:checked ~ * .daynight__morestars::after {
            opacity: 1;
            transform: translateY(0);
        }

        .daynight__stars::before {
            left: 3.8em;
            top: 0.8em;
            text-shadow: 6.1em 1.1em;
        }

        .daynight__stars::after {
            font-size: 1em;
            left: 11em;
            top: 6.8em;
            animation-duration: 9.1s;
            animation-delay: -2.8s;
        }

        .daynight__morestars::before {
            font-size: 0.6em;
            left: 4.9em;
            top: 5.2em;
            text-shadow: 4.5em 1.9em, 13.1em -0.8em, 16.8em 4.4em, 4.5em 8.7em;
            animation-duration: 5.6s;
            animation-delay: -7s;
        }

        .daynight__morestars::after {
            font-size: 0.4em;
            left: 8em;
            top: 19.6em;
            text-shadow: 1.5em -2.1em, 16.7em -7.1em;
            animation-duration: 11.2s;
            animation-delay: -1.4s;
        }

        .daynight__sunmoon {
            content: "";
            overflow: hidden;
            display: block;
            position: absolute;
            width: 8em;
            height: 8em;
            border-radius: 50%;
            transition: transform 1s cubic-bezier(0.65, 0, 0.34, 1.17);
            background-color: #f2c426;
            box-shadow: 0.4em 0.4em 0.5em 0.1em rgba(0, 0, 0, 0.3), inset -0.2em -0.2em 0.5em 0 rgba(0, 0, 0, 0.4), inset 0.2em 0.2em 0.5em 0 rgb(255, 254, 255), 0 0 0 10em rgba(255, 255, 255, 0.07), 0 0 0 6.5em rgba(255, 255, 255, 0.07), 0 0 0 3em rgba(255, 255, 255, 0.07);
            left: 3em;
            top: 1em;
        }

        .daynight__sunmoon::before {
            content: "";
            overflow: hidden;
            display: block;
            position: relative;
            width: 8em;
            height: 8em;
            border-radius: 50%;
            transition: 1s cubic-bezier(0.65, 0, 0.34, 1.17);
            box-shadow: 0.4em 0.4em 0.5em 0.1em rgba(0, 0, 0, 0.3), inset -0.2em -0.2em 0.5em 0 rgba(0, 0, 0, 0.4), inset 0.2em 0.2em 0.5em 0 rgb(255, 254, 255);
            background: radial-gradient(circle, rgba(150, 157, 176, 1) 1.1em, rgba(121, 128, 144, 1) 1.3em, rgba(129, 136, 153, 0) 1.4em), radial-gradient(circle, rgb(150, 157, 176) 0.5em, rgb(121, 128, 144) 0.7em, rgba(129, 136, 153, 0) 0.8em), radial-gradient(circle, rgb(150, 157, 176) 0.5em, rgb(121, 128, 144) 0.7em, rgba(129, 136, 153, 0) 0.8em);
            background-position: -1.2em 0.7em, 0em -2em, 2em 1.4em;
            background-color: #c5c8cf;
            transform: translateX(105%) rotate(50deg);
            animation: moon 25s infinite linear;
        }

        .daynight__checkbox:checked ~ .daynight__sky .daynight__sunmoon {
            transform: translateX(15em);
        }

        .daynight__checkbox:checked ~ .daynight__sky .daynight__sunmoon::before {
            transform: translateX(0) rotate(0);
        }

        @keyframes stars {
            0% { opacity: 1; }
            50% { opacity: 0.3; }
            100% { opacity: 1; }
        }

        @keyframes clouds {
            0% { scale: 1; }
            50% { scale: 1.05; }
            100% { scale: 1; }
        }

        @keyframes moon {
            to { background-position: 6.8em 0.7em, 8em -2em, 10em 1.4em; }
        }
    </style>
</head>
<body>
    <!-- Splash Screen with WebGL Particle Animation -->
    <div class="splash-screen">
        <video id="splash-video" autoplay muted playsinline style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
            <source src="{{ asset('images/particules.mp4') }}" type="video/mp4">
            <source src="{{ asset('images/particules.mov') }}" type="video/quicktime">
        </video>
    </div>

    <header class="site">
        <nav class="nav" role="navigation" aria-label="Navigation principale">
            <a href="{{ path('app_home') }}" class="logo" aria-label="Sirius-Solar - Accueil">
                <span class="logo-mark" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                </span>
                Sirius-Solar
            </a>

            <!-- Menu desktop -->
            <div class="nav-links" id="nav-desktop" role="navigation" aria-label="Menu principal">
                <a href="{{ path('app_home') }}#services" title="Voir nos services">{{ 'nav.services'|trans }}</a>
                <a href="{{ path('app_home') }}#avantages" title="Voir nos avantages">{{ 'nav.why_us'|trans }}</a>
                <a href="{{ path('app_devis') }}" title="Demander un devis">{{ 'nav.quote'|trans }}</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}" title="Tableau de bord administrateur">{{ 'nav.admin'|trans }}</a>
                {% elseif is_granted('ROLE_MEMBER') %}
                    <a href="{{ path('app_member_dashboard') }}" title="Mon espace">{{ 'nav.member_area'|trans }}</a>
                {% endif %}
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <a href="{{ path('app_logout') }}" title="Se déconnecter">{{ 'nav.logout'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_login') }}" title="Se connecter">{{ 'nav.login'|trans }}</a>
                {% endif %}
            </div>

            <!-- Language switcher et CTA -->
            <div class="lang-switch">
                <a href="{{ path('app_locale_switch', {locale: 'fr'}) }}" class="{{ app.request.locale == 'fr' ? '-active' : '' }}" title="Français">FR</a>
                <a href="{{ path('app_locale_switch', {locale: 'en'}) }}" class="{{ app.request.locale == 'en' ? '-active' : '' }}" title="English">EN</a>
            </div>

            <a href="{{ path('app_devis') }}" class="btn btn-primary" style="font-size:0.9rem; padding:10px 20px;">{{ 'nav.free_quote'|trans }}</a>

            <!-- Dark mode toggle - MEGASWITCHER -->
            <label class="daynight theme-toggle">
                <input type="checkbox" class="daynight__checkbox">
                <span class="daynight__sky">
                    <span class="daynight__stars"></span>
                    <span class="daynight__morestars"></span>
                    <span class="daynight__sunmoon"></span>
                </span>
            </label>

            <!-- Circular Burger Menu -->
            <div class="burger-container">
                <div class="bars" id="nav-action">
                    <span class="bar"></span>
                </div>
            </div>
        </nav>

        <!-- Circular Navigation Menu -->
        <nav id="nav-circular" role="navigation" aria-label="Menu circulaire mobile">
            <ul>
                <li class="shape-circle circle-one">
                    <a href="{{ path('app_home') }}#services">{{ 'nav.services'|trans }}</a>
                </li>
                <li class="shape-circle circle-two">
                    <a href="{{ path('app_home') }}#avantages">{{ 'nav.why_us'|trans }}</a>
                </li>
                <li class="shape-circle circle-three">
                    <a href="{{ path('app_devis') }}">{{ 'nav.quote'|trans }}</a>
                </li>
                <li class="shape-circle circle-five">
                    <a href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a>
                </li>
            </ul>
        </nav>

        <!-- Menu mobile -->
        <div class="mobile-menu" id="mobile-menu" role="navigation" aria-label="Menu mobile">
            <div class="mobile-menu-content">
                <a href="{{ path('app_home') }}" class="mobile-menu-link">{{ 'nav.home'|trans }}</a>
                <a href="{{ path('app_home') }}#services" class="mobile-menu-link">{{ 'nav.services'|trans }}</a>
                <a href="{{ path('app_home') }}#avantages" class="mobile-menu-link">{{ 'nav.why_us'|trans }}</a>
                <a href="{{ path('app_devis') }}" class="mobile-menu-link">{{ 'nav.quote'|trans }}</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}" class="mobile-menu-link">{{ 'nav.admin'|trans }}</a>
                {% elseif is_granted('ROLE_MEMBER') %}
                    <a href="{{ path('app_member_dashboard') }}" class="mobile-menu-link">{{ 'nav.member_area'|trans }}</a>
                {% endif %}
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <a href="{{ path('app_logout') }}" class="mobile-menu-link">{{ 'nav.logout'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="mobile-menu-link">{{ 'nav.login'|trans }}</a>
                {% endif %}

                <div class="lang-switch">
                    <a href="{{ path('app_locale_switch', {locale: 'fr'}) }}" class="{{ app.request.locale == 'fr' ? '-active' : '' }}">FR</a>
                    <a href="{{ path('app_locale_switch', {locale: 'en'}) }}" class="{{ app.request.locale == 'en' ? '-active' : '' }}">EN</a>
                </div>
            </div>
        </div>
    </header>

    <main role="main">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} container" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}

        <div class="page-nav">
            {% block page_nav_prev %}{% endblock %}
            <div class="page-nav-spacer"></div>
            {% block page_nav_next %}{% endblock %}
        </div>
    </main>

    <!-- Back to top button -->
    <button class="back-to-top" aria-label="Retour en haut">↑</button>

    <footer class="site" role="contentinfo">
        <div class="container">
            <!-- About section -->
            <div style="text-align: center; grid-column: 1 / -1;">
                <h4>Sirius-Solar</h4>
                <p>Spécialiste du nettoyage & entretien de panneaux photovoltaïques depuis 2020.</p>
                <p style="font-size: 0.8rem; margin-top: var(--space-md); color: rgba(255,255,255,0.5);">
                    "Un panneau propre, un rendement optimal!"
                </p>
            </div>

            <!-- Navigation links -->
            <div>
                <h4>Navigation</h4>
                <p><a href="{{ path('app_home') }}">Accueil</a></p>
                <p><a href="{{ path('app_home') }}#pillars">Nos Engagements</a></p>
                <p><a href="{{ path('app_devis') }}">Devis Gratuit</a></p>
                <p><a href="{{ path('app_login') }}">Connexion</a></p>
            </div>

            <!-- Contact Info -->
            <div>
                <h4>Contact</h4>
