{% extends 'base.html.twig' %}

{% block title %}Blog - Réalisations Sirius-Solar{% endblock %}

{% block body %}

<style>
    .gooey-navbar { display: flex !important; visibility: visible !important; height: 80px !important; margin: 0 !important; padding: 0 40px !important; }
    .circular-nav-container { display: none !important; visibility: hidden !important; height: 0 !important; width: 0 !important; }

    .back-button-wrapper {
        max-width: 1200px;
        margin: 40px auto 0;
        padding: 0 40px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        background: linear-gradient(135deg, rgba(10, 61, 53, 0.15), rgba(192, 192, 192, 0.15));
        border: 2px solid rgba(192, 192, 192, 0.5);
        color: rgba(192, 192, 192, 0.85);
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .back-btn:hover {
        background: linear-gradient(135deg, rgba(10, 61, 53, 0.25), rgba(192, 192, 192, 0.25));
        border-color: rgba(192, 192, 192, 0.7);
        color: #ffd700;
        transform: translateX(-3px);
    }

    .back-arrow {
        font-size: 16px;
        transition: transform 0.3s ease;
    }

    .back-btn:hover .back-arrow {
        transform: translateX(-2px);
    }

    .blog-hero {
        background: linear-gradient(135deg, #003d5c 0%, #1a6b8f 40%, #2a9cc0 60%, #3d7ba0 100%);
        padding: 80px 40px;
        text-align: center;
        color: white;
    }

    .blog-hero h1 {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 20px;
        font-family: 'Space Grotesk', sans-serif;
    }

    .blog-hero p {
        font-size: 18px;
        opacity: 0.9;
        max-width: 600px;
        margin: 0 auto;
    }

    .blog-container {
        max-width: 1200px;
        margin: 60px auto;
        padding: 0 40px;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 40px;
        margin-bottom: 60px;
    }

    .project-card {
        background: rgba(2, 12, 20, 0.7);
        border-radius: 15px;
        overflow: hidden;
        border: 2px solid rgba(0, 212, 255, 0.7);
        box-shadow: 0 0 24px rgba(0, 212, 255, 0.3), inset 0 0 16px rgba(0, 212, 255, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        cursor: pointer;
    }

    .project-card:hover {
        transform: translateY(-10px);
        border-color: #00d4ff;
        box-shadow: 0 20px 60px rgba(0, 212, 255, 0.4), inset 0 0 20px rgba(0, 212, 255, 0.12);
    }

    .project-images {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 250px;
        background: #f0f0f0;
        position: relative;
    }

    .project-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: relative;
    }

    .image-label {
        position: absolute;
        top: 10px;
        font-size: 12px;
        font-weight: 600;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        z-index: 2;
    }

    .before-label {
        left: 5px;
    }

    .after-label {
        right: 5px;
    }

    .project-content {
        padding: 30px;
    }

    .project-title {
        font-size: 22px;
        font-weight: 700;
        color: #00d4ff;
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
        margin-bottom: 10px;
        font-family: 'Space Grotesk', sans-serif;
    }

    .project-description {
        font-size: 14px;
        color: rgba(0, 212, 255, 0.8);
        margin-bottom: 15px;
        line-height: 1.6;
    }

    .project-meta {
        display: flex;
        gap: 20px;
        font-size: 13px;
        color: rgba(0, 212, 255, 0.7);
        margin-bottom: 20px;
        border-top: 1px solid rgba(0, 212, 255, 0.25);
        padding-top: 15px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 5px;
        text-shadow: 0 0 6px rgba(0, 212, 255, 0.35);
    }

    .project-badge {
        display: inline-block;
        background: linear-gradient(135deg, #00d4ff 0%, #0099cc 100%);
        color: #021018;
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        box-shadow: 0 4px 16px rgba(0, 212, 255, 0.4);
    }

    .empty-state {
        text-align: center;
        padding: 60px 40px;
        color: #999;
    }

    .empty-state-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }

    .empty-state h3 {
        font-size: 24px;
        color: #0A3D35;
        margin-bottom: 10px;
    }

    .project-images svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    .project-images > div:first-child {
        background: linear-gradient(135deg, #4a4a4a 0%, #666 50%, #505050 100%);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #999;
        font-weight: bold;
        font-size: 18px;
    }

    .project-images > div:last-child {
        background: linear-gradient(135deg, #0066cc 0%, #1e90ff 50%, #0099ff 100%);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #87ceeb;
        font-weight: bold;
        font-size: 18px;
    }

    /* Dark mode */
    body.dark-mode .project-card {
        background: #1a1a1a;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    body.dark-mode .project-title {
        color: #a8a8a8;
    }

    body.dark-mode .project-description {
        color: #ccc;
    }

    body.dark-mode .project-meta {
        color: #999;
        border-top-color: #333;
    }

    /* Mobile */
    @media (max-width: 768px) {
        .blog-hero {
            padding: 50px 20px;
        }

        .blog-hero h1 {
            font-size: 32px;
        }

        .blog-container {
            padding: 0 20px;
        }

        .projects-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .project-content {
            padding: 20px;
        }
    }
    .realisations-h1 {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .scramble-blue {
        display: inline-block;
        min-height: 1.1em;
        color: #00eaff;
        font-family: 'Bebas Neue', 'Space Grotesk', sans-serif;
        letter-spacing: 0.03em;
        text-shadow: 0 0 16px rgba(0, 234, 255, 0.6), 0 0 40px rgba(0, 234, 255, 0.25);
    }

    .scramble-blue .char {
        display: inline-block;
    }

    .scramble-blue .char.glitch {
        color: rgba(0, 234, 255, 0.5);
        animation: realisationsFlicker 0.08s steps(1) infinite;
    }

    @keyframes realisationsFlicker {
        0%, 100% { opacity: 1; }
        50%      { opacity: 0.4; }
    }
</style>

<!-- Back Button -->
<div class="back-button-wrapper">
    <a href="{{ path('app_home') }}" class="back-btn">
        <span class="back-arrow">←</span>
        Retour à l'accueil
    </a>
</div>

<section class="blog-hero">
    <h1 class="realisations-h1"><span class="realisations-emoji">🏆</span> <span class="scramble-blue" id="realisationsScramble" data-text="Nos Réalisations"></span></h1>
    <p>Découvrez nos derniers projets de nettoyage de panneaux solaires avec résultats avant/après</p>
</section>

<section class="blog-container">
