                                    <stop offset="50%" style="stop-color:#0066cc;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#0052a3;stop-opacity:1" />
                                </linearGradient>
                                <linearGradient id="shine" x1="0%" y1="0%" x2="100%" y2="100%">
