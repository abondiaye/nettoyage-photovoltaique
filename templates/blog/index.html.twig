                            <rect x="62" y="132" width="86" height="66" fill="url(#shine)" opacity="0.6"/>
                            <line x1="60" y1="155" x2="150" y2="155" stroke="#87ceeb" stroke-width="2" opacity="0.5"/>
                            <line x1="60" y1="175" x2="150" y2="175" stroke="#87ceeb" stroke-width="2" opacity="0.5"/>
                            <!-- Reflets -->
                            <circle cx="80" cy="145" r="4" fill="#ffffff" opacity="0.7"/>
                            <circle cx="130" cy="160" r="3" fill="#ffffff" opacity="0.6"/>

                            <!-- Panneau 2 (propre) -->
                            <rect x="175" y="140" width="90" height="70" fill="url(#panelGradient)" stroke="#0052a3" stroke-width="2"/>
                            <rect x="177" y="142" width="86" height="66" fill="url(#shine)" opacity="0.6"/>
                            <line x1="175" y1="165" x2="265" y2="165" stroke="#87ceeb" stroke-width="2" opacity="0.5"/>
                            <line x1="175" y1="185" x2="265" y2="185" stroke="#87ceeb" stroke-width="2" opacity="0.5"/>
                            <!-- Reflets -->
                            <circle cx="200" cy="150" r="4" fill="#ffffff" opacity="0.7"/>
                            <circle cx="245" cy="175" r="3" fill="#ffffff" opacity="0.6"/>

                            <!-- Panneau 3 (propre et brillant) -->
                            <rect x="290" y="135" width="90" height="70" fill="url(#panelGradient)" stroke="#0052a3" stroke-width="2"/>
                            <rect x="292" y="137" width="86" height="66" fill="url(#shine)" opacity="0.6"/>
                            <line x1="290" y1="160" x2="380" y2="160" stroke="#87ceeb" stroke-width="2" opacity="0.5"/>
                            <line x1="290" y1="180" x2="380" y2="180" stroke="#87ceeb" stroke-width="2" opacity="0.5"/>
                            <!-- Reflets -->
                            <circle cx="315" cy="148" r="4" fill="#ffffff" opacity="0.7"/>
                            <circle cx="360" cy="165" r="3" fill="#ffffff" opacity="0.6"/>

