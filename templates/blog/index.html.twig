                <div class="project-images">
                    <div style="position: relative; width: 100%; height: 100%;">
                        <svg preserveAspectRatio="xMidYMid slice" viewBox="0 0 500 350" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 100%; display: block; background: #e8e8e8;">
                            <!-- Ciel -->
                            <rect fill="#b0c4de" width="500" height="180"/>
                            <!-- Terrain -->
                            <rect fill="#8b7355" y="180" width="500" height="170"/>
                            <!-- Toit -->
                            <polygon points="50,180 450,180 480,120 20,120" fill="#a52a2a"/>

                            <!-- Panneau 1 (très sale) -->
                            <rect x="60" y="130" width="90" height="70" fill="#3a3a3a" stroke="#1a1a1a" stroke-width="2"/>
                            <line x1="60" y1="155" x2="150" y2="155" stroke="#555" stroke-width="1.5" opacity="0.6"/>
                            <line x1="60" y1="175" x2="150" y2="175" stroke="#555" stroke-width="1.5" opacity="0.6"/>
                            <!-- Poussière panneau 1 -->
                            <circle cx="85" cy="145" r="6" fill="#999" opacity="0.7"/>
                            <circle cx="125" cy="160" r="5" fill="#aaa" opacity="0.6"/>
                            <circle cx="100" cy="175" r="7" fill="#999" opacity="0.7"/>
                            <ellipse cx="80" cy="170" rx="8" ry="4" fill="#888" opacity="0.5"/>

                            <!-- Panneau 2 (sale) -->
                            <rect x="175" y="140" width="90" height="70" fill="#424242" stroke="#1a1a1a" stroke-width="2"/>
                            <line x1="175" y1="165" x2="265" y2="165" stroke="#666" stroke-width="1.5" opacity="0.6"/>
                            <line x1="175" y1="185" x2="265" y2="185" stroke="#666" stroke-width="1.5" opacity="0.6"/>
                            <!-- Poussière panneau 2 -->
                            <circle cx="195" cy="150" r="7" fill="#aaa" opacity="0.7"/>
                            <circle cx="240" cy="170" r="6" fill="#999" opacity="0.6"/>
                            <rect x="200" y="175" width="12" height="8" fill="#888" opacity="0.5"/>

                            <!-- Panneau 3 (très sale) -->
                            <rect x="290" y="135" width="90" height="70" fill="#383838" stroke="#1a1a1a" stroke-width="2"/>
                            <line x1="290" y1="160" x2="380" y2="160" stroke="#555" stroke-width="1.5" opacity="0.6"/>
                            <line x1="290" y1="180" x2="380" y2="180" stroke="#555" stroke-width="1.5" opacity="0.6"/>
                            <!-- Poussière panneau 3 -->
                            <circle cx="310" cy="148" r="8" fill="#aaa" opacity="0.7"/>
                            <circle cx="355" cy="155" r="6" fill="#999" opacity="0.6"/>
                            <circle cx="330" cy="175" r="7" fill="#999" opacity="0.7"/>
                            <ellipse cx="365" cy="180" rx="10" ry="5" fill="#888" opacity="0.5"/>

                            <!-- Traces de pluie/saleté -->
                            <path d="M 70 135 Q 72 145 70 155" stroke="#666" stroke-width="1" opacity="0.4" fill="none"/>
                            <path d="M 200 140 Q 202 155 200 170" stroke="#777" stroke-width="1" opacity="0.4" fill="none"/>
                            <path d="M 320 140 Q 318 160 320 180" stroke="#666" stroke-width="1" opacity="0.4" fill="none"/>

                            <!-- Texte -->
                            <text x="250" y="320" font-size="24" font-weight="bold" text-anchor="middle" fill="#666">PANNEAUX ENCRASSÉS ❌</text>
                            <text x="250" y="345" font-size="14" text-anchor="middle" fill="#888">Rendement réduit de 25-30%</text>
                        </svg>
                        <span class="image-label before-label">AVANT</span>
                    </div>
                    <div style="position: relative; width: 100%; height: 100%;">
                        <svg preserveAspectRatio="xMidYMid slice" viewBox="0 0 500 350" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 100%; display: block; background: #e8f4ff;">
