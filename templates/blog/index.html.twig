                    <span class="project-badge">✨ +25% Rendement</span>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>
</section>

<script>
(function () {
    var CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*!?/\\|<>';

    function realRand(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
    }

    function realScramble(el, finalText) {
        return new Promise(function (resolve) {
            var chars = finalText.split('').map(function (ch, i) {
                return {
                    char: ch,
                    done: ch === ' ',
                    iterations: Math.floor(Math.random() * 8) + i * 2
                };
            });

            el.innerHTML = chars.map(function (c, i) {
                return c.char === ' '
                    ? '<span class="char">&nbsp;</span>'
                    : '<span class="char glitch" data-i="' + i + '">' + realRand(CHARS) + '</span>';
            }).join('');

            var spans = el.querySelectorAll('.char');
            var frame = 0;

            var tick = setInterval(function () {
                var allDone = true;
                chars.forEach(function (c, i) {
                    if (c.done) return;
                    if (frame >= c.iterations) {
                        spans[i].textContent = c.char;
                        spans[i].classList.remove('glitch');
                        c.done = true;
                    } else {
                        spans[i].textContent = realRand(CHARS);
                        allDone = false;
                    }
                });
                frame++;
                if (allDone) {
                    clearInterval(tick);
                    resolve();
                }
            }, 45);
        });
    }

    var target = document.getElementById('realisationsScramble');
    if (target) {
        realScramble(target, target.dataset.text);
    }
})();
</script>

{% endblock %}
