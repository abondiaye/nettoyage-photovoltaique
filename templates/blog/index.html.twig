            ➕ Ajouter une Réalisation
        </a>
    </div>
    {% endif %}

    {% set example_projects = [
        {
            title: 'Rénovation Complète - Cheseaux-sur-Lausanne',
            description: 'Installation de 8kW entièrement nettoyée et optimisée. Résultats impressionnants avec augmentation du rendement de 28%.',
            location: 'Cheseaux-sur-Lausanne',
            date: '2024-09-10',
            image_before: 'https://images.unsplash.com/photo-1509644851169-569e0def3610?w=600&h=400&fit=crop',
            image_after: 'https://images.unsplash.com/photo-1634236500000-cfd2b8a77d7d?w=600&h=400&fit=crop'
        },
        {
            title: 'Maintenance Préventive - Lausanne',
            description: 'Nettoyage régulier de panneaux résidentiels. Prévention de la dégradation et maintien de l\'efficacité maximale.',
            location: 'Lausanne',
            date: '2024-09-05',
            image_before: 'https://images.unsplash.com/photo-1617127365659-c0fb4e0b6610?w=600&h=400&fit=crop',
            image_after: 'https://images.unsplash.com/photo-1497440991519-91fde9c0e159?w=600&h=400&fit=crop'
        },
        {
            title: 'Grand Projet Commercial - Région Lausanne',
            description: 'Nettoyage de panneaux solaires commerciaux de 50kW. Utilisation d\'eau osmosée pour résultat impeccable.',
            location: 'Région Lausannoise',
            date: '2024-08-28',
            image_before: 'https://images.unsplash.com/photo-1497440912892-ffc7e6f4c383?w=600&h=400&fit=crop',
            image_after: 'https://images.unsplash.com/photo-1509391366360-2e938286db4c?w=600&h=400&fit=crop'
        }
    ] %}

    <div class="projects-grid">
        {% if projects is not empty %}
            {% for project in projects %}
            <div class="project-card">
                <div class="project-images">
                    <div style="position: relative;">
                        <img src="{% if project.image_before is defined %}{{ project.image_before }}{% else %}{{ project['image_before'] }}{% endif %}" alt="Avant" class="project-image">
                        <span class="image-label before-label">AVANT</span>
                    </div>
                    <div style="position: relative;">
                        <img src="{% if project.image_after is defined %}{{ project.image_after }}{% else %}{{ project['image_after'] }}{% endif %}" alt="Après" class="project-image">
                        <span class="image-label after-label">APRÈS</span>
                    </div>
                </div>
                <div class="project-content">
                    <h3 class="project-title">{% if project.title is defined %}{{ project.title }}{% else %}{{ project['title'] }}{% endif %}</h3>
                    <p class="project-description">{% if project.description is defined %}{{ project.description }}{% else %}{{ project['description'] }}{% endif %}</p>

                    <div class="project-meta">
                        <div class="meta-item">
                            📍 {% if project.location is defined %}{{ project.location }}{% else %}{{ project['location'] }}{% endif %}
                        </div>
                        <div class="meta-item">
                            📅 {% if project.date is defined %}
                                {% if project.date is iterable %}{{ project.date|date('d/m/Y') }}{% else %}{{ project.date }}{% endif %}
                            {% else %}{{ project['date'] }}{% endif %}
