{# Fond « liquid glass » (taches de couleur floues qui dérivent) + bloc « connexion / inscription »
   à panneau coulissant, aux couleurs du site (vert menthe #00ff9d, vert profond #0A3D35, jaune #ffd21f).
   Usage : {% include 'components/_auth3d.html.twig' %} puis un .auth-slide (voir login / register). #}
<div class="auth3d-bg" aria-hidden="true">
    <div class="auth3d-blob auth3d-blob--1"></div>
    <div class="auth3d-blob auth3d-blob--2"></div>
    <div class="auth3d-blob auth3d-blob--3"></div>
</div>

<style>
    body { background: #020a07; }
    body:has(.auth3d) footer,
    body:has(.auth3d) .circular-nav-container { display: none !important; }

    .auth3d-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        background: #04100c;
    }
    .auth3d-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.55;
        animation: auth3dDrift linear infinite;
    }
    .auth3d-blob--1 { width: 520px; height: 520px; background: #00c77a; top: -15%; left: -8%; animation-duration: 22s; }
    .auth3d-blob--2 { width: 460px; height: 460px; background: #0b5d8a; bottom: -12%; right: -2%; animation-duration: 28s; animation-direction: reverse; }
    .auth3d-blob--3 { width: 380px; height: 380px; background: #d9a800; top: 50%; left: 42%; opacity: 0.35; animation-duration: 34s; animation-delay: -10s; }
    @keyframes auth3dDrift {
        0%   { transform: translate(0, 0) scale(1); }
        33%  { transform: translate(40px, -40px) scale(1.06); }
        66%  { transform: translate(-30px, 25px) scale(0.94); }
        100% { transform: translate(0, 0) scale(1); }
    }

    .auth3d {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 100px 16px 40px;
        perspective: 1200px;
    }

    /* ---- The card ---- */
    .auth-slide {
        --mint: #00ff9d;
        --deep: #0A3D35;
        position: relative;
        width: min(900px, 100%);
        min-height: 600px;
        border-radius: 22px;
        overflow: hidden;
        /* Liquid glass: very transparent, strongly blurred, light rim. */
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(24px) saturate(180%);
        -webkit-backdrop-filter: blur(24px) saturate(180%);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.18);
        color: #fff;
        transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(var(--s, 1));
        transition: transform 0.12s ease-out;
        will-change: transform;
    }
    /* Light that follows the mouse across the glass. */
    .auth-slide::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 4;
        border-radius: inherit;
        background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.12) 0%, transparent 60%);
        opacity: 0;
        transition: opacity 0.4s;
        pointer-events: none;
    }
    .auth-slide:hover::before { opacity: 1; }
    /* Specular line on the top edge. */
    .auth-slide::after {
        content: '';
        position: absolute;
        top: 0;
        left: 10%;
        right: 10%;
        height: 1px;
        z-index: 4;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        pointer-events: none;
    }

    .auth-slide.is-register { min-height: 690px; }

    /* Green panel (welcome) : on the left for login, on the right for sign-up. */
    .auth-slide__welcome {
        position: absolute;
        top: 0;
        left: 0;
        width: 45%;
        height: 100%;
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 36px;
        text-align: center;
        background: linear-gradient(135deg, rgba(10, 61, 53, 0.78) 0%, rgba(0, 168, 107, 0.6) 70%, rgba(0, 255, 157, 0.45) 140%);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-radius: 22px 220px 220px 22px;
        box-shadow: 10px 0 30px rgba(0, 0, 0, 0.35), inset 5px 5px 25px rgba(255, 255, 255, 0.18),
                    inset -5px -5px 15px rgba(0, 0, 0, 0.25);
        transition: left 0.75s cubic-bezier(0.68, -0.55, 0.265, 1.55), border-radius 0.75s ease;
    }
    .auth-slide__welcome::before {
        content: '';
        position: absolute;
        inset: -50%;
        background: radial-gradient(ellipse at top left, rgba(255, 255, 255, 0.16), transparent 45%);
        pointer-events: none;
    }
    .auth-slide__form {
        position: absolute;
        top: 0;
        right: 0;
        width: 55%;
        height: 100%;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 56px;
        transition: right 0.75s cubic-bezier(0.68, -0.55, 0.265, 1.55), opacity 0.4s ease;
    }

    .auth-slide.is-register .auth-slide__welcome { left: 55%; border-radius: 220px 22px 22px 220px; }
    .auth-slide.is-register .auth-slide__welcome::before { background: radial-gradient(ellipse at top right, rgba(255, 255, 255, 0.16), transparent 45%); }
    .auth-slide.is-register .auth-slide__form { right: 45%; }

    /* Leaving towards the other page: the panel slides across, the form fades. */
    .auth-slide.is-leaving .auth-slide__form { opacity: 0; }
    .auth-slide.no-anim * { transition: none !important; }

    .auth-slide__welcome h2 {
        position: relative;
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 800;
        text-shadow: 0 4px 12px rgba(0, 0, 0, 0.35);
    }
    .auth-slide__welcome p { position: relative; margin: 0 0 26px; font-size: 15px; color: rgba(255, 255, 255, 0.9); }
    .auth-slide__toggle {
        position: relative;
        display: inline-block;
        padding: 11px 40px;
        border-radius: 12px;
        border: 1.5px solid rgba(255, 255, 255, 0.55);
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        backdrop-filter: blur(8px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.25), inset 0 2px 2px rgba(255, 255, 255, 0.35);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), background 0.3s ease, color 0.3s ease;
    }
    .auth-slide__toggle:hover { background: #fff; color: var(--deep); transform: translateY(-4px); }

    .auth-slide__brand {
        margin: 0 0 6px;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: 0.06em;
        color: var(--mint);
        text-shadow: 0 0 12px rgba(0, 255, 157, 0.5);
    }
    .auth-slide__sub { margin: 0 0 26px; font-size: 14px; color: rgba(255, 255, 255, 0.7); }

    .auth-slide form { width: 100%; max-width: 340px; }

    .auth3d-field { position: relative; margin-bottom: 16px; text-align: left; }
    .auth3d-field label,
    .auth3d-field .form-label {
        display: block;
        margin-bottom: 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--mint);
    }
    .auth3d-field input {
        width: 100%;
        padding: 13px 16px;
        border-radius: 12px;
        border: 1px solid rgba(0, 255, 157, 0.2);
        background: rgba(0, 0, 0, 0.35);
        color: #fff;
        font-size: 16px; /* 16px: iOS does not zoom on focus */
        outline: none;
        box-shadow: inset 3px 3px 8px rgba(0, 0, 0, 0.45), inset -2px -2px 6px rgba(0, 255, 157, 0.05);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .auth3d-field input::placeholder { color: rgba(255, 255, 255, 0.35); }
    .auth3d-field input:focus {
        background: rgba(0, 0, 0, 0.5);
        border-color: var(--mint);
        box-shadow: 0 0 0 3px rgba(0, 255, 157, 0.15), 0 0 18px rgba(0, 255, 157, 0.2);
    }
    .auth3d-field ul { margin: 6px 0 0; padding: 0; list-style: none; color: #ff9b9b; font-size: 13px; }

    .auth3d-forgot { display: block; margin: -4px 0 18px; text-align: right; font-size: 13px; color: rgba(255, 255, 255, 0.7); text-decoration: none; }
    .auth3d-forgot:hover { color: var(--mint); }

    .auth3d-btn {
        width: 100%;
        margin-top: 6px;
        padding: 14px;
        border: 0;
        border-radius: 12px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, var(--deep) 0%, #00a86b 60%, var(--mint) 140%);
        box-shadow: 0 10px 20px rgba(0, 255, 157, 0.2), inset 0 2px 0 rgba(255, 255, 255, 0.35), inset 0 -3px 0 rgba(0, 0, 0, 0.2);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    }
    .auth3d-btn:hover { transform: translateY(-4px); box-shadow: 0 15px 28px rgba(0, 255, 157, 0.35), inset 0 2px 0 rgba(255, 255, 255, 0.45); }
    .auth3d-btn:active { transform: translateY(2px); }

    .auth3d-alert { width: 100%; max-width: 340px; margin: 0 0 16px; padding: 11px 14px; border-radius: 10px; font-size: 14px; text-align: left; }
    .auth3d-alert ul { margin: 0; padding: 0; list-style: none; }
    .auth3d-alert--error { background: rgba(255, 60, 60, 0.12); border: 1px solid rgba(255, 90, 90, 0.4); color: #ffb3b3; }
    .auth3d-alert--success { background: rgba(0, 255, 157, 0.1); border: 1px solid rgba(0, 255, 157, 0.4); color: #bfffe4; }

    /* ---- Phone : welcome band on top, form below, no sliding ---- */
    @media (max-width: 760px) {
        .auth3d { padding-top: 84px; align-items: flex-start; }
        .auth-slide { min-height: 0; display: flex; flex-direction: column; transform: none; }
        .auth3d-blob { filter: blur(70px); }
        .auth-slide__welcome,
        .auth-slide.is-register .auth-slide__welcome {
            position: relative;
            left: auto;
            width: 100%;
            height: auto;
            padding: 30px 20px 34px;
            border-radius: 0 0 50% 50% / 0 0 40px 40px;
        }
        .auth-slide__welcome h2 { font-size: 24px; }
        .auth-slide__welcome p { margin-bottom: 16px; }
        .auth-slide__form,
        .auth-slide.is-register .auth-slide__form {
            position: relative;
            right: auto;
            width: 100%;
            height: auto;
            padding: 26px 20px 30px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .auth-slide, .auth-slide * { transition: none !important; }
        .auth3d-blob { animation: none; }
    }
</style>

<script>
(function () {
    var card = document.querySelector('[data-auth-slide]');
    if (!card) return;
    var registerMode = card.classList.contains('is-register');
    var wide = function () { return window.matchMedia('(min-width: 761px)').matches; };

    // Arriving from the other page: start from the other side, then slide into place.
    try {
        if (sessionStorage.getItem('authSlide') === (registerMode ? 'to-register' : 'to-login') && wide()) {
            card.classList.add('no-anim');
            card.classList.toggle('is-register', !registerMode);
            card.getBoundingClientRect();
            card.classList.remove('no-anim');
            requestAnimationFrame(function () { card.classList.toggle('is-register', registerMode); });
        }
        sessionStorage.removeItem('authSlide');
    } catch (e) {}

    // Toggle button: slide across, then open the other page.
    var toggle = card.querySelector('.auth-slide__toggle');
    if (toggle) {
        toggle.addEventListener('click', function (e) {
            if (!wide()) return;
            e.preventDefault();
            try { sessionStorage.setItem('authSlide', registerMode ? 'to-login' : 'to-register'); } catch (err) {}
            card.classList.add('is-leaving');
            card.classList.toggle('is-register', !registerMode);
            setTimeout(function () { location.href = toggle.href; }, 650);
        });
    }

    // Liquid glass: the card tilts under the mouse and a light follows the pointer.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        card.addEventListener('pointermove', function (e) {
            var r = card.getBoundingClientRect();
            var x = (e.clientX - r.left) / r.width;
            var y = (e.clientY - r.top) / r.height;
            card.style.setProperty('--mx', (x * 100).toFixed(1) + '%');
            card.style.setProperty('--my', (y * 100).toFixed(1) + '%');
            if (!wide()) return;
            card.style.setProperty('--rx', ((y - 0.5) * -8).toFixed(2) + 'deg');
            card.style.setProperty('--ry', ((x - 0.5) * 8).toFixed(2) + 'deg');
            card.style.setProperty('--s', '1.01');
        });
        card.addEventListener('pointerleave', function () {
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--s', '1');
        });
    }
})();
</script>
