{# Circular Navigation Bar Component #}
<div class="circular-nav-wrapper">
    <button class="circular-nav-toggle" id="circularNavToggle" aria-label="Menu de navigation">
        <span class="toggle-icon">⚡</span>
    </button>

    <nav class="circular-nav-menu" id="circularNavMenu">
        <a href="{{ path('app_home') }}" class="circular-nav-item" data-index="0">
            <span class="nav-icon">🏠</span>
            <span class="nav-label">Accueil</span>
        </a>
        <a href="#processus" class="circular-nav-item" data-index="1">
            <span class="nav-icon">⚙️</span>
            <span class="nav-label">Processus</span>
        </a>
        <a href="#services" class="circular-nav-item" data-index="2">
            <span class="nav-icon">🔧</span>
            <span class="nav-label">Services</span>
        </a>
        <a href="#avantages" class="circular-nav-item" data-index="3">
            <span class="nav-icon">✨</span>
            <span class="nav-label">Avantages</span>
        </a>
        <a href="#contact" class="circular-nav-item" data-index="4">
            <span class="nav-icon">📞</span>
            <span class="nav-label">Contact</span>
        </a>
        {% if app.user %}
            <a href="{{ path('app_devis') }}" class="circular-nav-item" data-index="5" style="background: linear-gradient(135deg, var(--dore), var(--dore-clair));">
                <span class="nav-icon">📋</span>
                <span class="nav-label">Devis</span>
            </a>
        {% endif %}
    </nav>
</div>

<style>
    :root {
        --vert-fonce: #0A3D35;
        --vert-clair: #2D6B55;
        --dore: #a8a8a8;
        --dore-clair: #e8e8e8;
        --blanc: #FFFFFF;
    }

    .circular-nav-wrapper {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 9999;
    }

    .circular-nav-toggle {
        position: relative;
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        border: 3px solid var(--dore);
        color: var(--blanc);
        font-size: 32px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(10, 61, 53, 0.4);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1001;
    }

    .circular-nav-toggle:hover {
        transform: scale(1.1);
        box-shadow: 0 12px 32px rgba(10, 61, 53, 0.6);
    }

    .circular-nav-toggle.active {
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        color: var(--vert-fonce);
    }

    .toggle-icon {
        transition: transform 0.3s ease;
        display: inline-block;
    }

    .circular-nav-toggle.active .toggle-icon {
        transform: rotate(90deg);
    }

    .circular-nav-menu {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 70px;
        height: 70px;
        z-index: 1000;
    }

    .circular-nav-item {
        position: absolute;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(45, 107, 85, 0.95) 0%, rgba(10, 61, 53, 0.95) 100%);
        color: var(--blanc);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 24px;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        border: 2px solid var(--dore);
        box-shadow: 0 4px 16px rgba(10, 61, 53, 0.3);
        bottom: 5px;
        right: 5px;
        opacity: 0;
        visibility: hidden;
    }

    .circular-nav-item .nav-icon {
        font-size: 24px;
        transition: transform 0.3s ease;
    }

    .circular-nav-item .nav-label {
        font-size: 10px;
        text-align: center;
        margin-top: 2px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .circular-nav-menu.active .circular-nav-item {
        opacity: 1;
        visibility: visible;
    }

    /* Position items in a circle */
    .circular-nav-item[data-index="0"] {
        --angle: 0deg;
    }
    .circular-nav-item[data-index="1"] {
        --angle: 60deg;
    }
    .circular-nav-item[data-index="2"] {
        --angle: 120deg;
    }
    .circular-nav-item[data-index="3"] {
        --angle: 180deg;
    }
    .circular-nav-item[data-index="4"] {
        --angle: 240deg;
    }
    .circular-nav-item[data-index="5"] {
        --angle: 300deg;
    }

    .circular-nav-menu.active .circular-nav-item {
        bottom: calc(5px + 90px * sin(var(--angle)));
        right: calc(5px + 90px * (1 - cos(var(--angle))));
    }

    .circular-nav-item:hover {
        transform: scale(1.15);
        box-shadow: 0 8px 24px rgba(10, 61, 53, 0.5);
    }

    .circular-nav-item:hover .nav-icon {
        transform: scale(1.2) rotate(10deg);
    }

    @media (max-width: 768px) {
        .circular-nav-wrapper {
            bottom: 20px;
            right: 20px;
        }

        .circular-nav-toggle {
            width: 60px;
            height: 60px;
            font-size: 28px;
        }

        .circular-nav-item {
            width: 55px;
            height: 55px;
            font-size: 20px;
        }

        .circular-nav-menu.active .circular-nav-item {
            bottom: calc(5px + 80px * sin(var(--angle)));
            right: calc(5px + 80px * (1 - cos(var(--angle))));
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.getElementById('circularNavToggle');
        const menu = document.getElementById('circularNavMenu');
        const items = document.querySelectorAll('.circular-nav-item');

        toggle.addEventListener('click', function() {
            toggle.classList.toggle('active');
            menu.classList.toggle('active');
        });

        items.forEach(item => {
            item.addEventListener('click', function() {
                toggle.classList.remove('active');
                menu.classList.remove('active');
            });
        });

        // Close menu when clicking outside
        document.addEventListener('click', function(event) {
            if (!event.target.closest('.circular-nav-wrapper')) {
                toggle.classList.remove('active');
                menu.classList.remove('active');
            }
        });
    });
</script>
