{# Circular Navigation Bar - Hamburger Menu #}
<button class="hamburger" id="hamburger-menu" aria-label="Toggle menu">
    <span></span>
    <span></span>
    <span></span>
</button>

<nav class="nav-menu" id="nav-menu">
    <ul class="nav-list">
        <li><a href="{{ path('app_home') }}" class="nav-link">🏠 Accueil</a></li>
        <li><a href="#processus" class="nav-link">⚙️ Processus</a></li>
        <li><a href="#services" class="nav-link">🔧 Services</a></li>
        <li><a href="#avantages" class="nav-link">✨ Avantages</a></li>
        <li><a href="#contact" class="nav-link">📞 Contact</a></li>
        {% if app.user %}
        <li><a href="{{ path('app_devis') }}" class="nav-link nav-link-devis">📋 Devis</a></li>
        {% endif %}
    </ul>
</nav>

<style>
    :root {
        --vert-fonce: #0A3D35;
        --vert-clair: #2D6B55;
        --dore: #a8a8a8;
        --dore-clair: #e8e8e8;
        --blanc: #FFFFFF;
    }

    #hamburger-menu {
        position: fixed;
        top: 30px;
        right: 30px;
        width: 50px;
        height: 50px;
        background: transparent;
        border: 3px solid var(--dore);
        border-radius: 8px;
        cursor: pointer;
        z-index: 1001;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 6px;
        padding: 0;
        transition: all 0.3s ease;
    }

    #hamburger-menu:hover {
        background: rgba(168, 168, 168, 0.1);
        transform: scale(1.05);
    }

    #hamburger-menu span {
        display: block;
        width: 24px;
        height: 3px;
        background: var(--blanc);
        border-radius: 2px;
        transition: all 0.3s ease;
    }

    #hamburger-menu.active span:nth-child(1) {
        transform: rotate(45deg) translateY(12px);
    }

    #hamburger-menu.active span:nth-child(2) {
        opacity: 0;
    }

    #hamburger-menu.active span:nth-child(3) {
        transform: rotate(-45deg) translateY(-12px);
    }

    #nav-menu {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 61, 53, 0.95);
        backdrop-filter: blur(5px);
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    #nav-menu.active {
        opacity: 1;
        visibility: visible;
    }

    .nav-list {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        list-style: none;
        text-align: center;
        width: 100%;
    }

    .nav-list li {
        margin: 20px 0;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.3s ease;
    }

    #nav-menu.active .nav-list li {
        opacity: 1;
        transform: translateY(0);
    }

    #nav-menu.active .nav-list li:nth-child(1) { transition-delay: 0.1s; }
    #nav-menu.active .nav-list li:nth-child(2) { transition-delay: 0.2s; }
    #nav-menu.active .nav-list li:nth-child(3) { transition-delay: 0.3s; }
    #nav-menu.active .nav-list li:nth-child(4) { transition-delay: 0.4s; }
    #nav-menu.active .nav-list li:nth-child(5) { transition-delay: 0.5s; }
    #nav-menu.active .nav-list li:nth-child(6) { transition-delay: 0.6s; }

    .nav-link {
        display: inline-block;
        font-size: 24px;
        font-weight: 600;
        color: var(--blanc);
        text-decoration: none;
        padding: 12px 30px;
        border-radius: 50px;
        transition: all 0.3s ease;
    }

    .nav-link:hover {
        color: var(--dore-clair);
        background: rgba(168, 168, 168, 0.1);
    }

    .nav-link-devis {
        color: var(--dore-clair);
        font-weight: 700;
    }

    @media (max-width: 768px) {
        #hamburger-menu {
            top: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
        }

        .nav-link {
            font-size: 20px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const hamburger = document.getElementById('hamburger-menu');
        const navMenu = document.getElementById('nav-menu');
        const navLinks = document.querySelectorAll('.nav-link');

        if (hamburger && navMenu) {
            hamburger.addEventListener('click', function() {
                hamburger.classList.toggle('active');
                navMenu.classList.toggle('active');
            });

            navLinks.forEach(link => {
                link.addEventListener('click', function() {
                    hamburger.classList.remove('active');
                    navMenu.classList.remove('active');
                });
            });

            navMenu.addEventListener('click', function(e) {
                if (e.target === this) {
                    hamburger.classList.remove('active');
                    navMenu.classList.remove('active');
                }
            });
        }
    });
</script>
