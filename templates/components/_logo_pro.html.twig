{# Flat Sirius-Solar logo (the two-roller brush on its pole) for the "Pro" style.
   Colours come from CSS: --pl-a (accent), --pl-b (text/pole), --pl-hub. #}
<svg class="sirius-logo-pro" viewBox="-2 0 232 64" role="img" aria-label="Sirius-Solar">
    <line class="pl-pole" x1="22" y1="32" x2="214" y2="32" stroke-width="2.4" stroke-linecap="round"/>
    <g class="pl-pole" fill="none" stroke-width="1.6"><rect x="58" y="29.5" width="4" height="5" rx="1"/><rect x="118" y="29.5" width="4" height="5" rx="1"/><rect x="170" y="29.5" width="4" height="5" rx="1"/></g>
    <rect class="pl-mark" x="196" y="29" width="14" height="6" rx="3"/>
    <path class="pl-pole" d="M214 32 C219 28.5 224 29 225 32.5 C226 36 225 39 223.5 41" fill="none" stroke-width="2.4" stroke-linecap="round"/>
    <circle class="pl-roll" cx="15" cy="17" r="13.2" fill="none" stroke-width="3.6" stroke-dasharray="1.6 1.2"/>
    <circle class="pl-hub" cx="15" cy="17" r="10.4" stroke-width="1.3"/>
    <path class="pl-mark" d="M15 10.5 L16.4 15.6 L21.5 17 L16.4 18.4 L15 23.5 L13.6 18.4 L8.5 17 L13.6 15.6 Z" stroke-width="0"/>
    <circle class="pl-roll" cx="15" cy="47" r="13.2" fill="none" stroke-width="3.6" stroke-dasharray="1.6 1.2"/>
    <circle class="pl-hub" cx="15" cy="47" r="10.4" stroke-width="1.3"/>
    <circle class="pl-roll" cx="15" cy="47" r="3.6" fill="none" stroke-width="2"/>
    {# Round Swiss flags in the middle of the brushes #}
    <g class="ch-flag"><circle cx="15" cy="17" r="7.2" fill="#da291c" stroke="#ffffff" stroke-width="0.9"/><rect x="12.07" y="16.12" width="5.85" height="1.76" fill="#ffffff"/><rect x="14.12" y="14.07" width="1.76" height="5.85" fill="#ffffff"/></g>
    <g class="ch-flag"><circle cx="15" cy="47" r="7.2" fill="#da291c" stroke="#ffffff" stroke-width="0.9"/><rect x="12.07" y="46.12" width="5.85" height="1.76" fill="#ffffff"/><rect x="14.12" y="44.08" width="1.76" height="5.85" fill="#ffffff"/></g>
    <text class="pl-t1" x="36" y="25">SIRIUS</text>
    <text class="pl-t2" x="36" y="52">-SOLAR</text>
</svg>
