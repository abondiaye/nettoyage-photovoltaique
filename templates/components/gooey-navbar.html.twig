<script>
const navbar = document.querySelector('.navbar');
const items = document.querySelectorAll('.nav-item');
const decorator = document.querySelector('.decorator');

// Initialize decorator position
function updateDecoratorPosition() {
    const activeItem = document.querySelector('.nav-item.active');
    if (activeItem) {
        const itemRect = activeItem.getBoundingClientRect();
        const navbarRect = navbar.getBoundingClientRect();
        const x = itemRect.x - navbarRect.x - 5;
        decorator.style.left = `${x}px`;
    }
}

// Update on load
updateDecoratorPosition();
window.addEventListener('resize', updateDecoratorPosition);

items.forEach(item => {
    item.addEventListener('click', event => {
        event.preventDefault();

        const target = event.currentTarget;

        if(target.classList.contains('active')) {
            window.location.href = target.href;
            return;
        }

        items.forEach(el => el.classList.remove('active'));
        target.classList.add('active');
        updateDecoratorPosition();

        setTimeout(() => {
            window.location.href = target.href;
        }, 300);
    });
});

// Theme Toggle
const html = document.documentElement;
const currentTheme = localStorage.getItem('theme') || 'light';
if (currentTheme === 'dark') {
    document.body.classList.add('dark-mode');
    html.setAttribute('data-theme', 'dark');
}
</script>
