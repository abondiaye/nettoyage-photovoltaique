<style>
/* ===== MOBILE BOTTOM NAVBAR (Sevenpion Style) ===== */
.gooey-navbar {
    display: none !important;
    visibility: hidden !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* Top Right Navigation Bar */
.bottom-nav {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
    background:
        radial-gradient(circle at 30% 30%, rgba(255, 255, 200, 0.3), transparent 50%),
        radial-gradient(circle at 70% 70%, rgba(100, 80, 0, 0.2), transparent 50%),
        linear-gradient(135deg, #ffd700 0%, #ffed4e 25%, #d4a842 50%, #b8860b 75%, #cd853f 100%);
    backdrop-filter: blur(10px);
    border: 3px solid #d4a842;
    border-radius: 15px;
    padding: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    box-shadow: 0 8px 32px rgba(212, 168, 66, 0.5), inset 0 1px 0 rgba(255, 255, 200, 0.3);
}

/* Wave effect - hidden for top nav */
.bottom-nav::before {
    display: none;
}

/* Navigation items - hidden by default in navbar */
.nav-item {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: #ffffff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.3s ease;
    padding: 10px;
    position: relative;
    z-index: 2;
}

.nav-item svg {
    width: 28px;
    height: 28px;
    stroke: #ffffff;
    stroke-width: 1.5;
    fill: none;
}

.nav-item:hover {
    color: #00d4ff;
    transform: scale(1.15);
}

.nav-item:hover svg {
    stroke: #00d4ff;
}

/* Hamburger Button - Part of navbar */
.hamburger-center {
    position: relative;
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #ffd700 0%, #ffed4e 25%, #d4a842 50%, #b8860b 75%, #cd853f 100%);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    box-shadow: 0 4px 15px rgba(212, 168, 66, 0.5), inset 0 1px 0 rgba(255, 255, 200, 0.3);
    transition: all 0.3s ease;
    flex-shrink: 0;
}

.hamburger-center:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 25px rgba(212, 168, 66, 0.7), inset 0 1px 0 rgba(255, 255, 200, 0.5);
}

.hamburger-center:active {
    transform: scale(0.95);
}

.hamburger-center span {
    width: 28px;
    height: 2.5px;
    background: #3d2817;
    display: block;
    transition: all 0.3s ease;
    border-radius: 2px;
}

/* Mobile menu overlay */
.mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 31, 63, 0.95);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    gap: 30px;
}

.mobile-menu.active {
    display: flex;
}

.mobile-menu a {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
}

.mobile-menu a:hover {
    color: #00d4ff;
    transform: scale(1.1);
}

.close-menu {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 40px;
    color: #ffd700;
    cursor: pointer;
    background: none;
    border: none;
    transition: all 0.3s ease;
}

.close-menu:hover {
    transform: rotate(90deg);
}

/* No padding needed for top right navbar */
html { }
body { }

/* Responsive - show bottom nav on all devices */
@media (max-width: 1024px) {
    .bottom-nav {
        height: 100px;
    }

    .nav-item {
        font-size: 11px;
    }
}

@media (max-width: 768px) {
    .hamburger-center {
        width: 70px;
        height: 70px;
        bottom: 25px;
    }
}

/* Light mode */
body:not(.dark-mode) .bottom-nav {
    background: linear-gradient(180deg, #0a1f3f 0%, #1a3a5a 100%) !important;
}

body:not(.dark-mode) .hamburger-center {
    background: #ffd700;
}
</style>

<!-- Bottom Navigation Bar -->
<nav class="bottom-nav">
    <a href="{{ path('app_home') }}" class="nav-item" title="Accueil">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 12l9-9 9 9M5 11v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
            <path d="M9 21v-6h6v6"/>
        </svg>
        <span>Accueil</span>
    </a>

    <a href="{{ path('app_home') }}#avantages" class="nav-item" title="À propos">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/>
        </svg>
        <span>À propos</span>
    </a>

    <a href="{{ path('app_home') }}#services" class="nav-item" title="Services">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="8" height="8"/>
            <rect x="13" y="3" width="8" height="8"/>
            <rect x="3" y="13" width="8" height="8"/>
            <rect x="13" y="13" width="8" height="8"/>
        </svg>
        <span>Services</span>
    </a>

    <a href="{{ path('app_blog') }}" class="nav-item" title="Gallery">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M3 15l5-5 5 5 9-9"/>
        </svg>
        <span>Gallery</span>
    </a>

    <a href="{{ path('app_home') }}#contact" class="nav-item" title="Contact">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 8l8.5-6 8.5 6v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <path d="M9 13h6v6H9z"/>
        </svg>
        <span>Contact</span>
    </a>
</nav>

<!-- Center Hamburger Button -->
<button class="hamburger-center" id="hamburgerCenter" aria-label="Menu">
    <span></span>
    <span></span>
    <span></span>
</button>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu" id="mobileMenu">
    <button class="close-menu" id="closeMenu">×</button>
    <a href="{{ path('app_home') }}">Accueil</a>
    <a href="{{ path('app_home') }}#avantages">À propos</a>
    <a href="{{ path('app_home') }}#services">Services</a>
    <a href="{{ path('app_blog') }}">Gallery</a>
    <a href="{{ path('app_home') }}#contact">Contact</a>
    {% if app.user %}
        <a href="{{ path('app_admin_dashboard') }}">👤 Admin</a>
        <a href="{{ path('app_logout') }}">Déconnexion</a>
    {% else %}
        <a href="{{ path('app_login') }}">Se connecter</a>
        <a href="{{ path('app_register') }}">S'inscrire</a>
    {% endif %}
</div>

<nav class="gooey-navbar" id="gooeyNav">
    <!-- Hamburger Menu Button -->
    <button class="hamburger-btn" id="hamburgerBtn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <!-- Logo/Brand -->
    <a href="{{ path('app_home') }}" class="brand">
        SIRIUS-SOLAR
    </a>

    <!-- Navigation Links -->
    <div class="nav-links" id="navLinks">
        <a href="{{ path('app_home') }}">Accueil</a>
        <a href="{{ path('app_home') }}#avantages">À propos</a>
        <a href="{{ path('app_home') }}#services">Services</a>
        <a href="{{ path('app_blog') }}">Gallery</a>
        <a href="{{ path('app_home') }}#contact">Contact</a>
    </div>

    <!-- Auth Buttons -->
    <div class="auth-buttons">
        {% if app.user %}
            <a href="{{ path('app_admin_dashboard') }}" class="btn-login">
                👤 Admin
            </a>
            <a href="{{ path('app_logout') }}" class="btn-signup">
                Déconnexion
            </a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn-login">
                Se connecter
            </a>
            <a href="{{ path('app_register') }}" class="btn-signup">
                S'inscrire
            </a>
        {% endif %}
    </div>
</nav>

<script>
// Mobile menu functionality
const hamburgerBtn = document.getElementById('hamburgerCenter');
const mobileMenu = document.getElementById('mobileMenu');
const closeBtn = document.getElementById('closeMenu');

if (hamburgerBtn) {
    hamburgerBtn.addEventListener('click', () => {
        mobileMenu.classList.add('active');
    });
}

if (closeBtn) {
    closeBtn.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
    });
}

// Close menu when a link is clicked
document.querySelectorAll('.mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
    });
});

// Close menu when clicking outside
mobileMenu.addEventListener('click', (e) => {
    if (e.target === mobileMenu) {
        mobileMenu.classList.remove('active');
    }
});

// Theme Toggle
const html = document.documentElement;
const currentTheme = localStorage.getItem('theme') || 'light';
if (currentTheme === 'dark') {
    document.body.classList.add('dark-mode');
    html.setAttribute('data-theme', 'dark');
}
</script>
