<style>
/* ===== GOOEY NAVBAR - FROSTED GLASS ===== */
:root {
    --primary-color: #0A3D35;
    --secondary-color: #2D6B55;
    --accent-color: #a8a8a8;
    --glass-bg: rgba(10, 61, 53, 0.7);
}

.gooey-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: 80px;
    background: rgba(10, 61, 53, 0.5);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(192, 192, 192, 0.2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    animation: slideDown 0.6s ease-out;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-100%);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Logo/Brand */
.gooey-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: white;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.gooey-brand:hover {
    transform: scale(1.05);
}

.gooey-brand-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(192, 192, 192, 0.3);
    border-radius: 10px;
    border: 2px solid rgba(192, 192, 192, 0.7);
}

.gooey-brand-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6px;
    filter: brightness(1.1) drop-shadow(0 2px 6px rgba(192, 192, 192, 0.5));
}

/* Center Navigation */
.gooey-nav-center {
    display: flex;
    gap: 30px;
    align-items: center;
    flex: 1;
    justify-content: center;
    position: relative;
}

/* Gooey Effect SVG Background */
.gooey-nav-center::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    pointer-events: none;
    z-index: -1;
}

/* Navigation Links */
.gooey-nav-link {
    position: relative;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 8px 16px;
    border-radius: 8px;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
}

.gooey-nav-link::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: radial-gradient(circle, rgba(192, 192, 192, 0.3) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
    z-index: -1;
}

.gooey-nav-link:hover {
    color: #ffffff;
    transform: translateY(-3px);
    background: rgba(192, 192, 192, 0.15);
}

.gooey-nav-link:hover::before {
    width: 200px;
    height: 200px;
}

/* Underline animation */
.gooey-nav-link::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 16px;
    right: 16px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(192, 192, 192, 0.8), transparent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.gooey-nav-link:hover::after {
    transform: scaleX(1);
}

/* Right Section */
.gooey-nav-right {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-shrink: 0;
}

/* Language Selector */
.gooey-language {
    display: flex;
    gap: 8px;
    align-items: center;
    background: rgba(192, 192, 192, 0.1);
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid rgba(192, 192, 192, 0.2);
    transition: all 0.3s ease;
}

.gooey-language:hover {
    background: rgba(192, 192, 192, 0.15);
    border-color: rgba(192, 192, 192, 0.4);
}

.gooey-lang-item {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 6px;
    border-radius: 4px;
    transition: all 0.3s ease;
    cursor: pointer;
}

.gooey-lang-item:hover,
.gooey-lang-item.active {
    color: #ffffff;
    background: rgba(192, 192, 192, 0.2);
}

.gooey-lang-separator {
    color: rgba(255, 255, 255, 0.3);
    font-size: 10px;
}

/* Auth Buttons */
.gooey-auth-buttons {
    display: flex;
    gap: 12px;
    align-items: center;
}

.gooey-btn {
    position: relative;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    border: none;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    overflow: hidden;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.gooey-btn-login {
    background: rgba(192, 192, 192, 0.1);
    color: rgba(255, 255, 255, 0.8);
    border: 1.5px solid rgba(192, 192, 192, 0.4);
}

.gooey-btn-login:hover {
    background: rgba(192, 192, 192, 0.2);
    border-color: rgba(192, 192, 192, 0.8);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(192, 192, 192, 0.2);
}

.gooey-btn-signup {
    background: linear-gradient(135deg, rgba(192, 192, 192, 0.4), rgba(192, 192, 192, 0.2));
    color: #ffffff;
    border: none;
}

.gooey-btn-signup::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.6s ease;
    z-index: -1;
}

.gooey-btn-signup:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(192, 192, 192, 0.3);
}

.gooey-btn-signup:hover::before {
    left: 100%;
}

/* Hamburger Menu */
.gooey-hamburger {
    display: none;
    flex-direction: column;
    cursor: pointer;
    gap: 6px;
}

.gooey-hamburger span {
    width: 25px;
    height: 2.5px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 2px;
    transition: all 0.3s ease;
}

.gooey-hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
}

.gooey-hamburger.active span:nth-child(2) {
    opacity: 0;
}

.gooey-hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
}

/* Mobile Menu */
.gooey-mobile-menu {
    position: fixed;
    top: 80px;
    left: 0;
    right: 0;
    background: rgba(10, 61, 53, 0.95);
    backdrop-filter: blur(20px);
    padding: 20px;
    display: none;
    flex-direction: column;
    gap: 15px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    z-index: 999;
    border-bottom: 1px solid rgba(192, 192, 192, 0.2);
}

.gooey-mobile-menu.active {
    display: flex;
}

.gooey-mobile-menu .gooey-nav-link {
    padding: 12px 16px;
    width: 100%;
    text-align: left;
}

.gooey-mobile-menu .gooey-language {
    width: 100%;
    margin-top: 10px;
}

.gooey-mobile-menu .gooey-auth-buttons {
    width: 100%;
    margin-top: 10px;
    flex-direction: column;
}

.gooey-mobile-menu .gooey-btn {
    width: 100%;
}

/* Responsive */
@media (max-width: 1024px) {
    .gooey-navbar {
        padding: 0 20px;
    }

    .gooey-nav-center {
        gap: 15px;
    }

    .gooey-nav-link {
        font-size: 13px;
        padding: 6px 12px;
    }
}

@media (max-width: 768px) {
    .gooey-navbar {
        padding: 0 15px;
        height: 70px;
    }

    .gooey-brand {
        gap: 10px;
        font-size: 16px;
    }

    .gooey-brand-icon {
        width: 40px;
        height: 40px;
    }

    .gooey-nav-center {
        display: none;
    }

    .gooey-nav-right {
        display: none;
    }

    .gooey-hamburger {
        display: flex;
    }

    .gooey-mobile-menu {
        top: 70px;
    }
}

/* Gravity effect - falling animation */
@keyframes gravity {
    0% {
        transform: translateY(-10px);
        opacity: 0;
    }
    100% {
        transform: translateY(0);
        opacity: 1;
    }
}

.gooey-navbar > * {
    animation: gravity 0.6s ease-out backwards;
}

.gooey-brand {
    animation-delay: 0.1s;
}

.gooey-nav-center {
    animation-delay: 0.2s;
}

.gooey-nav-right {
    animation-delay: 0.3s;
}
</style>

<nav class="gooey-navbar">
    <!-- Brand/Logo -->
    <a href="{{ path('app_home') }}" class="gooey-brand">
        <div class="gooey-brand-icon">
            <img src="{{ asset('images/logo.svg') }}" alt="Sirius-Solar">
        </div>
        <span>SIRIUS-SOLAR</span>
    </a>

    <!-- Center Navigation -->
    <div class="gooey-nav-center">
        <a href="{{ path('app_home') }}" class="gooey-nav-link">Accueil</a>
        <a href="{{ path('app_home') }}#avantages" class="gooey-nav-link">À propos</a>
        <a href="{{ path('app_home') }}#services" class="gooey-nav-link">Services</a>
        <a href="{{ path('app_blog') }}" class="gooey-nav-link">Gallery</a>
        <a href="{{ path('app_home') }}#contact" class="gooey-nav-link">Contact</a>
    </div>

    <!-- Right Section -->
    <div class="gooey-nav-right">
        <!-- Language Selector -->
        <div class="gooey-language">
            <a href="#" class="gooey-lang-item active" data-lang="fr">FR</a>
            <span class="gooey-lang-separator">|</span>
            <a href="#" class="gooey-lang-item" data-lang="de">DE</a>
            <span class="gooey-lang-separator">|</span>
            <a href="#" class="gooey-lang-item" data-lang="it">IT</a>
            <span class="gooey-lang-separator">|</span>
            <a href="#" class="gooey-lang-item" data-lang="rm">RM</a>
        </div>

        <!-- Auth Buttons -->
        <div class="gooey-auth-buttons">
            {% if app.user %}
                <!-- Si connecté -->
                <a href="{{ path('app_admin_dashboard') }}" class="gooey-btn gooey-btn-login">
                    👤 Tableau de bord
                </a>
                <a href="{{ path('app_logout') }}" class="gooey-btn gooey-btn-signup">
                    Déconnexion
                </a>
            {% else %}
                <!-- Si non connecté -->
                <a href="{{ path('app_login') }}" class="gooey-btn gooey-btn-login">
                    S'identifier
                </a>
                <a href="{{ path('app_register') }}" class="gooey-btn gooey-btn-signup">
                    Créer un compte
                </a>
            {% endif %}
        </div>
    </div>

    <!-- Mobile Hamburger -->
    <div class="gooey-hamburger" id="gooeyHamburger">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <!-- Mobile Menu -->
    <div class="gooey-mobile-menu" id="gooeyMobileMenu">
        <a href="{{ path('app_home') }}" class="gooey-nav-link">Accueil</a>
        <a href="{{ path('app_home') }}#avantages" class="gooey-nav-link">À propos</a>
        <a href="{{ path('app_home') }}#services" class="gooey-nav-link">Services</a>
        <a href="{{ path('app_blog') }}" class="gooey-nav-link">Gallery</a>
        <a href="{{ path('app_home') }}#contact" class="gooey-nav-link">Contact</a>

        <div class="gooey-language">
            <a href="#" class="gooey-lang-item active" data-lang="fr">FR</a>
            <span class="gooey-lang-separator">|</span>
            <a href="#" class="gooey-lang-item" data-lang="de">DE</a>
            <span class="gooey-lang-separator">|</span>
            <a href="#" class="gooey-lang-item" data-lang="it">IT</a>
            <span class="gooey-lang-separator">|</span>
            <a href="#" class="gooey-lang-item" data-lang="rm">RM</a>
        </div>

        <div class="gooey-auth-buttons">
            {% if app.user %}
                <a href="{{ path('app_admin_dashboard') }}" class="gooey-btn gooey-btn-login">
                    👤 Tableau de bord
                </a>
                <a href="{{ path('app_logout') }}" class="gooey-btn gooey-btn-signup">
                    Déconnexion
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="gooey-btn gooey-btn-login">
                    S'identifier
                </a>
                <a href="{{ path('app_register') }}" class="gooey-btn gooey-btn-signup">
                    Créer un compte
                </a>
            {% endif %}
        </div>
    </div>
</nav>

<script>
// Hamburger Menu Toggle
const hamburger = document.getElementById('gooeyHamburger');
const mobileMenu = document.getElementById('gooeyMobileMenu');

if (hamburger) {
    hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileMenu.classList.toggle('active');
    });

    // Close menu when clicking on a link
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
            hamburger.classList.remove('active');
            mobileMenu.classList.remove('active');
        });
    });
}

// Language selector
const langItems = document.querySelectorAll('.gooey-lang-item');
langItems.forEach(item => {
    item.addEventListener('click', (e) => {
        e.preventDefault();
        langItems.forEach(li => li.classList.remove('active'));
        item.classList.add('active');
        console.log('Language changed to:', item.dataset.lang);
    });
});
</script>
