<style>
/* ===== NAVBAR WITH ANIMATED CIRCULAR DECORATOR ===== */
.gooey-navbar {
    display: none !important;
    visibility: hidden !important;
    height: 0 !important;
}

* {
    margin: 0;
    box-sizing: border-box;
}

body {
    padding-top: 120px !important;
}

.navbar {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 10px;
    row-gap: 8px;
    padding: 10px 30px;
    width: auto;
    max-width: 90vw;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border: 3px solid #d4a842;
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(212, 168, 66, 0.4), inset 0 1px 0 rgba(255, 255, 200, 0.3);
    position: relative;
}

/* Animated circular decorator */
.decorator {
    position: absolute;
    left: 30px;
    top: -30px;
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #ffd700 0%, #ffed4e 25%, #d4a842 50%, #b8860b 75%, #cd853f 100%);
    border-radius: 50%;
    transition: left 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 8px 32px rgba(212, 168, 66, 0.5), inset 0 1px 0 rgba(255, 255, 200, 0.4);
    border: 3px solid #d4a842;
}

.decorator::before {
    content: '';
    position: absolute;
    bottom: -10px;
    right: calc(100% - 8px);
    width: 40px;
    height: 40px;
    border-top-right-radius: 20px;
    box-shadow: 0 -10px rgba(255, 255, 255, 0.95);
}

.decorator::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: calc(100% - 8px);
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    box-shadow: 0 -10px rgba(255, 255, 255, 0.95);
}

/* Navigation items */
.nav-item {
    width: 65px;
    height: 60px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 12px;
    position: relative;
    cursor: pointer;
    z-index: 1;
    top: 0;
    transition: all 0.3s ease;
    font-weight: 700;
    font-size: 11px;
    color: #3d2817;
    text-decoration: none;
    flex-direction: column;
    gap: 3px;
    padding: 3px;
    text-align: center;
    line-height: 1.1;
    white-space: normal;
}

.nav-item svg {
    width: 26px;
    height: 26px;
    stroke: #3d2817;
    stroke-width: 2;
    fill: none;
    flex-shrink: 0;
}

.nav-item.active {
    top: -25px;
    background: rgba(255, 255, 255, 0.9);
    color: #d4a842;
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.95);
    font-size: 14px;
    font-weight: 700;
}

.nav-item.active svg {
    stroke: #d4a842;
}

.nav-item:hover {
    color: #d4a842;
    transform: scale(1.08);
}

.nav-item:hover svg {
    stroke: #d4a842;
}

/* Responsive */
@media (max-width: 768px) {
    .navbar {
        min-width: 90vw;
        column-gap: 15px;
        padding: 0 15px;
        height: 60px;
    }

    .nav-item {
        width: 50px;
        height: 60px;
        font-size: 11px;
    }

    .decorator {
        width: 60px;
        height: 60px;
    }
}

/* Light and dark mode */
body:not(.dark-mode) .navbar {
    background: rgba(255, 255, 255, 0.95);
    border-color: #d4a842;
}

body.dark-mode .navbar {
    background: rgba(20, 20, 30, 0.95);
    border-color: #d4a842;
}

body.dark-mode .nav-item {
    color: #e8e8e8;
}

body.dark-mode .nav-item.active {
    color: #d4a842;
    background: rgba(40, 40, 50, 0.8);
}

body.dark-mode .decorator::before,
body.dark-mode .decorator::after {
    box-shadow: 0 -10px rgba(20, 20, 30, 0.95);
}
</style>

<!-- Navbar with animated circular decorator -->
