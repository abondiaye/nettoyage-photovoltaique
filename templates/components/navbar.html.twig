{# Navbar 3D : logo néon à gauche, menu burger à droite.
   Au clic, la page bascule en 3D vers la gauche et le menu apparaît à droite. #}
{% set home = path('app_home') %}
<header class="nav3d" id="siteNavbar">
    <a href="{{ home }}" class="nav3d__brand" aria-label="Sirius-Solar, accueil">
        <span class="nav3d__logo" data-sirius-logo3d="compact"></span>
        {% include 'components/_logo_pro.html.twig' %}
    </a>

    <div class="nav3d__right">
        <button type="button" class="theme-switch" id="themeSwitch" data-theme-switch title="Changer la couleur du site (vert / bleu)">
            <i aria-hidden="true"></i><span id="themeSwitchLabel" data-theme-label>Style bleu</span>
        </button>
        {% if app.user %}
            <a href="{{ path('app_logout') }}" class="nav3d__pill">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="nav3d__pill">Connexion</a>
            <a href="{{ path('app_register') }}" class="nav3d__pill nav3d__pill--gold">Inscription</a>
        {% endif %}
        <button type="button" class="nav3d__burger" id="nav3dBurger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav3dMenu">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

<div class="nav3d-ghost nav3d-ghost--1" aria-hidden="true"></div>
<div class="nav3d-ghost nav3d-ghost--2" aria-hidden="true"></div>
<div class="nav3d-catch" id="nav3dCatch" aria-hidden="true"></div>

<nav class="nav3d-menu" id="nav3dMenu" aria-label="Menu principal">
    <ul>
        <li><a href="{{ home }}"><span>01</span>Accueil</a></li>
        <li><a href="{{ home }}#processus"><span>02</span>Processus</a></li>
        <li><a href="{{ home }}#services"><span>03</span>Services</a></li>
        <li><a href="{{ home }}#avantages"><span>04</span>Avantages</a></li>
        <li><a href="/devis"><span>05</span>Devis</a></li>
        <li><a href="{{ home }}#contact"><span>06</span>Contact</a></li>
        <li><a href="/about"><span>07</span>À propos</a></li>
        <li><a href="/blog"><span>08</span>Blog</a></li>
    </ul>
    <button type="button" class="nav3d-menu__style" data-theme-switch>
        <i aria-hidden="true"></i><span data-theme-label>Style bleu</span>
    </button>
    <div class="nav3d-menu__auth">
        {% if app.user %}
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
            <a href="{{ path('app_register') }}" class="is-gold">Inscription</a>
        {% endif %}
    </div>
</nav>

<style>
    .nav3d {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 6px 20px;
        /* Translucent green glass: the page shows through, blurred. */
        background: linear-gradient(180deg, rgba(6, 60, 38, 0.42) 0%, rgba(3, 30, 20, 0.32) 100%);
        backdrop-filter: blur(14px) saturate(1.5);
        -webkit-backdrop-filter: blur(14px) saturate(1.5);
        border-bottom: 1px solid rgba(74, 222, 128, 0.3);
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.08);
        box-sizing: border-box;
        transition: background 0.4s ease;
    }
    /* Menu open: the page is tilted, so what shows around it is the <html> canvas, which base.html.twig
       paints white. Paint it dark instead, otherwise the white menu text is invisible. */
    html:has(body.nav3d-open) { background: #020a07 !important; }
    body.nav3d-open .nav3d { background: rgba(2, 10, 7, 0.6); border-color: transparent; box-shadow: none; }

    .nav3d__brand { display: block; line-height: 0; }
    .nav3d__logo { display: block; width: 150px; height: 62px; }
    .nav3d__logo canvas { display: block; width: 100%; height: 100%; }

    .nav3d__right { display: flex; align-items: center; gap: 12px; }

    .nav3d__pill {
        padding: 9px 16px;
        border-radius: 999px;
        border: 1px solid rgba(74, 222, 128, 0.45);
        color: #eafff0;
        font: 600 14px/1 system-ui, sans-serif;
        text-decoration: none;
        white-space: nowrap;
        transition: box-shadow 0.2s ease, color 0.2s ease;
    }
    .nav3d__pill:hover { color: #4ade80; box-shadow: 0 0 16px rgba(74, 222, 128, 0.35); }
    .nav3d__pill--gold { border-color: rgba(255, 210, 31, 0.6); }
    .nav3d__pill--gold:hover { color: #ffd21f; box-shadow: 0 0 16px rgba(255, 210, 31, 0.35); }

    .nav3d__burger {
        position: relative;
        width: 46px;
        height: 46px;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
    }
    .nav3d__burger span {
        position: absolute;
        left: 9px;
        right: 9px;
        height: 2px;
        border-radius: 2px;
        background: #4ade80;
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.8);
        transition: transform 0.5s cubic-bezier(.7, 0, .3, 1), opacity 0.3s ease, top 0.5s cubic-bezier(.7, 0, .3, 1);
    }
    .nav3d__burger span:nth-child(1) { top: 15px; }
    .nav3d__burger span:nth-child(2) { top: 22px; right: 17px; }
    .nav3d__burger span:nth-child(3) { top: 29px; }
    body.nav3d-open .nav3d__burger span:nth-child(1) { top: 22px; transform: rotate(45deg); }
    body.nav3d-open .nav3d__burger span:nth-child(2) { opacity: 0; transform: translateX(10px); }
    body.nav3d-open .nav3d__burger span:nth-child(3) { top: 22px; transform: rotate(-45deg); }

    /* The page itself: it tilts back in 3D when the menu opens. */
    .nav3d-page {
        position: relative;
        z-index: 2;
        transform-origin: 50% var(--nav3d-origin, 50vh);
        transition: transform 0.7s cubic-bezier(.7, 0, .3, 1), border-radius 0.7s ease, box-shadow 0.7s ease;
    }
    body.nav3d-open { overflow: hidden; background: radial-gradient(ellipse at 70% 50%, #06231a 0%, #020a07 70%) fixed !important; min-height: 100vh; }
    body.nav3d-open .nav3d-page {
        transform: perspective(1500px) rotateY(20deg) translateX(-34%) scale(0.62);
        border-radius: 22px;
        overflow: hidden;
        pointer-events: none;
        box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.35), 0 0 60px rgba(74, 222, 128, 0.25);
    }

    /* Two faint panels behind the page for depth. */
    .nav3d-ghost {
        position: fixed;
        inset: 0;
        z-index: 1;
        border-radius: 22px;
        pointer-events: none;
        opacity: 0;
        transform: none;
        transition: transform 0.7s cubic-bezier(.7, 0, .3, 1), opacity 0.5s ease;
    }
    .nav3d-ghost--1 { background: rgba(74, 222, 128, 0.08); border: 1px solid rgba(74, 222, 128, 0.2); }
    .nav3d-ghost--2 { background: rgba(255, 210, 31, 0.05); border: 1px solid rgba(255, 210, 31, 0.16); }
    body.nav3d-open .nav3d-ghost--1 { opacity: 1; transform: perspective(1500px) rotateY(20deg) translateX(-42%) scale(0.56); }
    body.nav3d-open .nav3d-ghost--2 { opacity: 1; transform: perspective(1500px) rotateY(20deg) translateX(-50%) scale(0.5); transition-delay: 0.05s; }

    /* Click on the tilted page to close. */
    .nav3d-catch { position: fixed; inset: 0 45% 0 0; z-index: 3; display: none; cursor: pointer; }
    body.nav3d-open .nav3d-catch { display: block; }

    .nav3d-menu {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 999;
        width: min(420px, 45vw);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 90px 40px 40px 0;
        box-sizing: border-box;
        pointer-events: none;
        visibility: hidden;
        transition: visibility 0s linear 0.7s;
    }
    body.nav3d-open .nav3d-menu { pointer-events: auto; visibility: visible; transition-delay: 0s; }

    .nav3d-menu ul { list-style: none; margin: 0; padding: 0; }
    .nav3d-menu li {
        opacity: 0;
        transform: translateX(60px);
        transition: transform 0.5s cubic-bezier(.2, .8, .2, 1), opacity 0.4s ease;
    }
    body.nav3d-open .nav3d-menu li { opacity: 1; transform: none; }
    {% for i in 1..8 %}
    body.nav3d-open .nav3d-menu li:nth-child({{ i }}) { transition-delay: {{ 0.25 + i * 0.05 }}s; }
    {% endfor %}

    .nav3d-menu a {
        display: flex;
        align-items: baseline;
        gap: 14px;
        padding: 7px 0;
        color: #eafff0;
        text-decoration: none;
        font: 700 clamp(22px, 3.2vw, 34px)/1.15 system-ui, sans-serif;
        letter-spacing: 0.02em;
        transition: color 0.2s ease, text-shadow 0.2s ease, transform 0.2s ease;
    }
    .nav3d-menu a span { font-size: 12px; font-weight: 600; color: #ffd21f; letter-spacing: 0.1em; }
    .nav3d-menu a:hover { color: #4ade80; text-shadow: 0 0 14px rgba(74, 222, 128, 0.7); transform: translateX(-6px); }

    .nav3d-menu__style {
        display: inline-flex; align-items: center; gap: 10px;
        margin-top: 22px; padding: 10px 16px; border-radius: 999px;
        border: 1px solid rgba(74, 222, 128, 0.45); background: rgba(3, 18, 14, 0.5);
        color: #eafff0; font: 600 15px/1 system-ui, sans-serif; cursor: pointer;
        opacity: 0; transition: opacity 0.4s ease 0.65s;
    }
    body.nav3d-open .nav3d-menu__style { opacity: 1; }
    .nav3d-menu__style i { width: 20px; height: 20px; border-radius: 50%; background: conic-gradient(#1d4ed8 0 50%, #4ade80 0 100%); }
    .nav3d-menu__auth {
        display: flex;
        gap: 18px;
        margin-top: 28px;
        opacity: 0;
        transition: opacity 0.4s ease 0.7s;
    }
    body.nav3d-open .nav3d-menu__auth { opacity: 1; }
    .nav3d-menu__auth a { font-size: 16px; color: #4ade80; }
    .nav3d-menu__auth a.is-gold { color: #ffd21f; }

    @media (max-width: 700px) {
        .nav3d { padding: 4px 10px; }
        .nav3d__logo { width: 120px; height: 50px; }
        .nav3d__pill { display: none; }
        body.nav3d-open .nav3d-page { transform: perspective(1200px) rotateY(24deg) translateX(-62%) scale(0.6); }
        body.nav3d-open .nav3d-ghost--1 { transform: perspective(1200px) rotateY(24deg) translateX(-70%) scale(0.54); }
        body.nav3d-open .nav3d-ghost--2 { transform: perspective(1200px) rotateY(24deg) translateX(-78%) scale(0.48); }
        .nav3d-catch { right: 62%; }
        .nav3d-menu { width: 62vw; padding-right: 20px; }
        .nav3d-menu a { font-size: 22px; }
        .nav3d-menu__auth { flex-wrap: wrap; gap: 10px 16px; }
        .nav3d-menu__auth a { font-size: 15px; }
    }


    /* ===== Menu burger en 3D : chaque lien est une dalle épaisse qui pivote vers la page ===== */
    .nav3d-menu ul { display: grid; gap: 10px; perspective: 900px; perspective-origin: 100% 50%; }
    .nav3d-menu li { transform-style: preserve-3d; transform-origin: right center; transform: translateX(70px) rotateY(-55deg) !important; }
    body.nav3d-open .nav3d-menu li { transform: rotateY(-14deg) !important; }
    .nav3d-menu ul a {
        position: relative;
        display: flex; align-items: center; gap: 14px;
        padding: 11px 18px 11px 12px;
        border-radius: 14px;
        font-size: clamp(18px, 2.3vw, 26px) !important;
        background: linear-gradient(135deg, rgba(18, 70, 48, 0.92) 0%, rgba(4, 24, 17, 0.95) 100%);
        border: 1px solid rgba(74, 222, 128, 0.35);
        box-shadow: 1px 1px 0 #0f3d29, 2px 2px 0 #0d3624, 3px 3px 0 #0b301f, 4px 4px 0 #0a2a1b, 5px 5px 0 #082417, 6px 6px 0 #071f14,
                    12px 16px 26px rgba(0, 0, 0, 0.5);
        transition: transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease !important;
    }
    .nav3d-menu ul a:hover {
        transform: translate(-4px, -4px) !important;
        box-shadow: 1px 1px 0 #0f3d29, 2px 2px 0 #0d3624, 3px 3px 0 #0b301f, 4px 4px 0 #0a2a1b, 5px 5px 0 #082417, 6px 6px 0 #071f14,
                    7px 7px 0 #061b12, 8px 8px 0 #05170f, 9px 9px 0 #04130c, 10px 10px 0 #030f0a, 18px 22px 30px rgba(0, 0, 0, 0.55);
    }
    .nav3d-menu ul a:active { transform: translate(3px, 3px) !important; box-shadow: 1px 1px 0 #0f3d29, 2px 2px 0 #0d3624, 6px 8px 14px rgba(0, 0, 0, 0.45); }
    .nav3d-menu ul a span {
        display: inline-grid; place-items: center; width: 34px; height: 34px; flex: none;
        border-radius: 10px; background: rgba(255, 210, 31, 0.14); border: 1px solid rgba(255, 210, 31, 0.45);
        font-size: 12px !important;
    }
    @media (max-width: 700px) {
        .nav3d-menu ul { gap: 8px; }
        .nav3d-menu ul a { padding: 8px 12px 8px 8px; font-size: 18px !important; }
        .nav3d-menu ul a span { width: 28px; height: 28px; }
        body.nav3d-open .nav3d-menu li { transform: rotateY(-10deg) !important; }
    }
    html.theme-pro .nav3d-menu ul a {
        background: linear-gradient(135deg, #ffffff 0%, #eef3fb 100%) !important;
        border-color: #cfdbee !important;
        box-shadow: 1px 1px 0 #c7d5ec, 2px 2px 0 #b9cae6, 3px 3px 0 #aabddf, 4px 4px 0 #9bb1d9, 5px 5px 0 #8ca5d2, 6px 6px 0 #7d99cc,
                    12px 16px 26px rgba(15, 23, 42, 0.18) !important;
    }
    html.theme-pro .nav3d-menu ul a:hover {
        box-shadow: 1px 1px 0 #c7d5ec, 2px 2px 0 #b9cae6, 3px 3px 0 #aabddf, 4px 4px 0 #9bb1d9, 5px 5px 0 #8ca5d2, 6px 6px 0 #7d99cc,
                    7px 7px 0 #6e8dc5, 8px 8px 0 #5f81bf, 9px 9px 0 #5075b8, 10px 10px 0 #4169b2, 18px 22px 30px rgba(15, 23, 42, 0.22) !important;
    }
    html.theme-pro .nav3d-menu ul a span { background: #dbeafe !important; border-color: #93c5fd !important; color: #1d4ed8 !important; }

    @media (prefers-reduced-motion: reduce) {
        .nav3d-page, .nav3d-ghost, .nav3d-menu li { transition-duration: 0.01s !important; transition-delay: 0s !important; }
    }
</style>

<script>
(function () {
    var body = document.body;
    var burger = document.getElementById('nav3dBurger');
    var catcher = document.getElementById('nav3dCatch');
    var menu = document.getElementById('nav3dMenu');
    var page = document.querySelector('.nav3d-page');
    if (!burger || !menu) return;

    function setOpen(open) {
        if (open && page) {
            // Tilt around the middle of what is on screen, not the middle of the whole page.
            // The page may scroll inside <body> instead of the window: take whichever has moved.
            var scrolled = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
            page.style.setProperty('--nav3d-origin', (scrolled + window.innerHeight / 2) + 'px');
        }
        body.classList.toggle('nav3d-open', open);
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    }

    burger.addEventListener('click', function () { setOpen(!body.classList.contains('nav3d-open')); });
    catcher.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

    // Links: close the menu first, then go (or scroll, for an anchor on this page).
    menu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function (e) {
            var url = new URL(a.href, location.href);
            e.preventDefault();
            setOpen(false);
            setTimeout(function () {
                if (url.pathname === location.pathname && url.hash) {
                    var target = document.querySelector(url.hash);
                    if (target) { window.siriusScrollTo(target); history.replaceState(null, '', url.hash); return; }
                }
                location.href = url.href;
            }, 650);
        });
    });
})();
</script>

<script>
(function () {
    // Colour switch (top bar + burger menu): green neon by default, blue "Pro" as second choice.
    // The choice is kept in this browser.
    var root = document.documentElement;
    function refresh() {
        var pro = root.classList.contains('theme-pro');
        document.querySelectorAll('[data-theme-label]').forEach(function (l) { l.textContent = pro ? 'Style vert' : 'Style bleu'; });
        document.querySelectorAll('[data-theme-switch]').forEach(function (b) { b.setAttribute('aria-label', pro ? 'Passer au style vert' : 'Passer au style bleu'); });
    }
    function toggle(e) {
        if (e) e.preventDefault();
        var pro = !root.classList.contains('theme-pro');
        root.classList.toggle('theme-pro', pro);
        try { localStorage.setItem('sirius-style', pro ? 'pro' : 'neon'); } catch (err) {}
        if (!pro && window.siriusLoadLogo3d) window.siriusLoadLogo3d();
        refresh();
    }
    document.querySelectorAll('[data-theme-switch]').forEach(function (b) { b.addEventListener('click', toggle); });
    refresh();
})();
</script>
