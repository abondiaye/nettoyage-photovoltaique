<script>
    // ===== PRICING CALCULATOR =====
    const TVARATE = 0.081; // TVA suisse 8,1 %
    const euro = n => 'CHF ' + new Intl.NumberFormat('fr-CH', {minimumFractionDigits: 2, maximumFractionDigits: 2}).format(n);

    const isTTC = () => {
        const toggle = document.getElementById('ttcToggle');
        return toggle ? toggle.checked : false;
    };

    const tarifM2 = m2 => (m2 > 60 ? 5 : (m2 > 30 ? 6 : 7));
    const withTax = n => (isTTC() ? n * (1 + TVARATE) : n);

    function updatePricingDisplay() {
        const mode = isTTC() ? 'TTC' : 'HT';
        document.querySelectorAll('.pricing-card').forEach(card => {
            const priceHT = parseFloat(card.querySelector('[data-price-ht]').getAttribute('data-price-ht'));
            card.querySelector('.pricing-card__price').textContent = euro(withTax(priceHT));
            card.querySelector('.pricing-card__period').textContent = 'par m² • ' + mode;
            card.querySelectorAll('[data-example]').forEach(el => {
                const m2 = parseFloat(el.dataset.example);
                el.textContent = euro(withTax(m2 * tarifM2(m2)));
            });
        });
        updateTotalPrice();
    }

    document.getElementById('ttcToggle').addEventListener('change', updatePricingDisplay);

    // ===== ESTIMATION : surface × tarif au m² + options =====
    const surfaceInput = document.getElementById('surface');
    const panelsInput = document.getElementById('nombrePanneaux');

    function updateTotalPrice() {
        const m2 = parseFloat((surfaceInput.value || '').replace(',', '.')) || 0;
        const rate = tarifM2(m2);
        const base = m2 > 0 ? m2 * rate : 0;
        let options = 0;
        document.querySelectorAll('input[name="lavage_types[]"]:checked').forEach(cb => { options += parseFloat(cb.dataset.price) || 0; });

        document.getElementById('estSurface').textContent = m2 > 0 ? (m2 + ' m² × ' + euro(withTax(rate)) + '/m²') : '—';
        document.getElementById('estBase').textContent = m2 > 0 ? euro(withTax(base)) : '—';
        document.getElementById('estOptions').textContent = euro(withTax(options));
        document.getElementById('estMode').textContent = isTTC() ? 'TTC' : 'HT';
        document.getElementById('totalPrice').textContent = euro(withTax(base + options));

        // Highlight the matching tier card.
        const tier = m2 <= 0 ? '' : (m2 > 60 ? 'l' : (m2 > 30 ? 'm' : 's'));
        document.querySelectorAll('.pricing-card[data-tier]').forEach(c => c.classList.toggle('is-current', c.dataset.tier === tier));
    }

    // Panels → surface (1 panel ≈ 1.7 m²), as long as the client has not typed a surface himself.
    panelsInput.addEventListener('input', () => {
        const n = parseInt(panelsInput.value, 10);
        if (!surfaceInput.value || surfaceInput.dataset.auto === '1') {
            surfaceInput.value = n > 0 ? (Math.round(n * 1.7 * 2) / 2) : '';
            surfaceInput.dataset.auto = n > 0 ? '1' : '';
            document.getElementById('surfaceHint').textContent = n > 0 ? ('≈ ' + n + ' panneaux × 1,7 m² — modifiable') : '1 panneau ≈ 1,7 m²';
        }
        updateTotalPrice();
    });
    surfaceInput.addEventListener('input', () => { surfaceInput.dataset.auto = ''; updateTotalPrice(); });
    document.querySelectorAll('input[name="lavage_types[]"]').forEach(cb => cb.addEventListener('change', updateTotalPrice));

    // Supplement notice when the roof is hard to reach or there is no water/electricity.
    function updateTabsNote() {
        const hard = document.getElementById('acces_difficile').checked;
        const ee = document.querySelector('input[name="devis[accesEauElec]"]:checked');
        document.getElementById('tabsNote').hidden = !(hard || (ee && ee.value !== 'les_deux'));
    }
    document.querySelectorAll('.devis-tabs input').forEach(r => r.addEventListener('change', updateTabsNote));
    document.querySelector('.devis-form-card form').addEventListener('reset', () => setTimeout(() => { surfaceInput.dataset.auto = ''; updateTotalPrice(); updateTabsNote(); }, 0));

    // ===== PACK SELECTION =====
    function initPackSelection() {
        document.querySelectorAll('.pricing-card__btn').forEach(btn => {
            btn.addEventListener('click', e => {
                e.preventDefault();
                (window.siriusScrollTo ? window.siriusScrollTo(surfaceInput) : surfaceInput.scrollIntoView({ behavior: 'smooth', block: 'center' }));
                setTimeout(() => surfaceInput.focus({ preventScroll: true }), 500);
            });
        });
    }

    // Initialize on page load
    try {
        updatePricingDisplay();
    } catch (err) {
        console.error('Error in pricing display:', err);
    }

    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPackSelection);
    } else {
        initPackSelection();
    }
</script>

{% endblock %}
