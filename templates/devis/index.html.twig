{% extends 'base.html.twig' %}

{% block title %}Demande de Devis Gratuit — Sirius-Solar{% endblock %}

{% block body %}
<style>
    .gooey-navbar { display: flex !important; visibility: visible !important; height: 80px !important; margin: 0 !important; padding: 0 40px !important; }
    .circular-nav-container { display: block !important; visibility: visible !important; height: 280px !important; width: 280px !important; margin: unset !important; padding: unset !important; }

    /* ===== DEVIS PAGE HEADER ===== */
    .devis-header {
        padding: 80px 40px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        text-align: center;
        color: white;

        animation: fadeInDown 0.8s ease-out;
    }

    .devis-header h1 {
        font-size: 42px;
        margin-bottom: 15px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .devis-header p {
        font-size: 16px;
        opacity: 0.95;
        max-width: 600px;
        margin: 0 auto;
    }

    /* ===== FORM CONTAINER ===== */
    .devis-container {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;

        /* Outer gradient */
        background: linear-gradient(135deg, #a8e6cf 0%, #88d8c0 100%);
        padding: 60px 20px;
        overflow: hidden;
    }

    .devis-gradient-bg {
        position: absolute;
        inset: 20px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        border-radius: 20px;
        z-index: 0;
    }

    .devis-form-card {
        position: relative;
        z-index: 1;

        /* Glasmorphism */
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.3);

        border-radius: 20px;
        padding: 60px;
        max-width: 600px;
        width: 100%;

        /* Shadow */
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3),
                    inset 0 0 30px rgba(255, 255, 255, 0.1);

        /* Animation */
        animation: fadeInUp 0.8s ease-out;
    }

    .form-title {
        font-size: 28px;
        font-weight: 700;
        color: white;
        margin-bottom: 10px;
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
    }

    .form-subtitle {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
        text-align: center;
        margin-bottom: 40px;
    }

    /* ===== FORM GROUPS ===== */
    .form-group {
        margin-bottom: 25px;
        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

    .form-group:nth-child(1) { animation-delay: 0.1s; }
    .form-group:nth-child(2) { animation-delay: 0.15s; }
    .form-group:nth-child(3) { animation-delay: 0.2s; }
    .form-group:nth-child(4) { animation-delay: 0.25s; }
    .form-group:nth-child(5) { animation-delay: 0.3s; }
    .form-group:nth-child(6) { animation-delay: 0.35s; }
    .form-group:nth-child(7) { animation-delay: 0.4s; }
    .form-group:nth-child(8) { animation-delay: 0.45s; }
    .form-group:nth-child(9) { animation-delay: 0.5s; }

    /* ===== LABELS ===== */
    .form-group label {
        display: block;
        margin-bottom: 10px;
        font-size: 13px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-group.required label::after {
        content: ' *';
        color: var(--dore);
    }

    /* ===== INPUTS ===== */
    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 14px 16px;
        font-size: 15px;
        font-family: 'Inter', sans-serif;

        /* Glasmorphism input */
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
        color: white;
        border-radius: 8px;

        transition: all 0.3s ease;

        resize: vertical;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--dore);
        box-shadow: 0 0 15px rgba(160, 160, 160, 0.3);
    }

    .form-group textarea {
        min-height: 120px;
    }

    .form-group select {
        appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 12px center;
        background-size: 18px;
        padding-right: 40px;
        cursor: pointer;
    }

    .form-group select option {
        background: var(--vert-fonce);
        color: white;
    }

    /* ===== TWO-COLUMN LAYOUT ===== */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-row .form-group {
        margin-bottom: 0;
    }

    @media (max-width: 600px) {
        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-row .form-group {
            margin-bottom: 25px;
        }
    }

    /* ===== SUBMIT BUTTON ===== */
    .form-submit-group {
        margin-top: 40px;
        display: flex;
        gap: 15px;
    }

    .btn-submit {
        flex: 1;
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        color: #121212;
        border: none;
        padding: 16px 32px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 10px 30px rgba(160, 160, 160, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 20px 50px rgba(160, 160, 160, 0.5);
    }

    .btn-submit:active {
        transform: translateY(-1px) scale(0.98);
    }

    .btn-reset {
        flex: 1;
        background: transparent;
        border: 2px solid rgba(255, 255, 255, 0.5);
        color: white;
        padding: 14px 32px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;

        transition: all 0.3s ease;
    }

    .btn-reset:hover {
        border-color: white;
        background: rgba(255, 255, 255, 0.1);
    }

    /* ===== SUCCESS MESSAGE ===== */
    .alert-success {
        background: rgba(76, 175, 80, 0.2);
        border: 1px solid rgba(76, 175, 80, 0.5);
        color: #90EE90;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 30px;
        font-size: 14px;
        animation: fadeInDown 0.6s ease-out;
    }

    /* ===== INFO BOX ===== */
    .devis-info-box {
        background: rgba(160, 160, 160, 0.1);
        border-left: 4px solid var(--dore);
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 40px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.6;
    }

    /* ===== LAVAGE TYPE SELECTION ===== */
    .lavage-section {
        background: rgba(160, 160, 160, 0.08);
        border: 1px solid rgba(160, 160, 160, 0.3);
        border-radius: 12px;
        padding: 30px;
        margin: 30px 0;
        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

    .lavage-section:nth-child(2) {
        animation-delay: 0.6s;
    }

    .lavage-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--vert-fonce);
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .lavage-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
    }

    .lavage-card {
        position: relative;
        cursor: pointer;
    }

    .lavage-card input[type="checkbox"] {
        display: none;
    }

    .lavage-card-label {
        display: block;
        padding: 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(160, 160, 160, 0.3);
        border-radius: 12px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
        font-size: 14px;
        color: var(--vert-fonce);
    }

    .lavage-icon {
        font-size: 28px;
        margin-bottom: 8px;
        display: block;
    }

    .lavage-name {
        display: block;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .lavage-price {
        font-size: 12px;
        color: var(--dore);
        font-weight: bold;
    }

    .lavage-card input[type="checkbox"]:checked + .lavage-card-label {
        background: rgba(160, 160, 160, 0.2);
        border-color: var(--dore);
        box-shadow: 0 0 15px rgba(160, 160, 160, 0.3);
        transform: scale(1.05);
    }

    .price-summary {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(160, 160, 160, 0.3);
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
    }

    .price-label {
        font-size: 14px;
        font-weight: 600;
    }

    .price-value {
        font-size: 24px;
        font-weight: bold;
        color: var(--dore);
    }

    /* ===== PRICING CALCULATOR SECTION ===== */
    .pricing-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 80px 20px;
    }

    .pricing-head {
        text-align: center;
        margin-bottom: 60px;
    }

    .pricing-head h2 {
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 900;
        margin-bottom: 15px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .pricing-head p {
        color: #666;
        font-size: 1.05rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .pricing-mode {
        display: flex;
        align-items: center;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
    }

    .pricing-mode__label {
        color: #666;
        font-size: 0.95rem;
        font-weight: 600;
    }

    /* Toggle Switch */
    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 26px;
        width: 26px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        -webkit-transition: .4s;
        transition: .4s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: var(--dore);
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(26px);
        -ms-transform: translateX(26px);
        transform: translateX(26px);
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-top: 60px;
    }

    .pricing-card {
        position: relative;
        background: white;
        border-radius: 20px;
        padding: 40px 30px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border: 2px solid transparent;
        display: flex;
        flex-direction: column;
    }

    .pricing-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 60px rgba(160, 160, 160, 0.2);
        border-color: var(--dore);
    }

    .pricing-card.featured {
        border-color: var(--dore);
        background: linear-gradient(135deg, rgba(160, 160, 160, 0.05) 0%, rgba(244, 208, 63, 0.05) 100%);
        transform: scale(1.05);
    }

    .pricing-card.featured:hover {
        transform: scale(1.08) translateY(-8px);
    }

    /* === SELECTED STATE === */
    .pricing-card.selected {
        border-color: var(--dore);
        background: linear-gradient(135deg, rgba(160, 160, 160, 0.1) 0%, rgba(168, 168, 168, 0.05) 100%);
        box-shadow: 0 0 30px rgba(160, 160, 160, 0.4), inset 0 0 20px rgba(168, 168, 168, 0.1);
    }

    .pricing-card.selected::before {
        content: '✓';
        position: absolute;
        top: 20px;
        right: 20px;
        width: 40px;
        height: 40px;
        background: var(--dore);
        color: white;
        font-size: 24px;
        font-weight: bold;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(168, 168, 168, 0.3);
    }

    .pricing-card.featured.selected {
        transform: scale(1.08);
    }

    .pricing-card__head {
        margin-bottom: 25px;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 20px;
    }

    .pricing-card__title {
        font-size: 22px;
        font-weight: 700;
        color: var(--vert-fonce);
        margin-bottom: 8px;
    }

    .pricing-card__sub {
        font-size: 14px;
        color: #999;
        margin: 0;
    }

    .pricing-card__price {
        font-size: 42px;
        font-weight: 900;
        color: var(--dore);
        margin-bottom: 5px;
    }

    .pricing-card__period {
        font-size: 14px;
        color: #999;
        margin-bottom: 25px;
    }

    .pricing-features {
        flex-grow: 1;
        margin-bottom: 30px;
    }

    .pricing-features li {
        list-style: none;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 14px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pricing-features li:before {
        content: "✓";
        color: var(--dore);
        font-weight: bold;
        font-size: 16px;
    }

    .pricing-features li:last-child {
        border-bottom: none;
    }

    .pricing-card__btn {
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        color: #121212;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .pricing-card__btn:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 30px rgba(160, 160, 160, 0.3);
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .devis-header {
            padding: 60px 20px;
        }

        .devis-header h1 {
            font-size: 28px;
        }

        .devis-container {
            padding: 40px 10px;
        }

        .devis-gradient-bg {
            inset: 10px;
        }

        .devis-form-card {
            padding: 40px 24px;
        }

        .form-title {
            font-size: 22px;
        }

        .form-submit-group {
            flex-direction: column;
        }

        .btn-submit, .btn-reset {
            width: 100%;
        }

        .lavage-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .price-summary {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        .pricing-card.featured {
            transform: scale(1);
        }

        .pricing-card.featured:hover {
            transform: translateY(-8px) scale(1);
        }

        .pricing-grid {
            grid-template-columns: 1fr;
        }

        .pricing-head h2 {
            font-size: 28px;
        }
    }

    /* ===================================================================
       Thème sombre + dalles 3D épaisses à tranche bleu néon
       =================================================================== */
    html, body { background: #03120e !important; }
    .devis-header {
        padding-top: 130px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, #046b4c 60%, #03120e 100%);
        border-bottom: 1px solid rgba(61, 220, 151, 0.25);
    }
    .devis-header h1 { color: #fff; text-shadow: 0 0 18px rgba(61, 220, 151, 0.35); }

    .pricing-head h2 {
        background: linear-gradient(90deg, #ffffff 0%, #3ddc97 60%, #00b377 100%);
        -webkit-background-clip: text;
        background-clip: text;
        filter: drop-shadow(0 0 14px rgba(61, 220, 151, 0.3));
    }
    .pricing-head p,
    .pricing-mode__label { color: rgba(234, 255, 240, 0.75); }

    /* Shared 3D slab: stacked outlines in depth give a thick mint glass edge. */
    .slab3d { transform-style: preserve-3d; }
    .slab3d__layers {
        position: absolute;
        inset: 0;
        z-index: 0;
        transform-style: preserve-3d;
        pointer-events: none;
    }
    .slab3d__layers span {
        position: absolute;
        inset: -1px;
        border-radius: 20px;
        border: 1.5px solid rgba(0, 200, 255, calc(0.8 - var(--i) * 0.02));
        background: rgba(0, 70, 120, 0.06);
        transform: translateZ(calc(var(--i) * -4px));
    }
    .slab3d__layers span:last-child {
        background: rgba(2, 10, 20, 0.65);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55), 0 0 50px rgba(0, 200, 255, 0.25);
    }
    .slab3d > :not(.slab3d__layers) { position: relative; z-index: 1; }

    /* Offer cards */
    .pricing-grid { perspective: 1400px; gap: 44px; padding: 10px; }
    .pricing-card,
    .pricing-card.featured,
    .pricing-card.selected {
        background: rgba(3, 12, 22, 0.5);
        border: 0;
        box-shadow: none;
        transform: rotateY(-14deg) rotateX(6deg);
        transition: transform 0.7s cubic-bezier(.2, .8, .2, 1);
    }
    .pricing-card.featured { transform: rotateY(-14deg) rotateX(6deg) translateZ(30px); }
    .pricing-card:hover,
    .pricing-card.featured:hover,
    .pricing-card.featured.selected { transform: rotateY(0) rotateX(0) translateZ(40px); box-shadow: none; }
    .pricing-card.selected .slab3d__layers span { border-color: rgba(255, 210, 31, 0.8); }
    .pricing-card.selected::before { z-index: 2; background: #ffd21f; color: #021208; }
    .pricing-card__head { border-bottom-color: rgba(0, 200, 255, 0.25); }
    .pricing-card__title { color: #3cd6ff; text-shadow: 0 0 12px rgba(0, 200, 255, 0.55); }
    .pricing-card__sub,
    .pricing-card__period { color: rgba(234, 255, 240, 0.6); }
    .pricing-card__price { color: #ffd21f; text-shadow: 0 0 14px rgba(255, 210, 31, 0.4); }
    .pricing-features li { color: rgba(234, 255, 240, 0.9); border-bottom-color: rgba(0, 200, 255, 0.14); }
    .pricing-features li:before { color: #3cd6ff; }
    .pricing-card__btn { background: linear-gradient(135deg, #ffd21f, #ffe27a); color: #021208; }

    /* Quote form */
    .devis-container { background: #03120e; perspective: 1600px; }
    .devis-gradient-bg {
        background: radial-gradient(ellipse at 30% 20%, rgba(61, 220, 151, 0.12) 0%, transparent 55%),
                    radial-gradient(ellipse at 80% 90%, rgba(11, 93, 138, 0.25) 0%, transparent 55%),
                    linear-gradient(135deg, #062a20 0%, #03120e 100%);
        border: 1px solid rgba(61, 220, 151, 0.12);
    }
    .devis-form-card {
        background: rgba(3, 12, 22, 0.55);
        backdrop-filter: none;          /* a filter would flatten the 3D */
        -webkit-backdrop-filter: none;
        border: 0;
        box-shadow: none;
        transform: rotateY(-7deg) rotateX(3deg);
        animation: none;
    }
    .lavage-title,
    .lavage-name { color: #3cd6ff; text-shadow: 0 0 8px rgba(0, 200, 255, 0.4); }
    .btn-submit {
        background: linear-gradient(135deg, #ffd21f, #ffe27a);
        color: #021208;
        box-shadow: 0 0 22px rgba(255, 210, 31, 0.35);
    }
    .lavage-price, .price-value { color: #ffd21f; }

    @media (max-width: 768px) {
        .devis-header { padding-top: 100px; }
        .pricing-card, .pricing-card.featured, .pricing-card.selected { transform: rotateY(-7deg) rotateX(4deg); }
        .devis-form-card { transform: rotateY(-4deg) rotateX(2deg); }
        .slab3d__layers span { transform: translateZ(calc(var(--i) * -3px)); }
    }
    @media (prefers-reduced-motion: reduce) {
        .pricing-card, .pricing-card:hover, .devis-form-card { transform: none !important; transition: none; }
    }
    /* ===== Onglets devis (toit / accès / eau & électricité) ===== */
    .field-hint { display: block; margin-top: 6px; font-size: 12px; color: rgba(255, 255, 255, 0.6); }
    .devis-tabs { border: 0; padding: 0; margin: 0 0 22px; min-width: 0; }
    .devis-tabs legend { padding: 0; margin-bottom: 10px; font-weight: 600; font-size: 14px; color: #fff; }
    .devis-tabs .req { color: var(--dore); }
    .seg { display: grid; gap: 8px; padding: 6px; border-radius: 14px; background: rgba(0, 0, 0, 0.28); border: 1px solid rgba(255, 255, 255, 0.14); }
    .seg--2 { grid-template-columns: repeat(2, 1fr); }
    .seg--4 { grid-template-columns: repeat(4, 1fr); }
    .seg input { position: absolute; opacity: 0; pointer-events: none; }
