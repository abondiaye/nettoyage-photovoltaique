{% extends 'base.html.twig' %}

{% block title %}Demande de Devis Gratuit — Sirius-Solar{% endblock %}

{% block body %}
<style>
    /* ===== DEVIS PAGE HEADER ===== */
    .devis-header {
        padding: 80px 40px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        text-align: center;
        color: white;

        animation: fadeInDown 0.8s ease-out;
    }

    .devis-header h1 {
        font-size: 42px;
        margin-bottom: 15px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .devis-header p {
        font-size: 16px;
        opacity: 0.95;
        max-width: 600px;
        margin: 0 auto;
    }

    /* ===== FORM CONTAINER ===== */
    .devis-container {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;

        /* Outer gradient */
        background: linear-gradient(135deg, #a8e6cf 0%, #88d8c0 100%);
        padding: 60px 20px;
        overflow: hidden;
    }

    .devis-gradient-bg {
        position: absolute;
        inset: 20px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        border-radius: 20px;
        z-index: 0;
    }

    .devis-form-card {
        position: relative;
        z-index: 1;

        /* Glasmorphism */
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.3);

        border-radius: 20px;
        padding: 60px;
        max-width: 600px;
        width: 100%;

        /* Shadow */
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3),
                    inset 0 0 30px rgba(255, 255, 255, 0.1);

        /* Animation */
        animation: fadeInUp 0.8s ease-out;
    }

    .form-title {
        font-size: 28px;
        font-weight: 700;
        color: white;
        margin-bottom: 10px;
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
    }

    .form-subtitle {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
        text-align: center;
        margin-bottom: 40px;
    }

    /* ===== FORM GROUPS ===== */
    .form-group {
        margin-bottom: 25px;
        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

    .form-group:nth-child(1) { animation-delay: 0.1s; }
    .form-group:nth-child(2) { animation-delay: 0.15s; }
    .form-group:nth-child(3) { animation-delay: 0.2s; }
    .form-group:nth-child(4) { animation-delay: 0.25s; }
    .form-group:nth-child(5) { animation-delay: 0.3s; }
    .form-group:nth-child(6) { animation-delay: 0.35s; }
    .form-group:nth-child(7) { animation-delay: 0.4s; }
    .form-group:nth-child(8) { animation-delay: 0.45s; }
    .form-group:nth-child(9) { animation-delay: 0.5s; }

    /* ===== LABELS ===== */
    .form-group label {
        display: block;
        margin-bottom: 10px;
        font-size: 13px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-group.required label::after {
        content: ' *';
        color: var(--dore);
    }

    /* ===== INPUTS ===== */
    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 14px 16px;
        font-size: 15px;
        font-family: 'Inter', sans-serif;

        /* Glasmorphism input */
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
        color: white;
        border-radius: 8px;

        transition: all 0.3s ease;

        resize: vertical;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--dore);
        box-shadow: 0 0 15px rgba(212, 168, 66, 0.3);
    }

    .form-group textarea {
        min-height: 120px;
    }

    /* ===== TWO-COLUMN LAYOUT ===== */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-row .form-group {
        margin-bottom: 0;
    }

    @media (max-width: 600px) {
        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-row .form-group {
            margin-bottom: 25px;
        }
    }

    /* ===== SUBMIT BUTTON ===== */
    .form-submit-group {
        margin-top: 40px;
        display: flex;
        gap: 15px;
    }

    .btn-submit {
        flex: 1;
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        color: #121212;
        border: none;
        padding: 16px 32px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 10px 30px rgba(212, 168, 66, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 20px 50px rgba(212, 168, 66, 0.5);
    }

    .btn-submit:active {
        transform: translateY(-1px) scale(0.98);
    }

    .btn-reset {
        flex: 1;
        background: transparent;
        border: 2px solid rgba(255, 255, 255, 0.5);
        color: white;
        padding: 14px 32px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;

        transition: all 0.3s ease;
    }

    .btn-reset:hover {
        border-color: white;
        background: rgba(255, 255, 255, 0.1);
    }

    /* ===== SUCCESS MESSAGE ===== */
    .alert-success {
        background: rgba(76, 175, 80, 0.2);
        border: 1px solid rgba(76, 175, 80, 0.5);
        color: #90EE90;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 30px;
        font-size: 14px;
        animation: fadeInDown 0.6s ease-out;
    }

    /* ===== INFO BOX ===== */
    .devis-info-box {
        background: rgba(212, 168, 66, 0.1);
        border-left: 4px solid var(--dore);
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 40px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.6;
    }

    /* ===== LAVAGE TYPE SELECTION ===== */
    .lavage-section {
        background: rgba(212, 168, 66, 0.08);
        border: 1px solid rgba(212, 168, 66, 0.3);
        border-radius: 12px;
        padding: 30px;
        margin: 30px 0;
        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

    .lavage-section:nth-child(2) {
        animation-delay: 0.6s;
    }

    .lavage-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--vert-fonce);
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .lavage-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
    }

    .lavage-card {
        position: relative;
        cursor: pointer;
    }

    .lavage-card input[type="checkbox"] {
        display: none;
    }

    .lavage-card-label {
        display: block;
        padding: 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(212, 168, 66, 0.3);
        border-radius: 12px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
        font-size: 14px;
        color: var(--vert-fonce);
    }

    .lavage-icon {
        font-size: 28px;
        margin-bottom: 8px;
        display: block;
    }

    .lavage-name {
        display: block;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .lavage-price {
        font-size: 12px;
        color: var(--dore);
        font-weight: bold;
    }

    .lavage-card input[type="checkbox"]:checked + .lavage-card-label {
        background: rgba(212, 168, 66, 0.2);
        border-color: var(--dore);
        box-shadow: 0 0 15px rgba(212, 168, 66, 0.3);
        transform: scale(1.05);
    }

    .price-summary {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(212, 168, 66, 0.3);
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
    }

    .price-label {
        font-size: 14px;
        font-weight: 600;
    }

    .price-value {
        font-size: 24px;
        font-weight: bold;
        color: var(--dore);
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .devis-header {
            padding: 60px 20px;
        }

        .devis-header h1 {
            font-size: 28px;
        }

        .devis-container {
            padding: 40px 10px;
        }

        .devis-gradient-bg {
            inset: 10px;
        }

        .devis-form-card {
            padding: 40px 24px;
        }

        .form-title {
            font-size: 22px;
        }

        .form-submit-group {
            flex-direction: column;
        }

        .btn-submit, .btn-reset {
            width: 100%;
        }

        .lavage-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .price-summary {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }
    }
</style>

<!-- Header -->
<div class="devis-header" style="position: relative;">
    <a href="{{ path('app_home') }}" style="position: absolute; top: 20px; right: 40px; color: rgba(255,255,255,0.8); text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: all 0.3s ease;">
        ← Retour à l'accueil
    </a>
    <h1>Demande de Devis Gratuit</h1>
    <p>Remplissez le formulaire ci-dessous et nos experts Sirius-Solar vous répondront dans les 48 heures</p>
</div>

<!-- Form Section -->
<section class="devis-container">
    <div class="devis-gradient-bg"></div>

    <div class="devis-form-card">
        {% for message in app.flashes('success') %}
            <div class="alert-success">
                ✅ {{ message }}
            </div>
        {% endfor %}

        <div class="form-title">Formulaire de Devis</div>
        <p class="form-subtitle">Informations de contact et installation</p>

        <div class="devis-info-box">
            ℹ️ Tous les champs marqués avec un <span style="color: var(--dore);">*</span> sont obligatoires. Nous vous garantissons une réponse rapide.
        </div>

        <form method="POST" action="{{ path('app_devis') }}" novalidate>
            <!-- Nom & Prénom -->
            <div class="form-row">
                <div class="form-group required">
                    <label for="clientPrenom">Prénom</label>
                    <input type="text" id="clientPrenom" name="devis[clientPrenom]" placeholder="Votre prénom" required>
                </div>

                <div class="form-group required">
                    <label for="clientNom">Nom</label>
                    <input type="text" id="clientNom" name="devis[clientNom]" placeholder="Votre nom" required>
                </div>
            </div>

            <!-- Email & Phone -->
            <div class="form-row">
                <div class="form-group required">
                    <label for="clientEmail">Email</label>
                    <input type="email" id="clientEmail" name="devis[clientEmail]" placeholder="votre@email.ch" required>
                </div>

                <div class="form-group required">
                    <label for="clientTelephone">Téléphone</label>
                    <input type="tel" id="clientTelephone" name="devis[clientTelephone]" placeholder="+41 XX XXX XX XX" required>
                </div>
            </div>

            <!-- Address -->
            <div class="form-group required">
                <label for="clientAdresse">Adresse</label>
                <input type="text" id="clientAdresse" name="devis[clientAdresse]" placeholder="Rue et numéro" required>
            </div>

            <!-- Postal Code & City -->
            <div class="form-row">
                <div class="form-group required">
                    <label for="clientCodePostal">Code Postal</label>
                    <input type="text" id="clientCodePostal" name="devis[clientCodePostal]" placeholder="1200" required>
                </div>

                <div class="form-group required">
                    <label for="clientVille">Ville</label>
                    <input type="text" id="clientVille" name="devis[clientVille]" placeholder="Genève" required>
                </div>
            </div>

            <!-- Types de Lavage -->
            <div class="lavage-section">
                <div class="lavage-title">
                    🧹 Types de Lavage (Sélectionnez un ou plusieurs)
                </div>

                <div class="lavage-grid">
                    <!-- Nettoyage Standard -->
                    <div class="lavage-card">
                        <input type="checkbox" id="lavage_standard" name="lavage_types[]" value="standard" data-price="120">
                        <label for="lavage_standard" class="lavage-card-label">
                            <span class="lavage-icon">💧</span>
                            <span class="lavage-name">Standard</span>
                            <span class="lavage-price">CHF 120</span>
                        </label>
                    </div>

                    <!-- Nettoyage Premium -->
                    <div class="lavage-card">
                        <input type="checkbox" id="lavage_premium" name="lavage_types[]" value="premium" data-price="180">
                        <label for="lavage_premium" class="lavage-card-label">
                            <span class="lavage-icon">⭐</span>
                            <span class="lavage-name">Premium</span>
                            <span class="lavage-price">CHF 180</span>
                        </label>
                    </div>

                    <!-- Haute Pression -->
                    <div class="lavage-card">
                        <input type="checkbox" id="lavage_haute_pression" name="lavage_types[]" value="haute_pression" data-price="150">
                        <label for="lavage_haute_pression" class="lavage-card-label">
                            <span class="lavage-icon">⚡</span>
                            <span class="lavage-name">Haute Pression</span>
                            <span class="lavage-price">CHF 150</span>
                        </label>
                    </div>

                    <!-- Inspection -->
                    <div class="lavage-card">
                        <input type="checkbox" id="lavage_inspection" name="lavage_types[]" value="inspection" data-price="80">
                        <label for="lavage_inspection" class="lavage-card-label">
                            <span class="lavage-icon">🔍</span>
                            <span class="lavage-name">Inspection</span>
                            <span class="lavage-price">CHF 80</span>
                        </label>
                    </div>

                    <!-- Protection Sealant -->
                    <div class="lavage-card">
                        <input type="checkbox" id="lavage_protection" name="lavage_types[]" value="protection" data-price="200">
                        <label for="lavage_protection" class="lavage-card-label">
                            <span class="lavage-icon">🛡️</span>
                            <span class="lavage-name">Protection</span>
                            <span class="lavage-price">CHF 200</span>
                        </label>
                    </div>

                    <!-- Analyse Performance -->
                    <div class="lavage-card">
                        <input type="checkbox" id="lavage_analyse" name="lavage_types[]" value="analyse" data-price="120">
                        <label for="lavage_analyse" class="lavage-card-label">
                            <span class="lavage-icon">📊</span>
                            <span class="lavage-name">Analyse</span>
                            <span class="lavage-price">CHF 120</span>
                        </label>
                    </div>
                </div>

                <div class="price-summary">
                    <span class="price-label">💰 Prix Total Estimé</span>
                    <span class="price-value" id="totalPrice">CHF 0</span>
                </div>
            </div>

            <!-- Message -->
            <div class="form-group">
                <label for="message">Message additionnel</label>
                <textarea id="message" name="message" placeholder="Décrivez votre installation solaire, nombre de panneaux, etc..."></textarea>
            </div>

            <!-- Submit -->
            <div class="form-submit-group">
                <button type="submit" class="btn-submit">Envoyer la demande</button>
                <button type="reset" class="btn-reset">Réinitialiser</button>
            </div>
        </form>
    </div>
</section>

<script>
    // Calculate total price based on selected lavage types
    function updateTotalPrice() {
        let total = 0;
        const checkboxes = document.querySelectorAll('input[name="lavage_types[]"]');

        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                const price = parseInt(checkbox.getAttribute('data-price'));
                total += price;
            }
        });

        const totalPriceElement = document.getElementById('totalPrice');
        if (total === 0) {
            totalPriceElement.textContent = 'CHF 0';
        } else {
            totalPriceElement.textContent = 'CHF ' + total;
        }
    }

    // Add event listeners to all checkboxes
    document.querySelectorAll('input[name="lavage_types[]"]').forEach(checkbox => {
        checkbox.addEventListener('change', updateTotalPrice);
    });

    // Initialize on page load
    updateTotalPrice();
</script>

{% endblock %}
