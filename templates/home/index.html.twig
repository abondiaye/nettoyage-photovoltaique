    .why-face--left,
    .why-face--right {
        top: 0;
        width: var(--d);
        height: var(--h);
        transform-origin: left center;
        transform: rotateY(90deg);
        background: linear-gradient(90deg, #0e3150 0%, #081a2b 100%);
