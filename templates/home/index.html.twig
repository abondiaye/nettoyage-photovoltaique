{% extends 'base.html.twig' %}

{% block title %}Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques{% endblock %}

{% block body %}
<style>
    /* Remove all padding/margin from body and html */
    html {
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: clip !important;   /* clip, not hidden: the window keeps scrolling (hidden made <body> the scroller) */
        overflow-y: visible !important;
        width: 100% !important;
    }

    body {
        padding-top: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: clip !important;
        overflow-y: visible !important;
        width: 100% !important;
        box-sizing: border-box;
    }

    /* ===== HERO SECTION ===== */
    .hero-container {
        position: relative;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0;
        width: 100%;
        overflow: hidden;
    }

    .hero-gradient-bg {
        position: absolute;
        inset: 0;
        background: none;
        border-radius: 0;
        z-index: 0;
        overflow: hidden;
        filter: brightness(1.15) contrast(1.1);
    }

    .hero-gradient-bg img,
    .hero-gradient-bg video {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
    }

    .hero-gradient-bg img {
        z-index: 1;
        opacity: 1.2;
        filter: brightness(1.2) contrast(1.15);
    }

    .hero-gradient-bg video {
        z-index: 2;
        opacity: 0.4;
        mix-blend-mode: lighten;
    }

    .hero-card {
        position: relative;
        z-index: 1;
        overflow: visible;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        /* Glasmorphism */
        background: rgba(0, 0, 0, 0.12);
        backdrop-filter: blur(2px);
        border: 1px solid rgba(61, 220, 151, 0.55);

        border-radius: 20px;
        padding: 100px 60px 80px 60px;
        max-width: 820px;
        text-align: center;
        color: white;

        /* Shadow */
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3),
                    0 0 40px rgba(61, 220, 151, 0.2),
                    inset 0 0 30px rgba(255, 255, 255, 0.1);

        /* Animation */
        animation: fadeInUp 0.8s ease-out, raindropsEffect 4s ease-in-out infinite;
    }

    .hero-logo {
        position: absolute;
        top: -55px;
        left: 50%;
        transform: translateX(-50%);
        width: 200px;
        height: 110px;
        background: linear-gradient(180deg, #c3dfe1 0%, #a8d5e0 100%);
        border-radius: 16px;
        padding: 12px;
        border: 2px solid rgba(61, 220, 151, 0.8);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.4),
                    0 0 30px rgba(61, 220, 151, 0.5),
                    inset -5px -5px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        animation: logoFloat 3s ease-in-out infinite;
        overflow: hidden;
    }

    .hero-logo::before {
        content: '';
        position: absolute;
        top: 5px;
        left: 5px;
        width: 60px;
        height: 35px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        z-index: 1;
        filter: blur(8px);
        animation: cloudDriftLeft 8s ease-in-out infinite;
    }

    .hero-logo::after {
        content: '';
        position: absolute;
        top: 20px;
        right: 15px;
        width: 70px;
        height: 40px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        z-index: 1;
        filter: blur(10px);
        animation: cloudDriftRight 10s ease-in-out infinite;
    }

    .hero-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 12px;
        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.15));
        position: relative;
        z-index: 2;
    }

    .hero-logo video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.15));
        position: relative;
        z-index: 2;
    }

    @keyframes logoFloat {
        0%, 100% {
            transform: translateX(-50%) translateY(0px);
        }
        50% {
            transform: translateX(-50%) translateY(-8px);
        }
    }

    @keyframes cloudDriftLeft {
        0%, 100% {
            left: 5px;
            opacity: 0.4;
        }
        25% {
            left: -15px;
            opacity: 0.6;
        }
        50% {
            left: 20px;
            opacity: 0.8;
            filter: blur(8px) brightness(1.1);
        }
        75% {
            left: 10px;
            opacity: 0.5;
        }
    }

    @keyframes cloudDriftRight {
        0%, 100% {
            right: 15px;
            opacity: 0.5;
        }
        25% {
            right: 35px;
            opacity: 0.7;
            filter: blur(10px) brightness(1.15);
        }
        50% {
            right: 5px;
            opacity: 0.4;
        }
        75% {
            right: 25px;
            opacity: 0.65;
        }
    }

    @media (max-width: 768px) {
        .hero-card {
            max-width: 90%;
            padding: 60px 30px 50px 30px;
            margin: 0 20px;
        }

        .hero-logo {
            width: 140px;
            height: 80px;
            top: -40px;
        }

        .hero-title {
            font-size: 32px;
            margin-bottom: 15px;
        }

        .hero-subtitle {
            font-size: 14px;
            margin-bottom: 20px;
        }
    }

    @media (max-width: 480px) {
        .hero-card {
            max-width: 95%;
            padding: 50px 20px 40px 20px;
            margin: 0 10px;
            border-radius: 16px;
        }

        .hero-logo {
            width: 110px;
            height: 65px;
            top: -32px;
        }

        .hero-title {
            font-size: 24px;
            margin-bottom: 12px;
        }

        .hero-subtitle {
            font-size: 12px;
            margin-bottom: 15px;
        }
    }

.hero-title {
        position: relative;
        z-index: 1;
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 20px;
        background: linear-gradient(90deg, #ffffff 0%, #3ddc97 55%, #00b377 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 14px rgba(61, 220, 151, 0.35));
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: -1px;
        animation: titleGlow 4s ease-in-out infinite;
    }

    @keyframes titleGlow {
        0%, 100% { filter: brightness(1); }
        50% { filter: brightness(1.2); }
    }

    .hero-subtitle {
        position: relative;
        z-index: 1;
        font-size: 18px;
        opacity: 0.95;
        margin-bottom: 30px;
        line-height: 1.6;
        font-weight: 500;
        color: #3ddc97;
        text-shadow: 0 0 8px rgba(61, 220, 151, 0.5), 0 0 20px rgba(61, 220, 151, 0.25);
    }

    .hero-features {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .feature-tag {
        background: rgba(61, 220, 151, 0.1);
        border: 1px solid rgba(61, 220, 151, 0.5);
        color: #3ddc97;
        text-shadow: 0 0 8px rgba(61, 220, 151, 0.4);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        animation: fadeInUp 0.8s ease-out;
        animation-fill-mode: both;
    }

    .feature-tag:nth-child(1) { animation-delay: 0.1s; }
    .feature-tag:nth-child(2) { animation-delay: 0.2s; }
    .feature-tag:nth-child(3) { animation-delay: 0.3s; }

    .btn-cta {
        position: relative;
        z-index: 1;
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        color: #121212;
        border: none;
        padding: 16px 40px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

        box-shadow: 0 10px 30px rgba(160, 160, 160, 0.3);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-cta:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 20px 50px rgba(160, 160, 160, 0.5);
    }

    .btn-cta:active {
        transform: translateY(-1px) scale(0.98);
    }

    @keyframes raindropsEffect {
        0%, 100% {
            box-shadow:
                inset 0 0 50px rgba(160, 160, 160, 0.05),
                0 20px 60px rgba(0, 0, 0, 0.3);
        }
        50% {
            box-shadow:
                inset 0 0 50px rgba(160, 160, 160, 0.15),
                0 20px 60px rgba(160, 160, 160, 0.2);
        }
    }

    .raindrops-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 20px;
        pointer-events: none;
        object-fit: cover;
        opacity: 0.95;
        z-index: 0;
    }

    .hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.1);
        z-index: 0.5;
        border-radius: 20px;
        pointer-events: none;
    }

    /* ===== SERVICES SECTION ===== */
    .services-section {
        padding: 100px 40px;
        position: relative;
    }

    .services-section > * {
        position: relative;
        z-index: 1;
    }

    .section-title {
        font-size: 42px;
        text-align: center;
        margin-bottom: 60px;
        background: linear-gradient(90deg, #ffffff 0%, #3ddc97 55%, #00b377 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 14px rgba(61, 220, 151, 0.35));
        animation: fadeInDown 0.6s ease-out;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    @keyframes liquidTitleFlow {
        0%, 100% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .service-card {
        /* Background with rain image */
        background-size: cover;
        background-position: center;
        background-attachment: fixed;

        /* Glasmorphism overlay */
        position: relative;
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        border: 2px solid rgba(0, 212, 255, 0.3);

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: pointer;

        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
        overflow: hidden;
    }

    .service-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(20px);
        z-index: 1;
        border-radius: 16px;
        pointer-events: none;
    }

    .service-card:nth-child(1) { animation-delay: 0.1s; }
    .service-card:nth-child(2) { animation-delay: 0.2s; }
    .service-card:nth-child(3) { animation-delay: 0.3s; }

    .service-card > * {
        position: relative;
        z-index: 2;
    }

    .service-card:hover {
        transform: translateY(-10px) scale(1.02);
        border-color: #00d4ff;
        box-shadow: 0 20px 60px rgba(0, 212, 255, 0.3), 0 0 30px rgba(0, 212, 255, 0.2);
        animation: liquidGlow 1.5s ease-in-out;
    }

    @keyframes liquidGlow {
        0%, 100% {
            box-shadow: 0 20px 60px rgba(0, 212, 255, 0.3), 0 0 30px rgba(0, 212, 255, 0.2);
        }
        50% {
            box-shadow: 0 20px 60px rgba(0, 212, 255, 0.5), 0 0 50px rgba(0, 212, 255, 0.4);
        }
    }

    .card-icon {
        font-size: 48px;
        margin-bottom: 20px;
        transition: transform 0.4s ease;
    }

    .service-card:hover .card-icon {
        transform: scale(1.2) rotateZ(10deg);
    }

    .service-card h3 {
        font-size: 22px;
        color: var(--vert-fonce);
        margin-bottom: 15px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .service-card p {
        color: #666;
        line-height: 1.6;
        margin-bottom: 25px;
        font-size: 15px;
    }

    .btn-learn {
        background: transparent;
        border: 2px solid var(--dore);
        color: var(--dore);
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

    .btn-learn:hover {
        background: var(--dore);
        color: white;
        transform: scale(1.05);
    }

    /* ===== ADVANTAGES SECTION ===== */
    .advantages-section {
        position: relative;
        padding: 100px 40px;
        background-size: cover;
        background-position: center;
        overflow: hidden;
    }

    /* Animation subtile en arrière-plan */
    .advantages-bg-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.3;
        z-index: -1;
        opacity: 0.08;  /* Très subtil */
        pointer-events: none;
        display: none !important;
    }

    /* En mode sombre, rendre l'animation encore plus subtile */
    body.dark-mode .advantages-bg-video {
        opacity: 0.05;
    }

    /* Désactiver la vidéo sur mobile pour performance */
    @media (max-width: 768px) {
        .advantages-bg-video {
            display: none;
        }
    }

    .advantages-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .advantage-card {
        background: rgba(61, 220, 151, 0.08);
        backdrop-filter: blur(20px);
        border: 2px solid rgba(61, 220, 151, 0.3);

        border-radius: 16px;
        padding: 40px;
        text-align: center;

        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;

        transition: all 0.3s ease;
        position: relative;
        padding-top: 60px;
    }

    .advantage-card::before {
        content: attr(data-number);
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 60px;
        background:
            radial-gradient(circle at 30% 30%, rgba(255, 255, 200, 0.9), transparent 50%),
            radial-gradient(circle at 70% 70%, rgba(100, 80, 0, 0.3), transparent 50%),
            linear-gradient(135deg, #ffd700 0%, #ffed4e 25%, #d4a842 50%, #b8860b 75%, #cd853f 100%);
        border: 3px solid #d4a842;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 28px;
        color: #3d2817;
        box-shadow:
            inset 0 2px 5px rgba(255, 255, 150, 0.7),
            inset 0 -2px 5px rgba(100, 80, 0, 0.5),
            0 8px 20px rgba(160, 160, 160, 0.5),
            0 0 20px rgba(255, 215, 0, 0.4);
        transition: all 0.3s ease;
    }

    .advantage-card:nth-child(1) { animation-delay: 0.1s; }
    .advantage-card:nth-child(1)::before { content: "1"; }

    .advantage-card:nth-child(2) { animation-delay: 0.2s; }
    .advantage-card:nth-child(2)::before { content: "2"; }

    .advantage-card:nth-child(3) { animation-delay: 0.3s; }
    .advantage-card:nth-child(3)::before { content: "3"; }

    .advantage-card:nth-child(4) { animation-delay: 0.4s; }
    .advantage-card:nth-child(4)::before { content: "4"; }

    .advantage-card:hover {
        transform: translateY(-8px) scale(1.01);
        box-shadow: 0 15px 45px rgba(61, 220, 151, 0.2), 0 0 30px rgba(61, 220, 151, 0.15);
        border-color: #3ddc97;
        animation: liquidCardPulse 2s ease-in-out;
    }

    @keyframes liquidCardPulse {
        0%, 100% {
            box-shadow: 0 15px 45px rgba(61, 220, 151, 0.2), 0 0 30px rgba(61, 220, 151, 0.15);
        }
        50% {
            box-shadow: 0 15px 45px rgba(61, 220, 151, 0.4), 0 0 40px rgba(61, 220, 151, 0.3);
        }
    }

    .advantage-card:hover::before {
        transform: translateX(-50%) scale(1.2);
        box-shadow: 0 12px 30px rgba(255, 215, 0, 0.6), 0 0 20px rgba(255, 215, 0, 0.4);
        animation: goldenPulse 1.5s ease-in-out;
    }

    @keyframes goldenPulse {
        0%, 100% { filter: brightness(1); }
        50% { filter: brightness(1.3); }
    }

    .advantage-icon {
        font-size: 42px;
        margin-bottom: 15px;
    }

    .advantage-card h3 {
        font-size: 20px;
        color: #3ddc97;
        text-shadow: 0 0 8px rgba(61, 220, 151, 0.4);
        margin-bottom: 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .advantage-card p {
        color: rgba(61, 220, 151, 0.8);
        font-size: 14px;
        line-height: 1.6;
    }

    /* ===== CTA SECTION ===== */
    .cta-section {
        padding: 80px 40px;
        background-image:
            linear-gradient(135deg, rgba(10, 61, 53, 0.3) 0%, rgba(10, 61, 53, 0.3) 100%),
            url('/images/SOLAR.jpeg');
        background-size: auto 100%;
        background-position: center center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .cta-content {
        max-width: 600px;
        margin: 0 auto;
        animation: fadeInUp 0.8s ease-out;
        position: relative;
        z-index: 2;
    }

    .cta-title {
        font-size: 38px;
        margin-bottom: 20px;
        background: linear-gradient(90deg, #ffffff 0%, #3ddc97 55%, #00b377 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 14px rgba(61, 220, 151, 0.35));
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .cta-text {
        font-size: 19px;
        margin-bottom: 40px;
        opacity: 0.95;
        line-height: 1.7;
        color: #3ddc97;
        text-shadow: 0 0 10px rgba(61, 220, 151, 0.4);
        font-family: 'Bebas Neue', 'Space Grotesk', sans-serif;
        letter-spacing: 0.5px;
    }

    .optimization-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
        margin-bottom: 50px;
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
        text-align: left;
    }

    .detail-item {
        background: rgba(61, 220, 151, 0.06);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(61, 220, 151, 0.25);
        padding: 25px;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .detail-item:hover {
        background: rgba(61, 220, 151, 0.1);
        border-color: rgba(61, 220, 151, 0.5);
        box-shadow: 0 10px 30px rgba(61, 220, 151, 0.15);
        transform: translateY(-5px);
    }

    .detail-item h4 {
        font-size: 19px;
        margin-bottom: 12px;
        font-weight: 600;
        color: #3ddc97;
        text-shadow: 0 0 8px rgba(61, 220, 151, 0.4);
        font-family: 'Bebas Neue', 'Space Grotesk', sans-serif;
        letter-spacing: 0.5px;
    }

    .detail-item p {
        font-size: 16px;
        opacity: 0.95;
        line-height: 1.6;
        margin: 0;
        color: rgba(61, 220, 151, 0.85);
        font-family: 'Bebas Neue', 'Space Grotesk', sans-serif;
        letter-spacing: 0.3px;
    }

    .btn-cta-white {
        background: linear-gradient(135deg, #3ddc97, #00b377);
        color: #021410;
        border: none;
        padding: 16px 40px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 10px 30px rgba(61, 220, 151, 0.3);
    }

    .btn-cta-white:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 20px 50px rgba(61, 220, 151, 0.5);
    }

    /* ===== FOOTER ===== */
    .footer {
        background: var(--noir);
        color: rgba(255, 255, 255, 0.7);
        padding: 60px 40px 30px;
    }

    .contact-scramble-heading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 4px;
    }

    .scramble-green {
        display: inline-block;
        min-height: 1.1em;
        font-size: 34px;
        font-weight: 700;
        color: #3ddc97;
        font-family: 'Bebas Neue', 'Space Grotesk', sans-serif;
        letter-spacing: 0.04em;
        text-shadow: 0 0 16px rgba(61, 220, 151, 0.6), 0 0 40px rgba(61, 220, 151, 0.25);
    }

    .scramble-green .char {
        display: inline-block;
    }

    .scramble-green .char.glitch {
        color: rgba(61, 220, 151, 0.5);
        animation: contactFlicker 0.08s steps(1) infinite;
    }

    @keyframes contactFlicker {
        0%, 100% { opacity: 1; }
        50%      { opacity: 0.4; }
    }

    /* Footer with Knob */
    .footer {
        position: relative;
    }

    .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        max-width: 1200px;
