{% extends 'base.html.twig' %}

{% block title %}Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* === NEW MODERN DESIGN INSPIRED BY BUSINESS CARDS === */

        /* Hero Section - Card Design */
        .hero-modern {
            position: relative;
            background: linear-gradient(135deg, rgba(27, 77, 62, 0.9) 0%, rgba(45, 107, 85, 0.85) 100%),
                        url("{{ asset('images/panneaux-solaires-sous-la-pluie.png') }}") center/cover no-repeat;
            background-attachment: fixed;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
            padding: 60px 24px;
            min-height: 700px;
        }

        .hero-card {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 550px;
            background: rgba(255, 255, 255, 0.15);
            color: var(--blanc);
            padding: 60px 40px;
            border-radius: 20px;
            border: 2px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow:
                0 8px 32px rgba(0, 0, 0, 0.2),
                inset 0 0 0 1px rgba(255, 255, 255, 0.2);
            animation: fadeInDown 0.8s ease-out;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        /* Raindrops effect */
        .hero-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
            border-radius: 20px;
            background-image:
                radial-gradient(circle at 20% 10%, rgba(255, 255, 255, 0.8) 3px, transparent 3px),
                radial-gradient(circle at 75% 20%, rgba(255, 255, 255, 0.7) 2.5px, transparent 2.5px),
                radial-gradient(circle at 15% 35%, rgba(255, 255, 255, 0.75) 2px, transparent 2px),
                radial-gradient(circle at 85% 45%, rgba(255, 255, 255, 0.65) 3px, transparent 3px),
                radial-gradient(circle at 45% 15%, rgba(255, 255, 255, 0.7) 2px, transparent 2px),
                radial-gradient(circle at 60% 60%, rgba(255, 255, 255, 0.72) 2.5px, transparent 2.5px),
                radial-gradient(circle at 30% 70%, rgba(255, 255, 255, 0.68) 2px, transparent 2px),
                radial-gradient(circle at 80% 75%, rgba(255, 255, 255, 0.7) 2.5px, transparent 2.5px);
            background-repeat: no-repeat;
            background-size: 100% 100%;
            animation:
                rainfall 4s linear infinite,
                raindrop-flow 8s ease-in-out infinite;
        }

        @keyframes rainfall {
            0% {
                background-position: 0 0;
            }
            100% {
                background-position: 0 100%;
            }
        }

        @keyframes raindrop-flow {
            0%, 100% {
                opacity: 0.5;
            }
            50% {
                opacity: 0.9;
            }
        }

        .hero-logo {
            margin-bottom: 30px;
            color: var(--blanc);
            font-weight: bold;
            animation: fadeInUp 0.8s ease-out;
        }

        .hero-logo svg {
            width: 150px;
            height: auto;
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
        }

        .hero-title {
            font-size: clamp(2.5rem, 6vw, 3.5rem);
            font-weight: 700;
            margin-bottom: 12px;
            letter-spacing: 2px;
            text-shadow: 0 4px 12px rgba(0, 0, 0, 0.4);
            animation: fadeInUp 0.8s ease-out 0.1s both;
        }

        .hero-title-main {
            display: block;
            color: var(--blanc);
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        }

        .hero-title-accent {
            display: block;
            color: var(--jaune-solaire);
            font-size: 1.1em;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        }

        .hero-subtitle {
            font-size: 1.1rem;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.95);
            margin-bottom: 50px;
            letter-spacing: 1px;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        .hero-features {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            margin-bottom: 50px;
            animation: fadeInUp 0.8s ease-out 0.3s both;
        }

        .hero-feature {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(212, 168, 66, 0.3);
            border-radius: 12px;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .hero-feature:hover {
            background: rgba(212, 168, 66, 0.15);
            border-color: rgba(212, 168, 66, 0.6);
            transform: translateY(-5px);
        }

        .feature-icon {
            font-size: 2.5rem;
            line-height: 1;
        }

        .feature-text {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .feature-text strong {
            font-size: 0.9rem;
            color: var(--blanc);
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .feature-text span {
            font-size: 0.8rem;
            color: var(--jaune-solaire);
            letter-spacing: 0.5px;
            font-weight: 500;
        }

        .hero-cta {
            animation: fadeInUp 0.8s ease-out 0.4s both;
        }

        .hero-cta .btn {
            font-size: 1.05rem;
            padding: 16px 48px;
            letter-spacing: 0.5px;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Brushes/Brooms Icon Animation */
        .brushes-icon {
            width: 100%;
            max-width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 120px;
            backdrop-filter: blur(10px);
            border: 2px solid rgba(212, 168, 66, 0.3);
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 20px rgba(212, 168, 66, 0.2);
                border-color: rgba(212, 168, 66, 0.3);
            }
            50% {
                box-shadow: 0 0 40px rgba(212, 168, 66, 0.5);
                border-color: rgba(212, 168, 66, 0.6);
            }
        }

        /* Stats Section */
        .stats-modern {
            background: var(--gris-verre);
            padding: 60px 0;
            border-top: 3px solid var(--jaune-solaire);
            border-bottom: 3px solid var(--bleu-nuit);
        }

        .stats-modern .container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
            text-align: center;
        }

        .stat-box {
            animation: fadeInUp 0.8s ease-out;
        }

        .stat-number {
            font-size: clamp(2.5rem, 6vw, 3.5rem);
            font-weight: 700;
            color: var(--bleu-nuit);
            font-family: var(--font-display);
            margin-bottom: 8px;
        }

        .stat-number .symbol {
            color: var(--jaune-solaire);
        }

        .stat-text {
            font-size: 0.95rem;
            color: var(--gris-texte-leger);
            line-height: 1.6;
        }

        /* 4 Piliers Section (Card Design) */
        .pillars-section {
            padding: 80px 0;
            background: var(--blanc);
        }

        .pillars-header {
            text-align: center;
            margin-bottom: 60px;
            animation: fadeInUp 0.8s ease-out;
        }

        .pillars-header h2 {
            font-size: clamp(2rem, 4vw, 2.5rem);
            margin-bottom: 16px;
            color: var(--bleu-nuit);
        }

        .pillars-header p {
            color: var(--gris-texte-leger);
            font-size: 1.05rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .pillars-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .pillar-card {
            background: linear-gradient(135deg, var(--blanc) 0%, #f9f7f4 100%);
            border: 2px solid var(--gris-bordure);
            border-radius: var(--radius-xl);
            padding: 40px 24px;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            animation: fadeInUp 0.8s ease-out;
            position: relative;
            overflow: hidden;
        }

        .pillar-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--bleu-nuit), var(--jaune-solaire));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.5s ease;
        }

        .pillar-card:hover {
            border-color: var(--jaune-solaire);
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(27, 77, 62, 0.15);
            background: linear-gradient(135deg, var(--blanc) 0%, #fffbf5 100%);
        }

        .pillar-card:hover::before {
            transform: scaleX(1);
        }

        .pillar-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--bleu-nuit), var(--bleu-panneau));
            border: 3px solid var(--jaune-solaire);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 24px;
            box-shadow: 0 4px 15px rgba(27, 77, 62, 0.2);
            transition: all 0.4s ease;
        }

        .pillar-card:hover .pillar-icon {
            transform: rotate(-15deg) scale(1.1);
            box-shadow: 0 8px 25px rgba(212, 168, 66, 0.4);
        }

        .pillar-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--bleu-nuit);
            margin-bottom: 12px;
            font-family: var(--font-display);
        }

        .pillar-description {
            font-size: 0.9rem;
            color: var(--gris-texte-leger);
            line-height: 1.6;
        }

        /* Services Section */
        .services-modern {
            padding: 80px 0;
            background: linear-gradient(135deg, var(--gris-verre) 0%, var(--blanc) 100%);
        }

        .services-header {
            text-align: center;
            margin-bottom: 60px;
            animation: fadeInUp 0.8s ease-out;
        }

        .services-header h2 {
            font-size: clamp(2rem, 4vw, 2.5rem);
            margin-bottom: 16px;
            color: var(--bleu-nuit);
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 32px;
        }

        .service-card-modern {
            background: var(--blanc);
            border-radius: var(--radius-xl);
            padding: 32px 28px;
            border: 2px solid var(--gris-bordure);
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            animation: fadeInUp 0.8s ease-out;
            position: relative;
        }

        .service-card-modern::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--bleu-nuit), var(--jaune-solaire));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.5s ease;
            border-radius: 0 0 var(--radius-xl) var(--radius-xl);
        }

        .service-card-modern:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 40px rgba(27, 77, 62, 0.15);
            border-color: var(--jaune-solaire);
        }

        .service-card-modern:hover::after {
            transform: scaleX(1);
        }

        .service-card-modern h3 {
            font-size: 1.3rem;
            margin-bottom: 12px;
            color: var(--bleu-nuit);
        }

        .service-card-modern p {
            color: var(--gris-texte-leger);
            font-size: 0.95rem;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .service-price {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--jaune-solaire);
            font-family: var(--font-display);
        }

        /* CTA Section */
        .cta-modern {
            padding: 80px 0;
            background: linear-gradient(135deg, var(--bleu-nuit) 0%, var(--bleu-panneau) 100%);
            position: relative;
            overflow: hidden;
        }

        .cta-modern::before {
            content: "";
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(212, 168, 66, 0.1) 0%, transparent 70%);
            border-radius: 50%;
            z-index: 1;
        }

        .cta-modern .container {
            position: relative;
            z-index: 2;
            text-align: center;
            animation: fadeInUp 0.8s ease-out;
        }

        .cta-modern h2 {
            font-size: clamp(1.8rem, 4vw, 2.5rem);
            margin-bottom: 24px;
            color: var(--blanc);
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .cta-modern p {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 32px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .cta-modern .btn {
            font-size: 1.05rem;
            padding: 16px 40px;
            min-width: 280px;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .hero-modern .container {
                grid-template-columns: 1fr;
                gap: 40px;
                padding: 60px 24px;
            }

            .pillars-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .stats-modern .container {
                grid-template-columns: 1fr;
                gap: 30px;
            }
        }

        @media (max-width: 768px) {
            .hero-modern {
                min-height: auto;
                padding: 40px 0;
            }

            .hero-modern .container {
                gap: 30px;
                padding: 40px 16px;
            }

            .hero-content h1 {
                font-size: 1.8rem;
            }

            .pillars-grid {
                grid-template-columns: 1fr;
            }

            .pillar-card {
                padding: 32px 20px;
            }

            .services-grid {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .stats-modern .container {
                gap: 20px;
            }

            .hero-visual {
                display: none;
            }
        }

        @media (max-width: 640px) {
            .hero-content h1 {
                font-size: 1.5rem;
            }

            .hero-content > p {
                font-size: 1rem;
            }

            .hero-tagline {
                font-size: 1.1rem;
            }

            .pillar-icon {
                width: 60px;
                height: 60px;
                font-size: 1.8rem;
            }

            .cta-modern h2 {
                font-size: 1.5rem;
            }

            .cta-modern .btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}

<!-- HERO SECTION -->
<section class="hero-modern">
    <div class="hero-card">
        <div class="hero-logo">
            <svg viewBox="0 0 200 60" width="200" height="60">
                <!-- Logo design -->
                <circle cx="25" cy="30" r="18" fill="none" stroke="currentColor" stroke-width="2"/>
                <circle cx="25" cy="30" r="14" fill="none" stroke="currentColor" stroke-width="1.5"/>
                <line x1="20" y1="30" x2="30" y2="30" stroke="currentColor" stroke-width="2"/>
                <circle cx="55" cy="30" r="18" fill="none" stroke="currentColor" stroke-width="2"/>
                <circle cx="55" cy="30" r="14" fill="none" stroke="currentColor" stroke-width="1.5"/>
                <line x1="50" y1="30" x2="60" y2="30" stroke="currentColor" stroke-width="2"/>
                <text x="75" y="38" font-size="24" font-weight="bold" fill="currentColor">SIRIUS</text>
                <polygon points="195,5 200,15 190,15" fill="currentColor"/>
            </svg>
        </div>
        <h1 class="hero-title">
            <span class="hero-title-main">SIRIUS</span>
            <span class="hero-title-accent">-SOLAR</span>
        </h1>
        <p class="hero-subtitle">ENTRETIEN & NETTOYAGE<br>DE PANNEAUX PHOTOVOLTAÏQUES</p>

        <div class="hero-features">
            <div class="hero-feature">
                <div class="feature-icon">💧</div>
                <div class="feature-text">
                    <strong>NETTOYAGE</strong>
                    <span>À L'EAU PURE</span>
                </div>
            </div>
            <div class="hero-feature">
                <div class="feature-icon">✓</div>
                <div class="feature-text">
                    <strong>SÉCURITÉ</strong>
                    <span>MAXIMALE</span>
                </div>
            </div>
            <div class="hero-feature">
                <div class="feature-icon">🌿</div>
                <div class="feature-text">
                    <strong>RESPECT DE</strong>
                    <span>L'ENVIRONNEMENT</span>
                </div>
            </div>
            <div class="hero-feature">
                <div class="feature-icon">📈</div>
                <div class="feature-text">
                    <strong>PERFORMANCE</strong>
                    <span>OPTIMALE</span>
                </div>
            </div>
        </div>

        <div class="hero-cta">
            <a href="{{ path('app_devis') }}" class="btn btn-primary">Devis Gratuit</a>
        </div>
    </div>
</section>

<!-- STATS SECTION -->
<section class="stats-modern">
    <div class="container">
        <div class="stat-box">
            <div class="stat-number"><span class="symbol">+</span>15<span class="symbol">%</span></div>
            <div class="stat-text">Production retrouvée<br>en moyenne</div>
        </div>
        <div class="stat-box">
            <div class="stat-number">100<span class="symbol">%</span></div>
            <div class="stat-text">Eau osmosée<br>Zéro chimique</div>
        </div>
        <div class="stat-box">
            <div class="stat-number"><span class="symbol">~</span>48h</div>
            <div class="stat-text">Réponse moyenne<br>à vos devis</div>
        </div>
    </div>
</section>

<!-- 4 PILLARS SECTION -->
<section class="pillars-section" id="pillars">
    <div class="container">
        <div class="pillars-header">
            <h2>Nos Engagements</h2>
            <p>Qualité, sécurité, respect de l'environnement et performance optimale</p>
        </div>
        <div class="pillars-grid">
            <div class="pillar-card">
                <div class="pillar-icon">💧</div>
                <h3 class="pillar-title">Nettoyage<br>à l'eau pure</h3>
                <p class="pillar-description">Zéro résidu calcaire, aucun produit chimique agressif</p>
            </div>
            <div class="pillar-card">
                <div class="pillar-icon">✅</div>
                <h3 class="pillar-title">Sécurité<br>maximale</h3>
                <p class="pillar-description">Techniciens formés au travail en hauteur</p>
            </div>
            <div class="pillar-card">
                <div class="pillar-icon">🌿</div>
                <h3 class="pillar-title">Respect de<br>l'environnement</h3>
                <p class="pillar-description">Approche écologique et durable</p>
            </div>
            <div class="pillar-card">
                <div class="pillar-icon">📈</div>
                <h3 class="pillar-title">Performance<br>optimale</h3>
                <p class="pillar-description">Jusqu'à 25% de perte évitée</p>
            </div>
        </div>
    </div>
</section>

<!-- SERVICES SECTION -->
<section class="services-modern">
    <div class="container">
        <div class="services-header">
            <h2>Nos Prestations</h2>
            <p>Un entretien adapté à chaque installation</p>
        </div>
        <div class="services-grid">
            {% for service in services %}
                <div class="service-card-modern">
                    <h3>{{ service.titre }}</h3>
                    <p>{{ service.description }}</p>
                    <div class="service-price">{{ service.prix }}</div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- CTA SECTION -->
<section class="cta-modern">
    <div class="container">
        <h2>Prêt à optimiser votre installation?</h2>
        <p>Obtenez un devis gratuit en moins de 48h. Nos experts analyseront votre installation et vous proposeront une solution adaptée.</p>
        <a href="{{ path('app_devis') }}" class="btn btn-primary">Demander mon devis gratuit</a>
    </div>
</section>

{% endblock %}

{% block page_nav_next %}
    <a href="{{ path('app_devis') }}" class="page-nav-link">Devis Gratuit →</a>
{% endblock %}
