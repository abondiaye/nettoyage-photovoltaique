    <div class="hero-card">
        <!-- Logo débordant vers le haut -->
        <div class="hero-logo">
            <img src="{{ asset('images/logo1.jpeg') }}" alt="Sirius-Solar Logo">
        </div>

        <div class="glitch-intro">
            <div class="glitch-grid"></div>
            <div class="glitch-corner tl"></div>
            <div class="glitch-corner tr"></div>
            <div class="glitch-corner bl"></div>
            <div class="glitch-corner br"></div>

            <span class="glitch-prefix">// Sirius-Solar</span>
            <span class="glitch-line" id="glitchLine1" data-text="WELCOME"></span>
            <span class="glitch-line" id="glitchLine2" data-text=" the Sirius-solar website."></span>

            <div class="glitch-divider"></div>
            <div class="glitch-sub">Propreté · claireté · clarté</div>
            <div class="glitch-sub glitch-sub--small">Nettoyage &amp; entretien de vos panneaux photovoltaïques</div>

            <a href="{{ path('app_devis') }}" class="glitch-cta" id="glitchCta" data-text="[ devis ]">[ devis ]</a>
            <div class="glitch-statusbar" id="glitchStatus">Un panneau propre, c’est jusqu’à 25 % d’énergie en plus.</div>
        </div>

        <script>
        (function () {
            var CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*!?/\\|<>';

            function glitchRand(arr) {
                return arr[Math.floor(Math.random() * arr.length)];
            }

            function glitchScramble(el, finalText, delay) {
                delay = delay || 0;
                return new Promise(function (resolve) {
                    setTimeout(function () {
                        var chars = finalText.split('').map(function (ch, i) {
                            return {
                                char: ch,
                                done: ch === ' ',
                                iterations: Math.floor(Math.random() * 8) + i * 2
                            };
                        });

                        el.innerHTML = chars.map(function (c, i) {
                            return c.char === ' '
                                ? '<span class="glitch-char">&nbsp;</span>'
                                : '<span class="glitch-char is-glitching" data-i="' + i + '">' + glitchRand(CHARS) + '</span>';
                        }).join('');

                        var spans = el.querySelectorAll('.glitch-char');
                        var frame = 0;

                        var tick = setInterval(function () {
                            var allDone = true;
                            chars.forEach(function (c, i) {
                                if (c.done) return;
                                if (frame >= c.iterations) {
                                    spans[i].textContent = c.char;
                                    spans[i].classList.remove('is-glitching');
                                    c.done = true;
                                } else {
                                    spans[i].textContent = glitchRand(CHARS);
                                    allDone = false;
                                }
                            });
                            frame++;
                            if (allDone) {
                                clearInterval(tick);
                                resolve();
                            }
                        }, 45);
                    }, delay);
                });
            }

            async function glitchRunSequence() {
                var line1 = document.getElementById('glitchLine1');
                var line2 = document.getElementById('glitchLine2');
                var status = document.getElementById('glitchStatus');
                var cta = document.getElementById('glitchCta');
                if (!line1 || !line2) return;

                if (status) status.textContent = 'SYS://DÉCODAGE...';
                await glitchScramble(line1, line1.dataset.text, 300);
                await glitchScramble(line2, line2.dataset.text, 60);
                if (cta) await glitchScramble(cta, cta.dataset.text, 100);
                if (status) status.textContent = 'Un panneau propre, c’est jusqu’à 25 % d’énergie en plus.';
            }

            glitchRunSequence();

            var glitchCta = document.getElementById('glitchCta');
            if (glitchCta) {
                glitchCta.addEventListener('mouseenter', function () {
                    glitchScramble(glitchCta, glitchCta.dataset.text, 0);
                });
            }

        })();
        </script>
        <p class="hero-subtitle">Eau osmosée • Zéro produit chimique • Jusqu'à 25% regagné</p>

