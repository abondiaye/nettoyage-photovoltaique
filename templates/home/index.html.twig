<!-- Advantages Section -->
<section class="advantages-section" id="avantages">
    <!-- Animation subtile en arrière-plan -->
    <video class="advantages-bg-video" autoplay muted loop playsinline>
        <source src="{{ asset('media/raindrops.mp4') }}" type="video/mp4">
    </video>

    <div style="position: relative; z-index: 1;">
        <h2 class="section-title">Pourquoi Sirius-Solar ?</h2>

        <div class="advantages-grid">
        <div class="advantage-card">
            <div class="advantage-icon">📈</div>
            <h3>Rendement +25%</h3>
            <p>Retrouvez jusqu'à 25% de rendement perdu par la saleté et les dépôts</p>
        </div>

        <div class="advantage-card">
            <div class="advantage-icon">💧</div>
            <h3>Eau Osmosée</h3>
            <p>Nettoyage avec eau pure, sans résidu, sans trace sur vos panneaux</p>
        </div>

        <div class="advantage-card">
            <div class="advantage-icon">🌍</div>
