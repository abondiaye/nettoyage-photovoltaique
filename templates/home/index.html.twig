    top: 50%;
    transform: translateY(-50%);
    z-index: 998;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: rgba(10, 61, 53, 0.15);
    padding: 16px 8px;
    border-radius: 16px;
    backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 212, 255, 0.2);
    box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.2),
        inset 0 0 20px rgba(0, 212, 255, 0.05),
        0 0 20px rgba(0, 212, 255, 0.1);
    perspective: 1000px;
    scrollbar-width: none;
    -ms-overflow-style: none;
}

.scroll-nav-bar::-webkit-scrollbar {
    display: none;
}

.scroll-nav-btn {
    width: 100px;
    height: 50px;
    padding: 0;
    border-radius: 12px;
    border: 2px solid rgba(0, 212, 255, 0.3);
    background: linear-gradient(135deg, rgba(0,212,255,0.1) 0%, rgba(0,153,204,0.1) 100%);
    color: #00d4ff;
    cursor: pointer;
    font-size: 10px;
    font-weight: 700;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
    position: relative;
    transform-style: preserve-3d;
    box-shadow:
        0 4px 15px rgba(0, 212, 255, 0.15),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.nav-label {
    display: block;
    white-space: nowrap;
    position: relative;
    z-index: 2;
}

.scroll-nav-btn:hover {
    background: linear-gradient(135deg, rgba(0,212,255,0.25) 0%, rgba(0,153,204,0.25) 100%);
    border-color: rgba(0,212,255,0.6);
    transform:
        translateX(-5px)
        rotateY(-15deg)
        rotateX(5deg)
        scale(1.05);
    box-shadow:
        0 10px 30px rgba(0, 212, 255, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.2),
        0 0 20px rgba(0, 212, 255, 0.4);
    text-shadow: 0 0 15px rgba(0, 212, 255, 0.8);
}

/* Active button with enhanced 3D effect */
.scroll-nav-btn.active {
    background: linear-gradient(135deg, rgba(0,212,255,0.4) 0%, rgba(0,153,204,0.4) 100%);
    border-color: rgba(0,212,255,0.8);
    transform:
        translateX(-10px)
        rotateY(-20deg)
        scale(1.1);
    box-shadow:
        0 15px 40px rgba(0, 212, 255, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 30px rgba(0, 212, 255, 0.6);
    text-shadow: 0 0 20px rgba(0, 212, 255, 1);
    color: #00d4ff;
}

/* Scroll animation - button moves when scrolling to that section */
.scroll-nav-btn.scrolling {
    animation: slideInActive 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes slideInActive {
    0% {
        transform: translateX(20px) rotateY(30deg) scale(0.8);
        opacity: 0;
    }
    50% {
        transform: translateX(-8px) rotateY(-15deg) scale(1.08);
    }
    100% {
        transform: translateX(-10px) rotateY(-20deg) scale(1.1);
    }
}

@media (max-width: 1024px) {
    .scroll-nav-bar {
        right: 12px !important;
        gap: 10px !important;
        padding: 12px 6px !important;
    }

    .scroll-nav-btn {
        width: 85px !important;
        height: 45px !important;
        font-size: 9px !important;
        border-radius: 10px !important;
    }

    .scroll-nav-btn:hover {
        transform:
            translateX(-4px)
            rotateY(-12deg)
            rotateX(3deg)
            scale(1.03) !important;
    }

    .scroll-nav-btn.active {
        transform:
            translateX(-8px)
            rotateY(-15deg)
            scale(1.08) !important;
    }
}

@media (max-width: 768px) {
    .scroll-nav-bar {
        right: 0 !important;
        left: 0 !important;
        top: auto !important;
        bottom: 0 !important;
        transform: none !important;
        gap: 4px !important;
        padding: 6px !important;
        flex-direction: row !important;
        background: rgba(10, 61, 53, 0.2) !important;
        border-radius: 0 !important;
        border: 1px solid rgba(0, 212, 255, 0.2) !important;
        border-bottom: none !important;
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: auto !important;
        overflow-y: hidden !important;
        box-sizing: border-box;
    }

    .scroll-nav-btn {
        width: 65px !important;
        height: 38px !important;
        min-width: 65px !important;
        font-size: 8px !important;
        border-radius: 8px !important;
        flex-shrink: 0 !important;
        padding: 0 !important;
    }

    .scroll-nav-btn:hover {
        transform: scale(1.02) !important;
    }

    .scroll-nav-btn.active {
        transform: scale(1.03) !important;
    }

    /* Mobile fixes for business card container */
    .carte-visite-container {
        height: auto !important;
        padding: 20px 15px !important;
    }

    .carte-visite-container > div[style*="display"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 20px !important;
        max-width: 100% !important;
        margin: 0 auto !important;
    }

    .carte-visite-container > div[style*="display"] > div {
        height: 200px !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .carte-visite-container > p {
        margin-top: 20px !important;
        font-size: 12px !important;
    }
}
</style>

<script>
// Scroll Navigation Bar Functionality
const scrollNavButtons = document.querySelectorAll('.scroll-nav-btn');
const scrollNavBar = document.getElementById('scrollNavBar');

// Handle button clicks
scrollNavButtons.forEach(btn => {
    btn.addEventListener('click', () => {
        const targetId = btn.dataset.target;
        const targetElement = targetId === 'hero'
            ? document.querySelector('.hero-container')
            : document.getElementById(targetId);

        if (targetElement) {
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
});

// Update active button based on scroll position
window.addEventListener('scroll', () => {
    let currentSection = 'hero';

    const sections = [
        { id: 'hero', element: document.querySelector('.hero-container'), offset: 0 },
        { id: 'processus', element: document.getElementById('processus'), offset: 200 },
        { id: 'services', element: document.getElementById('services'), offset: 200 },
        { id: 'avantages', element: document.getElementById('avantages'), offset: 200 },
        { id: 'promotions', element: document.getElementById('promotions'), offset: 200 },
        { id: 'realisations', element: document.getElementById('realisations'), offset: 200 },
        { id: 'cta', element: document.getElementById('cta'), offset: 200 },
        { id: 'contact', element: document.getElementById('contact'), offset: 200 }
    ];

    sections.forEach(section => {
        if (section.element) {
            const rect = section.element.getBoundingClientRect();
            if (rect.top <= section.offset && rect.bottom > section.offset) {
                currentSection = section.id;
            }
        }
    });

    scrollNavButtons.forEach(btn => {
        btn.classList.remove('active');
        btn.classList.remove('scrolling');
        if (btn.dataset.target === currentSection) {
            btn.classList.add('active');
            btn.classList.add('scrolling');
            // Remove animation class after animation completes for next trigger
            setTimeout(() => {
                btn.classList.remove('scrolling');
            }, 600);
        }
    });

    // Show/hide scroll bar based on scroll position with smooth transition
    if (window.scrollY > 300) {
        scrollNavBar.style.opacity = '1';
        scrollNavBar.style.pointerEvents = 'auto';
        scrollNavBar.style.transition = 'opacity 0.3s ease';
    } else {
        scrollNavBar.style.opacity = '0.3';
        scrollNavBar.style.pointerEvents = 'none';
        scrollNavBar.style.transition = 'opacity 0.3s ease';
    }
});

// Scroll down by 500px (one step) - instantaneous
const scrollDownBtn = document.querySelector('[data-scroll-down]');
if (scrollDownBtn) {
    scrollDownBtn.addEventListener('click', () => {
        const currentScroll = window.scrollY;
        const targetScroll = currentScroll + 500;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        window.scrollTo(0, Math.min(targetScroll, maxScroll));
    });
}
</script>

{% endblock %}
