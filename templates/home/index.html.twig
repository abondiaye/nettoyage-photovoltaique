            <img src="{{ asset('images/carte2.svg') }}" alt="Sirius-Solar - Carte de Visite" style="width: 100%; height: auto; max-width: 1000px; display: block; margin: 0 auto; border-radius: 15px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);">
