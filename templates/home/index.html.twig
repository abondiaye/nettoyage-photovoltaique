            <p style="font-size: 12px; color: #999; margin-top: 10px; font-style: italic;">"Un panneau propre, un rendement optimal !"</p>
        </div>

        <div class="footer-column">
            <h3>Liens Utiles</h3>
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="{{ path('app_home') }}#services">Services</a>
            <a href="{{ path('app_devis') }}">Demander un devis</a>
            <a href="{{ path('app_login') }}">Connexion Admin</a>
        </div>

        <div class="footer-column">
            <h3>Services</h3>
            <a href="{{ path('app_home') }}#services">Nettoyage Premium</a>
            <a href="{{ path('app_home') }}#services">Inspection Complète</a>
            <a href="{{ path('app_home') }}#services">Maintenance Régulière</a>
            <a href="{{ path('app_home') }}#services">Protection Sealant</a>
        </div>

        <div class="footer-column">
