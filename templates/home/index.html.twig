<script>
(function () {
    var CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*!?/\\|<>';

    function contactRand(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
    }

    function contactScramble(el, finalText) {
        return new Promise(function (resolve) {
            var chars = finalText.split('').map(function (ch, i) {
                return {
                    char: ch,
                    done: ch === ' ',
                    iterations: Math.floor(Math.random() * 8) + i * 2
                };
            });

            // One box per word so a title only wraps between words.
            var html = '<span class="word">';
            chars.forEach(function (c, i) {
                html += c.char === ' '
                    ? '</span><span class="char sp"> </span><span class="word">'
                    : '<span class="char glitch" data-i="' + i + '">' + contactRand(CHARS) + '</span>';
            });
            el.innerHTML = html + '</span>';

            var spans = el.querySelectorAll('.char');
            var frame = 0;

            var tick = setInterval(function () {
                var allDone = true;
                chars.forEach(function (c, i) {
                    if (c.done) return;
                    if (frame >= c.iterations) {
                        spans[i].textContent = c.char;
                        spans[i].classList.remove('glitch');
                        c.done = true;
                    } else {
                        spans[i].textContent = contactRand(CHARS);
                        allDone = false;
                    }
                });
                frame++;
                if (allDone) {
                    clearInterval(tick);
                    resolve();
                }
            }, 45);
        });
    }

    function runScrambleById(id) {
        var target = document.getElementById(id);
        if (target) {
            contactScramble(target, target.dataset.text);
        }
    }

    window.runContactScramble = function () { runScrambleById('contactScramble'); };
    window.runProcessusScramble = function () { runScrambleById('processusScramble'); };
    window.runServicesScramble = function () { runScrambleById('servicesScramble'); };
    window.runAvantagesScramble = function () { runScrambleById('avantagesScramble'); };

    window.runContactScramble();
    window.runProcessusScramble();
    window.runServicesScramble();
    window.runAvantagesScramble();
})();
</script>

<script>
(function () {
    // The thick hero card leans a little towards the mouse.
    var card = document.querySelector('.hero-card--thick');
    if (!card || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var hero = card.closest('.hero-container') || document;
    hero.addEventListener('pointermove', function (e) {
        if (window.innerWidth < 769) return;
        var x = e.clientX / window.innerWidth - 0.5;
        var y = e.clientY / window.innerHeight - 0.5;
        card.style.setProperty('--hy', (-12 + x * 12).toFixed(2) + 'deg');
        card.style.setProperty('--hx', (7 - y * 8).toFixed(2) + 'deg');
    }, { passive: true });
})();
</script>
