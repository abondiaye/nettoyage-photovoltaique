{% extends 'base.html.twig' %}

{% block title %}Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques{% endblock %}

{% block body %}
<style>
    /* Show navbar on home page - positioned over hero */
    .gooey-navbar { display: flex !important; visibility: visible !important; height: 70px !important; min-height: 70px !important; max-height: 70px !important; margin: 0 !important; padding: 0 40px !important; position: relative !important; z-index: 1001 !important; }
    .gooey-navbar * { max-height: none !important; height: auto !important; }

    /* Hide circular nav - it duplicates links */
    .circular-nav-container { display: none !important; visibility: hidden !important; height: 0 !important; width: 0 !important; }

    /* Remove all padding/margin from body and html */
    html {
        margin: 0 !important;
        padding: 0 !important;
    }

    body {
        padding-top: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    /* ===== HERO SECTION ===== */
    .hero-container {
        position: relative;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0;
        width: 100%;
        overflow: hidden;
    }

    .hero-gradient-bg {
        position: absolute;
        inset: 0;
        background: none;
        border-radius: 0;
        z-index: 0;
        overflow: hidden;
        filter: brightness(1.15) contrast(1.1);
    }

    .hero-gradient-bg img,
    .hero-gradient-bg video {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
    }

    .hero-gradient-bg img {
        z-index: 1;
        opacity: 1.2;
        filter: brightness(1.2) contrast(1.15);
    }

    .hero-gradient-bg video {
        z-index: 2;
        opacity: 0.4;
        mix-blend-mode: lighten;
    }

    .hero-card {
        position: relative;
        z-index: 1;
        overflow: visible;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        /* Glasmorphism */
        background: rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.3);

        border-radius: 20px;
        padding: 100px 60px 80px 60px;
        max-width: 700px;
        text-align: center;
        color: white;

        /* Shadow */
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3),
                    inset 0 0 30px rgba(255, 255, 255, 0.1);

        /* Animation */
        animation: fadeInUp 0.8s ease-out, raindropsEffect 4s ease-in-out infinite;
    }

    .hero-logo {
        position: absolute;
        top: -55px;
        left: 50%;
        transform: translateX(-50%);
        width: 200px;
        height: 110px;
        background: white;
        border-radius: 16px;
        padding: 12px;
        border: 2px solid rgba(192, 192, 192, 0.6);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.8), 0 0 25px rgba(192, 192, 192, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        animation: logoFloat 3s ease-in-out infinite;
    }

    .hero-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 12px;
        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.15));
    }

    @keyframes logoFloat {
        0%, 100% {
            transform: translateX(-50%) translateY(0px);
        }
        50% {
            transform: translateX(-50%) translateY(-8px);
        }
    }

.hero-title {
        position: relative;
        z-index: 1;
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 20px;
        text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: -1px;
    }

    .hero-subtitle {
        position: relative;
        z-index: 1;
        font-size: 18px;
        opacity: 0.95;
        margin-bottom: 30px;
        line-height: 1.6;
        font-weight: 500;
    }

    .hero-features {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .feature-tag {
        background: rgba(160, 160, 160, 0.2);
        border: 1px solid rgba(160, 160, 160, 0.5);
        color: var(--dore);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        animation: fadeInUp 0.8s ease-out;
        animation-fill-mode: both;
    }

    .feature-tag:nth-child(1) { animation-delay: 0.1s; }
    .feature-tag:nth-child(2) { animation-delay: 0.2s; }
    .feature-tag:nth-child(3) { animation-delay: 0.3s; }

    .btn-cta {
        position: relative;
        z-index: 1;
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        color: #121212;
        border: none;
        padding: 16px 40px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

        box-shadow: 0 10px 30px rgba(160, 160, 160, 0.3);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-cta:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 20px 50px rgba(160, 160, 160, 0.5);
    }

    .btn-cta:active {
        transform: translateY(-1px) scale(0.98);
    }

    @keyframes raindropsEffect {
        0%, 100% {
            box-shadow:
                inset 0 0 50px rgba(160, 160, 160, 0.05),
                0 20px 60px rgba(0, 0, 0, 0.3);
        }
        50% {
            box-shadow:
                inset 0 0 50px rgba(160, 160, 160, 0.15),
                0 20px 60px rgba(160, 160, 160, 0.2);
        }
    }

    .raindrops-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 20px;
        pointer-events: none;
        object-fit: cover;
        opacity: 0.95;
        z-index: 0;
    }

    .hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.2);
        z-index: 0.5;
        border-radius: 20px;
        pointer-events: none;
    }

    /* ===== SERVICES SECTION ===== */
    .services-section {
        padding: 100px 40px;
        position: relative;
    }

    .services-section > * {
        position: relative;
        z-index: 1;
    }

    .section-title {
        font-size: 42px;
        text-align: center;
        margin-bottom: 60px;
        color: var(--vert-fonce);
        animation: fadeInDown 0.6s ease-out;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .service-card {
        /* Glasmorphism */
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);

        border-radius: 16px;
        padding: 40px;
        text-align: center;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: pointer;

        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

    .service-card:nth-child(1) { animation-delay: 0.1s; }
    .service-card:nth-child(2) { animation-delay: 0.2s; }
    .service-card:nth-child(3) { animation-delay: 0.3s; }

    .service-card:hover {
        transform: translateY(-10px);
        background: rgba(160, 160, 160, 0.1);
        border-color: rgba(160, 160, 160, 0.5);

        box-shadow: 0 20px 40px rgba(160, 160, 160, 0.2);
    }

    .card-icon {
        font-size: 48px;
        margin-bottom: 20px;
        transition: transform 0.4s ease;
    }

    .service-card:hover .card-icon {
        transform: scale(1.2) rotateZ(10deg);
    }

    .service-card h3 {
        font-size: 22px;
        color: var(--vert-fonce);
        margin-bottom: 15px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .service-card p {
        color: #666;
        line-height: 1.6;
        margin-bottom: 25px;
        font-size: 15px;
    }

    .btn-learn {
        background: transparent;
        border: 2px solid var(--dore);
        color: var(--dore);
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

    .btn-learn:hover {
        background: var(--dore);
        color: white;
        transform: scale(1.05);
    }

    /* ===== ADVANTAGES SECTION ===== */
    .advantages-section {
        position: relative;
        padding: 100px 40px;
        background: linear-gradient(180deg, transparent 0%, rgba(10, 61, 53, 0.05) 100%);
        overflow: hidden;
    }

    /* Animation subtile en arrière-plan */
    .advantages-bg-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
        opacity: 0.08;  /* Très subtil */
        pointer-events: none;
        display: none !important;
    }

    /* En mode sombre, rendre l'animation encore plus subtile */
    body.dark-mode .advantages-bg-video {
        opacity: 0.05;
    }

    /* Désactiver la vidéo sur mobile pour performance */
    @media (max-width: 768px) {
        .advantages-bg-video {
            display: none;
        }
    }

    .advantages-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .advantage-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(160, 160, 160, 0.3);

        border-radius: 16px;
        padding: 40px;
        text-align: center;

        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;

        transition: all 0.3s ease;
        position: relative;
        padding-top: 60px;
    }

    .advantage-card::before {
        content: attr(data-number);
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 60px;
        background:
            radial-gradient(circle at 30% 30%, rgba(255, 255, 200, 0.9), transparent 50%),
            radial-gradient(circle at 70% 70%, rgba(100, 80, 0, 0.3), transparent 50%),
            linear-gradient(135deg, #ffd700 0%, #ffed4e 25%, #d4a842 50%, #b8860b 75%, #cd853f 100%);
        border: 3px solid #d4a842;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 28px;
        color: #3d2817;
        box-shadow:
            inset 0 2px 5px rgba(255, 255, 150, 0.7),
            inset 0 -2px 5px rgba(100, 80, 0, 0.5),
            0 8px 20px rgba(160, 160, 160, 0.5),
            0 0 20px rgba(255, 215, 0, 0.4);
        transition: all 0.3s ease;
    }

    .advantage-card:nth-child(1) { animation-delay: 0.1s; }
    .advantage-card:nth-child(1)::before { content: "1"; }

    .advantage-card:nth-child(2) { animation-delay: 0.2s; }
    .advantage-card:nth-child(2)::before { content: "2"; }

    .advantage-card:nth-child(3) { animation-delay: 0.3s; }
    .advantage-card:nth-child(3)::before { content: "3"; }

    .advantage-card:nth-child(4) { animation-delay: 0.4s; }
    .advantage-card:nth-child(4)::before { content: "4"; }

    .advantage-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(160, 160, 160, 0.15);
    }

    .advantage-card:hover::before {
        transform: translateX(-50%) scale(1.15);
        box-shadow: 0 12px 30px rgba(160, 160, 160, 0.7);
    }

    .advantage-icon {
        font-size: 42px;
        margin-bottom: 15px;
    }

    .advantage-card h3 {
        font-size: 20px;
        color: var(--vert-fonce);
        margin-bottom: 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .advantage-card p {
        color: #666;
        font-size: 14px;
        line-height: 1.6;
    }

    /* ===== CTA SECTION ===== */
    .cta-section {
        padding: 80px 40px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        text-align: center;
        color: white;
    }

    .cta-content {
        max-width: 600px;
        margin: 0 auto;
        animation: fadeInUp 0.8s ease-out;
    }

    .cta-title {
        font-size: 38px;
        margin-bottom: 20px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .cta-text {
        font-size: 16px;
        margin-bottom: 30px;
        opacity: 0.95;
        line-height: 1.6;
    }

    .btn-cta-white {
        background: white;
        color: var(--vert-fonce);
        border: none;
        padding: 16px 40px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .btn-cta-white:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    }

    /* ===== FOOTER ===== */
    .footer {
        background: var(--noir);
        color: rgba(255, 255, 255, 0.7);
        padding: 60px 40px 30px;
    }

    .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto 40px;
    }

    .footer-column h3 {
        color: white;
        margin-bottom: 20px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .footer-column a,
    .footer-column p {
        display: block;
        margin-bottom: 10px;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        font-size: 14px;
        transition: color 0.3s ease;
    }

    .footer-column a:hover {
        color: var(--dore);
    }

    .footer-bottom {
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 13px;
    }

    /* ===== RESPONSIVE MOBILE ===== */
    @media (max-width: 768px) {
        .hero-container {
            height: auto;
            padding: 20px 10px;
            min-height: 100vh;
        }

        .hero-gradient-bg {
            inset: 10px;
        }

        .hero-card {
            padding: 50px 30px;
        }

        .hero-title {
            font-size: 32px;
        }

        .hero-subtitle {
            font-size: 14px;
        }

        .services-section, .advantages-section, .cta-section, .footer {
            padding: 60px 20px;
        }

        .section-title, .cta-title {
            font-size: 28px;
        }

        .services-grid, .advantages-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .service-card, .advantage-card {
            padding: 30px 20px;
        }

        .footer-content {
            grid-template-columns: 1fr;
            gap: 30px;
        }
    }

    /* ===== NEON GRAY LED ANIMATION ===== */
    @keyframes neonPulse {
        0%, 100% {
            opacity: 0.6;
            filter: blur(0px);
        }
        50% {
            opacity: 1;
            filter: blur(0.5px);
        }
    }

    /* ===== METALLIC SEPARATOR WITH YELLOW LEDS ===== */
    .processus-section::before,
    .services-section::before,
    .advantages-section::before,
    .cta-section::before {
        content: '';
        display: block;
        height: 12px;
        margin: 50px 0;
        background:
            /* LED Yellow glow spots - ANIMATED */
            radial-gradient(circle at 10% 50%, #ffd700 0%, rgba(255, 215, 0, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 25% 50%, #ffd700 0%, rgba(255, 215, 0, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 40% 50%, #ffd700 0%, rgba(255, 215, 0, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 55% 50%, #ffd700 0%, rgba(255, 215, 0, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 70% 50%, #ffd700 0%, rgba(255, 215, 0, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 85% 50%, #ffd700 0%, rgba(255, 215, 0, 0.6) 8%, transparent 15%),
            /* Metallic rays conic gradient */
            conic-gradient(
                #cdcdcd, #9d9d9d, #808080,
                #bcbcbc, #c4c4c4, #e6e6e6,
                #dddddd, #a1a1a1, #7f7f7f,
                #8b8b8b, #bfbfbf, #e3e3e3,
                #d2d2d2, #a6a6a6, #858585,
                #8d8d8d, #c0c0c0, #e5e5e5,
                #d6d6d6, #9e9e9e, #828282,
                #8f8f8f, #bdbdbd, #e3e3e3,
                #cdcdcd
            );
        box-shadow:
            inset 0 1px 3px rgba(255, 255, 255, 0.5),
            inset 0 -1px 3px rgba(0, 0, 0, 0.6),
            0 0 20px rgba(255, 215, 0, 0.6),
            0 4px 12px rgba(0, 0, 0, 0.3);
        border-radius: 3px;
        position: relative;
        z-index: 10;
        animation: neonPulse 2s ease-in-out infinite;
    }

    /* ===== PROCESSUS SECTION ===== */
    .processus-section {
        padding: 100px 40px;
        background: linear-gradient(180deg, transparent 0%, rgba(10, 61, 53, 0.03) 100%);
    }

    .processus-container {
        max-width: 900px;
        margin: 0 auto;
        animation: fadeInUp 0.8s ease-out;
    }

    .processus-video {
        position: relative;
        width: 100%;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
        background: rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .processus-video video {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 20px;
    }

    .processus-title {
        font-size: 36px;
        text-align: center;
        margin-bottom: 50px;
        color: var(--vert-fonce);
        animation: fadeInDown 0.6s ease-out;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    /* ===== SCROLL BUTTONS ===== */
    .scroll-button {
        position: fixed;
        left: 30px;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        border: none;
        color: #121212;
        font-size: 24px;
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(160, 160, 160, 0.4);
        transition: all 0.3s ease;
        z-index: 999;
    }

    .scroll-button:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(160, 160, 160, 0.6);
    }

    .scroll-button.active {
        display: flex;
    }

    #scrollUp {
        bottom: 100px;
    }

    #scrollDown {
        bottom: 30px;
    }

    /* ===== PROMOTIONS SECTION ===== */
    .promotions-section {
        padding: 100px 40px;
        background: linear-gradient(180deg, rgba(10, 61, 53, 0.08) 0%, rgba(10, 61, 53, 0.03) 100%);
    }

    .promotions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .promo-card {
        position: relative;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
        backdrop-filter: blur(20px);
        border: 2px solid rgba(168, 168, 168, 0.3);
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: pointer;
        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

    .promo-card:nth-child(1) { animation-delay: 0.1s; }
    .promo-card:nth-child(2) { animation-delay: 0.2s; }
    .promo-card:nth-child(3) { animation-delay: 0.3s; }

    .promo-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(168, 168, 168, 0.3) 0%, transparent 70%);
        animation: promoGlow 3s ease-in-out infinite;
    }

    @keyframes promoGlow {
        0%, 100% {
            opacity: 0.5;
            transform: translate(0, 0);
        }
        50% {
            opacity: 0.8;
            transform: translate(-10px, -10px);
        }
    }

    .promo-card:hover {
        transform: translateY(-8px);
        border-color: rgba(168, 168, 168, 0.6);
        background: linear-gradient(135deg, rgba(168, 168, 168, 0.15), rgba(168, 168, 168, 0.08));
        box-shadow: 0 20px 50px rgba(168, 168, 168, 0.25), inset 0 0 20px rgba(168, 168, 168, 0.1);
    }

    .promo-badge {
        position: relative;
        z-index: 2;
        display: inline-block;
        background: linear-gradient(135deg, #a8a8a8, #e8e8e8);
        color: #0A3D35;
        padding: 10px 20px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 4px 15px rgba(168, 168, 168, 0.4);
    }

    .promo-title {
        position: relative;
        z-index: 2;
        font-size: 24px;
        color: white;
        margin-bottom: 10px;
