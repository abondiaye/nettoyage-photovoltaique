<!-- Scroll Navigation Bar -->
<div class="scroll-nav-bar" id="scrollNavBar">
    <button class="scroll-nav-btn" data-target="hero" title="Accueil">🏠</button>
    <button class="scroll-nav-btn" data-target="processus" title="Processus">🔄</button>
    <button class="scroll-nav-btn" data-target="services" title="Services">⚙️</button>
    <button class="scroll-nav-btn" data-target="avantages" title="Avantages">💡</button>
    <button class="scroll-nav-btn" data-target="promotions" title="Promotions">🎁</button>
    <button class="scroll-nav-btn" data-target="cta" title="Optimiser">🚀</button>
    <button class="scroll-nav-btn" data-target="contact" title="Contact">📍</button>
</div>

<style>
/* Scroll Navigation Bar */
.scroll-nav-bar {
    position: fixed;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 998;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    padding: 12px;
    border-radius: 50px;
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.scroll-nav-btn {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    color: white;
    cursor: pointer;
    font-size: 18px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.scroll-nav-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.4);
    transform: scale(1.1);
}

.scroll-nav-btn.active {
    background: rgba(10, 61, 53, 0.4);
    border-color: rgba(160, 160, 160, 0.6);
}

@media (max-width: 768px) {
    .scroll-nav-bar {
        right: 6px !important;
        gap: 2px !important;
        padding: 4px !important;
        background: rgba(255, 255, 255, 0.02) !important;
        border-radius: 25px !important;
        border: none !important;
        box-shadow: none !important;
    }

    .scroll-nav-btn {
        width: 30px !important;
        height: 30px !important;
        font-size: 10px !important;
        border: none !important;
        background: rgba(255, 255, 255, 0.01) !important;
        color: rgba(255, 255, 255, 0.3) !important;
    }

    .scroll-nav-btn:hover {
        background: rgba(255, 255, 255, 0.1) !important;
        color: rgba(255, 255, 255, 0.8) !important;
        transform: scale(1.05);
    }

    .scroll-nav-btn.active {
        background: rgba(160, 160, 160, 0.15) !important;
        color: rgba(255, 255, 255, 0.9) !important;
    }

    /* Mobile fixes for business card container */
    .carte-visite-container {
        height: auto !important;
        padding: 20px 15px !important;
    }

    .carte-visite-container > div[style*="display"] {
        display: flex !important;
        flex-direction: column !important;
        gap: 20px !important;
        max-width: 100% !important;
        margin: 0 auto !important;
    }

    .carte-visite-container > div[style*="display"] > div {
        height: 200px !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .carte-visite-container > p {
        margin-top: 20px !important;
        font-size: 12px !important;
    }
}
</style>

<script>
// Scroll Navigation Bar Functionality
const scrollNavButtons = document.querySelectorAll('.scroll-nav-btn');
const scrollNavBar = document.getElementById('scrollNavBar');

// Handle button clicks
scrollNavButtons.forEach(btn => {
    btn.addEventListener('click', () => {
        const targetId = btn.dataset.target;
        const targetElement = targetId === 'hero'
            ? document.querySelector('.hero-container')
            : document.getElementById(targetId);

        if (targetElement) {
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
});

// Update active button based on scroll position
window.addEventListener('scroll', () => {
    let currentSection = 'hero';

    const sections = [
        { id: 'hero', element: document.querySelector('.hero-container'), offset: 0 },
        { id: 'processus', element: document.getElementById('processus'), offset: 200 },
        { id: 'services', element: document.getElementById('services'), offset: 200 },
        { id: 'avantages', element: document.getElementById('avantages'), offset: 200 },
        { id: 'promotions', element: document.getElementById('promotions'), offset: 200 },
        { id: 'realisations', element: document.getElementById('realisations'), offset: 200 },
        { id: 'cta', element: document.getElementById('cta'), offset: 200 },
        { id: 'contact', element: document.getElementById('contact'), offset: 200 }
    ];

    sections.forEach(section => {
        if (section.element) {
            const rect = section.element.getBoundingClientRect();
            if (rect.top <= section.offset && rect.bottom > section.offset) {
                currentSection = section.id;
            }
        }
    });

    scrollNavButtons.forEach(btn => {
        btn.classList.remove('active');
        if (btn.dataset.target === currentSection) {
            btn.classList.add('active');
        }
    });

    // Show/hide scroll bar based on scroll position
    if (window.scrollY > 300) {
        scrollNavBar.style.opacity = '1';
        scrollNavBar.style.pointerEvents = 'auto';
    } else {
        scrollNavBar.style.opacity = '0.3';
        scrollNavBar.style.pointerEvents = 'none';
    }
});

// Scroll down by 500px (one step) - instantaneous
scrollDownBtn.addEventListener('click', () => {
    const currentScroll = window.scrollY;
    const targetScroll = currentScroll + 500;
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    window.scrollTo(0, Math.min(targetScroll, maxScroll));
});
</script>

{% endblock %}
