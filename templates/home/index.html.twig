{% extends 'base.html.twig' %}

{% block title %}Sirius-Solar — Nettoyage & Entretien de Panneaux Photovoltaïques{% endblock %}

{% block body %}
<style>
    /* ===== HERO SECTION ===== */
    .hero-container {
        position: relative;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;

        /* Outer gradient (type LISA BLACKPINK) */
        background: linear-gradient(135deg, #a8e6cf 0%, #88d8c0 100%);
        padding: 20px;
        overflow: hidden;
    }

    .hero-gradient-bg {
        position: absolute;
        inset: 20px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        border-radius: 20px;
        z-index: 0;
    }

    .hero-card {
        position: relative;
        z-index: 1;

        /* Glasmorphism */
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.3);

        border-radius: 20px;
        padding: 80px 60px;
        max-width: 700px;
        text-align: center;
        color: white;

        /* Shadow */
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3),
                    inset 0 0 30px rgba(255, 255, 255, 0.1);

        /* Animation */
        animation: fadeInUp 0.8s ease-out, floatCard 3s ease-in-out infinite;
    }

    @keyframes floatCard {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }

    .hero-title {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 20px;
        text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: -1px;
    }

    .hero-subtitle {
        font-size: 18px;
        opacity: 0.95;
        margin-bottom: 30px;
        line-height: 1.6;
        font-weight: 500;
    }

    .hero-features {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .feature-tag {
        background: rgba(212, 168, 66, 0.2);
        border: 1px solid rgba(212, 168, 66, 0.5);
        color: var(--dore);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        animation: fadeInUp 0.8s ease-out;
        animation-fill-mode: both;
    }

    .feature-tag:nth-child(1) { animation-delay: 0.1s; }
    .feature-tag:nth-child(2) { animation-delay: 0.2s; }
    .feature-tag:nth-child(3) { animation-delay: 0.3s; }

    .btn-cta {
        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
        color: #121212;
        border: none;
        padding: 16px 40px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

        box-shadow: 0 10px 30px rgba(212, 168, 66, 0.3);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-cta:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 20px 50px rgba(212, 168, 66, 0.5);
    }

    .btn-cta:active {
        transform: translateY(-1px) scale(0.98);
    }

    /* ===== SERVICES SECTION ===== */
    .services-section {
        padding: 100px 40px;
        background: linear-gradient(180deg, rgba(10, 61, 53, 0.05) 0%, transparent 100%);
    }

    .section-title {
        font-size: 42px;
        text-align: center;
        margin-bottom: 60px;
        color: var(--vert-fonce);
        animation: fadeInDown 0.6s ease-out;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .service-card {
        /* Glasmorphism */
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);

        border-radius: 16px;
        padding: 40px;
        text-align: center;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: pointer;

        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;
    }

    .service-card:nth-child(1) { animation-delay: 0.1s; }
    .service-card:nth-child(2) { animation-delay: 0.2s; }
    .service-card:nth-child(3) { animation-delay: 0.3s; }

    .service-card:hover {
        transform: translateY(-10px);
        background: rgba(212, 168, 66, 0.1);
        border-color: rgba(212, 168, 66, 0.5);

        box-shadow: 0 20px 40px rgba(212, 168, 66, 0.2);
    }

    .card-icon {
        font-size: 48px;
        margin-bottom: 20px;
        transition: transform 0.4s ease;
    }

    .service-card:hover .card-icon {
        transform: scale(1.2) rotateZ(10deg);
    }

    .service-card h3 {
        font-size: 22px;
        color: var(--vert-fonce);
        margin-bottom: 15px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .service-card p {
        color: #666;
        line-height: 1.6;
        margin-bottom: 25px;
        font-size: 15px;
    }

    .btn-learn {
        background: transparent;
        border: 2px solid var(--dore);
        color: var(--dore);
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

    .btn-learn:hover {
        background: var(--dore);
        color: white;
        transform: scale(1.05);
    }

    /* ===== ADVANTAGES SECTION ===== */
    .advantages-section {
        padding: 100px 40px;
        background: linear-gradient(180deg, transparent 0%, rgba(10, 61, 53, 0.05) 100%);
    }

    .advantages-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .advantage-card {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(212, 168, 66, 0.3);

        border-radius: 16px;
        padding: 40px;
        text-align: center;

        animation: fadeInUp 0.6s ease-out;
        animation-fill-mode: both;

        transition: all 0.3s ease;
    }

    .advantage-card:nth-child(1) { animation-delay: 0.1s; }
    .advantage-card:nth-child(2) { animation-delay: 0.2s; }
    .advantage-card:nth-child(3) { animation-delay: 0.3s; }
    .advantage-card:nth-child(4) { animation-delay: 0.4s; }

    .advantage-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(212, 168, 66, 0.15);
    }

    .advantage-icon {
        font-size: 42px;
        margin-bottom: 15px;
    }

    .advantage-card h3 {
        font-size: 20px;
        color: var(--vert-fonce);
        margin-bottom: 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .advantage-card p {
        color: #666;
        font-size: 14px;
        line-height: 1.6;
    }

    /* ===== CTA SECTION ===== */
    .cta-section {
        padding: 80px 40px;
        background: linear-gradient(135deg, var(--vert-fonce) 0%, var(--vert-clair) 100%);
        text-align: center;
        color: white;
    }

    .cta-content {
        max-width: 600px;
        margin: 0 auto;
        animation: fadeInUp 0.8s ease-out;
    }

    .cta-title {
        font-size: 38px;
        margin-bottom: 20px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .cta-text {
        font-size: 16px;
        margin-bottom: 30px;
        opacity: 0.95;
        line-height: 1.6;
    }

    .btn-cta-white {
        background: white;
        color: var(--vert-fonce);
        border: none;
        padding: 16px 40px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;

        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .btn-cta-white:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    }

    /* ===== FOOTER ===== */
    .footer {
        background: var(--noir);
        color: rgba(255, 255, 255, 0.7);
        padding: 60px 40px 30px;
    }

    .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto 40px;
    }

    .footer-column h3 {
        color: white;
        margin-bottom: 20px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
    }

    .footer-column a,
    .footer-column p {
        display: block;
        margin-bottom: 10px;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        font-size: 14px;
        transition: color 0.3s ease;
    }

    .footer-column a:hover {
        color: var(--dore);
    }

    .footer-bottom {
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 13px;
    }

    /* ===== RESPONSIVE MOBILE ===== */
    @media (max-width: 768px) {
        .hero-container {
            height: auto;
            padding: 20px 10px;
            min-height: 100vh;
        }

        .hero-gradient-bg {
            inset: 10px;
        }

        .hero-card {
            padding: 50px 30px;
        }

        .hero-title {
            font-size: 32px;
        }

        .hero-subtitle {
            font-size: 14px;
        }

        .services-section, .advantages-section, .cta-section, .footer {
            padding: 60px 20px;
        }

        .section-title, .cta-title {
            font-size: 28px;
        }

        .services-grid, .advantages-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .service-card, .advantage-card {
            padding: 30px 20px;
        }

        .footer-content {
            grid-template-columns: 1fr;
            gap: 30px;
        }
    }
</style>

<!-- Hero Section -->
<section class="hero-container">
    <div class="hero-gradient-bg"></div>

    <div class="hero-card">
        <h1 class="hero-title">Optimisez votre rendement solaire</h1>
