    /* Left wall only around the open niche: below it, it is hidden behind the text panel anyway
       (drawing it full height makes Chrome paint it over the panel). */
    .why-face--left { left: 0; height: var(--niche); }
    .why-face--right { left: var(--w); background: linear-gradient(90deg, #12406a 0%, #0a2238 100%); }
    .why-face--top,
    .why-face--floor,
    .why-face--bottom {
        left: 0;
        width: var(--w);
        height: var(--d);
        transform-origin: center top;
        transform: rotateX(-90deg);
        background: linear-gradient(180deg, #0d2c47 0%, #07182a 100%);
