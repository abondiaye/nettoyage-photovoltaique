    @keyframes whyDrip { 0% { transform: translateY(0) scale(0.4); opacity: 0; } 15% { transform: translateY(0) scale(1); opacity: 1; } 70% { transform: translateY(70px); opacity: 1; } 72%, 100% { transform: translateY(72px); opacity: 0; } }
    @keyframes whyRipple { 0%, 68% { transform: scale(0.2); opacity: 0; } 72% { opacity: 1; } 100% { transform: scale(1); opacity: 0; } }

