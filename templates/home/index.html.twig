    /* ===== Glitch / scramble intro (inside hero-card) ===== */
    .glitch-intro {
        position: relative;
        z-index: 2;
        width: 100%;
        padding: 1.5rem 0.5rem 1.75rem;
        margin-bottom: 10px;
        border-radius: 14px;
        overflow: hidden;
        font-family: 'Share Tech Mono', monospace;
        isolation: isolate;
    }

    .glitch-intro::before {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            0deg,
            transparent,
            transparent 2px,
            rgba(0, 0, 0, 0.08) 2px,
            rgba(0, 0, 0, 0.08) 4px
        );
        pointer-events: none;
        z-index: 1;
    }

    .glitch-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(61, 220, 151, 0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(61, 220, 151, 0.05) 1px, transparent 1px);
        background-size: 28px 28px;
        pointer-events: none;
    }

    .glitch-corner {
        position: absolute;
        width: 16px;
        height: 16px;
        border-color: rgba(61, 220, 151, 0.3);
        border-style: solid;
        z-index: 2;
        opacity: 0;
        animation: glitchFadeIn 1s ease 1.1s forwards;
    }
    .glitch-corner.tl { top: 10px; left: 10px; border-width: 1px 0 0 1px; }
    .glitch-corner.tr { top: 10px; right: 10px; border-width: 1px 1px 0 0; }
    .glitch-corner.bl { bottom: 10px; left: 10px; border-width: 0 0 1px 1px; }
    .glitch-corner.br { bottom: 10px; right: 10px; border-width: 0 1px 1px 0; }

    .glitch-prefix {
        position: relative;
        z-index: 2;
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: rgba(61, 220, 151, 0.4);
        text-transform: uppercase;
        margin-bottom: 0.6rem;
        opacity: 0;
        animation: glitchFadeUp 0.6s ease 0.2s forwards;
    }

    .glitch-line {
        position: relative;
        z-index: 2;
        font-family: 'Bebas Neue', 'Space Grotesk', sans-serif;
        font-size: clamp(1.7rem, 5vw, 3rem);
        color: #3ddc97;
        line-height: 1;
        letter-spacing: 0.03em;
        text-shadow: 0 0 14px rgba(61, 220, 151, 0.5), 0 0 36px rgba(61, 220, 151, 0.2);
        display: block;
        min-height: 1.1em;
        opacity: 0;
        animation: glitchFadeUp 0.4s ease 0.05s forwards;
    }

    .glitch-line + .glitch-line {
        color: #3ddc97;
        font-size: clamp(1rem, 3vw, 1.6rem);
        margin-top: 0.15em;
        text-shadow: 0 0 10px rgba(61, 220, 151, 0.6), 0 0 26px rgba(61, 220, 151, 0.3);
    }

    .glitch-char {
        display: inline-block;
        transition: color 0.05s;
    }
    .glitch-char.is-glitching {
        color: rgba(61, 220, 151, 0.5);
        animation: glitchFlicker 0.08s steps(1) infinite;
    }

    .glitch-divider {
        position: relative;
        z-index: 2;
        width: 70px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #3ddc97, transparent);
        margin: 0.9rem auto;
        opacity: 0;
        animation: glitchFadeUp 0.6s ease 0.5s forwards;
    }

    .glitch-sub {
        position: relative;
        z-index: 2;
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        color: #3ddc97;
        text-transform: uppercase;
        text-shadow: 0 0 8px rgba(61, 220, 151, 0.5);
        opacity: 0;
        animation: glitchFadeUp 0.6s ease 0.65s forwards;
    }

    .glitch-sub--small {
        margin-top: 0.4rem;
        font-size: 0.62rem;
        letter-spacing: 0.08em;
        color: #3ddc97;
        text-shadow: 0 0 8px rgba(61, 220, 151, 0.5);
        text-transform: none;
        animation-delay: 0.8s;
    }

    .glitch-cta {
        position: relative;
        z-index: 2;
        margin-top: 1.3rem;
        display: inline-block;
        font-family: 'Share Tech Mono', monospace;
        font-size: 0.62rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #3ddc97;
        text-shadow: 0 0 8px rgba(61, 220, 151, 0.5);
        border: 1px solid rgba(61, 220, 151, 0.45);
        padding: 0.45rem 1.1rem;
        background: transparent;
        text-decoration: none;
        transition: color 0.2s, border-color 0.2s, box-shadow 0.2s, background 0.2s;
        opacity: 0;
        animation: glitchFadeUp 0.6s ease 0.95s forwards;
    }
    .glitch-cta:hover {
        color: #3ddc97;
        border-color: rgba(61, 220, 151, 0.9);
        box-shadow: 0 0 18px rgba(61, 220, 151, 0.4), inset 0 0 18px rgba(61, 220, 151, 0.2);
        background: rgba(61, 220, 151, 0.08);
    }

    .glitch-statusbar {
        position: relative;
        z-index: 2;
        margin-top: 0.9rem;
        font-size: 0.55rem;
        letter-spacing: 0.14em;
        color: #3ddc97;
        text-shadow: 0 0 8px rgba(61, 220, 151, 0.5);
        opacity: 0;
        animation: glitchFadeIn 1s ease 1.3s forwards;
        white-space: nowrap;
        overflow-x: auto;
    }

    @keyframes glitchFadeUp {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes glitchFadeIn {
        to { opacity: 1; }
    }
    @keyframes glitchFlicker {
        0%, 100% { opacity: 1; }
        50%      { opacity: 0.4; }
    }

    @media (max-width: 480px) {
        .glitch-intro { padding: 1.1rem 0.4rem 1.3rem; }
        .glitch-statusbar { font-size: 0.5rem; }
    }


    /* Logo 3D (Three.js) : sans cadre, posé en haut de la carte. */
    .hero-logo--3d {
        position: relative;
        top: auto;
        left: auto;
        transform: none;
        width: min(560px, 100%);
        height: auto;
        aspect-ratio: 2.4;
        margin: -30px auto 10px;
        padding: 0;
        background: none;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
        animation: logo3dFloat 4s ease-in-out infinite;
    }
    .hero-logo--3d::before,
    .hero-logo--3d::after { display: none; }
    .hero-logo--3d canvas { display: block; width: 100%; height: 100%; }
    .hero-card:has(.hero-logo--3d) { padding-top: 30px; }
    /* Carte principale épaisse : 18 contours empilés en profondeur forment une dalle de verre
       de ~70 px, la carte est légèrement inclinée et suit un peu la souris. */
    .hero-container { perspective: 1400px; }
    .hero-card--thick {
        backdrop-filter: none;          /* un filtre aplatirait la 3D */
        -webkit-backdrop-filter: none;
        background: rgba(3, 18, 14, 0.35);
        transform-style: preserve-3d;
        transform: rotateX(var(--hx, 7deg)) rotateY(var(--hy, -12deg));
        transition: transform 0.35s ease-out;
        overflow: visible;
    }
    .hero-card--thick::before { background: rgba(0, 0, 0, 0.12); }
    .hero-card__layers {
        position: absolute;
        inset: 0;
        z-index: 0;
        transform-style: preserve-3d;
        pointer-events: none;
    }
    .hero-card__layers span {
        position: absolute;
        inset: -1px;
        border-radius: 20px;
        border: 1.5px solid rgba(61, 220, 151, calc(0.75 - var(--i) * 0.025));
        background: rgba(0, 90, 60, 0.05);
        transform: translateZ(calc(var(--i) * -4px));
    }
    .hero-card__layers span:last-child {
        background: rgba(2, 14, 10, 0.55);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55), 0 0 40px rgba(61, 220, 151, 0.15);
    }
    @media (max-width: 768px) {
        .hero-card--thick { transform: rotateX(6deg) rotateY(-8deg); }
        .hero-card__layers span { transform: translateZ(calc(var(--i) * -3px)); }
    }
    @media (prefers-reduced-motion: reduce) {
        .hero-card--thick { transform: none; transition: none; }
    }
    /* Mobile: the footer (knob + columns) stacks and stays centred. */
    @media (max-width: 768px) {
        .footer-main { flex-direction: column !important; align-items: center !important; gap: 30px !important; padding: 20px 0 !important; }
        .footer-main > div { width: 100%; }
    }


    /* ===== « Pourquoi Sirius-Solar ? » : vitrines 3D ouvertes avec un objet animé dedans =====
       Boîte en CSS 3D (fond, côtés, plafond, plancher de la niche) ; le panneau du bas porte le texte,
       le côté droit une bannière verticale. Tranches bleu néon, objets lumineux. */
    .why-grid {
        --w: 250px;   /* largeur */
        --h: 340px;   /* hauteur */
        --d: 120px;   /* profondeur */
        --niche: 165px; /* hauteur de la vitrine ouverte */
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 40px 30px;
        max-width: 1280px;
        margin: 0 auto;
        padding: 20px 10px 30px;
        justify-items: center;
    }
    .why-box { width: var(--w); height: calc(var(--h) + 30px); perspective: 1100px; }
    .why-box__scene {
        position: relative;
        width: var(--w);
        height: var(--h);
        transform-style: preserve-3d;
        transform: rotateX(-12deg) rotateY(-28deg);
        transition: transform 0.8s cubic-bezier(.2, .8, .2, 1);
    }
    .why-box:hover .why-box__scene { transform: rotateX(-6deg) rotateY(-8deg); }

    .why-face {
        position: absolute;
        box-sizing: border-box;
        border: 1px solid rgba(60, 214, 255, 0.55);
        box-shadow: inset 0 0 18px rgba(60, 214, 255, 0.12);
