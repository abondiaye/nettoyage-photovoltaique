    /* 2. Tap with a falling drop and a ripple */
    .why-tap {
        position: absolute;
        top: 22px;
        left: 50%;
        width: 60px;
        height: 22px;
        margin-left: -30px;
        border-radius: 6px 6px 14px 14px;
        background: linear-gradient(180deg, #d8e6f2 0%, #7b8fa3 100%);
