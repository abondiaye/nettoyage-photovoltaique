            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; max-width: 900px; margin: 0 auto;">
                <!-- Face 1: cartet.jpeg -->
                <div style="position: relative; border-radius: 20px; overflow: hidden; box-shadow: 0 15px 50px rgba(160, 160, 160, 0.3); cursor: pointer; transition: transform 0.3s ease, filter 0.3s ease;">
                    <img src="{{ asset('images/cartet.jpeg') }}" alt="Sirius-Solar - Carte de Visite (Face 1)" style="width: 100%; height: 100%; object-fit: cover; border-radius: 20px; filter: brightness(1.2) contrast(1.3) saturate(1.15); transition: filter 0.3s ease;" onmouseover="this.style.filter='brightness(1.35) contrast(1.4) saturate(1.25)'" onmouseout="this.style.filter='brightness(1.2) contrast(1.3) saturate(1.15)'">
                    <div style="position: absolute; top: 15px; right: 15px; background: rgba(160, 160, 160, 0.9); color: #0A3D35; padding: 8px 16px; border-radius: 50px; font-weight: 600; font-size: 14px; backdrop-filter: blur(10px);">Face 1</div>
                </div>

                <!-- Face 2: cartet2.jpeg -->
                <div style="position: relative; border-radius: 20px; overflow: hidden; box-shadow: 0 15px 50px rgba(160, 160, 160, 0.3); cursor: pointer; transition: transform 0.3s ease, filter 0.3s ease;">
                    <img src="{{ asset('images/cartet2.jpeg') }}" alt="Sirius-Solar - Carte de Visite (Face 2)" style="width: 100%; height: 100%; object-fit: cover; border-radius: 20px; filter: brightness(1.2) contrast(1.3) saturate(1.15); transition: filter 0.3s ease;" onmouseover="this.style.filter='brightness(1.35) contrast(1.4) saturate(1.25)'" onmouseout="this.style.filter='brightness(1.2) contrast(1.3) saturate(1.15)'">
                    <div style="position: absolute; top: 15px; right: 15px; background: rgba(160, 160, 160, 0.9); color: #0A3D35; padding: 8px 16px; border-radius: 50px; font-weight: 600; font-size: 14px; backdrop-filter: blur(10px);">Face 2</div>
                </div>
            </div>

            <!-- Texte d'indication -->
            <p style="text-align: center; margin-top: 40px; color: rgba(255, 255, 255, 0.7); font-size: 14px; letter-spacing: 1px;">
                ✨ Vos cartes de visite professionnelles Sirius-Solar
            </p>

            {% if app.user %}
            <!-- Boutons Contact pour Connectés -->
            <div style="text-align: center; margin-top: 30px; display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                <a href="#contact" style="background: #a8a8a8; color: #0A3D35; padding: 12px 25px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 14px; transition: all 0.3s ease; display: inline-block;" onmouseover="this.style.boxShadow='0 10px 30px rgba(160, 160, 160, 0.5)'" onmouseout="this.style.boxShadow='none'">
                    📞 Nous Contacter
                </a>
                <a href="/devis" style="background: rgba(160, 160, 160, 0.2); color: #a8a8a8; padding: 12px 25px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 14px; border: 2px solid #a8a8a8; transition: all 0.3s ease; display: inline-block;" onmouseover="this.style.background='rgba(160, 160, 160, 0.3)'" onmouseout="this.style.background='rgba(160, 160, 160, 0.2)'">
                    📋 Demander un Devis
                </a>
            </div>
            {% else %}
            <!-- Message pour non-connectés -->
            <p style="text-align: center; margin-top: 30px; color: rgba(160, 160, 160, 0.8); font-size: 13px; letter-spacing: 0.5px;">
                <a href="{{ path('app_login') }}" style="color: #a8a8a8; text-decoration: underline;">Connectez-vous</a> pour voir les options de contact
            </p>
            {% endif %}
        </div>
    </div>

    <div class="footer-content">
        <div class="footer-column">
            <h3>Sirius-Solar</h3>
