    /* ===== NEON GRAY LED ANIMATION ===== */
    @keyframes neonPulse {
        0%, 100% {
            opacity: 0.6;
            filter: blur(0px);
        }
        50% {
            opacity: 1;
            filter: blur(0.5px);
        }
    }

    /* ===== METALLIC SEPARATOR WITH YELLOW LEDS ===== */
    .processus-section::before,
    .services-section::before,
    .advantages-section::before,
    .cta-section::before {
        content: '';
        display: block;
        height: 12px;
        margin: 50px 0;
        background:
            /* LED White/Silver glow spots */
            radial-gradient(circle at 10% 50%, #f0f0f0 0%, rgba(240, 240, 240, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 25% 50%, #f0f0f0 0%, rgba(240, 240, 240, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 40% 50%, #f0f0f0 0%, rgba(240, 240, 240, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 55% 50%, #f0f0f0 0%, rgba(240, 240, 240, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 70% 50%, #f0f0f0 0%, rgba(240, 240, 240, 0.6) 8%, transparent 15%),
            radial-gradient(circle at 85% 50%, #f0f0f0 0%, rgba(240, 240, 240, 0.6) 8%, transparent 15%),
            /* 3D button style gradient */
            linear-gradient(180deg, #e6e6e6 0%, rgba(0, 0, 0, 0.25) 49%, rgba(38, 38, 38, 0.6) 51%, rgba(0, 0, 0, 0.25) 100%);
        box-shadow:
            inset 0 1px 2px rgba(255, 255, 255, 0.3),
            0 2px 4px rgba(0, 0, 0, 0.3);
        border-radius: 3px;
        position: relative;
        z-index: 10;
        animation: neonPulse 2s ease-in-out infinite;
    }

    /* ===== PROCESSUS SECTION ===== */
    .processus-section {
