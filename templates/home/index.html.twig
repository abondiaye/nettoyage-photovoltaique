    .why-face--top { top: 0; }
    .why-face--floor { top: var(--niche); background: linear-gradient(180deg, #16466e 0%, #0b2640 100%); }
    .why-face--bottom { top: var(--h); box-shadow: 0 0 40px rgba(60, 214, 255, 0.25), 0 30px 60px rgba(0, 0, 0, 0.6); }

    /* Vertical banner on the right side, like the Monopoly utility cards. */
    .why-banner {
