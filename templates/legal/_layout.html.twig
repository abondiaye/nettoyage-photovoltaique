{% extends 'base.html.twig' %}
{# Shared look of the legal pages: one readable card, green or blue with the site style. #}
{% block body %}
<style>
    .legal { padding: 30px 16px 70px; min-height: 70vh; background: radial-gradient(ellipse at 20% 0%, rgba(61, 220, 151, 0.12), transparent 55%), #03120e; }
    .legal__card { max-width: 820px; margin: 0 auto; padding: 40px 44px; border-radius: 20px; background: rgba(6, 30, 22, 0.85); border: 1px solid rgba(61, 220, 151, 0.25); color: #dff5ea; line-height: 1.7; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35); }
    .legal__card h1 { margin: 0 0 6px; font: 700 32px/1.2 'Space Grotesk', system-ui, sans-serif; color: #ffffff; }
    .legal__card .legal__date { margin: 0 0 28px; font-size: 14px; color: rgba(223, 245, 234, 0.65); }
    .legal__card h2 { margin: 30px 0 10px; font: 700 20px/1.3 'Space Grotesk', system-ui, sans-serif; color: #3ddc97; }
    .legal__card p, .legal__card li { font-size: 15px; }
    .legal__card ul { padding-left: 20px; }
    .legal__card a { color: #3ddc97; }
    html.theme-pro .legal { background: #f8fafc; }
    html.theme-pro .legal__card { background: #ffffff; border-color: #e2e8f0; color: #334155; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 8px 24px rgba(15, 23, 42, 0.08); }
    html.theme-pro .legal__card h1 { color: #0f172a; }
    html.theme-pro .legal__card .legal__date { color: #64748b; }
    html.theme-pro .legal__card h2 { color: #1d4ed8; }
    html.theme-pro .legal__card a { color: #1d4ed8; }
    @media (max-width: 600px) { .legal__card { padding: 26px 20px; } .legal__card h1 { font-size: 26px; } }
</style>
<section class="legal">
    <article class="legal__card">
        {% block legal %}{% endblock %}
    </article>
</section>
{% endblock %}
