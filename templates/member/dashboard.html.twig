{% extends 'base.html.twig' %}

{% block title %}Member Dashboard - Solar Cleaning{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-bleu-nuit mb-8">Member Dashboard</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-2xl font-bold text-jaune-solaire mb-2">{{ points }}</h2>
            <p class="text-gray-600">Points Available</p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-2xl font-bold text-bleu-panneau mb-2">{{ discounts | length }}</h2>
            <p class="text-gray-600">Active Discounts</p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-2xl font-bold text-green-600 mb-2">{{ user.appointments | length }}</h2>
            <p class="text-gray-600">Scheduled Appointments</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-2xl font-bold text-bleu-nuit mb-4">Points History</h3>
            <div class="space-y-3">
                {% for point in pointsHistory %}
                    <div class="border-l-4 border-jaune-solaire pl-4">
                        <p class="font-semibold">+{{ point.amount }} points</p>
                        <p class="text-sm text-gray-600">{{ point.source | replace({'_': ' '}) }}</p>
                        <p class="text-xs text-gray-500">{{ point.createdAt ? point.createdAt.format('d/m/Y') : 'N/A' }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-2xl font-bold text-bleu-nuit mb-4">Available Discounts</h3>
            <div class="space-y-3">
                {% for discount in discounts %}
                    <div class="bg-green-50 border border-green-200 rounded p-4">
                        <p class="font-semibold text-green-700">{{ discount.percent }}% Discount</p>
                        <p class="text-sm text-gray-600">Created: {{ discount.createdAt.format('d/m/Y') }}</p>
                    </div>
                {% else %}
                    <p class="text-gray-500">Accumulate 100 points to earn a discount!</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="mt-8">
        <a href="{{ path('app_member_appointments') }}" class="inline-block bg-jaune-solaire text-bleu-nuit font-bold py-3 px-6 rounded-lg hover:bg-opacity-90 transition">
            View My Appointments
        </a>
        <a href="{{ path('app_appointment_book') }}" class="inline-block bg-bleu-panneau text-white font-bold py-3 px-6 rounded-lg hover:bg-opacity-90 transition ml-4">
            Book Appointment
        </a>
    </div>
</div>
{% endblock %}
