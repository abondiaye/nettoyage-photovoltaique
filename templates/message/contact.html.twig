{% extends 'base.html.twig' %}

{% block title %}Envoyer un message - Sirius-Solar{% endblock %}

{% block body %}
{# Same liquid-glass card as the login page: green panel with our details on the left, form on the right. #}
<div class="auth3d">
    <div class="auth-slide is-contact" data-auth-slide>
        <div class="auth-slide__welcome">
            <h2>Contact</h2>
            <p>Une question, un devis ?<br>Nous répondons sous 48 h.</p>
            <ul class="contact-info">
                <li>📞 <a href="tel:0779096413">077 909 64 13</a></li>
                <li>💬 <a href="https://wa.me/41779096413" target="_blank" rel="noopener">WhatsApp</a></li>
                <li>✉️ <a href="mailto:ndiayeharouna1991@gmail.com">ndiayeharouna1991@gmail.com</a></li>
                <li>📍 Route des dragons 7<br>1033 Cheseaux-sur-Lausanne</li>
            </ul>
            <a href="{{ path('app_devis') }}" class="contact-devis">Demander un devis</a>
        </div>

        <div class="auth-slide__form">
            <h1 class="auth-slide__brand">Envoyer un message</h1>
            <p class="auth-slide__sub">Laissez-nous un message, nous vous recontactons au plus tôt</p>

            {% if success %}
                <div class="auth3d-alert auth3d-alert--success">✅ Votre message a bien été reçu. Nous vous recontacterons bientôt.</div>
            {% endif %}

            <form method="POST" action="{{ path('app_contact_submit') }}">
                <div class="auth3d-field">
                    <label for="nom">Votre nom *</label>
                    <input type="text" id="nom" name="nom" placeholder="Jean Dupont" autocomplete="name" required>
                </div>
                <div class="auth3d-field">
                    <label for="email">Votre e-mail *</label>
                    <input type="email" id="email" name="email" placeholder="jean@example.com" autocomplete="email" required>
                </div>
                <div class="auth3d-field">
                    <label for="message">Votre message *</label>
                    <textarea id="message" name="message" rows="4" placeholder="Décrivez votre demande ici..." required></textarea>
                </div>
                <div class="auth3d-field">
                    <label for="datePreferee">Date préférée d'intervention</label>
                    <input type="date" id="datePreferee" name="datePreferee">
                </div>
                <button type="submit" class="auth3d-btn">Envoyer le message</button>
            </form>
        </div>
    </div>
</div>

<style>
    .auth-slide.is-contact { min-height: 640px; }
    .auth3d-field textarea {
        width: 100%;
        padding: 13px 16px;
        border-radius: 12px;
        border: 1px solid rgba(61, 220, 151, 0.2);
        background: rgba(0, 0, 0, 0.35);
        color: #fff;
        font: inherit;
        font-size: 15px;
        resize: vertical;
        min-height: 110px;
        outline: none;
        box-sizing: border-box;
    }
    .auth3d-field textarea::placeholder { color: rgba(255, 255, 255, 0.35); }
    .auth3d-field textarea:focus { background: rgba(0, 0, 0, 0.5); border-color: #3ddc97; box-shadow: 0 0 0 3px rgba(61, 220, 151, 0.15); }
    .auth3d-field input[type="date"] { color-scheme: dark; }
    .contact-info { position: relative; list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 10px; font-size: 14px; color: rgba(255, 255, 255, 0.92); }
    .contact-info a { color: #fff; text-decoration: none; word-break: break-all; }
    .contact-info a:hover { text-decoration: underline; }
    .contact-devis {
        position: relative;
        display: inline-block;
        padding: 12px 26px;
        border-radius: 12px;
        border: 1.5px solid rgba(255, 255, 255, 0.55);
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    }
    .contact-devis:hover { background: #fff; color: #0A3D35; transform: translateY(-3px); }
    html.theme-pro .auth3d-field textarea { background: #fff !important; border: 1px solid #cbd5e1 !important; color: #0f172a !important; }
    html.theme-pro .auth3d-field textarea::placeholder { color: #94a3b8 !important; }
    html.theme-pro .auth3d-field input[type="date"] { color-scheme: light; }
    html.theme-pro .contact-info, html.theme-pro .contact-info a { color: #ffffff !important; }
    html.theme-pro .contact-devis:hover { color: #1d4ed8; }
</style>

{% include 'components/_auth3d.html.twig' %}
{% endblock %}
