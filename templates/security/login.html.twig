{% extends "base.html.twig" %}

{% block title %}Connexion - Sirius-Solar{% endblock %}

{% block body %}
<div class="auth3d">
    <div class="auth-slide" data-auth-slide>
        <div class="auth-slide__welcome">
            <h2>Bonjour !</h2>
            <p>Pas encore de compte ?</p>
            <a href="{{ path('app_register') }}" class="auth-slide__toggle">Créer un compte</a>
        </div>

        <div class="auth-slide__form">
            <h1 class="auth-slide__brand">Connexion</h1>
            <p class="auth-slide__sub">Accédez à votre espace Sirius-Solar</p>

            {% for message in app.flashes('success') %}
                <div class="auth3d-alert auth3d-alert--success">{{ message }}</div>
            {% endfor %}

            {% if error %}
                <div class="auth3d-alert auth3d-alert--error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="auth3d-field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" value="{{ last_username }}" placeholder="votre@email.com" autocomplete="email" required autofocus>
                </div>

                <div class="auth3d-field">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required>
                </div>

                <a href="{{ path('app_forgot_password') }}" class="auth3d-forgot">Mot de passe oublié ?</a>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="auth3d-btn">Se connecter</button>
            </form>
        </div>
    </div>
</div>

{% include 'components/_auth3d.html.twig' %}
{% endblock %}
