{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe - Sirius-Solar{% endblock %}

{% block body %}

<style>
    .reset-password-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #0A3D35, #2D6B55);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        margin-top: 70px;
    }

    .reset-password-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        padding: 50px 40px;
        max-width: 450px;
        width: 100%;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .reset-password-card h1 {
        font-size: 32px;
        color: white;
        margin: 0 0 10px 0;
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
    }

    .reset-password-card p {
        color: rgba(255, 255, 255, 0.8);
        text-align: center;
        margin-bottom: 30px;
        font-size: 14px;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 8px;
        font-weight: 600;
        font-size: 14px;
    }

    .form-group input[type="password"] {
        width: 100%;
        padding: 12px 15px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        color: white;
        font-size: 14px;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-group input[type="password"]::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .form-group input[type="password"]:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.15);
        border-color: #a8a8a8;
        box-shadow: 0 0 10px rgba(168, 168, 168, 0.3);
    }

    .password-strength {
        margin-top: 8px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.7);
    }

    .error-message {
        background: rgba(244, 67, 54, 0.2);
        border: 1px solid rgba(244, 67, 54, 0.4);
        color: #ff6b6b;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .btn-submit {
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, #a8a8a8, #d8d8d8);
        color: #0A3D35;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 20px;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(168, 168, 168, 0.3);
    }

    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .links {
        text-align: center;
        margin-top: 20px;
    }

    .links a {
        color: #a8a8a8;
        text-decoration: none;
        font-size: 13px;
        transition: all 0.3s ease;
    }

    .links a:hover {
        text-decoration: underline;
        color: #ffffff;
    }

    /* Dark mode */
    body.dark-mode .reset-password-container {
        background: linear-gradient(135deg, #1a4d42, #2D6B55);
    }

    body.dark-mode .reset-password-card {
        background: rgba(30, 30, 30, 0.8);
        border-color: rgba(255, 255, 255, 0.1);
    }

    /* Mobile */
    @media (max-width: 600px) {
        .reset-password-card {
            padding: 30px 20px;
        }

        .reset-password-card h1 {
            font-size: 24px;
        }
    }
</style>

<div class="reset-password-container">
    <div class="reset-password-card">
        <h1>🔐 Créer un nouveau mot de passe</h1>
        <p>Entrez votre nouveau mot de passe (minimum 8 caractères)</p>

        {% if error %}
            <div class="error-message">
                ❌ {{ error }}
            </div>
        {% endif %}

        <form method="POST">
            <div class="form-group">
                <label for="password">Nouveau mot de passe</label>
                <input type="password" id="password" name="password" placeholder="••••••••" required autofocus minlength="8">
                <div class="password-strength">✓ Minimum 8 caractères</div>
            </div>

            <div class="form-group">
                <label for="password_confirm">Confirmer le mot de passe</label>
                <input type="password" id="password_confirm" name="password_confirm" placeholder="••••••••" required minlength="8">
            </div>

            <button type="submit" class="btn-submit">Réinitialiser le mot de passe</button>
        </form>

        <div class="links">
            <p><a href="{{ path('app_login') }}">← Retour au login</a></p>
        </div>
    </div>
</div>

{% endblock %}
