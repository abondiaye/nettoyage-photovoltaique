{% extends "base.html.twig" %}

{% block title %}Mon Dashboard - Sirius-Solar{% endblock %}

{% block body %}
<div style="min-height: calc(100vh - 80px); background: linear-gradient(135deg, #0A3D35 0%, #2D6B55 100%); padding: 40px 20px;">
    <div class="container" style="max-width: 1200px;">
        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; animation: fadeInDown 0.6s ease-out;">
            <div>
                <h1 style="
                    color: white;
                    font-size: 36px;
                    font-weight: 700;
                    font-family: 'Space Grotesk', sans-serif;
                    margin-bottom: 5px;
                ">Bienvenue, {{ app.user.prenom }}!</h1>
                <p style="color: rgba(255,255,255, 0.7);">Gérez vos demandes de devis et vos services</p>
            </div>
            <a href="{{ path('app_logout') }}" style="
                background: rgba(255,255,255, 0.1);
                color: white;
                border: 1px solid rgba(255,255,255, 0.3);
                padding: 10px 20px;
                border-radius: 8px;
                text-decoration: none;
                transition: all 0.3s ease;
            " onmouseover="this.style.background='rgba(255,255,255, 0.2)'; this.style.borderColor='var(--dore)'; this.style.color='var(--dore)'" onmouseout="this.style.background='rgba(255,255,255, 0.1)'; this.style.borderColor='rgba(255,255,255, 0.3)'; this.style.color='white'">
                Déconnexion
            </a>
        </div>

        <!-- Stats Cards -->
        <div style="
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        ">
            <!-- Total Devis -->
            <div style="
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(160, 160, 160, 0.3);
                border-radius: 15px;
                padding: 25px;
                animation: fadeInUp 0.6s ease-out;
            ">
                <div style="display: flex; justify-content: space-between; align-items: start;">
                    <div>
                        <p style="color: rgba(255,255,255, 0.7); font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Total Devis</p>
                        <p style="color: var(--dore-clair); font-size: 32px; font-weight: 700;">{{ app.user.devis|length }}</p>
                    </div>
                    <span style="font-size: 32px;">📋</span>
                </div>
            </div>

            <!-- En Attente -->
            <div style="
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(160, 160, 160, 0.3);
                border-radius: 15px;
                padding: 25px;
                animation: fadeInUp 0.6s ease-out 0.1s both;
            ">
                <div style="display: flex; justify-content: space-between; align-items: start;">
                    <div>
                        <p style="color: rgba(255,255,255, 0.7); font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">En Attente</p>
                        <p style="color: #FFB84D; font-size: 32px; font-weight: 700;">
                            {% set en_attente = app.user.devis|filter(d => d.statut == 'nouveau')|length %}
                            {{ en_attente }}
                        </p>
                    </div>
                    <span style="font-size: 32px;">⏳</span>
                </div>
            </div>

            <!-- Confirmées -->
            <div style="
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(160, 160, 160, 0.3);
                border-radius: 15px;
                padding: 25px;
                animation: fadeInUp 0.6s ease-out 0.2s both;
            ">
                <div style="display: flex; justify-content: space-between; align-items: start;">
                    <div>
                        <p style="color: rgba(255,255,255, 0.7); font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Confirmées</p>
                        <p style="color: #52C77A; font-size: 32px; font-weight: 700;">
                            {% set confirmees = app.user.devis|filter(d => d.statut == 'accepte')|length %}
                            {{ confirmees }}
                        </p>
                    </div>
                    <span style="font-size: 32px;">✅</span>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div style="
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 40px;
        ">
            <a href="{{ path('app_devis') }}" style="
                background: linear-gradient(135deg, var(--dore), var(--dore-clair));
                color: #121212;
                padding: 15px 20px;
                border-radius: 10px;
                text-decoration: none;
                text-align: center;
                font-weight: 600;
                transition: all 0.3s ease;
                box-shadow: 0 8px 20px rgba(160, 160, 160, 0.3);
            " onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 12px 30px rgba(160, 160, 160, 0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 8px 20px rgba(160, 160, 160, 0.3)'">
                📝 Demander un Devis
            </a>

            <a href="{{ path('app_user_devis') }}" style="
                background: rgba(255, 255, 255, 0.1);
                color: white;
                padding: 15px 20px;
                border-radius: 10px;
                text-decoration: none;
                text-align: center;
                font-weight: 600;
                border: 1px solid rgba(160, 160, 160, 0.3);
                transition: all 0.3s ease;
            " onmouseover="this.style.background='rgba(160, 160, 160, 0.15)'; this.style.borderColor='var(--dore)'; this.style.color='var(--dore)'" onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='rgba(160, 160, 160, 0.3)'; this.style.color='white'">
                📊 Mes Devis
            </a>

            <a href="{{ path('app_user_profile') }}" style="
                background: rgba(255, 255, 255, 0.1);
                color: white;
                padding: 15px 20px;
                border-radius: 10px;
                text-decoration: none;
                text-align: center;
                font-weight: 600;
                border: 1px solid rgba(160, 160, 160, 0.3);
                transition: all 0.3s ease;
            " onmouseover="this.style.background='rgba(160, 160, 160, 0.15)'; this.style.borderColor='var(--dore)'; this.style.color='var(--dore)'" onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='rgba(160, 160, 160, 0.3)'; this.style.color='white'">
                👤 Mon Profil
            </a>
        </div>

        <!-- Recent Devis -->
        <div style="
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(160, 160, 160, 0.3);
            border-radius: 15px;
            padding: 30px;
            animation: fadeInUp 0.6s ease-out 0.3s both;
        ">
            <h2 style="color: white; font-size: 24px; font-weight: 700; margin-bottom: 20px;">Mes Derniers Devis</h2>

            {% if app.user.devis|length == 0 %}
                <p style="color: rgba(255,255,255, 0.7); text-align: center; padding: 40px 0;">
                    Vous n'avez pas encore demandé de devis. <a href="{{ path('app_devis') }}" style="color: var(--dore-clair); font-weight: 600;">Commencer maintenant</a>
                </p>
            {% else %}
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid rgba(160, 160, 160, 0.3);">
                                <th style="text-align: left; color: rgba(255,255,255, 0.7); padding: 12px 0; font-weight: 600;">Date</th>
                                <th style="text-align: left; color: rgba(255,255,255, 0.7); padding: 12px 0; font-weight: 600;">Type</th>
                                <th style="text-align: left; color: rgba(255,255,255, 0.7); padding: 12px 0; font-weight: 600;">Panneaux</th>
                                <th style="text-align: left; color: rgba(255,255,255, 0.7); padding: 12px 0; font-weight: 600;">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for d in app.user.devis|reverse %}
                                <tr style="border-bottom: 1px solid rgba(160, 160, 160, 0.2);">
                                    <td style="color: rgba(255,255,255, 0.8); padding: 15px 0;">{{ d.dateCreation|date('d/m/Y') }}</td>
                                    <td style="color: rgba(255,255,255, 0.8); padding: 15px 0;">{{ d.typeInstallation }}</td>
                                    <td style="color: rgba(255,255,255, 0.8); padding: 15px 0;">{{ d.nombrePanneaux }}</td>
                                    <td style="padding: 15px 0;">
                                        <span style="
                                            padding: 6px 12px;
                                            border-radius: 20px;
                                            font-size: 12px;
                                            font-weight: 600;
                                            background: {% if d.statut == 'accepte' %}#52C77A{% elseif d.statut == 'refuse' %}#FF6B6B{% else %}#FFB84D{% endif %};
                                            color: white;
                                        ">
                                            {% if d.statut == 'nouveau' %}En attente{% elseif d.statut == 'accepte' %}Confirmé{% elseif d.statut == 'refuse' %}Refusé{% else %}En cours{% endif %}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
