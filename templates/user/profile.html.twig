{% extends "base.html.twig" %}

{% block title %}Mon Profil - Sirius-Solar{% endblock %}

{% block body %}
<div style="min-height: calc(100vh - 80px); background: linear-gradient(135deg, #0A3D35 0%, #2D6B55 100%); padding: 40px 20px;">
    <div class="container" style="max-width: 600px;">
        <a href="{{ path('app_user_dashboard') }}" style="
            color: var(--dore-clair);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 30px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: gap 0.3s ease;
        " onmouseover="this.style.gap='12px'" onmouseout="this.style.gap='8px'">
            ← Retour au Dashboard
        </a>

        <div style="
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(30px) saturate(130%);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 20px;
            padding: 50px 40px;
            animation: fadeInUp 0.6s ease-out;
        ">
            <h1 style="
                color: white;
                font-size: 32px;
                font-weight: 700;
                margin-bottom: 10px;
                font-family: 'Space Grotesk', sans-serif;
            ">Mon Profil</h1>

            <p style="color: rgba(255,255,255, 0.7); margin-bottom: 40px;">
                Gérez vos informations personnelles
            </p>

            <!-- Profile Info Card -->
            <div style="
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(160, 160, 160, 0.3);
                border-radius: 15px;
                padding: 25px;
                margin-bottom: 30px;
            ">
                <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px;">
                    <div style="
                        width: 80px;
                        height: 80px;
                        border-radius: 50%;
                        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 32px;
                        box-shadow: 0 8px 20px rgba(160, 160, 160, 0.3);
                    ">
                        👤
                    </div>
                    <div>
                        <p style="color: rgba(255,255,255, 0.7); font-size: 12px; text-transform: uppercase;">Membre depuis</p>
                        <p style="color: var(--dore-clair); font-size: 14px; font-weight: 600;">{{ app.user.createdAt|date('d MMMM Y') }}</p>
                    </div>
                </div>

                <div style="border-top: 1px solid rgba(160, 160, 160, 0.2); padding-top: 20px;">
                    <p style="color: rgba(255,255,255, 0.7); font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">Email</p>
                    <p style="color: white; font-size: 14px; margin-bottom: 20px;">{{ app.user.email }}</p>

                    <p style="color: rgba(255,255,255, 0.7); font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">Demandes de Devis</p>
                    <p style="color: white; font-size: 14px;">{{ app.user.devis|length }} devis</p>
                </div>
            </div>

            <!-- Edit Form -->
            <form method="POST" style="display: none;" id="editForm">
                <div style="margin-bottom: 20px;">
                    <label style="
                        display: block;
                        color: rgba(255,255,255, 0.8);
                        font-weight: 600;
                        font-size: 13px;
                        margin-bottom: 8px;
                        text-transform: uppercase;
                    ">Prénom</label>
                    <input type="text" name="prenom" value="{{ app.user.prenom }}" style="
                        width: 100%;
                        padding: 12px 16px;
                        border: 1px solid rgba(160, 160, 160, 0.3);
                        border-radius: 10px;
                        background: rgba(255,255,255, 0.1);
                        color: white;
                        font-size: 14px;
                    ">
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="
                        display: block;
                        color: rgba(255,255,255, 0.8);
                        font-weight: 600;
                        font-size: 13px;
                        margin-bottom: 8px;
                        text-transform: uppercase;
                    ">Nom</label>
                    <input type="text" name="nom" value="{{ app.user.nom }}" style="
                        width: 100%;
                        padding: 12px 16px;
                        border: 1px solid rgba(160, 160, 160, 0.3);
                        border-radius: 10px;
                        background: rgba(255,255,255, 0.1);
                        color: white;
                        font-size: 14px;
                    ">
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="
                        display: block;
                        color: rgba(255,255,255, 0.8);
                        font-weight: 600;
                        font-size: 13px;
                        margin-bottom: 8px;
                        text-transform: uppercase;
                    ">Email</label>
                    <input type="email" name="email" value="{{ app.user.email }}" style="
                        width: 100%;
                        padding: 12px 16px;
                        border: 1px solid rgba(160, 160, 160, 0.3);
                        border-radius: 10px;
                        background: rgba(255,255,255, 0.1);
                        color: white;
                        font-size: 14px;
                    ">
                </div>

                <div style="display: flex; gap: 15px; margin-top: 30px;">
                    <button type="submit" style="
                        flex: 1;
                        background: linear-gradient(135deg, var(--dore), var(--dore-clair));
                        color: #121212;
                        border: none;
                        padding: 14px 20px;
                        border-radius: 10px;
                        font-weight: 600;
                        cursor: pointer;
                        transition: all 0.3s ease;
                    " onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                        Sauvegarder
                    </button>
                    <button type="button" onclick="toggleEdit()" style="
                        flex: 1;
                        background: rgba(255, 255, 255, 0.1);
                        color: white;
                        border: 1px solid rgba(160, 160, 160, 0.3);
                        padding: 14px 20px;
                        border-radius: 10px;
                        font-weight: 600;
                        cursor: pointer;
                        transition: all 0.3s ease;
                    " onmouseover="this.style.background='rgba(160, 160, 160, 0.15)'; this.style.borderColor='var(--dore)'; this.style.color='var(--dore)'" onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='rgba(160, 160, 160, 0.3)'; this.style.color='white'">
                        Annuler
                    </button>
                </div>
            </form>

            <!-- Edit Button -->
            <button onclick="toggleEdit()" style="
                width: 100%;
                background: linear-gradient(135deg, var(--dore), var(--dore-clair));
                color: #121212;
                border: none;
                padding: 14px 20px;
                border-radius: 10px;
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                transition: all 0.3s ease;
                box-shadow: 0 10px 30px rgba(160, 160, 160, 0.3);
            " id="editBtn" onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 15px 40px rgba(160, 160, 160, 0.4)'" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 10px 30px rgba(160, 160, 160, 0.3)'">
                ✏️ Modifier le Profil
            </button>
        </div>
    </div>
</div>

<script>
    function toggleEdit() {
        const form = document.getElementById('editForm');
        const btn = document.getElementById('editBtn');
        if (form.style.display === 'none') {
            form.style.display = 'block';
            btn.style.display = 'none';
        } else {
            form.style.display = 'none';
            btn.style.display = 'block';
        }
    }
</script>
{% endblock %}
