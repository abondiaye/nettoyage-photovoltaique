{% extends "base.html.twig" %}

{% block title %}Inscription - Sirius-Solar{% endblock %}

{% block body %}
<style>
  body {
    background-color: #ffffff;
    margin: 0;
    padding: 0;
  }
</style>

<div style="position: relative; min-height: 100vh; background-color: #ffffff; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <a href="{{ path('app_home') }}" style="position: absolute; top: 20px; left: 20px; color: #0A3D35; text-decoration: none; font-weight: 600; font-size: 14px; display: flex; align-items: center; gap: 5px;">
        ← Retour
    </a>
    <div style="
        max-width: 500px;
        width: 100%;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 50px 40px;
        box-shadow: 8px 8px 16px rgba(142, 161, 176, 0.5),
                   -6px -6px 16px rgba(255, 255, 255, 0.7),
                   -8px -8px 16px -2px rgba(142, 161, 176, 0.6) inset,
                   6px 6px 16px rgba(255, 255, 255, 0.6) inset;
        border: none;
    ">
        <h1 style="
            text-align: center;
            color: #0A3D35;
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
            font-family: 'Space Grotesk', sans-serif;
        ">
            <span class="scramble-register" id="registerScramble" data-text="Créer un compte"></span>
        </h1>

        <p style="
            text-align: center;
            color: #666;
            margin-bottom: 40px;
            font-size: 14px;
        ">
            Rejoignez Sirius-Solar et suivez vos devis
        </p>

        {{ form_start(registrationForm, {'attr': {'class': 'register-form'}}) }}

        <div style="margin-bottom: 20px;">
            {{ form_label(registrationForm.prenom, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.prenom, {'attr': {
                'class': 'form-input',
                'placeholder': 'Votre prénom',
                'style': 'width: 100%; padding: 12px 16px; border: none; border-radius: 8px; background: rgba(255,255,255, 0.2); color: #0A3D35; font-size: 14px; transition: all 0.3s ease; box-shadow: 4px 4px 8px rgba(142, 161, 176, 0.3), -3px -3px 8px rgba(255, 255, 255, 0.5), -4px -4px 8px -1px rgba(142, 161, 176, 0.3) inset, 3px 3px 8px rgba(255, 255, 255, 0.4) inset;'
            }}) }}
            {{ form_errors(registrationForm.prenom) }}
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(registrationForm.nom, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.nom, {'attr': {
                'class': 'form-input',
                'placeholder': 'Votre nom',
                'style': 'width: 100%; padding: 12px 16px; border: none; border-radius: 8px; background: rgba(255,255,255, 0.2); color: #0A3D35; font-size: 14px; transition: all 0.3s ease; box-shadow: 4px 4px 8px rgba(142, 161, 176, 0.3), -3px -3px 8px rgba(255, 255, 255, 0.5), -4px -4px 8px -1px rgba(142, 161, 176, 0.3) inset, 3px 3px 8px rgba(255, 255, 255, 0.4) inset;'
            }}) }}
            {{ form_errors(registrationForm.nom) }}
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.email, {'attr': {
                'class': 'form-input',
                'placeholder': 'votre@email.com',
                'style': 'width: 100%; padding: 12px 16px; border: none; border-radius: 8px; background: rgba(255,255,255, 0.2); color: #0A3D35; font-size: 14px; transition: all 0.3s ease; box-shadow: 4px 4px 8px rgba(142, 161, 176, 0.3), -3px -3px 8px rgba(255, 255, 255, 0.5), -4px -4px 8px -1px rgba(142, 161, 176, 0.3) inset, 3px 3px 8px rgba(255, 255, 255, 0.4) inset;'
            }}) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(registrationForm.plainPassword.first, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.plainPassword.first, {'attr': {
                'class': 'form-input',
                'placeholder': 'Minimum 8 caractères',
                'style': 'width: 100%; padding: 12px 16px; border: none; border-radius: 8px; background: rgba(255,255,255, 0.2); color: #0A3D35; font-size: 14px; transition: all 0.3s ease; box-shadow: 4px 4px 8px rgba(142, 161, 176, 0.3), -3px -3px 8px rgba(255, 255, 255, 0.5), -4px -4px 8px -1px rgba(142, 161, 176, 0.3) inset, 3px 3px 8px rgba(255, 255, 255, 0.4) inset;'
            }}) }}
            {{ form_errors(registrationForm.plainPassword.first) }}
        </div>

        <div style="margin-bottom: 30px;">
            {{ form_label(registrationForm.plainPassword.second, 'Confirmer le mot de passe', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.plainPassword.second, {'attr': {
                'class': 'form-input',
                'placeholder': 'Confirmez votre mot de passe',
                'style': 'width: 100%; padding: 12px 16px; border: none; border-radius: 8px; background: rgba(255,255,255, 0.2); color: #0A3D35; font-size: 14px; transition: all 0.3s ease; box-shadow: 4px 4px 8px rgba(142, 161, 176, 0.3), -3px -3px 8px rgba(255, 255, 255, 0.5), -4px -4px 8px -1px rgba(142, 161, 176, 0.3) inset, 3px 3px 8px rgba(255, 255, 255, 0.4) inset;'
            }}) }}
            {{ form_errors(registrationForm.plainPassword.second) }}
        </div>

        <button type="submit" style="
            width: 100%;
            background: linear-gradient(135deg, #0A3D35 0%, #082d28 100%);
            color: #ffffff;
            border: none;
            padding: 14px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 4px 4px 8px rgba(10, 61, 53, 0.4), -3px -3px 8px rgba(255, 255, 255, 0.3), -4px -4px 8px -1px rgba(10, 61, 53, 0.3) inset, 3px 3px 8px rgba(255, 255, 255, 0.2) inset;
        " onmouseover="this.style.boxShadow='6px 6px 12px rgba(10, 61, 53, 0.5), -4px -4px 12px rgba(255, 255, 255, 0.4), -6px -6px 12px -2px rgba(10, 61, 53, 0.4) inset, 4px 4px 12px rgba(255, 255, 255, 0.3) inset'; this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='4px 4px 8px rgba(10, 61, 53, 0.4), -3px -3px 8px rgba(255, 255, 255, 0.3), -4px -4px 8px -1px rgba(10, 61, 53, 0.3) inset, 3px 3px 8px rgba(255, 255, 255, 0.2) inset'; this.style.transform='translateY(0)'">
            S'inscrire
        </button>

        {{ form_end(registrationForm) }}

        <p style="text-align: center; color: #0A3D35; margin-top: 20px; font-size: 14px;">
            Vous avez déjà un compte? <a href="{{ path('app_login') }}" style="color: #0A3D35; text-decoration: underline; font-weight: 600; cursor: pointer;">Connectez-vous</a>
        </p>
    </div>
</div>

<style>
    .form-label {
        display: block;
        color: #0A3D35;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-input:focus {
        outline: none;
        border-color: #0A3D35 !important;
        background: #f0f8f6 !important;
        box-shadow: 0 0 8px rgba(10, 61, 53, 0.2) !important;
    }

    .scramble-register {
        display: inline-block;
        min-height: 1.1em;
    }

    .scramble-register .char {
        display: inline-block;
    }

    .scramble-register .char.glitch {
        color: #00b377;
        animation: registerFlicker 0.08s steps(1) infinite;
    }

    @keyframes registerFlicker {
        0%, 100% { opacity: 1; }
        50%      { opacity: 0.4; }
    }
</style>

<script>
(function () {
    var CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*!?/\\|<>';

    function registerRand(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
    }

    function registerScramble(el, finalText) {
        return new Promise(function (resolve) {
            var chars = finalText.split('').map(function (ch, i) {
                return {
                    char: ch,
                    done: ch === ' ',
                    iterations: Math.floor(Math.random() * 8) + i * 2
                };
            });

            el.innerHTML = chars.map(function (c, i) {
                return c.char === ' '
                    ? '<span class="char">&nbsp;</span>'
                    : '<span class="char glitch" data-i="' + i + '">' + registerRand(CHARS) + '</span>';
            }).join('');

            var spans = el.querySelectorAll('.char');
            var frame = 0;

            var tick = setInterval(function () {
                var allDone = true;
                chars.forEach(function (c, i) {
                    if (c.done) return;
                    if (frame >= c.iterations) {
                        spans[i].textContent = c.char;
                        spans[i].classList.remove('glitch');
                        c.done = true;
                    } else {
                        spans[i].textContent = registerRand(CHARS);
                        allDone = false;
                    }
                });
                frame++;
                if (allDone) {
                    clearInterval(tick);
                    resolve();
                }
            }, 45);
        });
    }

    window.runRegisterScramble = function () {
        var target = document.getElementById('registerScramble');
        if (target) {
            registerScramble(target, target.dataset.text);
        }
    };

    window.runRegisterScramble();
})();
</script>
{% endblock %}
