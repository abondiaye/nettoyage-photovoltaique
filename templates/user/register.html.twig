{% extends "base.html.twig" %}

{% block title %}Inscription - Sirius-Solar{% endblock %}

{% block body %}
<div style="min-height: calc(100vh - 80px); background: linear-gradient(135deg, #a8e6cf 0%, #88d8c0 100%); display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div style="
        max-width: 500px;
        width: 100%;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(30px) saturate(130%);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 20px;
        padding: 50px 40px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        animation: fadeInUp 0.6s ease-out;
    ">
        <h1 style="
            text-align: center;
            color: var(--vert-fonce);
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
            font-family: 'Space Grotesk', sans-serif;
        ">
            Créer un compte
        </h1>

        <p style="
            text-align: center;
            color: rgba(10, 61, 53, 0.7);
            margin-bottom: 40px;
            font-size: 14px;
        ">
            Rejoignez Sirius-Solar et suivez vos devis
        </p>

        {{ form_start(registrationForm, {'attr': {'class': 'register-form'}}) }}

        <div style="margin-bottom: 20px;">
            {{ form_label(registrationForm.prenom, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.prenom, {'attr': {
                'class': 'form-input',
                'placeholder': 'Votre prénom',
                'style': 'width: 100%; padding: 12px 16px; border: 1px solid rgba(212, 168, 66, 0.3); border-radius: 10px; background: rgba(255,255,255, 0.2); color: var(--vert-fonce); font-size: 14px; transition: all 0.3s ease;'
            }}) }}
            {{ form_errors(registrationForm.prenom) }}
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(registrationForm.nom, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.nom, {'attr': {
                'class': 'form-input',
                'placeholder': 'Votre nom',
                'style': 'width: 100%; padding: 12px 16px; border: 1px solid rgba(212, 168, 66, 0.3); border-radius: 10px; background: rgba(255,255,255, 0.2); color: var(--vert-fonce); font-size: 14px; transition: all 0.3s ease;'
            }}) }}
            {{ form_errors(registrationForm.nom) }}
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.email, {'attr': {
                'class': 'form-input',
                'placeholder': 'votre@email.com',
                'style': 'width: 100%; padding: 12px 16px; border: 1px solid rgba(212, 168, 66, 0.3); border-radius: 10px; background: rgba(255,255,255, 0.2); color: var(--vert-fonce); font-size: 14px; transition: all 0.3s ease;'
            }}) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(registrationForm.plainPassword.first, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.plainPassword.first, {'attr': {
                'class': 'form-input',
                'placeholder': 'Minimum 8 caractères',
                'style': 'width: 100%; padding: 12px 16px; border: 1px solid rgba(212, 168, 66, 0.3); border-radius: 10px; background: rgba(255,255,255, 0.2); color: var(--vert-fonce); font-size: 14px; transition: all 0.3s ease;'
            }}) }}
            {{ form_errors(registrationForm.plainPassword.first) }}
        </div>

        <div style="margin-bottom: 30px;">
            {{ form_label(registrationForm.plainPassword.second, 'Confirmer le mot de passe', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.plainPassword.second, {'attr': {
                'class': 'form-input',
                'placeholder': 'Confirmez votre mot de passe',
                'style': 'width: 100%; padding: 12px 16px; border: 1px solid rgba(212, 168, 66, 0.3); border-radius: 10px; background: rgba(255,255,255, 0.2); color: var(--vert-fonce); font-size: 14px; transition: all 0.3s ease;'
            }}) }}
            {{ form_errors(registrationForm.plainPassword.second) }}
        </div>

        <button type="submit" style="
            width: 100%;
            background: linear-gradient(135deg, var(--dore), var(--dore-clair));
            color: #121212;
            border: none;
            padding: 14px 20px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(212, 168, 66, 0.3);
        " onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 15px 40px rgba(212, 168, 66, 0.4)'" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='0 10px 30px rgba(212, 168, 66, 0.3)'">
            S'inscrire
        </button>

        {{ form_end(registrationForm) }}

        <p style="text-align: center; color: var(--vert-fonce); margin-top: 20px; font-size: 14px;">
            Vous avez déjà un compte? <a href="{{ path('app_login') }}" style="color: var(--dore); text-decoration: none; font-weight: 600;">Connectez-vous</a>
        </p>
    </div>
</div>

<style>
    .form-label {
        display: block;
        color: var(--vert-fonce);
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-input:focus {
        outline: none;
        border-color: var(--dore) !important;
        background: rgba(255,255,255, 0.3) !important;
        box-shadow: 0 0 12px rgba(212, 168, 66, 0.3);
    }
</style>
{% endblock %}
